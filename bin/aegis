#!/usr/bin/env bash
#
# aegis — launcher for the Aegis Workstation "workstation" Dev Container stack
# (templates/workstation, see docs/10-workstation.md and
# docs/11-aegis-cli.md). This script is the single source of truth: aegis.cmd
# and aegis.ps1 are thin wrappers that only invoke this file through Git
# Bash's bash.exe — they must never duplicate any logic from here.
#
# Locating the stack: AEGIS_WORKSTATION_DIR must point at the folder that
# contains this workstation's .devcontainer/. It resolves from the signed
# bundle `aegis install` places in AEGIS_INSTALL_DIR — there is no baked-in
# checkout path, on any drive letter, to fall back to (2026-11-04: the
# AEGIS_CLI_MODE=dev checkout override this comment used to describe is
# retired — every real invocation, including the owner's own machine, is
# what used to be called "client mode").
#
# Usage: aegis <command> [args...]
#   up                     Download the licensed image from the registry, verify
#                          its signature, then start the stack and wait for
#                          egress-proxy to be healthy, then run first-run/
#                          post-start prep. An image that does not verify does
#                          not start. With languages/tools in the manifest it
#                          runs your aegis-workstation-env:<hash> image,
#                          building it first when it is missing — never the
#                          bare published image in its place.
#   up --build             Maintainer escape: skip download and verification and
#                          build from the local checkout. That image carries no
#                          signature.
#   shell [path] [-- cmd..]
#                          Open an interactive shell under /workspace/<path>
#                          (auto-starts the stack if it is not running). With
#                          "-- cmd args...", runs that command instead of an
#                          interactive shell (non-interactive, for scripting
#                          and tests) and propagates its exit code.
#   herdr [path]           Same as `shell`, but launches herdr instead of a
#                          plain shell.
#   shell/herdr [path] [--dry-run] [-- cmd..]
#                          --dry-run (or AEGIS_DRY_RUN=1) prints the docker
#                          exec command that WOULD run and does not touch
#                          docker at all.
#   shell/herdr [path] --tunnel <host>:<port>[:<localPort>]
#                          Repeatable. Opens a 127.0.0.1:<localPort> tunnel
#                          inside the session for raw TCP clients that cannot
#                          be told about the proxy (usql, psql, redis-cli);
#                          the T40 squid rule is still the gate — without it
#                          the tunnel connects and dies. Lives only with the
#                          session. Since T40.4 a window made with `allow add
#                          --port <n> --for <T> --to <host>` opens this same
#                          tunnel on its own at session start (localhost:<n> ->
#                          <host>:<n>), and an explicit --tunnel over that local
#                          port wins over the automatic one.
#                          See docs/04-red-egress.md.
#   sandbox <repo> [-- cmd..]
#                          Boot a disposable, per-repo container from the minimal
#                          sandbox template with ONLY <repo> mounted and a
#                          per-repo, model-endpoints-only egress proxy (T6), then
#                          open a shell in it (or run `-- cmd`). One project per
#                          repo (aegis-sandbox-<hash>); discard it with
#                          `docker compose -p <project> down` (T5/T6, feature
#                          aegis-sandbox).
#   account [verb] ...     Alias of `aegis license` (see below). It no longer
#                          manages git/Azure DevOps credentials: an identity is
#                          each tool's own flow (GCM, `gh auth login`, `az
#                          login`), a vault secret reaches a session through
#                          `aegis shell --secret <name>`, and variables through
#                          `aegis shell --env auto`. See docs/11-aegis-cli.md §8.16.
#   license [--file <p>]   Verify the signed license offline and show what it
#                          entitles. `license activate <id>` claims a seat for
#                          this machine; `license renew` re-signs it under the
#                          key the service uses now (after a rotation); `license
#                          heartbeat` marks it seen; `license retire --yes`
#                          frees the seat and deletes both local files. Same
#                          command as `aegis account license`, which still works.
#   connect [network]      Attach the dev container to an existing (or newly
#                          created) INTERNAL Docker network so it can reach
#                          service containers (e.g. a database) by name.
#                          Refuses to join a network that is not
#                          internal:true. Defaults to AEGIS_SERVICES_NETWORK
#                          or "aegis-services".
#   disconnect [network]   Detach the dev container from that network.
#   stop                   `docker compose stop` — containers only, volumes
#                          and networks untouched.
#   down                   `docker compose down` (WITHOUT -v) — removes
#                          containers/networks, keeps volumes.
#   status                 `docker compose ps` + `docker stats --no-stream`
#                          for this stack's containers.
#   audit                  Run scripts/audit-container.sh against the dev
#                          container and propagate its exit code.
#   backup [--dest <dir>] [--full]
#                          Snapshot the code/engram volumes into one
#                          timestamped .tar.gz (default dest: C:/Aegis/backups)
#                          via a throwaway, network-less container. Prints
#                          the archive path, size and sha256, and writes a
#                          secret-free *.manifest.json next to it. Skips
#                          regenerable build output in code (node_modules,
#                          dist, publish, .NET bin/obj, ... — see
#                          BACKUP_PRUNE_SH); --full includes it.
#   restore <archive> [--only code|engram] [--replace] [--force]
#                          Restore a backup archive into the named volumes
#                          via a throwaway, network-less container. Refuses
#                          while the stack is running unless --force (run
#                          `aegis stop` first instead). Verifies the
#                          archive's sha256 against its manifest when one is
#                          found next to it. Default merges without
#                          overwriting existing files; --replace overwrites.
#   export <path> [--dest <dir>]
#                          Copy a file/dir from inside /workspace/code out to
#                          the host (default dest: C:/Aegis/exports, or
#                          ~/Aegis/exports when running inside WSL2 — the
#                          distro is the workspace, nothing is written to the
#                          Windows host) — the one explicit, user-driven
#                          host channel this template still allows.
#   import <host-path> <path>
#                          Copy a host file/dir INTO /workspace/code. <path> is
#                          validated the same way
#                          as `shell`/`export` (relative, no "..", no symlink
#                          escape).
#   build windows <code>/<path>/<file>.iss
#                          Compile an Inno Setup script into a Windows installer
#                          in a throwaway container (Wine + official Inno Setup,
#                          image aegis-build-windows, built locally on first
#                          use): --network none, read-only rootfs, uid 1000, no
#                          capabilities, and ONLY the project root
#                          (code/<Cliente>/<repo>)
#                          mounted via volume-subpath (Docker Engine 26+). The
#                          .exe lands in Output/ next to the .iss, inside the
#                          volume; take it out with `aegis export` (T25).
#   build clean            Remove the aegis-build-windows image(s).
#   help                   Show this text.
#
# Environment:
#   AEGIS_WORKSTATION_DIR   Folder containing .devcontainer/docker-compose.yml
#                           for this workstation. No default of its own: an
#                           explicit value always wins, otherwise the copy
#                           `aegis install` placed in AEGIS_INSTALL_DIR.
#   AEGIS_SERVICES_NETWORK  Default network name for `aegis connect`.
#   GH_TOKEN, ANTHROPIC_API_KEY, GIT_AUTHOR_*, GIT_COMMITTER_*
#                           Forwarded into the container ONLY via
#                           `docker exec -e NAME` at `shell`/`herdr` time —
#                           never written to the compose file or to disk, and
#                           not visible in `docker inspect` of the container's
#                           own static config (see docs/11-aegis-cli.md).
#   AEGIS_LICENSE_FILE      Path to the signed license token (AEGIS1.<...>.<...>).
#                           Default: $HOME/.aegis/license. See docs/11-aegis-cli.md §8.16.
#   AEGIS_LICENSE_KEYS_FILE Path to the accepted public keys, keyed by kid,
#                           as JSON. Default:
#                           <AEGIS_WORKSTATION_DIR>/config/license-keys.json
#                           (shipped as data so a key rotation never edits
#                           logic). Overridable for tests/custom key sets.
#   AEGIS_LICENSE_API_URL   Base URL of the licensing service that
#                           `aegis license activate` claims a seat
#                           from. Default: the production deployment
#                           (https://aegis-workstation-production.up.railway.app).
#   AEGIS_DEVICE_CREDENTIAL_FILE
#                           Where activation stores the device credential and
#                           its activation id (owner-only). Default:
#                           $HOME/.aegis/device.json, alongside the license
#                           and the account map. See docs/11-aegis-cli.md
#                           §8.16.
#   AEGIS_DRY_RUN           1 has the same effect as `shell`/`herdr --dry-run`.
#   AEGIS_INSTALL_DIR       Where `aegis install` puts the configuration the
#                           host executes, OUTSIDE every mount. Default:
#                           $HOME/.aegis/workstation. When it exists, `aegis up`
#                           and `aegis audit` run that copy instead of the
#                           repository's (T18).
#   AEGIS_INSTALL_SOURCE    Folder `aegis install` copies FROM. Default: fetched
#                           from AEGIS_INSTALL_URL or the registry bundle, below.
#   AEGIS_INSTALL_URL       Install source: a .tar.gz whose entries are the
#                           repo-relative paths in client-bundle.txt, so
#                           extraction yields templates/workstation/... and
#                           templates/sandbox/.... Used by `aegis install` when
#                           set, instead of the registry bundle.
#   AEGIS_INSTALL_SHA256    Expected sha256 of the AEGIS_INSTALL_URL archive.
#                           When unset, <url>.sha256 is fetched instead; either
#                           way install fails closed without a hash.
#   AEGIS_BUNDLE_REPO       Registry repository of the BUNDLE image, the
#                           DEFAULT install source when neither --from/
#                           AEGIS_INSTALL_SOURCE nor AEGIS_INSTALL_URL is set.
#                           The image's filesystem carries the bundle tarball at
#                           /bundle.tar.gz. Default: ${AEGIS_IMAGE_REPO}-bundle.
#   AEGIS_BUNDLE_TAG        Tag of that bundle image. Default: latest.
#   AEGIS_SANDBOX_DIR       Folder containing the sandbox .devcontainer/.
#                           Priority, like AEGIS_WORKSTATION_DIR: this explicit
#                           value > an installed copy (AEGIS_SANDBOX_INSTALL_DIR).
#   AEGIS_SANDBOX_INSTALL_DIR
#                           Where `aegis install` puts the sandbox configuration
#                           (T10), OUTSIDE every mount like AEGIS_INSTALL_DIR.
#                           Default: $HOME/.aegis/sandbox-install. NOT
#                           $HOME/.aegis/sandbox: that path holds the per-repo
#                           state (allowlists, allowed-envs, T6/T8) and install
#                           replaces its destination, so sharing it would move
#                           the owner's state into a `.bak` on every install.
#   AEGIS_INSTALL_SANDBOX_SOURCE
#                           Folder `aegis install` copies the sandbox FROM.
#                           Default: next to the fetched bundle's workstation
#                           folder.
#   AEGIS_BUILD_WINDOWS_DIR Folder holding the build-windows Dockerfile (T25).
#                           Priority: this explicit value > an installed copy
#                           (AEGIS_BUILD_WINDOWS_INSTALL_DIR).
#   AEGIS_BUILD_WINDOWS_INSTALL_DIR
#                           Where `aegis install` puts it, OUTSIDE every mount.
#                           Default: $HOME/.aegis/build-windows-install.
#   AEGIS_INSTALL_BUILD_WINDOWS_SOURCE
#                           Folder `aegis install` copies it FROM. Default:
#                           next to the fetched bundle's workstation folder.
#   AEGIS_SANDBOX_RUNTIME   OCI runtime for the sandbox container. Default: runc.
#                           `aegis sandbox --gvisor` sets it to runsc, but only
#                           after a fail-closed preflight proves this daemon has
#                           `runsc` registered (T7); there is no silent fallback
#                           to runc when it is missing.
#   AEGIS_SANDBOX_ALLOWLIST_DIR
#                           Base folder for the per-repo generated egress
#                           allowlists (T6): <base>/<repo-hash>/allowlist.txt.
#                           Default: $HOME/.aegis/sandbox.
#   AEGIS_SANDBOX_ALLOWED_ENVS_FILE
#                           T8 credential-name allowlist for `aegis sandbox
#                           --env/--secret` (one name per line, '#' comments).
#                           Default: $HOME/.aegis/sandbox/allowed-envs. EMPTY by
#                           default: the sandbox receives no credential until a
#                           name is listed here.
#   AEGIS_SANDBOX_ALLOWED_ENVS
#                           Inline override of the allowlist above (comma/space
#                           separated), for tests and one-offs.
#   AEGIS_PROGRESS          always | never | auto (default). Live progress bars
#                           and spinners (stderr) only when stderr is a
#                           terminal; steps and results always print.
#   AEGIS_ASCII             Set to 1 to draw bars with = and - instead of
#                           block characters (also automatic on a non-UTF-8
#                           locale).
#   AEGIS_BACKUP_DIR        Default destination for `aegis backup`. Default:
#                           C:/Aegis/backups (created if missing).
#   AEGIS_EXPORT_DIR        Default destination for `aegis export`. Default:
#                           C:/Aegis/exports (~/Aegis/exports inside WSL2; created if missing).
#   AEGIS_PROFILE_STORE_PATH
#                           T38: container-side path where `aegis profile use`
#                           stores the chosen OpenCode provider profile — the
#                           code data volume, which survives a home/
#                           opencode-config recreation and rides `aegis
#                           backup` (docs/10-workstation.md section 12).
#                           Default: /workspace/code/.aegis/profile.json.
#                           Tests point it at a scratch path.
#   AEGIS_PROFILES_DIR      Container folder a bare profile NAME resolves
#                           against (`<name>.json`). Default:
#                           /usr/local/share/aegis/profiles.
#   AEGIS_APPLY_PROFILE_SCRIPT
#                           The apply-profile.sh entrypoint `aegis profile use`
#                           runs after storing (configure-workstation.sh reads
#                           the same variable for its auto-apply step).
#                           Default: /usr/local/share/aegis/apply-profile.sh.
#   AEGIS_OPENCODE_JSON     The live opencode.json the CLI checks for
#                           applied-vs-pending. Default:
#                           /home/dev/.config/opencode/opencode.json.

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

# --- T18: which configuration the host executes ------------------------------
# The host runs the compose file and the scripts below, so those files are
# exactly what an agent inside the workstation would want to rewrite: edit the
# compose and the host runs your code on its next `aegis up`. T18 moves them OUT
# of everything the container can see — `aegis install` copies the template tree
# into AEGIS_INSTALL_DIR, which is not mounted anywhere (not even read-only) —
# and from then on the launcher prefers that copy over the repository.
AEGIS_INSTALL_DIR="${AEGIS_INSTALL_DIR:-$HOME/.aegis/workstation}"
# OD1.2: the client install source, used only when no --from is given. Kept as
# data (empty by default) so a build without a published channel refuses
# instead of guessing, and tests can point it at a local file:// bundle.
AEGIS_INSTALL_URL="${AEGIS_INSTALL_URL:-}"
AEGIS_INSTALL_SHA256="${AEGIS_INSTALL_SHA256:-}"

# Priority: an explicit AEGIS_WORKSTATION_DIR always wins (tests, a deliberate
# override); otherwise the installed copy if there is one; otherwise report
# the destination `aegis install` will use, never a path nothing on this
# machine has.
if [[ -n "${AEGIS_WORKSTATION_DIR:-}" ]]; then
    AEGIS_CONFIG_SOURCE="explicit (AEGIS_WORKSTATION_DIR)"
elif [[ -f "${AEGIS_INSTALL_DIR%/}/.devcontainer/docker-compose.yml" ]]; then
    AEGIS_WORKSTATION_DIR="${AEGIS_INSTALL_DIR%/}"
    AEGIS_CONFIG_SOURCE="installed"
else
    AEGIS_WORKSTATION_DIR="${AEGIS_INSTALL_DIR%/}"
    AEGIS_CONFIG_SOURCE="not installed"
fi

COMPOSE_FILE="${AEGIS_WORKSTATION_DIR%/}/.devcontainer/docker-compose.yml"
AUDIT_SCRIPT="${AEGIS_WORKSTATION_DIR%/}/scripts/audit-container.sh"

DEV_SERVICE="dev"
DEV_CONTAINER="aegis-workstation-dev"
PROXY_CONTAINER="aegis-workstation-egress-proxy"
# T8 (D2): the container the session-injection helpers talk to. The workstation
# leaves it at DEV_CONTAINER; `aegis sandbox` points it at the per-repo sandbox
# container so the SAME vault -> session-tmpfs -> wrapper flow serves both,
# without the workstation's behaviour changing (nothing else assigns it). It is
# deliberately NOT exported: the process that sets it is the process that uses
# it, and an inherited environment value must not be able to retarget a shell.
AEGIS_SESSION_CONTAINER="${DEV_CONTAINER}"
FIRST_RUN_MARKER="/home/dev/.aegis-first-run-done"
# -v2 (2026-10-18): 0.27.3 ships the template scripts executable, so the
# AGENTS.md merge actually runs on Linux; clients that configured under 0.27.2
# carry the -v1 marker and would never get the merge. One idempotent re-run.
CONFIGURED_MARKER="/home/dev/.aegis-configured-v2"
DEFAULT_SERVICES_NETWORK="${AEGIS_SERVICES_NETWORK:-aegis-services}"

# --- Aegis Sandbox (feature aegis-sandbox, T1): a second, disposable stack ---
# `aegis sandbox <repo>` boots a per-repo, throwaway container from the minimal
# sandbox template (templates/sandbox) with ONLY that repo mounted and a
# per-repo, model-endpoints-only egress proxy (T6) gated by an allowlist drawn
# from templates/sandbox/config/allowlist.txt. It deliberately does NOT reuse
# COMPOSE_FILE/DEV_CONTAINER
# above: those are bound to the workstation stack and sharing them would let one
# command tear down the other. Same priority as the workstation (an explicit
# AEGIS_SANDBOX_DIR wins, then the installed copy).
#
# T10: the installed copy is what the host RUNS, so it must live outside every
# mount — the sandbox repo itself is mounted READ-WRITE and is untrusted, so a
# compose it could edit must never be the one the host executes (the T18 escape,
# one template over). It is deliberately NOT $HOME/.aegis/sandbox: that path is
# the per-repo STATE root (AEGIS_SANDBOX_ALLOWLIST_DIR, T6; the allowed-envs
# file, T8), and `aegis install` replaces its destination with a backup, so
# sharing it would move the owner's state aside on every install/update.
AEGIS_SANDBOX_INSTALL_DIR="${AEGIS_SANDBOX_INSTALL_DIR:-$HOME/.aegis/sandbox-install}"

if [[ -n "${AEGIS_SANDBOX_DIR:-}" ]]; then
    AEGIS_SANDBOX_SOURCE="explicit (AEGIS_SANDBOX_DIR)"
elif [[ -f "${AEGIS_SANDBOX_INSTALL_DIR%/}/.devcontainer/docker-compose.yml" ]]; then
    AEGIS_SANDBOX_DIR="${AEGIS_SANDBOX_INSTALL_DIR%/}"
    AEGIS_SANDBOX_SOURCE="installed"
else
    AEGIS_SANDBOX_DIR="${AEGIS_SANDBOX_INSTALL_DIR%/}"
    AEGIS_SANDBOX_SOURCE="not installed"
fi

SANDBOX_COMPOSE_FILE="${AEGIS_SANDBOX_DIR%/}/.devcontainer/docker-compose.yml"
SANDBOX_SERVICE="dev"

# --- T25: `aegis build windows` (Inno Setup under Wine, a throwaway container) ---
# The host BUILDS this image (`docker build` of templates/build-windows), so its
# Dockerfile is configuration the host executes: same priority and the same
# T18/T10 reasoning as the sandbox template — an explicit AEGIS_BUILD_WINDOWS_DIR
# wins, then the copy `aegis install` puts OUTSIDE every mount.
AEGIS_BUILD_WINDOWS_INSTALL_DIR="${AEGIS_BUILD_WINDOWS_INSTALL_DIR:-$HOME/.aegis/build-windows-install}"

if [[ -n "${AEGIS_BUILD_WINDOWS_DIR:-}" ]]; then
    AEGIS_BUILD_WINDOWS_SOURCE="explicit (AEGIS_BUILD_WINDOWS_DIR)"
elif [[ -f "${AEGIS_BUILD_WINDOWS_INSTALL_DIR%/}/Dockerfile" ]]; then
    AEGIS_BUILD_WINDOWS_DIR="${AEGIS_BUILD_WINDOWS_INSTALL_DIR%/}"
    AEGIS_BUILD_WINDOWS_SOURCE="installed"
else
    AEGIS_BUILD_WINDOWS_DIR="${AEGIS_BUILD_WINDOWS_INSTALL_DIR%/}"
    AEGIS_BUILD_WINDOWS_SOURCE="not installed"
fi

BUILD_WINDOWS_IMAGE_REPO="aegis-build-windows"
# --mount ...,volume-subpath= exists from Docker Engine 26 (API 1.45) on.
BUILD_WINDOWS_MIN_ENGINE=26

# --- T20: backup/restore/export/import ------------------------------------
# See docker-compose.yml's single "code-data" volume and
# docs/10-workstation.md, section 4/17, docs/11-aegis-cli.md for the full
# design. Named volumes this stack owns; NEVER touched: the home/config
# volumes below hold real Claude/OpenCode sessions and gentle-ai config and
# must never be included in a backup or exposed to a throwaway container.
# single-code-volume (2026-11-04): the memories volume is gone; the single
# code volume mounts at /workspace and keeps the repos under code/ inside it.
VOL_CODE="aegis-workstation-code"
VOL_ENGRAM="aegis-workstation-engram-data"

# T1 (luks-integration): the code volume's docker `-v` SOURCE. The compose
# file already honours AEGIS_CODE_DIR with its own shape rule (compose:214):
# a plain name resolves to the declared volume, a path (contains "/") becomes
# a host bind mount. Every launcher command that touches the code volume must
# follow the SAME rule, or the container reads from one place while
# import/export/backup write to another (a silent split-brain — and with the
# LUKS vault, the bind can live inside the mount while the named volume stays
# in the daemon's data-root, unencrypted).
code_volume_src() {
    local dir="${AEGIS_CODE_DIR:-}"
    case "$dir" in
        "") printf '%s' "$VOL_CODE" ;;
        */*) printf '%s' "$dir" ;;
        *) printf '%s' "$VOL_CODE" ;;
    esac
}

# T3 (luks-integration): with the code volume living on a host bind
# (AEGIS_CODE_DIR path-shaped), the bind source is INSIDE the LUKS mount. If
# the vault is sealed that directory does not exist, and Docker would happily
# CREATE it on the underlying filesystem — writing the user's work
# unencrypted, silently, exactly the failure the vault exists to prevent. So:
# refuse before compose, and point at the runbook's own helper.
require_vault_if_code_dir_is_a_bind() {
    local dir="${AEGIS_CODE_DIR:-}"
    case "$dir" in
        */*) ;;                 # path-shaped: a bind
        *) return 0 ;;          # plain name: the named volume, no vault involved
    esac
    local mnt="${AEGIS_VOLUME_MNT:-/mnt/aegis_secure}"
    case "${dir%/}/" in
        "${mnt%/}"/*) ;;         # the bind lives under the vault mountpoint
        *) return 0 ;;           # some other host folder: not ours to police
    esac
    if mountpoint -q "$mnt" 2>/dev/null; then
        mkdir -p "$dir" 2>/dev/null || true
        return 0
    fi
    err "the Aegis secure volume is sealed — '${mnt}' is not mounted."
    err "Your code lives at ${dir}, inside the vault, so starting now would write it unencrypted."
    err "open it first:  sh ~/mount-aegis.sh"
    return 1
}

# T2 (luks-integration): one root for every sensitive volume. When
# AEGIS_DATA_ROOT points inside the mounted vault, each volume becomes a host
# bind under it (compose already accepts the per-volume overrides) and the
# caches stay named volumes — they are regenerable, not data.
# Reads one key from the launcher state (.devcontainer/.env). The state is what
# makes the encrypted choice survive a new terminal: the environment variable is
# a convenience, not the source of truth.
state_get() {
    local key="$1" file="${AEGIS_WORKSTATION_DIR%/}/.devcontainer/.env"
    [[ -f "$file" ]] || return 0
    sed -n "s/^${key}=//p" "$file" 2>/dev/null | head -n1
}

derive_data_root() {
    local root="${AEGIS_DATA_ROOT:-}"
    # T9: an explicit AEGIS_ENCRYPTED=0 turns the mode OFF; otherwise a root
    # recorded by a previous run keeps it ON without re-exporting anything.
    if [[ "${AEGIS_ENCRYPTED:-}" == "0" ]]; then
        return 0
    fi
    [[ -n "$root" ]] || root="$(state_get AEGIS_DATA_ROOT)"
    # T11: the installer wizard records the choice before the workstation (and
    # its .env) exists. That file is what makes "install the CLI, then the WS"
    # land on encrypted persistence instead of the named volumes.
    if [[ -z "$root" ]]; then
        local _mode="${XDG_STATE_HOME:-$HOME/.local/state}/aegis/mode"
        if [[ -f "$_mode" ]] && grep -qx 'AEGIS_ENCRYPTED=1' "$_mode" 2>/dev/null; then
            root="$(sed -n 's/^AEGIS_DATA_ROOT=//p' "$_mode" | head -n1)"
            # No log here: derive_data_root runs for EVERY command and a stray
            # line would pollute version/status output. `up` reports it.
            [[ -n "$root" ]] && _AEGIS_ADOPTED_MODE=1
        fi
    fi
    [[ -n "$root" ]] || return 0
    case "$root" in
        /*) ;;
        *) err "AEGIS_DATA_ROOT must be an absolute path (got: $root)"; return 1 ;;
    esac
    root="${root%/}"
    # The resolved root becomes the effective one, so the writer records it even
    # when it came from the state and not from this shell.
    export AEGIS_DATA_ROOT="$root"
    : "${AEGIS_CODE_DIR:=${root}/workspace}"
    : "${AEGIS_HOME_DIR:=${root}/home}"
    : "${AEGIS_CLAUDE_DIR:=${root}/claude}"
    : "${AEGIS_OPENCODE_DIR:=${root}/opencode}"
    : "${AEGIS_GENTLE_AI_DIR:=${root}/gentle-ai}"
    : "${AEGIS_ENGRAM_DIR:=${root}/engram}"
    : "${AEGIS_HERDR_DIR:=${root}/herdr}"
    export AEGIS_CODE_DIR AEGIS_HOME_DIR AEGIS_CLAUDE_DIR AEGIS_OPENCODE_DIR \
        AEGIS_GENTLE_AI_DIR AEGIS_ENGRAM_DIR AEGIS_HERDR_DIR
}

# T5c (luks-integration): the sensitive state beyond code/engram. `home` is the
# /home/dev volume and CONTAINS the four specific ones, so it is always
# archived with explicit exclusions — otherwise the archive duplicates them and
# a restore would overwrite itself.
_vol_or_dir() {
    local dir="${1:-}"
    case "$dir" in
        */*) printf '%s' "$dir" ;;
        *) printf '%s' "$2" ;;
    esac
}

# True when the user opted into the encrypted layout (any per-volume dir set).
agent_state_mode() {
    [[ -n "${AEGIS_DATA_ROOT:-}${AEGIS_HOME_DIR:-}${AEGIS_CLAUDE_DIR:-}${AEGIS_OPENCODE_DIR:-}${AEGIS_GENTLE_AI_DIR:-}${AEGIS_HERDR_DIR:-}" ]]
}

# id -> docker source for the agent-state volumes.
agent_state_source() {
    case "$1" in
        home)      _vol_or_dir "${AEGIS_HOME_DIR:-}" aegis-workstation-home ;;
        claude)    _vol_or_dir "${AEGIS_CLAUDE_DIR:-}" aegis-workstation-claude-config ;;
        opencode)  _vol_or_dir "${AEGIS_OPENCODE_DIR:-}" aegis-workstation-opencode-config ;;
        gentle-ai) _vol_or_dir "${AEGIS_GENTLE_AI_DIR:-}" aegis-workstation-gentle-ai-state ;;
        herdr)     _vol_or_dir "${AEGIS_HERDR_DIR:-}" aegis-workstation-herdr-state ;;
        *) return 1 ;;
    esac
}

# One "id<TAB>source" line per agent-state volume.
agent_state_rows() {
    printf 'home\t%s\n'      "$(_vol_or_dir "${AEGIS_HOME_DIR:-}" aegis-workstation-home)"
    printf 'claude\t%s\n'     "$(_vol_or_dir "${AEGIS_CLAUDE_DIR:-}" aegis-workstation-claude-config)"
    printf 'opencode\t%s\n'   "$(_vol_or_dir "${AEGIS_OPENCODE_DIR:-}" aegis-workstation-opencode-config)"
    printf 'gentle-ai\t%s\n'  "$(_vol_or_dir "${AEGIS_GENTLE_AI_DIR:-}" aegis-workstation-gentle-ai-state)"
    printf 'herdr\t%s\n'      "$(_vol_or_dir "${AEGIS_HERDR_DIR:-}" aegis-workstation-herdr-state)"
}

# The engram volume follows the same shape rule as the code volume (T1).
engram_volume_src() {
    local dir="${AEGIS_ENGRAM_DIR:-}"
    case "$dir" in
        */*) printf '%s' "$dir" ;;
        *) printf '%s' "$VOL_ENGRAM" ;;
    esac
}

# T8 (luks-integration L9): compose asks for 20 CPUs and 24 GB by default. On
# a daemon that offers less (Docker Desktop on a laptop, a small WSL2 VM) the
# stack fails or comes up half-configured — and the user has no idea
# AEGIS_DEV_CPUS exists. Clamp the DEFAULTS to what the daemon actually offers;
# an explicit override is still honoured, clamped with a notice instead of a
# silent failure.
resolve_resource_limits() {
    local want_cpus="${AEGIS_DEV_CPUS:-20}" want_mem="${AEGIS_DEV_MEMORY:-24g}"
    local info ncpu memtotal
    info="$(docker info --format '{{.NCPU}} {{.MemTotal}}' 2>/dev/null)" || return 0
    read -r ncpu memtotal <<<"${info:-}"
    case "${ncpu:-}" in ''|*[!0-9]*) return 0 ;; esac
    case "${memtotal:-}" in ''|*[!0-9]*) return 0 ;; esac

    local mem_gb=$(( memtotal / 1073741824 ))
    local eff_cpus="$want_cpus" eff_mem_gb="${want_mem%[gG]}"
    case "$eff_mem_gb" in ''|*[!0-9]*) eff_mem_gb=24 ;; esac

    if (( want_cpus > ncpu )); then
        eff_cpus="$ncpu"
        log "resources: the daemon offers ${ncpu} CPU(s) — using ${eff_cpus} (requested ${want_cpus})."
    fi
    # Leave the daemon one gigabyte of headroom; never ask for zero.
    local max_mem=$(( mem_gb > 2 ? mem_gb - 1 : mem_gb ))
    (( max_mem < 1 )) && max_mem=1
    if (( eff_mem_gb > max_mem )); then
        log "resources: the daemon offers ${mem_gb}G — using ${max_mem}g (requested ${want_mem})."
        eff_mem_gb="$max_mem"
    fi
    export AEGIS_DEV_CPUS="$eff_cpus" AEGIS_DEV_MEMORY="${eff_mem_gb}g"
}

# resolve_data_path returns the logical volume IDENTITY (VOL_CODE for code),
# which promote/verify compare against. The docker `-v` flag needs the SOURCE,
# so every mount goes through this mapper.
data_mount_src() {
    case "$1" in
        "$VOL_CODE") code_volume_src ;;
        *) printf '%s' "$1" ;;
    esac
}

# Pinned by digest (same pattern as every other image reference in this
# repo — see .devcontainer/docker-compose.yml's egress-proxy image).
# Verified in this session: `docker pull alpine:3.20` resolved to this
# digest. Small, network-less, carries busybox tar (-k/--overwrite) and
# sha256sum — everything backup/restore/export/import need, nothing more.
BACKUP_IMAGE="alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc"

# `aegis backup` skips regenerable build output inside the code volume, for
# every stack in environments.publish.json (node, dotnet, java, go, python,
# cpp). Runs INSIDE the backup container (busybox sh/find); kept as one string
# so the count step and the archive step apply the exact same list. Prints one
# directory per line, relative to <root> (e.g. code/web/node_modules).
# Only whole DIRECTORIES are listed, never files. Unambiguous names are
# skipped anywhere; names that are often SOURCE elsewhere (bin, obj, target,
# build, venv) only next to the project file that produces them. public/ and
# Go vendor/ are never skipped (both are usually committed source).
# `aegis backup --full` bypasses this list.
# shellcheck disable=SC2016
BACKUP_PRUNE_SH='
aegis_bk_has() {
    for f in "$@"; do
        if [ -e "$f" ]; then return 0; fi
    done
    return 1
}
aegis_bk_prune_list() {
    find "$1/code" -type d \( -name node_modules -o -name dist -o -name publish \
        -o -name .next -o -name .nuxt -o -name .output -o -name .svelte-kit \
        -o -name .angular -o -name .turbo -o -name .parcel-cache \
        -o -name __pycache__ -o -name .pytest_cache -o -name .mypy_cache \
        -o -name .ruff_cache -o -name .tox -o -name .venv -o -name "*.egg-info" \
        -o -name .gradle -o -name "cmake-build-*" \
        -o -name bin -o -name obj -o -name target -o -name build -o -name venv \) \
        -prune -print 2>/dev/null |
    while IFS= read -r d; do
        p="${d%/*}"
        case "${d##*/}" in
            bin|obj) aegis_bk_has "$p"/*.csproj "$p"/*.fsproj "$p"/*.vbproj "$p"/*.sln || continue ;;
            target) aegis_bk_has "$p/pom.xml" || continue ;;
            build) aegis_bk_has "$p/build.gradle" "$p/build.gradle.kts" "$p/CMakeLists.txt" || continue ;;
            venv) aegis_bk_has "$d/pyvenv.cfg" || continue ;;
        esac
        printf "%s\n" "${d#"$1"/}"
    done
}
'

# `aegis restore`, run INSIDE the throwaway container (busybox sh/tar/find).
# Inputs come from env vars, never from interpolation (a file name is user
# input): AEGIS_RESTORE_ROOT (where the volumes are mounted), _ARCHIVE,
# _TARGETS (archive members) and _MODE (merge | replace).
# The extracting tar runs with -v: stdout is the per-file progress stream the
# launcher counts; messages go to stderr.
# merge must keep every existing file and still restore everything else.
# BusyBox tar -k cannot: it opens each file with O_EXCL and DIES on the first
# one that exists (archival/libarchive/data_extract_all.c), and cp -n refuses
# to descend into a directory that exists. So merge extracts into a staging
# dir, lists what is missing at the destination (sh builtins only, one pass;
# a missing directory is listed once and copied whole; anything whose
# destination is a symlink is kept, never written through), and copies that
# list with tar -T. Every error is a real error: a member missing from the
# archive, a full disk, a bad gzip.
# shellcheck disable=SC2016
RESTORE_SH='
set -eu
if (set -o pipefail) 2>/dev/null; then set -o pipefail; fi
root="$AEGIS_RESTORE_ROOT"
if [ "$AEGIS_RESTORE_MODE" = replace ]; then
    # shellcheck disable=SC2086
    exec tar xzvf "$AEGIS_RESTORE_ARCHIVE" -C "$root" --overwrite $AEGIS_RESTORE_TARGETS
fi
stage="$root/.aegis-restore-stage"
cleanup() { rm -rf "$stage"; }
trap cleanup EXIT
rm -rf "$stage"
mkdir "$stage"
# shellcheck disable=SC2086
tar xzvf "$AEGIS_RESTORE_ARCHIVE" -C "$stage" $AEGIS_RESTORE_TARGETS
cd "$stage"
skip=""
# shellcheck disable=SC2086
find $AEGIS_RESTORE_TARGETS | while IFS= read -r p; do
    if [ -n "$skip" ]; then
        case "$p" in "$skip"/*) continue ;; esac
    fi
    d="$root/$p"
    if [ -e "$d" ] || [ -L "$d" ]; then
        if [ -d "$p" ] && [ ! -L "$p" ] && [ -d "$d" ] && [ ! -L "$d" ]; then
            continue
        fi
        printf "%s\n" "$p" >&3
        skip="$p"
        continue
    fi
    printf "%s\n" "$p"
    skip="$p"
done > "$stage/.new" 3> "$stage/.kept"
if [ -s "$stage/.new" ]; then
    tar cf - -T "$stage/.new" | tar xf - -C "$root"
fi
echo "aegis-restore: $(wc -l < "$stage/.new" | tr -d " ") restored, $(wc -l < "$stage/.kept" | tr -d " ") kept (already present, not overwritten)" >&2
'

# Default host-channel destinations. A C:/Aegis/... default assumes a Windows
# host with Docker Desktop sharing C:. This template's contract is the opposite
# (T9 containment): everything lives INSIDE the WSL2 Ubuntu distro, and the
# daemon is a Linux docker that mis-parses "C:/..." mounts ("invalid mode").
# So: on WSL2 the default is a distro path; elsewhere (Docker Desktop, native
# Linux) the historic Windows default stays for compatibility.
_aegis_in_wsl() {
    [[ "$(uname -s)" == "Linux" ]] && grep -qi microsoft /proc/version 2>/dev/null
}
if _aegis_in_wsl; then
    DEFAULT_BACKUP_DIR="${AEGIS_BACKUP_DIR:-$HOME/Aegis/backups}"
    DEFAULT_EXPORT_DIR="${AEGIS_EXPORT_DIR:-$HOME/Aegis/exports}"
else
    DEFAULT_BACKUP_DIR="${AEGIS_BACKUP_DIR:-C:/Aegis/backups}"
    DEFAULT_EXPORT_DIR="${AEGIS_EXPORT_DIR:-C:/Aegis/exports}"
fi

SECRET_ENV_ARGS=(-e GH_TOKEN -e ANTHROPIC_API_KEY -e GIT_AUTHOR_NAME
    -e GIT_AUTHOR_EMAIL -e GIT_COMMITTER_NAME -e GIT_COMMITTER_EMAIL)

