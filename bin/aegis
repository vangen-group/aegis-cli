# The two messages every command speaks through. Defined this early because the
# image-tag default below already has something to say.
# Both first end a live progress line (see the renderer below), so a message
# never lands glued to a half-drawn bar.
log() { [[ "${_PG_LIVE_LINE:-0}" -eq 0 ]] || _pg_clear_line; echo "aegis: $*"; }
err() { [[ "${_PG_LIVE_LINE:-0}" -eq 0 ]] || _pg_clear_line; echo "aegis: $*" >&2; }

# --- progress renderer (begin) -----------------------------------------------
# Feature real-progress-bars (odd/tasks/real-progress-bars.md). Steps print to
# stdout like log(): "N/M <name>" and "✓ Step N complete". The LIVE parts (bar
# redraws, spinner) go to stderr, and only on a terminal, so pipes, CI and
# $(...) captures never see control characters. Every number shown comes from
# a measured counter: no total means no percentage, never a guess.
# AEGIS_PROGRESS=always|never|auto (default auto: stderr is a tty and TERM is
# not dumb). AEGIS_ASCII=1, or a non-UTF-8 locale, draws with = and -.
_PG_STEP=0
_PG_T0=0
_PG_LAST_MS=0
_PG_LIVE_LINE=0
_PG_SPIN_PID=""
_PG_BAR_TOTAL=0
_PG_BAR_CUR=0
_PG_BAR_UNIT=""

_pg_live() {
    case "${AEGIS_PROGRESS:-auto}" in
        always) return 0 ;;
        never) return 1 ;;
    esac
    [[ "${TERM:-}" != "dumb" && -t 2 ]]
}

_pg_unicode() {
    [[ -z "${AEGIS_ASCII:-}" ]] || return 1
    local loc="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
    [[ -z "$loc" || "$loc" == *[Uu][Tt][Ff]-8* || "$loc" == *[Uu][Tt][Ff]8* ]]
}

# Milliseconds since the epoch (bash 5 EPOCHREALTIME; whole seconds otherwise).
_pg_now_ms() {
    if [[ -n "${EPOCHREALTIME:-}" ]]; then
        local t="${EPOCHREALTIME/[.,]/}"
        printf '%s' "$(( 10#${t:0:${#t}-3} ))"
    else
        printf '%s' "$(( $(date +%s) * 1000 ))"
    fi
}

_format_bytes() {
    awk -v b="$1" 'BEGIN {
        if (b < 1024) { printf "%d B", b; exit }
        split("KB MB GB TB", u, " "); i = 0
        while (b >= 1024 && i < 4) { b /= 1024; i++ }
        printf "%.1f %s", b, u[i]
    }'
}

_format_eta() {
    local seconds=$1
    if (( seconds < 60 )); then
        printf '%ds' "$seconds"
    elif (( seconds < 3600 )); then
        printf '%dm %ds' "$((seconds / 60))" "$((seconds % 60))"
    else
        printf '%dh %dm' "$((seconds / 3600))" "$(( (seconds % 3600) / 60 ))"
    fi
}

# pg_bar_string <percent 0-100> -> "[████░░…] NN%"
pg_bar_string() {
    local pct=$1 width=20 full="█" rest="░" bar="" i filled
    _pg_unicode || { full="="; rest="-"; }
    (( pct < 0 )) && pct=0
    (( pct > 100 )) && pct=100
    filled=$(( pct * width / 100 ))
    for (( i = 0; i < filled; i++ )); do bar+="$full"; done
    for (( i = filled; i < width; i++ )); do bar+="$rest"; done
    printf '[%s] %3d%%' "$bar" "$pct"
}

# _pg_fit <text>: the text cut to the terminal width minus one column, marked
# with "…". A live line wider than the terminal wraps, and the \r redraw then
# stacks lines instead of replacing one.
_pg_fit() {
    local text="$1" cols="${COLUMNS:-}"
    [[ "$cols" =~ ^[0-9]+$ && "$cols" -gt 0 ]] || cols="$(tput cols 2>/dev/null || echo 80)"
    [[ "$cols" =~ ^[0-9]+$ && "$cols" -gt 10 ]] || cols=80
    if (( ${#text} > cols - 1 )); then
        text="${text:0:cols-2}…"
    fi
    printf '%s' "$text"
}

_pg_clear_line() {
    if [[ "$_PG_LIVE_LINE" -eq 1 ]]; then
        printf '\r\033[K' >&2
        _PG_LIVE_LINE=0
    fi
}

# pg_step <n> <of> <name>
pg_step() {
    _pg_clear_line
    _PG_STEP=$1
    _PG_T0="$(_pg_now_ms)"
    _PG_LAST_MS=0
    _PG_BAR_TOTAL=0
    _PG_BAR_UNIT=""
    printf '\n%d/%d %s\n' "$1" "$2" "$3"
}

# pg_progress <current> <total|0> <files|bytes|...> [force]
# Redraws at most every 150 ms unless force is set.
pg_progress() {
    _pg_live || return 0
    local cur=$1 total=$2 unit=$3 force="${4:-}" now elapsed_ms line rate eta
    _PG_BAR_TOTAL=$total
    _PG_BAR_CUR=$cur
    _PG_BAR_UNIT=$unit
    now="$(_pg_now_ms)"
    (( _PG_T0 > 0 )) || _PG_T0=$now
    if [[ -z "$force" ]] && (( now - _PG_LAST_MS < 150 )) && (( total == 0 || cur < total )); then
        return 0
    fi
    _PG_LAST_MS=$now
    elapsed_ms=$(( now - _PG_T0 ))
    if [[ "$unit" == "bytes" ]]; then
        if (( total > 0 )); then
            line="$(pg_bar_string $(( cur * 100 / total ))) | $(_format_bytes "$cur")/$(_format_bytes "$total")"
        else
            line="$(_format_bytes "$cur")"
        fi
    elif (( total > 0 )); then
        line="$(pg_bar_string $(( cur * 100 / total ))) | ${cur}/${total} ${unit}"
    else
        line="${cur} ${unit}"
    fi
    rate=0
    (( elapsed_ms >= 1000 && cur > 0 )) && rate=$(( cur * 1000 / elapsed_ms ))
    if (( rate > 0 )); then
        if [[ "$unit" == "bytes" ]]; then
            line+=" | $(_format_bytes "$rate")/s"
        else
            line+=" | ${rate} ${unit}/s"
        fi
        if (( total > cur && rate > 0 )); then
            eta=$(( (total - cur) / rate ))
            line+=" | ~$(_format_eta "$eta")"
        fi
    fi
    printf '\r\033[K%s' "$(_pg_fit "    $line")" >&2
    _PG_LIVE_LINE=1
}

# pg_done <n>: when the step drew a bar with a known total, redraw it with
# the last MEASURED count (live only) and keep it on screen; then print the
# ✓ line. It never rounds a short or long count up to an invented N/N.
pg_done() {
    if (( _PG_BAR_TOTAL > 0 )) && _pg_live; then
        pg_progress "$_PG_BAR_CUR" "$_PG_BAR_TOTAL" "$_PG_BAR_UNIT" force
        printf '\n' >&2
        _PG_LIVE_LINE=0
    fi
    _PG_BAR_TOTAL=0
    _pg_clear_line
    printf '    ✓ Step %d complete\n' "$1"
}

pg_fail() {
    _pg_clear_line
    err "✗ Step $1 failed: $2"
}

# pg_run_counted <total|0> <unit> -- <command...>
# Runs the command; each line it prints on stdout is one unit of progress
# (with unit "files", lines ending in "/" are directories and do not count —
# the shape of a tar -v stream). A line "@@aegis-total N" sets the total (a
# container that measures its own input announces it first) and is not
# counted. stderr is left alone (errors stay visible).
# Returns the command's exact status (callers tell failures apart by it, e.g.
# exit 3 = "destination exists"); the process substitution turns errexit off
# so a failing command still records its status.
pg_run_counted() {
    local total=$1 unit=$2
    shift 3
    if ! _pg_live; then
        "$@" >/dev/null
        return
    fi
    local n=0 line rc=0
    {
        while IFS= read -r line; do
            if [[ "$line" == "@@aegis-total "* ]]; then
                total="${line#@@aegis-total }"
                [[ "$total" =~ ^[0-9]+$ ]] || total=0
                continue
            fi
            [[ "$unit" == "files" && "$line" == */ ]] && continue
            n=$(( n + 1 ))
            pg_progress "$n" "$total" "$unit"
        done
        pg_progress "$n" "$total" "$unit" force
    } < <(set +e; "$@"; echo "$?" > "${TMPDIR:-/tmp}/.aegis-pg-rc.$$")
    rc="$(cat "${TMPDIR:-/tmp}/.aegis-pg-rc.$$" 2>/dev/null || echo 1)"
    rm -f "${TMPDIR:-/tmp}/.aegis-pg-rc.$$"
    # The bar stays on its line; pg_done redraws it full and ends the line.
    return "$rc"
}

# pg_download <url> <out>: curl with a byte bar. The total is the server's
# Content-Length (HEAD with redirects followed; the last response wins);
# without one the bar shows the bytes received only. Returns curl's status.
pg_download() {
    local url=$1 out=$2
    if ! _pg_live; then
        curl -fsSL --output "$out" "$url"
        return
    fi
    local total size=0 pid rc=0
    total="$(curl -fsSIL "$url" 2>/dev/null | tr -d '\r' \
        | awk 'tolower($1) == "content-length:" { n = $2 } END { print n + 0 }' || true)"
    [[ "$total" =~ ^[0-9]+$ ]] || total=0
    # The rate and ETA are measured from the start of THIS download, not of
    # the step (a step can do other work first, or download twice).
    _PG_T0="$(_pg_now_ms)"
    _PG_LAST_MS=0
    curl -fsSL --output "$out" "$url" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        [[ -f "$out" ]] && size="$(wc -c < "$out" | tr -d '[:space:]')"
        pg_progress "${size:-0}" "${total:-0}" bytes
        sleep 0.2
    done
    wait "$pid" || rc=$?
    [[ -f "$out" ]] && size="$(wc -c < "$out" | tr -d '[:space:]')"
    (( rc == 0 )) && pg_progress "${size:-0}" "${total:-0}" bytes force
    return "$rc"
}

# pg_watch_start <unit> <counter> [args...] / pg_watch_stop: for work that
# runs in the foreground but can be measured from the side (a log that grows,
# containers that become ready). The counter prints "<done> <total>"; it is
# polled every 0.3 s in a background loop that exits if this shell dies.
pg_watch_start() {
    _pg_live || return 0
    local unit=$1 parent=$$
    shift
    (
        while kill -0 "$parent" 2>/dev/null; do
            read -r d t <<<"$("$@" 2>/dev/null || echo "0 0")"
            pg_progress "${d:-0}" "${t:-0}" "$unit" force
            sleep 0.3
        done
    ) &
    _PG_SPIN_PID=$!
}

pg_watch_stop() {
    pg_spin_stop
}

# _pg_pull_counts <docker pull log>: "<layers done> <layers known>", counted
# over layers that TRANSFER this run. 'Already exists' is a layer that moved
# no bytes, so it counts in neither number (S1): a warm pull cannot look like
# progress toward a download. The total grows as docker announces each layer
# it intends to fetch ('Pulling fs layer'), so it is what docker has promised,
# never a guess; 'Pull complete' is a layer that arrived.
_pg_pull_counts() {
    local log=$1 known=0 done_=0
    if [[ -f "$log" ]]; then
        known="$(grep -cE ': Pulling fs layer$' "$log" || true)"
        done_="$(grep -cE ': Pull complete$' "$log" || true)"
    fi
    printf '%s %s\n' "${done_:-0}" "${known:-0}"
}

# _pg_compose_counts [service...]: "<ready> <total>" for this stack: running
# and (healthy or without a healthcheck). The total is the services asked
# for, or every service in the compose file.
_pg_compose_counts() {
    local total ready
    if [[ $# -gt 0 ]]; then
        total=$#
    else
        total="$(compose config --services 2>/dev/null | wc -l | tr -d '[:space:]')"
    fi
    ready="$(compose ps --format '{{.State}} {{.Health}}' "$@" 2>/dev/null \
        | awk '$1 == "running" && ($2 == "" || $2 == "healthy")' | wc -l | tr -d '[:space:]')"
    printf '%s %s\n' "${ready:-0}" "${total:-0}"
}

# pg_spin_start <label> / pg_spin_stop: for steps with no measurable signal.
# The spinner exits by itself if this shell dies.
pg_spin_start() {
    _pg_live || return 0
    local label="$1" parent=$$
    (
        frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
        _pg_unicode || frames='|/-\'
        start=$(date +%s); i=0
        while kill -0 "$parent" 2>/dev/null; do
            f="${frames:$(( i % ${#frames} )):1}"
            printf '\r\033[K%s' "$(_pg_fit "    $f $label $(( $(date +%s) - start ))s")" >&2
            i=$(( i + 1 ))
            sleep 0.1
        done
    ) &
    _PG_SPIN_PID=$!
}

pg_spin_stop() {
    [[ -n "$_PG_SPIN_PID" ]] || return 0
    kill "$_PG_SPIN_PID" 2>/dev/null || true
    wait "$_PG_SPIN_PID" 2>/dev/null || true
    _PG_SPIN_PID=""
    printf '\r\033[K' >&2
}
# --- progress renderer (end) -------------------------------------------------

# T2: AEGIS_DATA_ROOT must be resolved before anything reads AEGIS_*_DIR.
derive_data_root || exit 2

# 2026-11-04: this used to be one of two entrypoints (feature cli-aegis-dev,
# see docs/11-aegis-cli.md) switched by AEGIS_CLI_MODE -- `aegis-dev` and its
# checkout-coupled commands are retired; this is the only surface now.

# The product version, read from the version.json that release-please bumps at
# the repository root. One reader, two callers with different tolerances:
# `aegis version` (later) has nothing to say without it and dies; the default
# image tag below must NOT die — it falls back to `main` instead, because the
# launcher still has to work on a machine whose copy predates the file or never
# got it. Prints the version on stdout; returns non-zero when it cannot be read.
_product_version() {
    local file="${AEGIS_WORKSTATION_DIR%/}/version.json" v=""
    if [[ -f "$file" ]]; then
        v="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([0-9][0-9A-Za-z.+-]*\)".*/\1/p' "$file" | head -n1)"
    fi
    [[ -n "$v" ]] && printf '%s' "$v"
}

# Where the licensed image comes from (S5): our own pull-through registry, which caches GHCR and
# gates every pull behind a download token the API mints. The repository path mirrors the upstream's
# path, which is why it carries the GHCR owner. Moving the image to the VANGEN organisation is THIS
# value: the compose file and the cosign identity below are both derived from it, so there is no
# second copy of the name to forget. (An earlier note here claimed the move was "these two values
# and nothing else"; the case split below is what made that untrue.)
#
# It stays LOWERCASE: GHCR lowercases the owner, and the pull-through cache forwards the request path
# to `https://ghcr.io` verbatim (see registry/config.yml in aegis-licensing), so an uppercase owner
# would not resolve. The GitHub URL the workflow is signed under keeps the account's canonical case,
# which is exactly the gap AEGIS_IMAGE_IDENTITY_REGEXP has to bridge.
AEGIS_IMAGE_REGISTRY="${AEGIS_IMAGE_REGISTRY:-aegis-registry-production.up.railway.app}"
AEGIS_IMAGE_REPO="${AEGIS_IMAGE_REPO:-vangen-group/aegis-workstation}"
# The tag the client pulls follows the PUBLISHED version of the product, not a
# branch that moves: `main` is re-cut on every image-input change, so a machine
# running it could not answer "which version am I running". Newest is not the
# same as published — tracking the moving channel stays an explicit opt-in
# (`aegis image pull --tag main`, or AEGIS_IMAGE_TAG here). If version.json
# cannot be read, the fallback is `main` with a warning: degraded, never fatal —
# the launcher has to work before the first `aegis install` writes that file,
# and a missing version must not block a start.
AEGIS_IMAGE_TAG="${AEGIS_IMAGE_TAG:-}"
# Whether the tag was pinned by the caller (S3: a client update must let the NEW
# version pick its own tag unless the user pinned one on purpose).
AEGIS_IMAGE_TAG_EXPLICIT="${AEGIS_IMAGE_TAG:+1}"
if [[ -z "$AEGIS_IMAGE_TAG" ]]; then
    if _default_tag="$(_product_version)"; then
        AEGIS_IMAGE_TAG="v${_default_tag}"
    else
        AEGIS_IMAGE_TAG="main"
        err "WARNING: cannot read the product version (${AEGIS_WORKSTATION_DIR%/}/version.json) — falling back to the 'main' image tag; run 'aegis install' or 'aegis update'."
    fi
fi
# Exported because docker-compose.yml interpolates `image:` from the PROCESS
# ENVIRONMENT, not from shell variables: without this the compose file would
# substitute empty strings. The compose file carries NO defaults of its own any
# more. cmd_up also records these values (and AEGIS_DEV_IMAGE) in
# <AEGIS_WORKSTATION_DIR>/.devcontainer/.env, the launcher's state file, which
# docker compose loads too (see write_compose_env).
export AEGIS_IMAGE_REGISTRY AEGIS_IMAGE_REPO AEGIS_IMAGE_TAG

# OD1.3 — the client BUNDLE image, the registry channel `aegis install` falls
# back to when neither --from/AEGIS_INSTALL_SOURCE nor AEGIS_INSTALL_URL is set.
# It is the same delivery mechanism as the workstation image (a signed container
# image pulled with the SAME download token and proven with the SAME cosign
# identity), just carrying the bundle tarball at /bundle.tar.gz instead of a
# runtime. The repository default DERIVES from AEGIS_IMAGE_REPO, so moving the
# product to another org stays one edit, and the two artifacts are published
# together by the same CI (see odd/tasks/cliente-onboarding.md). The tag is
# `latest` by default because the bundle is content, not a runtime a person has
# to know the version of.
AEGIS_BUNDLE_REPO="${AEGIS_BUNDLE_REPO:-${AEGIS_IMAGE_REPO}-bundle}"
AEGIS_BUNDLE_TAG="${AEGIS_BUNDLE_TAG:-latest}"

# The image the dev service actually runs (2026-10-08). The compose file's
# `image:` is this ONE value, and `aegis up` / `aegis env rebuild` resolve it on
# every run (resolve_dev_image): the registry reference above when the language
# manifest asks for nothing, or the local `aegis-workstation-env:<hash>` built
# from it. Every OTHER compose call (stop, down, status, the proxy restart) only
# needs it to interpolate, and must not make the dev service look "changed": so
# the default is the value the last `up` wrote to .devcontainer/.env, and only
# without one the registry reference.
if [[ -z "${AEGIS_DEV_IMAGE:-}" ]]; then
    AEGIS_DEV_IMAGE="$(sed -n 's/^AEGIS_DEV_IMAGE=//p' "${AEGIS_WORKSTATION_DIR%/}/.devcontainer/.env" 2>/dev/null | tail -n 1 || true)"
    AEGIS_DEV_IMAGE="${AEGIS_DEV_IMAGE:-${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${AEGIS_IMAGE_TAG}}"
fi
export AEGIS_DEV_IMAGE
# The local tag an environment image is built under. Never the registry name:
# a pull of the published image must not be able to overwrite it.
AEGIS_ENV_IMAGE_REPO="aegis-workstation-env"

# Who signs the image, and what proves it. Keyless signing binds the signature to the workflow run
# that produced it, so verification names an IDENTITY and an ISSUER instead of a public key we would
# have to distribute and rotate.
#
# DERIVED from AEGIS_IMAGE_REPO — changing the repo moves both the registry path and the identity,
# which is what makes the org move a single edit. The two do not agree on case: the registry path is
# lowercased by GHCR (`emanolgonzalez`) while the certificate carries the GitHub account's canonical
# case (`EmanolGonzalez`). cosign matches this regexp with Go's regexp package, compiled and matched
# case-SENSITIVELY (cosign v3.1.3, pkg/cosign/verify.go CheckCertificatePolicy), so the bridge is the
# inline `(?i)` flag — verified against that source, not from memory. Overridable, like every other
# AEGIS_* value: an explicit AEGIS_IMAGE_IDENTITY_REGEXP still wins.
AEGIS_IMAGE_OIDC_ISSUER="${AEGIS_IMAGE_OIDC_ISSUER:-https://token.actions.githubusercontent.com}"
AEGIS_IMAGE_IDENTITY_REGEXP_WAS_SET="${AEGIS_IMAGE_IDENTITY_REGEXP:+1}"
AEGIS_IMAGE_IDENTITY_REGEXP="${AEGIS_IMAGE_IDENTITY_REGEXP:-(?i)^https://github\\.com/${AEGIS_IMAGE_REPO}/}"

# cosign runs from its own pinned image, in a throwaway container: no binary to install on Windows,
# and the pin is a release tag whose digest the first successful verify will make visible.
AEGIS_COSIGN_IMAGE="${AEGIS_COSIGN_IMAGE:-ghcr.io/sigstore/cosign/cosign:v3.1.3}"

# T4 (cli-standalone-distribution, 2026-10-29): aegis-cli is its own repo with
# its own release cadence — `aegis update`'s CLI step pulls the latest signed
# release from here instead of copying bin/ out of the just-installed bundle.
# AEGIS_CLI_VERSION pins an exact tag (e.g. v0.2.7); unset means latest.
AEGIS_CLI_REPO="${AEGIS_CLI_REPO:-vangen-group/aegis-cli}"
AEGIS_CLI_IDENTITY_REGEXP="${AEGIS_CLI_IDENTITY_REGEXP:-(?i)^https://github\\.com/${AEGIS_CLI_REPO}/}"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

require_compose_file() {
    if [[ ! -f "$COMPOSE_FILE" ]]; then
        err "no docker-compose.yml found - the configuration looks broken."
        err "run 'aegis install' to reinstall it, or set AEGIS_WORKSTATION_DIR to the folder that holds .devcontainer/."
        exit 1
    fi
}

compose() {
    require_compose_file
    # The read-only repo mount in the compose file defaults to ../../.. RELATIVE
    # TO THE WORKING DIRECTORY, which only resolves to the checkout when compose
    # runs from the repo. Since T18 the host runs the INSTALLED copy
    # (~/.aegis/workstation/.devcontainer), where that default is the user's
    # HOME: the whole Windows profile (with .ssh, .aegis, AppData) was readable
    # inside the container at /workspace/code/aegis-workstation. It was
    # read-only, so there was no host escape and no way to widen egress from
    # inside - but the leak was real (found 2026-10-03). Pass the resolved
    # configuration directory explicitly, which can never resolve to the home
    # directory; Docker Desktop needs a native path here, hence _to_native_path.
    local repo_dir="${AEGIS_WORKSTATION_DIR%/}"
    # egress-persistent-pairs (T4): a SECOND -f, only when the generated
    # extra_hosts override exists — compose merges it over the main file.
    # Passing an explicit -f (above) already opts out of compose's own
    # auto-discovery of a same-directory docker-compose.override.yml, so this
    # file is named and loaded explicitly instead of relying on that.
    local -a compose_files=(-f "$COMPOSE_FILE")
    [[ -f "$AEGIS_EXTRA_HOSTS_FILE" ]] && compose_files+=(-f "$AEGIS_EXTRA_HOSTS_FILE")
    AEGIS_REPO_DIR="$(_to_native_path "$repo_dir")" \
        docker compose "${compose_files[@]}" "$@"
}

# Sandbox sibling of require_compose_file() above (T1/T5). Kept separate so the
# workstation's COMPOSE_FILE and this one can never require each other's tree.
require_sandbox_compose_file() {
    if [[ ! -f "$SANDBOX_COMPOSE_FILE" ]]; then
        err "no sandbox docker-compose.yml found - the sandbox configuration looks broken."
        err "set AEGIS_SANDBOX_DIR to the folder that holds .devcontainer/."
        exit 1
    fi
}

# Runs `docker compose` for ONE sandbox project. Unlike compose() this never
# sets AEGIS_REPO_DIR (that variable belongs to the workstation compose file);
# the sandbox compose file only needs AEGIS_SANDBOX_REPO, which cmd_sandbox
# exports. SANDBOX_PROJECT is the per-repo project name (aegis-sandbox-<hash>).
sandbox_compose() {
    require_sandbox_compose_file
    docker compose -p "${SANDBOX_PROJECT:?}" -f "$SANDBOX_COMPOSE_FILE" "$@"
}

# _sandbox_hash <string> -> a short, stable, lowercase hex digest. Mirrors the
# launcher's existing use of sha256sum (backup/restore) with portable fallbacks
# so Git Bash (shasum) and a bare POSIX host (cksum) still yield a valid project
# name.
_sandbox_hash() {
    local h=""
    if command -v sha256sum >/dev/null 2>&1; then
        h="$(printf '%s' "$1" | sha256sum | cut -d' ' -f1)"
    elif command -v shasum >/dev/null 2>&1; then
        h="$(printf '%s' "$1" | shasum -a 256 | cut -d' ' -f1)"
    else
        h="$(printf '%s' "$1" | cksum | tr -dc '0-9a-fA-F')"
    fi
    printf '%s' "${h:0:12}"
}

# _sandbox_project_name <absolute-repo-path> -> aegis-sandbox-<hash>.
_sandbox_project_name() {
    printf 'aegis-sandbox-%s' "$(_sandbox_hash "$1")"
}

# T10 — the compose the host executes must never live inside the repo the
# sandbox mounts READ-WRITE. That repo is untrusted; T18 showed what happens
# when the host runs config an untrusted tree can edit. `aegis install` puts the
# executed copy under AEGIS_SANDBOX_INSTALL_DIR (outside every mount); this is
# the runtime backstop for the same invariant, so a repository fallback that
# points at the mounted repo is refused instead of executed.
_sandbox_assert_compose_outside_repo() {
    local repo_abs="$1" compose_dir compose_abs
    if ! compose_dir="$(cd "$(dirname "$SANDBOX_COMPOSE_FILE")" && pwd -P)"; then
        err "the sandbox configuration looks broken: cannot resolve ${SANDBOX_COMPOSE_FILE}"
        return 1
    fi
    compose_abs="${compose_dir%/}/$(basename "$SANDBOX_COMPOSE_FILE")"
    case "${compose_abs}/" in
        "${repo_abs%/}"/*)
            err "refusing: the sandbox compose lives inside the repo it would mount (${repo_abs})."
            err "run 'aegis install' so the host executes the sandbox configuration from outside every mount."
            return 1
            ;;
    esac
    return 0
}

# T8 (D2b) — fail-closed name allowlist for sandbox credential injection.
# Prints every allowed entry, one per line: $AEGIS_SANDBOX_ALLOWED_ENVS when it
# is set (comma/whitespace separated), plus one entry per line of
# $AEGIS_SANDBOX_ALLOWED_ENVS_FILE ('#' comments and blanks ignored). Absent or
# empty sources mean an empty set, which is the point: the default grants
# nothing.
_sandbox_allowed_names() {
    local from_var="${AEGIS_SANDBOX_ALLOWED_ENVS:-}"
    if [[ -n "$from_var" ]]; then
        printf '%s\n' "$from_var" | tr ',[:space:]' '\n'
    fi
    if [[ -f "$AEGIS_SANDBOX_ALLOWED_ENVS_FILE" ]]; then
        grep -v '^[[:space:]]*#' "$AEGIS_SANDBOX_ALLOWED_ENVS_FILE" 2>/dev/null || true
    fi
}

# Exits 1 (never injects silently) when <name> is not in the allowlist. Called
# for every --env/--secret BEFORE any docker call, so a typo cannot half-start a
# session. The whole sandbox gets exactly the names the owner listed.
_sandbox_require_allowed_name() {
    local name="$1" entry
    while IFS= read -r entry; do
        entry="${entry#"${entry%%[![:space:]]*}"}"
        entry="${entry%"${entry##*[![:space:]]}"}"
        [[ -n "$entry" ]] || continue
        [[ "$entry" == "$name" ]] && return 0
    done < <(_sandbox_allowed_names)
    err "sandbox: refusing to inject '${name}': it is not in the credential allowlist."
    err "Allow it explicitly in ${AEGIS_SANDBOX_ALLOWED_ENVS_FILE} (one name per line),"
    err "or with AEGIS_SANDBOX_ALLOWED_ENVS='<name>[,<name>...]'."
    err "The allowlist is empty by default: the sandbox receives no credential until you name it."
    exit 1
}

# On Git Bash/MSYS (Windows), the runtime auto-converts an argument that
# looks like a standalone absolute POSIX path (e.g. /home/dev/...,
# /workspace/...) into a Windows path before it ever reaches docker.exe —
# corrupting any `docker exec` argument that names an IN-CONTAINER path.
# This wrapper disables that conversion only for the single call it wraps,
# leaving conversion on (needed for the real host paths in `compose()`
# above) everywhere else. Harmless no-op on Linux/macOS/WSL bash.
docker_exec_path() {
    MSYS_NO_PATHCONV=1 docker exec "$@"
}

# Same MSYS/Git Bash path-mangling problem as docker_exec_path() above, but for
# a plain `node` call: node is a Windows .exe when the launcher runs under Git
# Bash, so every HOST path it receives (the license file, the device credential,
# config/license-keys.json, the telemetry/build-view scripts) has to be in native
# form, not the POSIX form bash sees. MSYS_NO_PATHCONV=1 alone would stop the
# conversion happening at all and break node's own module resolution — so each
# path is pre-converted with cygpath first. cygpath is a Git-Bash/MSYS-only
# tool; on Linux/macOS/WSL bash it does not exist, no conversion ever happens
# there in the first place, and _to_native_path() falls back to returning its
# argument unchanged.
_to_native_path() {
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -m "$1"
    else
        printf '%s' "$1"
    fi
}

# ---------------------------------------------------------------------------
# License helpers
# ---------------------------------------------------------------------------

require_license_helper() {
    if ! command -v node >/dev/null 2>&1; then
        err "node is required for 'aegis license' (Ed25519 verification) but was not found in PATH."
        exit 1
    fi
    if [[ ! -f "$LICENSE_JS" ]]; then
        err "the configuration is incomplete - the license helper is missing next to the launcher."
        exit 1
    fi
}

require_activate_helper() {
    if ! command -v node >/dev/null 2>&1; then
        err "node is required for 'aegis license activate' (HTTPS + hashing) but was not found in PATH."
        exit 1
    fi
    if [[ ! -f "$ACTIVATE_JS" ]]; then
        err "the configuration is incomplete - the activation helper is missing next to the launcher."
        exit 1
    fi
}

require_license_api_helper() {
    if ! command -v node >/dev/null 2>&1; then
        err "node is required for 'aegis license renew|heartbeat|retire' (HTTPS) but was not found in PATH."
        exit 1
    fi
    if [[ ! -f "$LICENSE_API_JS" ]]; then
        err "the configuration is incomplete - the license API helper is missing next to the launcher: $LICENSE_API_JS"
        exit 1
    fi
}

is_up() {
    docker inspect --format '{{.State.Running}}' "$DEV_CONTAINER" >/dev/null 2>&1 \
        && [[ "$(docker inspect --format '{{.State.Running}}' "$DEV_CONTAINER" 2>/dev/null)" == "true" ]]
}

ensure_up() {
    if ! is_up; then
        log "workstation is not running — starting it first (aegis up)."
        cmd_up
    fi
}

# Rejects an absolute path and any ".." path-traversal component, then
# prints the resolved /workspace/<rel> path. Never resolves against the real
# filesystem (no realpath/readlink) — this only has to validate the STRING,
# because the actual containment guarantee comes from the container's own
# mounts (see AGENTS.md: the single data volume mounts at /workspace).
resolve_workspace_path() {
    local rel="${1:-}"
    if [[ -z "$rel" || "$rel" == "." ]]; then
        printf '/workspace'
        return 0
    fi
    case "$rel" in
        /*)
            err "path must be relative to /workspace, not absolute: $rel"
            exit 1
            ;;
    esac
    local part
    local IFS='/'
    # shellcheck disable=SC2086
    for part in $rel; do
        if [[ "$part" == ".." ]]; then
            err "path traversal ('..') is not allowed: $rel"
            exit 1
        fi
    done
    printf '/workspace/%s' "$rel"
}

# ---------------------------------------------------------------------------
# T20 helpers — path validation and throwaway-container data operations
# ---------------------------------------------------------------------------

# resolve_data_path <rel> -> prints "<volume-name> <subpath>" on
# success, exits 1 with an error otherwise. Same rejection rules as
# resolve_workspace_path (no absolute path, no ".." component) PLUS: the
# first path segment must be exactly "code" — single-code-volume
# (2026-11-04): there is ONE data volume and it mounts at /workspace, so the
# "code" segment is KEPT as the first subpath component (the volume root
# holds the repositories under code/ inside it). "memories" is refused with
# a migration pointer instead of silently resolving. The subpath printed
# always starts with code/, because every consumer mounts the VOLUME ROOT
# (check_no_symlink_escape, export/import, build windows volume-subpath) and
# reaches the data through /data/code/....
resolve_data_path() {
    local rel="${1:-}"
    if [[ -z "$rel" ]]; then
        err "path must not be empty (expected code/...)"
        exit 2
    fi
    case "$rel" in
        /*)
            err "path must be relative to /workspace, not absolute: $rel"
            exit 1
            ;;
    esac
    local part first=1 vol="" sub=""
    local IFS='/'
    # shellcheck disable=SC2086
    for part in $rel; do
        if [[ "$part" == ".." ]]; then
            err "path traversal ('..') is not allowed: $rel"
            exit 1
        fi
        if [[ "$first" -eq 1 ]]; then
            case "$part" in
                code) vol="$VOL_CODE" ;;
                memories)
                    err "memories/... no longer exists: the workstation uses a single code volume (2026-11-04)."
                    err "Your old memories content lives under /workspace/code — see docs/10-workstation.md (single-code-volume)."
                    exit 2
                    ;;
                *)
                    err "path must start with 'code/': $rel"
                    exit 1
                    ;;
            esac
            first=0
            continue
        fi
        sub="${sub:+$sub/}$part"
    done
    printf '%s %s' "$vol" "code${sub:+/$sub}"
}

# check_no_symlink_escape <volume> <subpath> — mounts <volume> read-only in a
# throwaway, network-less container and rejects if any symlink under
# /data/<subpath> resolves (via `readlink -f`, which only follows an EXISTING
# chain — a dangling target is reported as-is and still checked as a string)
# outside /data. /data is the container-local, isolated view of the volume,
# so "outside /data" here means outside the volume entirely, which is exactly
# the escape this guards against.
check_no_symlink_escape() {
    local vol="$1" sub="$2"
    local target="/data${sub:+/$sub}"
    # TARGET passed as an env var (-e), not string-concatenated into the
    # script, so it never needs extra quoting/escaping here. The `for`
    # loop (not a pipe into `while`) keeps `status` in THIS shell, not a
    # pipeline subshell, so `exit "$status"` actually reflects a finding.
    if ! docker run --rm --network none -e TARGET="$target" -v "$(data_mount_src "$vol"):/data:ro" "$BACKUP_IMAGE" sh -c '
        [ -e "$TARGET" ] || exit 0
        links="$(find "$TARGET" -type l 2>/dev/null)"
        status=0
        old_ifs="$IFS"
        IFS="
"
        for link in $links; do
            [ -n "$link" ] || continue
            resolved="$(readlink -f "$link")"
            case "$resolved" in
                /data|/data/*) ;;
                *) echo "escape: $link -> $resolved" >&2; status=1 ;;
            esac
        done
        IFS="$old_ifs"
        exit "$status"
    '; then
        err "refusing: a symlink under '$sub' resolves outside its volume (path traversal via symlink)"
        exit 1
    fi
}

# `.devcontainer/.env` is the launcher's state file (T29; since S5, 2026-10-14,
# there is no VS Code "Reopen in Container" path that needed it for itself):
#   - the launcher reads AEGIS_DEV_IMAGE back from it when nothing else set it
#     (stop/down/status/rebuild), and the client `aegis update` compares the
#     previous and new developer image through it;
#   - docker compose loads it as well: the launcher runs `docker compose -f
#     <file>` with no --project-directory, so Compose reads the `.env` next to
#     the compose file. Exported values win over it, so the AEGIS_IMAGE_* keys
#     the launcher exports are unaffected, but a user's AEGIS_MEMORIES_DIR /
#     AEGIS_CODE_DIR override (docs/10-workstation.md §4) reaches compose only
#     through this file.
#
# The write is a merge, not a blank overwrite: we own only the three AEGIS_IMAGE_*
# keys and AEGIS_DEV_IMAGE, so we drop those (and any previous copy of our own
# header, including the pre-S5 "VS Code path" one) and keep everything else.
#
# Best-effort: a failed write only loses that recorded state — it does not stop `up`.
write_compose_env() {
    local dir="${AEGIS_WORKSTATION_DIR%/}/.devcontainer"
    [[ -d "$dir" ]] || return 0
    local env_file="${dir}/.env" keep="" _k _v own=""
    # T2: strip only the keys THIS run writes. A value the user put in .env by
    # hand (e.g. AEGIS_CODE_DIR=D:/code) must survive when the shell does not
    # set it — the launcher owns what it derives, not what it did not.
    for _k in AEGIS_DATA_ROOT AEGIS_CODE_DIR AEGIS_HOME_DIR AEGIS_CLAUDE_DIR \
              AEGIS_OPENCODE_DIR AEGIS_GENTLE_AI_DIR AEGIS_ENGRAM_DIR AEGIS_HERDR_DIR; do
        eval "_v=\${$_k:-}"
        [[ -n "$_v" ]] && own="${own:+${own}|}${_k}="
    done
    unset _k _v
    # T2: the launcher OWNS a marked block. If the previous .env carried it, all
    # the derived keys are stripped even when this run sets none — that is what
    # makes switching BACK to the named volumes work instead of leaving the
    # last encrypted paths stuck in place.
    local strip_pat="$own"
    if [[ -f "$env_file" ]] && grep -qx '# aegis:data-root' "$env_file" 2>/dev/null; then
        # Our block is in the file: own ALL of it, so unsetting AEGIS_DATA_ROOT
        # really returns to the named volumes.
        strip_pat="AEGIS_ENCRYPTED=|AEGIS_DATA_ROOT=|AEGIS_CODE_DIR=|AEGIS_HOME_DIR=|AEGIS_CLAUDE_DIR=|AEGIS_OPENCODE_DIR=|AEGIS_GENTLE_AI_DIR=|AEGIS_ENGRAM_DIR=|AEGIS_HERDR_DIR="
    fi
    if [[ -f "$env_file" ]]; then
        keep="$(grep -v -E "^(AEGIS_IMAGE_(REGISTRY|REPO|TAG)=|AEGIS_DEV_IMAGE=|${strip_pat:+${strip_pat}|}AEGIS_MARK_KEEP=|# aegis:data-root$|# Generated by aegis up|# Read by docker compose on the VS Code path|# Launcher state: )" "$env_file" || true)"
        # Collapse the blank lines our block may have left behind, so repeated `aegis up`
        # runs do not grow the file.
        keep="$(printf '%s' "$keep" | sed -e '/^[[:space:]]*$/d')"
    fi
    {
        printf '%s\n' \
            '# Generated by aegis up — do not edit, do not commit (gitignored).' \
            '# Launcher state: aegis reads it back, and docker compose loads it too.' \
            "AEGIS_IMAGE_REGISTRY=${AEGIS_IMAGE_REGISTRY}" \
            "AEGIS_IMAGE_REPO=${AEGIS_IMAGE_REPO}" \
            "AEGIS_IMAGE_TAG=${AEGIS_IMAGE_TAG}" \
            "AEGIS_DEV_IMAGE=${AEGIS_DEV_IMAGE}"
        # T2: only when the user opted into a data root (or set a per-volume
        # dir); otherwise compose falls back to the named volumes.
        local _wrote=0
        if [[ -n "${AEGIS_DATA_ROOT:-}" || -n "$(state_get AEGIS_DATA_ROOT)" ]] \
            && [[ "${AEGIS_ENCRYPTED:-}" != "0" ]]; then
            printf '%s\n' '# aegis:data-root'
            printf '%s\n' "AEGIS_ENCRYPTED=1"
            _wrote=1
        fi
        for _k in AEGIS_DATA_ROOT AEGIS_CODE_DIR AEGIS_HOME_DIR AEGIS_CLAUDE_DIR \
                  AEGIS_OPENCODE_DIR AEGIS_GENTLE_AI_DIR AEGIS_ENGRAM_DIR AEGIS_HERDR_DIR; do
            eval "_v=\${$_k:-}"
            if [[ -n "$_v" ]]; then
                [[ "$_wrote" -eq 0 ]] && printf '%s\n' '# aegis:data-root'
                _wrote=1
                printf '%s\n' "${_k}=${_v}"
            fi
        done
        unset _k _v _wrote
        if [[ -n "$keep" ]]; then
            printf '%s\n' "$keep"
        fi
    } >"$env_file" || \
        err "WARNING: could not write ${env_file} — stop/down/status and aegis update will not know the developer image"
}

# --- 2026-10-08: which image the dev service runs ---------------------------
# The bug this fixes: `aegis env rebuild` built the user's languages into an
# image tagged with the REGISTRY reference (the compose file had `image:` and
# `build:` both naming it), so the next `aegis up` — including the automatic one
# behind `aegis shell`/`aegis herdr` — pulled the published image over that tag
# and started it. `aegis env list` then said "Installed in the running
# workstation: (none)". Now the user's image lives under its own local name,
# aegis-workstation-env:<hash>, that no pull can touch.

# Regenerates .devcontainer/generated/ from the manifest: the same network-free
# step `aegis env rebuild` runs before building. Output goes to a log; returns
# the script's status (absent script = nothing to do, success). Prints the
# seconds it took on stdout, for the build view's first phase.
regenerate_build_context() {
    local started rc=0
    started="$(date +%s)"
    if [[ -f "$GEN_BUILD_CONTEXT_SH" ]]; then
        mkdir -p "${BUILD_LOG_DIR%/}"
        bash "$GEN_BUILD_CONTEXT_SH" >>"${BUILD_LOG_DIR%/}/context-$(date -u +%Y%m%dT%H%M%SZ).log" 2>&1 || rc=$?
    fi
    printf '%s' "$(( $(date +%s) - started ))"
    return "$rc"
}

# True when the generated build context asks for anything beyond the published
# image: a language version, cpp, or an opt-in tool. Reads the files the
# Dockerfile actually COPYs, not the manifest, so "requests something" means
# exactly "a local build would differ from the published base". An empty
# manifest makes generate-build-context.sh write EMPTY *.versions files and
# "false" in every *.enabled (tools.toml only restates the versions, so it is
# not consulted). An absent generated/ directory — a copy that never ran the
# generator — requests nothing too.
manifest_requests_anything() {
    local f
    [[ -d "$GENERATED_DIR" ]] || return 1
    for f in "$GENERATED_DIR"/*.versions; do
        [[ -f "$f" ]] || continue
        grep -q '[^[:space:]]' "$f" && return 0
    done
    for f in "$GENERATED_DIR"/*.enabled; do
        [[ -f "$f" ]] || continue
        [[ "$(tr -d '[:space:]' <"$f")" == "true" ]] && return 0
    done
    return 1
}

# A short, stable digest of everything a local build is made of that changes
# between users or releases: every file in generated/ (in a fixed C-locale
# order, name and contents), the Dockerfile, and the product version (which
# stands in for the rest of the build context — scripts, wrappers — that only
# changes with a release). A new manifest or a new product version therefore
# names a new tag, and an old image can never be mistaken for the current one.
# CRs are dropped so a CRLF checkout hashes like an LF one.
# How to retry an env-image build: `add`/`remove environment|tool` rebuild by
# themselves, but `env rebuild` forces one without changing the manifest.
_rebuild_hint() {
    printf "'aegis env rebuild' (or 'aegis up' again)"
}

# A client builds only the env layers on top of the verified published image
# (client-license-surface S2).
_dev_dockerfile() {
    printf '%s' "${AEGIS_WORKSTATION_DIR%/}/.devcontainer/Dockerfile.client"
}

env_image_hash() {
    local input
    input="$(
        export LC_ALL=C
        for f in "$GENERATED_DIR"/*; do
            [[ -f "$f" ]] || continue
            printf 'file %s\n' "${f##*/}"
            tr -d '\r' <"$f"
            printf '\n'
        done
        printf 'dockerfile\n'
        tr -d '\r' <"$(_dev_dockerfile)" 2>/dev/null || true
        printf '\nversion %s\n' "$(_product_version || echo unknown)"
        # A client's image is built FROM the verified base: a re-published base
        # (same version, new digest) must name a new image (R3-002).
        printf 'base %s\n' "$AEGIS_VERIFIED_BASE_REF"
    )"
    _sandbox_hash "$input"
}

env_image_ref() {
    printf '%s:%s' "$AEGIS_ENV_IMAGE_REPO" "$(env_image_hash)"
}

# Decides AEGIS_DEV_IMAGE from the CURRENT generated/ contents (regenerate them
# first): the registry reference when the manifest asks for nothing, the env tag
# otherwise. Only decides — whether that image exists is the caller's question.
resolve_dev_image() {
    if manifest_requests_anything; then
        AEGIS_DEV_IMAGE="$(env_image_ref)"
    else
        AEGIS_DEV_IMAGE="${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${AEGIS_IMAGE_TAG}"
    fi
    export AEGIS_DEV_IMAGE
}

# The licensed download plus the signature check, shared by `aegis up` and by a
# rebuild whose manifest asks for nothing (there the published image IS the
# result, and a signed one beats an unsigned local copy of it). Both failure
# modes (no token, signature not signed by our CI) stop the caller instead of
# warning: an image we cannot prove must not get a container.
pull_and_verify_published_image() {
    cmd_image_pull
    local image_ref image_digest
    image_ref="${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${AEGIS_IMAGE_TAG}"
    image_digest="$(docker inspect --format='{{index .RepoDigests 0}}' "$image_ref" 2>/dev/null | sed 's/.*@//')"
    if [[ -z "$image_digest" ]]; then
        err "no local digest for ${image_ref} after pulling it — refusing to start"
        err "the bytes that would run are not the ones just downloaded."
        exit 1
    fi
    if ! _verify_local_image "${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}@${image_digest}"; then
        err "refusing to start: the image that would run did not verify (see above)."
        exit 1
    fi
    # S2: the exact bytes that just verified, by digest — what a client's
    # developer image is built FROM (never the mutable tag).
    AEGIS_VERIFIED_BASE_REF="${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}@${image_digest}"
}

# ---------------------------------------------------------------------------
# T29: `aegis up` starts the image from the registry, verifies the signature first.
# ---------------------------------------------------------------------------

cmd_up() {
    [[ $# -eq 0 ]] || { err "usage: aegis up"; exit 2; }

    # T3: never start on top of a sealed vault (see the helper above).
    require_vault_if_code_dir_is_a_bind || exit 1

    # T11: say it out loud the one time it matters — when the mode came from
    # the installer rather than from this shell.
    if [[ "${_AEGIS_ADOPTED_MODE:-0}" = "1" ]]; then
        log "encrypted mode: adopting the installer's setting (AEGIS_DATA_ROOT=${AEGIS_DATA_ROOT})."
    fi

    # T8: fit the stack's defaults to the daemon instead of assuming a big one.
    resolve_resource_limits

    # T29: the image now comes from the registry, so it is proven BEFORE compose
    # is allowed to start anything. Leaving verification out of the start path
    # would make the signature a seal nobody checks for the one run that matters.
    #
    # Same licensed flow as `aegis image pull`, then the shared verify.
    pull_and_verify_published_image

    # The build context, regenerated from the manifest on EVERY start (network-
    # free, the same step `aegis env rebuild` runs): it is what decides which
    # image runs, and what --build builds from. If it cannot be regenerated (no
    # node on the host, say) the previous generated/ is what the last build used,
    # so it still names the right image — said out loud, never assumed silently.
    local context_seconds context_rc=0
    context_seconds="$(regenerate_build_context)" || context_rc=$?
    if [[ "$context_rc" != "0" ]]; then
        err "WARNING: generate-build-context.sh failed — using the build context of the last rebuild (log: ${BUILD_LOG_DIR%/}/context-*.log)"
    fi

    # Which image runs (2026-10-08). The published image was just verified; it is
    # what runs when the manifest asks for nothing. Otherwise the user's own
    # image runs — aegis-workstation-env:<hash>, a name no pull can overwrite —
    # and when that exact image is not here yet (first start with this manifest,
    # a new product version, a pruned image) it is built now, through the same
    # function `aegis env rebuild` uses. There is no fallback to the bare image:
    # starting it would be the 2026-10-08 bug again ("Installed in the running
    # workstation: (none)"), just with a different cause.
    resolve_dev_image
    if [[ "$AEGIS_DEV_IMAGE" != "${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${AEGIS_IMAGE_TAG}" ]]; then
        if docker image inspect "$AEGIS_DEV_IMAGE" >/dev/null 2>&1; then
            log "using your environment image ${AEGIS_DEV_IMAGE} (languages/tools from $(tildify "$AEGIS_ENV_FILE"))."
        else
            log "your environment image for this manifest and product version (${AEGIS_DEV_IMAGE}) is not here yet —"
            log "building it now (first start with this manifest, a new product version, or a pruned image)."
            # A subshell, so a missing helper's `exit` lands here and gets the
            # refusal below instead of ending the launcher mid-sentence.
            if ! ( build_dev_image "$context_seconds" ); then
                err "the environment image was not built — refusing to start the bare published image in its place."
                err "fix the cause above and run $(_rebuild_hint)."
                exit 1
            fi
        fi
    fi

    # Record the resolved image values in the launcher state (.env), which
    # stop/down/status, aegis update and docker compose read back.
    write_compose_env

    # T22: regenerate the effective allowlist from the current manifest
    # BEFORE `compose up` — the egress-proxy service bind-mounts
    # $AEGIS_ALLOWLIST_FILE (see docker-compose.yml); a first run with no
    # such file yet would otherwise either fail or (worse, on some Docker
    # Desktop versions) silently bind an empty directory there. Cheap and
    # network-free (falls back to always-on-only entries if no manifest
    # exists yet — see generate-allowlist.sh), so it is safe to run on every
    # `up`, not just after `aegis add/remove environment`.
    if [[ -f "$GEN_ALLOWLIST_SH" ]]; then
        # The script is an internal: its output goes to a log, and `aegis` is the
        # only thing that talks to the user (same rule as the rebuild path). When
        # it fails, its tail is what matters — not the whole output.
        if bash "$GEN_ALLOWLIST_SH" >>"${BUILD_LOG_DIR%/}/allowlist-$(date -u +%Y%m%dT%H%M%SZ).log" 2>&1; then
            local langs=""
            # node is not required for `up` (only the language commands need it),
            # so the detail is added only when it can actually be resolved. Both
            # fields, always: the rebuild path logs the same pair, and a line
            # that names languages but not tools read like the tools had been
            # lost (what the Linux acceptance reported).
            if command -v node >/dev/null 2>&1; then
                langs=" (languages: $(manifest_language_names); tools: $(manifest_tool_names))"
            fi
            log "allowlist updated${langs}"
        else
            err "WARNING: generate-allowlist.sh failed — egress-proxy may start with a stale/incomplete allowlist"
            err "last lines of its log (${BUILD_LOG_DIR%/}/allowlist-*.log):"
            tail -n 10 "${BUILD_LOG_DIR%/}"/allowlist-*.log 2>/dev/null | sed 's/^/  /' >&2
        fi
    fi

    # egress-persistent-pairs (T4): regenerate the extra_hosts override from
    # the current pairs BEFORE `compose up` below, same reasoning as the
    # allowlist regenerate just above — an `aegis update` wipes this file
    # (it lives outside AEGIS_WORKSTATION_DIR precisely so IT survives, but
    # the FIRST `up` after an update still needs to rebuild it fresh). The
    # file changing here never needs a recreate decision of its own: `compose
    # up` runs right below regardless.
    cmd_allow_regenerate_extra_hosts || true

    # --no-build is what makes this a promise instead of a hope. With `image:` and `build:` both in
    # the compose file, a plain `compose up` would BUILD if the image were missing — silently
    # substituting an unsigned image for the one we just downloaded and verified. With this flag
    # compose either runs the image resolved above (verified, or the user's env image that is
    # known to exist), or it fails.
    # Friendly CLI flow: this ran raw before, so every `docker compose` line
    # (`[+] up 2/2 ✔ Container ... Healthy`) leaked straight to the terminal —
    # noise a first-time user has no way to interpret. Captured to a log and
    # tailed only on failure, same convention as the rebuild path's own
    # compose-up a few hundred lines down ($stack_log) and generate-allowlist's
    # regenerate: "aegis is the only thing that talks to the user."
    local up_log="${BUILD_LOG_DIR%/}/up-$(date -u +%Y%m%dT%H%M%SZ).log"
    mkdir -p "${BUILD_LOG_DIR%/}"
    local up_rc=0
    pg_watch_start services _pg_compose_counts
    compose up -d --wait --no-build >>"$up_log" 2>&1 || up_rc=$?
    pg_watch_stop
    if [[ "$up_rc" -ne 0 ]]; then
        err "the container did not come up; last lines:"
        tail -n 20 "$up_log" | sed 's/^/  /' >&2
        exit 1
    fi
    log "containers up."
    log "preparing the cache directories."
    docker_exec_path "$DEV_CONTAINER" mkdir -p /home/dev/.cache/go-tmp /home/dev/.cache/exec-tmp

    if docker_exec_path "$DEV_CONTAINER" test -f "$FIRST_RUN_MARKER" 2>/dev/null; then
        log "first-run init already done (marker present) — skipping."
    else
        log "first-run init: git safe.directory."
        docker exec "$DEV_CONTAINER" git config --global --add safe.directory '*' \
            || err "WARNING: git config --global --add safe.directory '*' failed"
        docker exec "$DEV_CONTAINER" sh -c "touch '$FIRST_RUN_MARKER'"
    fi
    # Apply the per-user configuration with configure-workstation.sh (gentle-ai
    # for claude/opencode, herdr config, AGENTS.md, profile). Since S5 this is
    # its only trigger; the VS Code postCreateCommand used to run it too.
    # Without it ~/.config/opencode never exists and herdr's opencode
    # integration refuses to install. Its own marker (not FIRST_RUN_MARKER)
    # so homes created before this step existed still get configured.
    if docker_exec_path "$DEV_CONTAINER" test -f "$CONFIGURED_MARKER" 2>/dev/null; then
        log "workstation configuration already applied (marker present) — skipping."
    else
        log "configuring agents: configure-workstation.sh (gentle-ai, herdr, AGENTS.md)."
        # MSYS_NO_PATHCONV: Git Bash would otherwise rewrite the container-side
        # /usr/local/... path into a Windows path before docker sees it.
        if MSYS_NO_PATHCONV=1 docker exec -e GIT_AUTHOR_NAME -e GIT_AUTHOR_EMAIL "$DEV_CONTAINER" \
            bash /usr/local/share/aegis/configure-workstation.sh; then
            docker exec "$DEV_CONTAINER" sh -c "touch '$CONFIGURED_MARKER'"
        else
            err "WARNING: configure-workstation.sh failed — see docs/10-workstation.md (will retry on next 'aegis up')"
        fi
    fi
    log "workstation stack is up."
}

cmd_shell() {
    _exec_in_container bash "$@"
}

cmd_herdr() {
    _exec_in_container herdr "$@"
}

# ---------------------------------------------------------------------------
# Aegis Sandbox (T5/T8): `aegis sandbox <repo> [--env <name>] [--secret <name>]
# [-- <cmd> [args...]]`
#
# Boots a per-repo, disposable container from the minimal sandbox template with
# ONLY <repo> bind-mounted (RW) at /workspace/repo and model-endpoints-only
# egress, then either runs `-- cmd` inside it or opens an interactive bash. One
# Docker project per repo (aegis-sandbox-<hash of the absolute path>), so two
# repos never share a container. This command is intentionally standalone: it
# must never assume the repo lives under /workspace the way
# resolve_workspace_path does.
#
# T8 (D2): model credentials enter the sandbox ONLY through --env/--secret and
# ONLY when their name is in the allowlist ($AEGIS_SANDBOX_ALLOWED_ENVS_FILE,
# empty by default). Every name is checked before any docker call: a name that
# is not allowed is refused, never injected silently. The values remain
# ephemeral — vault -> session tmpfs -> the exec'd process's environment, never
# a persistent file and never baked into the image. The workstation's own
# host-environment pass-through (SECRET_ENV_ARGS: GH_TOKEN, ANTHROPIC_API_KEY,
# ...) is deliberately NOT reused here: handing the sandbox the host's client
# secrets is exactly what D2(a) forbids.
# ---------------------------------------------------------------------------
cmd_sandbox() {
    local repo=""
    local use_gvisor=0
    local -a cmd_args=()
    local -a env_names=()
    local -a secret_names=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --gvisor)
                use_gvisor=1
                shift
                ;;
            --env)
                [[ $# -ge 2 ]] || { err "--env requires a value (a vault name)"; exit 2; }
                env_names+=("$2")
                shift 2
                ;;
            --secret)
                [[ $# -ge 2 ]] || { err "--secret requires a value (a vault name = environment variable name)"; exit 2; }
                secret_names+=("$2")
                shift 2
                ;;
            --)
                shift
                cmd_args=("$@")
                break
                ;;
            -*)
                err "unknown option for 'aegis sandbox': $1"
                exit 2
                ;;
            *)
                if [[ -n "$repo" ]]; then
                    err "usage: aegis sandbox <repo> [--gvisor] [--env <name>] [--secret <name>] [-- <cmd> [args...]]"
                    exit 2
                fi
                repo="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$repo" ]]; then
        err "usage: aegis sandbox <repo> [--gvisor] [--env <name>] [--secret <name>] [-- <cmd> [args...]]"
        exit 2
    fi
    if [[ ! -e "$repo" ]]; then
        err "sandbox repo does not exist: $repo"
        exit 1
    fi
    if [[ ! -d "$repo" ]]; then
        err "sandbox repo is not a directory: $repo"
        exit 1
    fi

    # Client-redesign T2.1: the template installs lazily at first use — after
    # argument validation, before anything touches docker.
    ensure_sandbox_template || exit 1

    # T8 (D2b): the allowlist is checked FIRST, before any docker call, so a
    # denied name cannot even half-start a session. An empty allowlist refuses
    # everything — that is the default and the point.
    local _name
    for _name in "${env_names[@]:-}" "${secret_names[@]:-}"; do
        [[ -n "$_name" ]] || continue
        _sandbox_require_allowed_name "$_name"
    done
    # --secret names an environment variable, so it must be shaped like one;
    # --env keeps the aegis-shell contract of a vault path (validated later by
    # session_inject_env, after the container is up).
    for _name in "${secret_names[@]:-}"; do
        [[ -n "$_name" ]] || continue
        if [[ ! "$_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            err "--secret '${_name}' must be a valid environment variable name (letters, digits, '_'; not starting with a digit)."
            exit 2
        fi
    done

    # T7: gVisor is opt-in and FAIL-CLOSED. BEFORE any docker up (and before any
    # per-repo state is written) we check that this daemon really has `runsc`
    # registered. If it does not, we stop: booting on the default runc would be
    # a silent downgrade of the isolation the caller explicitly asked for, and
    # this command must never do that. The check is a read-only `docker info`.
    if [[ "$use_gvisor" -eq 1 ]]; then
        local runtimes
        if ! runtimes="$(docker info --format '{{json .Runtimes}}' 2>/dev/null)" || [[ -z "$runtimes" ]]; then
            err "gVisor was requested (--gvisor) but this Docker daemon could not be queried for its runtimes."
            err "gVisor/runsc is either not installed or Docker is unreachable; refusing to fall back to runc."
            exit 1
        fi
        if [[ "$runtimes" != *'"runsc"'* ]]; then
            err "gVisor was requested (--gvisor) but the runtime 'runsc' is not registered with this Docker daemon."
            err "gVisor is NOT available on this host. It needs a Linux/WSL host that supports it"
            err "(https://gvisor.dev/docs/user_guide/install/), registered as 'runsc' in the daemon config."
            err "Nothing was started: this command will not boot degraded on runc in silence."
            exit 1
        fi
        # Compose interpolates ${AEGIS_SANDBOX_RUNTIME:-runc}; exporting runsc
        # picks gVisor for the dev service without editing the compose file.
        export AEGIS_SANDBOX_RUNTIME=runsc
    fi

    # Absolute, physical path: the hash and the contract with compose both key
    # off it, so a symlink or a relative spelling must resolve to one value.
    local repo_abs
    if ! repo_abs="$(cd "$repo" && pwd -P)"; then
        err "could not resolve the sandbox repo path: $repo"
        exit 1
    fi

    SANDBOX_PROJECT="$(_sandbox_project_name "$repo_abs")"
    # Native form for Docker Desktop/Windows; identical on Linux/macOS/WSL.
    export AEGIS_SANDBOX_REPO
    AEGIS_SANDBOX_REPO="$(_to_native_path "$repo_abs")"

    # T6: generate THIS repo's effective egress allowlist — model endpoints
    # only — from the sandbox template's own SOURCE
    # (templates/sandbox/config/allowlist.txt) into a per-repo host dir
    # OUTSIDE every mount ($HOME/.aegis/sandbox/<hash>/), then hand that path
    # to compose. The source is the sandbox's copy, so the workstation's
    # broader list (source control, npm, languages, ...) never leaks in.
    #
    # AEGIS_ALLOWLIST_CUSTOM_FILE is pointed at a per-repo, initially ABSENT
    # file so the workstation's global ~/.aegis/allowlist.custom.json is NOT
    # appended either: a scoped, per-repo `aegis allow` store is a documented
    # follow-up of T6, and until then the sandbox must stay model-only.
    local allowlist_dir sandbox_allowlist
    allowlist_dir="${AEGIS_SANDBOX_ALLOWLIST_DIR:-$HOME/.aegis/sandbox}/$(_sandbox_hash "$repo_abs")"
    sandbox_allowlist="${allowlist_dir}/allowlist.txt"
    export AEGIS_SANDBOX_ALLOWLIST_FILE
    AEGIS_SANDBOX_ALLOWLIST_FILE="$(_to_native_path "$sandbox_allowlist")"

    mkdir -p "$allowlist_dir" "${BUILD_LOG_DIR%/}"
    if [[ -f "$GEN_ALLOWLIST_SH" ]]; then
        if AEGIS_ALLOWLIST_SOURCE="${AEGIS_SANDBOX_DIR%/}/config/allowlist.txt" \
            AEGIS_ALLOWLIST_FILE="$sandbox_allowlist" \
            AEGIS_ALLOWLIST_PORTS_FILE="${allowlist_dir}/allowlist-ports.conf" \
            AEGIS_ALLOWLIST_CUSTOM_FILE="${allowlist_dir}/allowlist.custom.json" \
            bash "$GEN_ALLOWLIST_SH" >>"${BUILD_LOG_DIR%/}/sandbox-allowlist-$(date -u +%Y%m%dT%H%M%SZ).log" 2>&1; then
            log "sandbox: per-repo egress allowlist ready ($(tildify "$sandbox_allowlist"))"
        else
            err "WARNING: generate-allowlist.sh failed drawing the sandbox allowlist — egress-proxy may start with a stale/incomplete list"
            tail -n 10 "${BUILD_LOG_DIR%/}"/sandbox-allowlist-*.log 2>/dev/null | sed 's/^/  /' >&2
        fi
    else
        err "WARNING: generate-allowlist.sh not found at ${GEN_ALLOWLIST_SH} — the sandbox egress allowlist was not regenerated"
    fi
    # Fail closed, never bind a missing path (Compose would materialize an
    # empty DIRECTORY at /etc/squid/allowlist.txt and Squid would refuse to
    # start): a comments-only file is a valid, deny-all allowlist.
    if [[ ! -f "$sandbox_allowlist" ]]; then
        printf '# GENERATED fallback: the sandbox allowlist could not be generated; nothing is allowed.\n' > "$sandbox_allowlist"
    fi

    require_sandbox_compose_file
    # T10: never execute a compose that lives inside the repo about to be mounted.
    _sandbox_assert_compose_outside_repo "$repo_abs" || exit 1
    log "sandbox: project ${SANDBOX_PROJECT} (repo ${repo_abs})"
    sandbox_compose up -d --wait --build

    local container
    container="$(sandbox_compose ps -q "$SANDBOX_SERVICE")"
    if [[ -z "$container" ]]; then
        err "the sandbox container did not start for project ${SANDBOX_PROJECT}"
        exit 1
    fi

    # T8 (D2): inject credentials into the SANDBOX container, ephemerally. The
    # helpers below are the same ones `aegis shell` uses, retargeted by
    # AEGIS_SESSION_CONTAINER (the workstation never changes it). Values travel
    # vault -> session tmpfs -> the exec'd process's environment and are removed
    # when the session ends; nothing persistent is written, nothing is baked
    # into the image.
    local -a env_args=()
    local -a entry_cmd=(bash)
    local have_creds=0
    if [[ "${#env_names[@]}" -gt 0 || "${#secret_names[@]}" -gt 0 ]]; then
        have_creds=1
        AEGIS_SESSION_CONTAINER="$container"
        local session_dir
        session_dir="/run/ssh-session/$(printf '%04x%04x%04x' "$$" "$RANDOM" "$RANDOM")"
        export AEGIS_SSH_DIR="$session_dir"
        env_args+=(-e AEGIS_SSH_DIR)
        if [[ "${#env_names[@]}" -gt 0 ]]; then
            session_inject_env "$session_dir" "${env_names[@]}"
        fi
        if [[ "${#secret_names[@]}" -gt 0 ]]; then
            session_inject_secret_env "$session_dir" "${secret_names[@]}"
        fi
        # The wrapper exports the variables, deletes their files, runs the entry
        # (bash, or bash -lc for -- cmd) and its EXIT trap removes the session
        # directory — even on failure.
        entry_cmd=(sh -c "$SESSION_WRAPPER_SH" _ bash)
    fi

    local rc=0
    if [[ "${#cmd_args[@]}" -gt 0 ]]; then
        if [[ "$have_creds" -eq 1 ]]; then
            docker_exec_path -i -w /workspace/repo "${env_args[@]}" "$container" \
                "${entry_cmd[@]}" -lc "$(printf '%q ' "${cmd_args[@]}")" || rc=$?
        else
            docker_exec_path -it -w /workspace/repo "$container" "${cmd_args[@]}" || rc=$?
        fi
    else
        if [[ "$have_creds" -eq 1 ]]; then
            docker_exec_path -it -w /workspace/repo "${env_args[@]}" "$container" \
                "${entry_cmd[@]}" || rc=$?
        else
            docker_exec_path -it -w /workspace/repo "$container" bash || rc=$?
        fi
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# T9 — `aegis promote <repo>`: out of the sandbox, into the workstation
# ---------------------------------------------------------------------------
#
# The last step of the quarantine -> promote story (feature aegis-sandbox): a
# repo evaluated inside a disposable sandbox is copied into the workstation's
# code volume and only THEN is the sandbox torn down. The ORDER is the contract
# — copy first, destroy second — so a failed or interrupted copy never leaves
# the only copy of the repo inside a stack that has already been removed.
#
# It reuses the sandbox naming (same repo -> same project/hash as cmd_sandbox)
# and the throwaway, network-less container pattern of import/restore. The
# destination is a path under code/ (default: the repo's own name); an existing
# destination is refused unless --force, and an uncommitted tree is refused
# unless --allow-dirty.
cmd_promote() {
    local repo="" to="" force=0 allow_dirty=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --to) [[ $# -ge 2 ]] || { err "--to requires a value"; exit 2; }; to="$2"; shift 2 ;;
            --force) force=1; shift ;;
            --allow-dirty) allow_dirty=1; shift ;;
            -*) err "unknown option for 'aegis promote': $1"; exit 2 ;;
            *)
                if [[ -n "$repo" ]]; then
                    err "usage: aegis promote <repo> [--to <destino>] [--force] [--allow-dirty]"
                    exit 2
                fi
                repo="$1"; shift
                ;;
        esac
    done
    if [[ -z "$repo" ]]; then
        err "usage: aegis promote <repo> [--to <destino>] [--force] [--allow-dirty]"
        exit 2
    fi
    if [[ ! -e "$repo" ]]; then
        err "sandbox repo does not exist: $repo"
        exit 1
    fi
    if [[ ! -d "$repo" ]]; then
        err "sandbox repo is not a directory: $repo"
        exit 1
    fi

    # Same absolute, physical path (and therefore the same project/hash) as
    # cmd_sandbox: promote must address the sandbox that was actually booted.
    local repo_abs
    if ! repo_abs="$(cd "$repo" && pwd -P)"; then
        err "could not resolve the sandbox repo path: $repo"
        exit 1
    fi

    SANDBOX_PROJECT="$(_sandbox_project_name "$repo_abs")"
    local hash state_dir sandbox_allowlist
    hash="$(_sandbox_hash "$repo_abs")"
    state_dir="${AEGIS_SANDBOX_ALLOWLIST_DIR:-$HOME/.aegis/sandbox}/$hash"
    sandbox_allowlist="${state_dir}/allowlist.txt"
    # Compose interpolates both even to tear the stack down; set them exactly
    # like cmd_sandbox does so the same project is addressed.
    export AEGIS_SANDBOX_REPO AEGIS_SANDBOX_ALLOWLIST_FILE
    AEGIS_SANDBOX_REPO="$(_to_native_path "$repo_abs")"
    AEGIS_SANDBOX_ALLOWLIST_FILE="$(_to_native_path "$sandbox_allowlist")"

    require_sandbox_compose_file
    # T10: even the teardown must not execute a compose from inside the repo.
    _sandbox_assert_compose_outside_repo "$repo_abs" || exit 1
    local container
    container="$(sandbox_compose ps -q "$SANDBOX_SERVICE" 2>/dev/null || true)"
    if [[ -z "$container" ]]; then
        err "no sandbox is running for ${repo_abs}."
        err "boot it first: aegis sandbox ${repo}"
        exit 1
    fi

    # A committed-clean tree unless told otherwise: promoting half a change is
    # exactly the mistake this guards against.
    if [[ "$allow_dirty" -ne 1 ]]; then
        local dirty
        if ! dirty="$(git -C "$repo_abs" status --porcelain 2>/dev/null)"; then
            err "cannot read 'git status' for ${repo_abs} (not a git checkout?)."
            err "pass --allow-dirty to promote it anyway."
            exit 1
        fi
        if [[ -n "$dirty" ]]; then
            err "the sandbox repo has uncommitted changes:"
            printf '%s\n' "$dirty" | sed 's/^/  /' >&2
            err "commit or stash them, or pass --allow-dirty."
            exit 1
        fi
    fi

    # Destination: a path under code/, defaulting to the repo's own name.
    [[ -n "$to" ]] || to="$(basename "$repo_abs")"
    local rel
    case "$to" in
        code/*) rel="$to" ;;
        code) err "--to must name a path under code/ (e.g. code/<name>), not code/ itself."; exit 2 ;;
        /*) err "--to must be relative to code/, not absolute: $to"; exit 2 ;;
        *) rel="code/$to" ;;
    esac
    local vol sub resolved
    resolved="$(resolve_data_path "$rel")" || exit 1
    read -r vol sub <<<"$resolved"
    if [[ "$vol" != "$VOL_CODE" ]]; then
        err "promote can only write into the code volume (got: $vol)."
        exit 2
    fi
    if [[ -z "$sub" ]]; then
        err "--to must name a path under code/, not code/ itself."
        exit 2
    fi

    if ! vault_confirm "promote ${repo_abs} -> /workspace/${rel} and tear the sandbox down?"; then
        log "cancelled: nothing was copied and the sandbox was left running."
        return 0
    fi

    # Copy FIRST (throwaway container, network-less — the same pattern as
    # import/restore). Only when this succeeds does anything below destroy.
    local repo_native rc=0
    repo_native="$(_to_native_path "$repo_abs")"
    log "promoting ${repo_abs} -> /workspace/${rel} (throwaway container, --network none)."
    pg_step 1 2 "Copying into the workstation"
    pg_run_counted 0 items -- env MSYS_NO_PATHCONV=1 docker run --rm --network none \
        -e DEST="/data${sub:+/$sub}" -e FORCE="$force" -e REL="/workspace/$rel" \
        -v "${repo_native}:/promote-src:ro" \
        -v "$(data_mount_src "$vol"):/data" \
        "$BACKUP_IMAGE" sh -c '
            # Fail closed, like import: without set -e a failed cp was masked
            # by the chown after it, and the sandbox was then torn down.
            set -eu
            if [ -e "$DEST" ]; then
                if [ "$FORCE" != "1" ]; then
                    echo "aegis: $REL already exists in the workstation code volume." >&2
                    echo "aegis: pass --force to replace it, or choose another --to path." >&2
                    exit 3
                fi
                rm -rf "$DEST"
            fi
            mkdir -p "$DEST"
            echo "@@aegis-total $(find /promote-src -mindepth 1 | wc -l)"
            cp -av /promote-src/. "$DEST/"
            chown -R 1000:1000 "$(dirname "$DEST")"
        ' || rc=$?
    if [[ "$rc" -eq 3 ]]; then
        err "nothing was promoted: the destination already exists (see the message above)."
        err "the sandbox was NOT torn down."
        exit 1
    elif [[ "$rc" -ne 0 ]]; then
        err "promote failed while copying into the workstation (container exit $rc)."
        err "the sandbox was NOT torn down."
        exit 1
    fi
    check_no_symlink_escape "$vol" "$sub"
    pg_done 1

    # Copy verified: now, and only now, destroy.
    log "copy complete — tearing the sandbox down (${SANDBOX_PROJECT})."
    pg_step 2 2 "Removing the sandbox"
    if ! sandbox_compose down -v; then
        err "the code is now at /workspace/${rel}, but tearing the sandbox down failed."
        err "remove it by hand: docker compose -p ${SANDBOX_PROJECT} -f ${SANDBOX_COMPOSE_FILE} down -v"
        exit 1
    fi
    if [[ -d "$state_dir" ]]; then
        rm -rf "$state_dir"
        log "sandbox state removed: $state_dir"
    fi
    pg_done 2
    log "promoted: ${repo_abs} -> /workspace/${rel}. The sandbox is gone."
}

# T40.2: validates one --tunnel spec and prints it normalized as
# host:remotePort:localPort (local defaults to remote). A malformed spec
# prints the reason and returns 1 — the caller exits 2. The host is a domain
# or an IP literal only: no IPv6, because the ':' separators of the spec and
# of an IPv6 address would need a syntax the option does not have; no
# wildcard either — one target per flag, same rule as T40's pairs.
_tunnel_normalize_spec() {
    local spec="$1"
    local -a parts=()
    local IFS=':'
    # shellcheck disable=SC2086 # word-splitting on ':' is the whole point
    read -r -a parts <<<"$spec"
    IFS=$' \t\n'
    if [[ "${#parts[@]}" -lt 2 || "${#parts[@]}" -gt 3 ]]; then
        err "--tunnel takes <host>:<port>[:<localPort>], got: $spec"
        return 1
    fi
    local host="${parts[0]}" rport="${parts[1]}" lport="${parts[2]:-${parts[1]}}"
    if [[ -z "$host" || ! "$host" =~ ^[A-Za-z0-9._-]+$ ]]; then
        err "--tunnel needs a hostname or IP literal (no IPv6, no wildcard, no empty host): $spec"
        return 1
    fi
    local p
    for p in "$rport" "$lport"; do
        if [[ ! "$p" =~ ^[0-9]+$ ]] || (( 10#$p < 1 || 10#$p > 65535 )); then
            err "--tunnel ports must be integers 1..65535: $spec"
            return 1
        fi
    done
    # 3128 is the proxy's own port (egress-tunnel.js repeats the refusal inside
    # the container, where the bind would actually happen).
    if (( 10#$lport == 3128 )); then
        err "--tunnel cannot bind localhost:3128 — that is the egress proxy's own port"
        return 1
    fi
    printf '%s:%d:%d' "$host" "$((10#$rport))" "$((10#$lport))"
}

# T40.2: warn-check for --tunnel — does a LOADED rule cover CONNECT to this
# exact pair? It reads the same two generated files `aegis allow test` reads:
# the fixed CONNECT ports (443/22/2022) live in allowlist.txt by host, any
# other port lives as a (host,port) pair in the T40 ports file — or, since
# T40.3, as a port WINDOW there combined with the host being in allowlist.txt
# (the allowed_https_dst gate). NOT a gate: the rule can arrive from another
# window after this session started, and squid always remains the authority —
# which is why a miss is a warning, never a refusal. The awk bodies mirror
# cmd_allow_test's (copied, not shared, so that command's tested wording
# stays frozen).
_tunnel_rule_covers() {
    local host="$1" port="$2"
    local fixed=""
    case "$port" in 443|22|2022) fixed="yes" ;; esac
    if [[ -n "$fixed" ]]; then
        [[ -f "$AEGIS_ALLOWLIST_FILE" ]] || return 1
        awk -v h="$host" '
            !/^[ \t]*#/ && NF {
                e = $1
                if (e == h) { found = 1; exit }
                if (substr(e, 1, 1) == ".") {
                    bare = substr(e, 2)
                    if (h == bare) { found = 1; exit }
                    if (length(h) > length(bare) && substr(h, length(h) - length(bare)) == "." bare) { found = 1; exit }
                }
            }
            END { exit found ? 0 : 1 }' "$AEGIS_ALLOWLIST_FILE"
        return
    fi
    [[ -f "$AEGIS_ALLOWLIST_PORTS_FILE" ]] || return 1
    if awk -v h="$host" -v p="$port" '
        $1 == "acl" && $2 ~ /^aegis_dst_/ && ($3 == "dst" || $3 == "dstdomain") { acl[$2] = $3 " " $4; next }
        $1 == "http_access" && $2 == "allow" && $3 == "CONNECT" && $5 == "aegis_port_" p && ($4 in acl) {
            split(acl[$4], v, " ")
            if (v[1] == "dst" && v[2] == h) { found = 1; exit }
            if (v[1] == "dstdomain") {
                e = v[2]
                if (e == h) { found = 1; exit }
                if (substr(e, 1, 1) == ".") {
                    bare = substr(e, 2)
                    if (h == bare || (length(h) > length(bare) && substr(h, length(h) - length(bare)) == "." bare)) { found = 1; exit }
                }
            }
        }
        END { exit found ? 0 : 1 }' "$AEGIS_ALLOWLIST_PORTS_FILE"; then
        return 0
    fi
    # T40.3: a live window on this port covers the tunnel's CONNECT too when
    # the host is already in the loaded list — the same allowed_https_dst gate
    # cmd_allow_test mirrors. Without this the warn would fire on the
    # documented window + host + explicit --tunnel path (decision 7).
    grep -q "^acl aegis_gport_${port} port ${port}\$" "$AEGIS_ALLOWLIST_PORTS_FILE" || return 1
    [[ -f "$AEGIS_ALLOWLIST_FILE" ]] || return 1
    awk -v h="$host" '
        !/^[ \t]*#/ && NF {
            e = $1
            if (e == h) { found = 1; exit }
            if (substr(e, 1, 1) == ".") {
                bare = substr(e, 2)
                if (h == bare) { found = 1; exit }
                if (length(h) > length(bare) && substr(h, length(h) - length(bare)) == "." bare) { found = 1; exit }
            }
        }
        END { exit found ? 0 : 1 }' "$AEGIS_ALLOWLIST_FILE"
}

# Shared by cmd_shell/cmd_herdr. Argument parsing:
#   aegis shell [path]                                -> interactive
#   aegis shell [path] -- cmd args...                 -> non-interactive, propagates exit code
#   aegis shell [path] --accounts a,b [--dry-run] ...  -> see docs/11-aegis-cli.md
#   aegis shell [path] --env auto|--env <name> ...    -> repeatable; load env vars from the vault
#                                                        into this session (never a host file):
#                                                        --env <name>: a vault name, e.g.
#                                                        --env envs/sbp/proyecto_sac/webapp;
#                                                        --env auto: the nearest .envrc (from the
#                                                        target up to /workspace) and its
#                                                        `# aegis-env: app1, app2` line ->
#                                                        envs/<that folder's name>/appN.
#   aegis shell [path] --tunnel <host>:<port>[:<localPort>]
#                                                     -> T40.2: repeatable; a localhost tunnel
#                                                        for TCP clients that cannot use a proxy
#                                                        (usql, psql, redis-cli). The T40 squid
#                                                        rule is still the gate.
_exec_in_container() {
    local entry="$1"
    shift
    local rel=""
    local rel_set=0
    local -a secrets=()
    local -a env_names=()
    local -a tunnels=()
    local dry_run="${AEGIS_DRY_RUN:-0}"
    local -a extra_cmd=()
    local seen_dashdash=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --accounts)
                err "--accounts is gone: the launcher no longer manages git credentials."
                err "A session takes its identity from what the host already authenticated:"
                err "  - git/gh/az over HTTPS: their own browser flow (GCM, 'gh auth login', 'az login')."
                err "  - an SSH key for this session: aegis shell --secret <name> (see: aegis secret list)."
                err "  - a token or variable from the vault: aegis shell --env auto | --env <name>."
                exit 2
                ;;
            --secret)
                [[ $# -ge 2 ]] || { err "--secret requires a value (a name under keys/, see: aegis secret list)"; exit 2; }
                secrets+=("$2")
                shift 2
                ;;
            --env)
                [[ $# -ge 2 ]] || { err "--env requires a value (env name or 'auto')"; exit 2; }
                env_names+=("$2")
                shift 2
                ;;
            --tunnel)
                [[ $# -ge 2 ]] || { err "--tunnel requires a value: <host>:<port>[:<localPort>]"; exit 2; }
                local _tspec
                _tspec="$(_tunnel_normalize_spec "$2")" || exit 2
                tunnels+=("$_tspec")
                shift 2
                ;;
            --dry-run)
                dry_run=1
                shift
                ;;
            # --cmd is an alias for "--": PowerShell consumes a bare "--"
            # as its own end-of-parameters marker and never passes it on.
            --|--cmd)
                seen_dashdash=1
                shift
                extra_cmd=("$@")
                break
                ;;
            *)
                if [[ "$rel_set" -eq 0 ]]; then
                    rel="$1"
                    rel_set=1
                    shift
                else
                    err "unexpected argument: $1"
                    exit 2
                fi
                ;;
        esac
    done

    # Two --tunnel flags cannot share one local bind: the second helper would
    # die on EADDRINUSE and the dev would only find it in tunnels.log.
    if [[ "${#tunnels[@]}" -gt 1 ]] \
        && printf '%s\n' "${tunnels[@]}" | awk -F: '{ print $3 }' | sort | uniq -d | grep -q .; then
        err "--tunnel: two tunnels cannot bind the same localhost port"
        exit 2
    fi

    # An explicit --env name is checked before anything touches docker; `auto`
    # names are checked once they are resolved from the .envrc.
    local _en
    for _en in "${env_names[@]}"; do
        [[ "$_en" == "auto" ]] || vault_require_name "$_en" "aegis shell --env auto|<name>"
    done

    # --- auto-tunnels: one per ACTIVE port WINDOW that carries --to (T40.4),
    # AND one per ACTIVE permanent (host,port) PAIR (T40.2, restored 2026-10-24
    # alongside pair creation itself — egress-persistent-pairs T2). Both share
    # one dedupe pass against explicit --tunnel (by exact host:port pair AND by
    # local port) and against each other (by local port, windows checked first
    # below, so a window wins a collision over a pair): the first writer of a
    # local port keeps it, every later one is skipped with a log line, never a
    # failure. `aegis shell`/`herdr` never guess silently past a collision.
    # Both read their canonical source fresh from the store on every session
    # start — the store's `windows`/`ports` verbs, NOT the generated squid
    # include: the include is a compilation artifact that lags behind a failed
    # regenerate, while the store verbs apply the same validity+expiry filters
    # the generator itself uses. Zero rules of a kind means total silence for
    # that kind — a session with none of either gains no lines and no process.
    local -a auto_specs=()
    local -a auto_notes=()
    if [[ -f "$AEGIS_ALLOWLIST_CUSTOM_FILE" ]]; then
        if ! command -v node >/dev/null 2>&1 || [[ ! -f "$ALLOWLIST_JS" ]]; then
            log "auto-tunnels skipped: node/aegis-allowlist.js is not available (an explicit --tunnel still works)."
        else
            local _at _ah _arest _apr _alport
            local occ_pairs="" occ_lports="" occ_auto=""
            for _at in "${tunnels[@]:-}"; do
                [[ -n "$_at" ]] || continue
                _ah="${_at%%:*}"; _arest="${_at#*:}"; _apr="${_arest%%:*}"; _alport="${_arest#*:}"
                occ_pairs="${occ_pairs}${occ_pairs:+ }${_ah}:${_apr}"
                occ_lports="${occ_lports}${occ_lports:+ }${_alport}"
            done

            # T40.4: windows that carry --to — D4/D8, unchanged.
            local _awins _ap _aexpires _ato
            _awins="$(node "$ALLOWLIST_JS" windows "$AEGIS_ALLOWLIST_CUSTOM_FILE" 2>/dev/null || true)"
            while IFS=$'\t' read -r _ap _aexpires _ato; do
                # No port, or no seed: no tunnel. This is the silence D4 asks for.
                [[ -n "$_ap" && -n "$_ato" ]] || continue
                if (( 10#$_ap == 3128 )); then
                    log "auto omitido: localhost:3128 es el puerto del propio proxy"
                    continue
                fi
                case " ${occ_lports} ${occ_auto} " in
                    *" ${_ap} "*)
                        log "auto omitido: localhost:${_ap} ya lo ocupa --tunnel u otro auto-túnel"
                        continue ;;
                esac
                occ_auto="${occ_auto}${occ_auto:+ }${_ap}"
                auto_specs+=("${_ato}:${_ap}:${_ap}")
                auto_notes+=("ventana hasta ${_aexpires:-<sin expiry>}")
            done <<<"$_awins"

            # T40.2 (restored 2026-10-24): permanent (host,port) pairs. A pair
            # never expires (the CLI refuses --for on one, see cmd_allow_add),
            # so its note never talks about an expiry the way a window's does.
            local _apairs _ameta _ph _pp _reason
            _apairs="$(node "$ALLOWLIST_JS" ports "$AEGIS_ALLOWLIST_CUSTOM_FILE" 2>/dev/null || true)"
            _ameta="$(node "$ALLOWLIST_JS" detail "$AEGIS_ALLOWLIST_CUSTOM_FILE" 2>/dev/null || true)"
            while IFS=$'\t' read -r _ph _pp; do
                [[ -n "$_ph" && -n "$_pp" ]] || continue
                if (( 10#$_pp == 3128 )); then
                    log "auto omitido: ${_ph}:${_pp} — localhost:3128 es el puerto del propio proxy"
                    continue
                fi
                case " ${occ_pairs} " in
                    *" ${_ph}:${_pp} "*)
                        log "auto omitido: ${_ph}:${_pp} ya tunelizado por --tunnel"
                        continue ;;
                esac
                case " ${occ_lports} ${occ_auto} " in
                    *" ${_pp} "*)
                        log "auto omitido: ${_ph}:${_pp} — localhost:${_pp} ya lo ocupa --tunnel u otro auto-túnel"
                        continue ;;
                esac
                occ_auto="${occ_auto}${occ_auto:+ }${_pp}"
                _reason="$(printf '%s\n' "$_ameta" | awk -F'\t' -v k="${_ph}:${_pp}" '$1 == k && $3 != "" { print $3; exit }')"
                auto_specs+=("${_ph}:${_pp}:${_pp}")
                auto_notes+=("par permanente \"${_reason:-sin motivo}\"")
            done <<<"$_apairs"
        fi
    fi

    local target
    target="$(resolve_workspace_path "$rel")"

    # The session's environment: the host pass-through below, plus whatever the
    # secret/env injections add. Credentials for git and gh are NOT part of this
    # list — they stopped being the launcher's job (see the --accounts refusal
    # above and docs/11-aegis-cli.md §8.16 for the licence surface).
    local -a env_args=("${SECRET_ENV_ARGS[@]}")

    # --- T24 (D4): the ssh side of a session with an injected secret ---------
    # The generated config and known_hosts live in the tmpfs, not in ~/.ssh (which
    # is persistent), so git and ssh have to be TOLD where they are; the session
    # wrapper below empties the tmpfs when the session ends. Nothing here is a
    # secret, so it appears in --dry-run like the git env-config rules do.
    local ssh_dir=""
    if [[ "${#secrets[@]}" -gt 0 || "${#env_names[@]}" -gt 0 ]]; then
        # One directory PER session (T24, D4). The tmpfs is shared by everything in
        # the container, so a fixed path made concurrent sessions — herdr panes, a
        # second `aegis shell` — step on each other, and the first one to exit wiped
        # the others' keys with it. The token is per invocation, and the session
        # wrapper below removes only its own directory. --env uses the same
        # directory for its files, which the wrapper reads and deletes at start.
        ssh_dir="/run/ssh-session/$(printf '%04x%04x%04x' "$$" "$RANDOM" "$RANDOM")"
        export AEGIS_SSH_DIR="$ssh_dir"
        env_args+=(-e AEGIS_SSH_DIR)
    fi
    if [[ "${#secrets[@]}" -gt 0 ]]; then
        # Only a session with a key gets an ssh config: an --env-only session
        # pointing git at a config that does not exist would break plain ssh.
        export AEGIS_SSH_CONFIG="${ssh_dir}/config"
        export GIT_SSH_COMMAND="ssh -F ${ssh_dir}/config"
        env_args+=(-e GIT_SSH_COMMAND -e AEGIS_SSH_CONFIG)
    fi

    if [[ "$dry_run" == "1" ]]; then
        {
            printf 'aegis: [dry-run] would run:\n'
            printf '  docker exec'
            if [[ "$seen_dashdash" -eq 1 ]]; then
                printf ' -i'
            else
                printf ' -it'
            fi
            printf ' -w %s' "$target"
            local e
            for e in "${env_args[@]}"; do
                printf ' %s' "$e"
            done
            printf ' %s %s' "$DEV_CONTAINER" "$entry"
            if [[ "$seen_dashdash" -eq 1 ]]; then
                printf ' -lc %s' "$(printf '%q ' "${extra_cmd[@]}")"
            fi
            printf '\n'
        }
        if [[ "${#secrets[@]}" -gt 0 ]]; then
            log "[dry-run] secrets named above are injected into the session tmpfs by name; their content is never printed."
        fi
        if [[ "${#env_names[@]}" -gt 0 ]]; then
            local _de
            for _de in "${env_names[@]}"; do
                if [[ "$_de" == "auto" ]]; then
                    log "[dry-run] would load env vars from the vault: auto (names resolved from the nearest .envrc's '# aegis-env:' line at session start)."
                else
                    log "[dry-run] would load env vars from the vault: ${_de} (values are never printed)."
                fi
            done
        fi
        if [[ "${#tunnels[@]}" -gt 0 ]]; then
            local _t _th _tr _tl
            for _t in "${tunnels[@]}"; do
                _th="${_t%%:*}"; _tr="${_t#*:}"; _tr="${_tr%%:*}"; _tl="${_t##*:}"
                log "[dry-run] would start tunnel localhost:${_tl} -> ${_th}:${_tr} (via egress proxy) for this session only."
            done
        fi
        # T40.4: the window seeds are announced the same way — nothing here
        # touches docker, and the store is the only source being read.
        if [[ "${#auto_specs[@]}" -gt 0 ]]; then
            local _ai _aspec _ahost _arest _aport
            for _ai in "${!auto_specs[@]}"; do
                _aspec="${auto_specs[$_ai]}"
                _ahost="${_aspec%%:*}"; _arest="${_aspec#*:}"; _aport="${_arest%%:*}"
                log "[dry-run] would start auto-tunnel localhost:${_aport} -> ${_ahost}:${_aport} (${auto_notes[$_ai]})."
            done
        fi
        log "[dry-run] nothing was sent to docker."
        return 0
    fi

    ensure_up

    # T24 (D4, D5) + env injection: put the material into this session's tmpfs
    # directory now that the container is up, and wrap the session so that
    # directory is emptied when it ends — the material disappears WITH the
    # session, and never lands in ~/.ssh or on the host.
    local -a entry_cmd=("$entry")
    if [[ "${#secrets[@]}" -gt 0 || "${#env_names[@]}" -gt 0 ]]; then
        local s
        for s in "${secrets[@]}"; do
            session_inject_secret "$s" "$ssh_dir"
        done
        if [[ "${#env_names[@]}" -gt 0 ]]; then
            # `auto` can only be resolved now: the .envrc lives in the container.
            local -a env_vault=()
            local n a auto_list
            for n in "${env_names[@]}"; do
                if [[ "$n" == "auto" ]]; then
                    # No .envrc or no `aegis-env:` line is an error: the
                    # session does not start (the user asked for variables).
                    auto_list="$(session_env_auto_names "$target")" || exit 1
                    while IFS= read -r a; do
                        [[ -n "$a" ]] && env_vault+=("$a")
                    done <<<"$auto_list"
                else
                    env_vault+=("$n")
                fi
            done
            session_inject_env "$ssh_dir" "${env_vault[@]}"
        fi
        # One wrapper for both: it loads (and deletes) the env files, and its
        # trap removes only this session's directory. See SESSION_WRAPPER_SH.
        entry_cmd=(sh -c "$SESSION_WRAPPER_SH" _ "$entry")
    fi

    # --- T40.2: localhost tunnels for TCP clients that do not know proxies ----
    # usql/psql/redis-cli cannot be pointed at a proxy — they dial
    # localhost:<port>. Each tunnel listens on 127.0.0.1 ONLY inside the dev
    # container (a 0.0.0.0 bind would hand every other devnet container an
    # exit the allowlist never granted) and forwards every connection through
    # ssh-egress-proxy.js, REUSED AS-IS — the one CONNECT implementation that
    # has existed since T24. The squid rule (T40) is still the gate: without
    # a rule covering the pair — a T40.3 window (`aegis allow add --port <rport>
    # --for <T>`) with the host in the allowlist, or a pair entry already in
    # the store — the helper draws a 403 and the tunnel dies with it; the echo
    # says so every time.
    #
    # Delivered the same way ssh-egress-proxy.js already reaches the container:
    # `docker exec -i ... cat >` into a per-session directory under the
    # /run/ssh-session tmpfs — never a new mount, never the read-only repo.
    # A dedicated directory (not the ssh one): the tunnels live and die with
    # the session through a host-side cleanup below, independently of which
    # entry_cmd wrapper (secret trap, env wrapper) is in play.
    #
    # Order: after ensure_up and after the secret/env injection, before the
    # session process starts — so the passphrase prompts never interleave with
    # the tunnel echoes and the port is listening by the first command. The
    # log and the pidfile live INSIDE that directory (not /run/aegis-tunnels.log):
    # the container runs as uid 1000 and /run is root-owned, so the literal
    # path from the feature doc could not be created — same tmpfs, same scope.
    local tunnel_dir=""
    # The helpers are delivered by exec-cat from AEGIS_WORKSTATION_DIR. Missing
    # them is a hard failure for an explicit --tunnel (the session was asked for
    # that port and cannot honour it); for T40.4's window seeds it is a skipped
    # convenience, said out loud — a session must not refuse to open because of
    # a seed the store still holds.
    if [[ ( "${#tunnels[@]}" -gt 0 || "${#auto_specs[@]}" -gt 0 ) \
        && ( ! -f "$EGRESS_TUNNEL_JS" || ! -f "$SSH_PROXY_JS" ) ]]; then
        if [[ "${#tunnels[@]}" -gt 0 ]]; then
            err "--tunnel needs scripts/egress-tunnel.js and scripts/ssh-egress-proxy.js, missing under ${AEGIS_WORKSTATION_DIR%/}/scripts — run 'aegis install' or 'aegis update'."
            exit 1
        fi
        err "auto-tunnels skipped: scripts/egress-tunnel.js or scripts/ssh-egress-proxy.js missing under ${AEGIS_WORKSTATION_DIR%/}/scripts — run 'aegis install' or 'aegis update'."
        auto_specs=()
        auto_notes=()
    fi
    if [[ "${#tunnels[@]}" -gt 0 || "${#auto_specs[@]}" -gt 0 ]]; then
        tunnel_dir="/run/ssh-session/$(printf '%04x%04x%04x' "$$" "$RANDOM" "$RANDOM")"
        docker_exec_path "$DEV_CONTAINER" sh -c 'mkdir -p "$1" && chmod 700 "$1"' sh "$tunnel_dir"
        docker_exec_path -i "$DEV_CONTAINER" sh -c \
            'cat > "$1" && chmod 700 "$1"' sh "${tunnel_dir}/egress-tunnel.js" < "$EGRESS_TUNNEL_JS"
        docker_exec_path -i "$DEV_CONTAINER" sh -c \
            'cat > "$1" && chmod 700 "$1"' sh "${tunnel_dir}/ssh-egress-proxy.js" < "$SSH_PROXY_JS"
        local t thost trest trport tlport hint
        for t in "${tunnels[@]}"; do
            thost="${t%%:*}"; trest="${t#*:}"; trport="${trest%%:*}"; tlport="${trest#*:}"
            if ! _tunnel_rule_covers "$thost" "$trport"; then
                err "WARNING: no loaded rule covers ${thost}:${trport} — the tunnel starts anyway and dies on 403 until the allow rule exists (the rule may also live in another session's regenerated list; squid is the authority)."
            fi
            # exec -d: detached INSIDE the session's container — the process is
            # a child of the container init, so `aegis stop`/`down` also reaps
            # it; the host-side cleanup below is what ties it to THIS session.
            # Every interpolated value passed _tunnel_normalize_spec's regexes,
            # so there is nothing left to escape inside the single quotes.
            docker_exec_path -d "$DEV_CONTAINER" sh -c \
                "echo \$\$ >> '${tunnel_dir}/tunnels.pid'; exec node '${tunnel_dir}/egress-tunnel.js' '${thost}' '${trport}' '${tlport}' >> '${tunnel_dir}/tunnels.log' 2>&1"
            # The pair-shaped add was retracted from the CLI (2026-10-13): the
            # live way to open a port is the window; fixed ports stay host-only.
            hint="aegis allow add --port ${trport} --for 2h"
            case "$trport" in 443|22|2022) hint="aegis allow add ${thost}" ;; esac
            log "tunnel localhost:${tlport} -> ${thost}:${trport} (via egress proxy; needs '${hint}' rule — without it the tunnel connects and dies)"
        done

        # T40.4 (D4): the window seeds, same mechanics, local = the window's own
        # port. The echo names the destination it came from; a seed whose window
        # or host is not in the LOADED files still gets its tunnel, with the
        # reload warning — squid, not the store, is the authority.
        local _ai _as _ahost _arest _aport
        for _ai in "${!auto_specs[@]}"; do
            _as="${auto_specs[$_ai]}"
            _ahost="${_as%%:*}"; _arest="${_as#*:}"; _aport="${_arest%%:*}"
            if ! _tunnel_rule_covers "$_ahost" "$_aport"; then
                err "WARNING: la ventana :${_aport} o su host ${_ahost} no están en la lista cargada — run 'aegis allow reload'; until then the auto-tunnel connects and dies on 403."
            fi
            docker_exec_path -d "$DEV_CONTAINER" sh -c \
                "echo \$\$ >> '${tunnel_dir}/tunnels.pid'; exec node '${tunnel_dir}/egress-tunnel.js' '${_ahost}' '${_aport}' '${_aport}' >> '${tunnel_dir}/tunnels.log' 2>&1"
            log "auto-tunnel localhost:${_aport} -> ${_ahost}:${_aport} (${auto_notes[$_ai]})"
        done
    fi

    local rc=0
    if [[ "$seen_dashdash" -eq 1 ]]; then
        docker_exec_path -i -w "$target" "${env_args[@]}" "$DEV_CONTAINER" "${entry_cmd[@]}" -lc \
            "$(printf '%q ' "${extra_cmd[@]}")" || rc=$?
    else
        docker_exec_path -it -w "$target" "${env_args[@]}" "$DEV_CONTAINER" "${entry_cmd[@]}" || rc=$?
    fi

    # T40.2: the tunnel dies with the session. The session command has returned
    # (or failed), so its tunnels have no reason to stay: kill the PIDs the
    # `exec -d` lines wrote, and remove the directory with the scripts, the log
    # and the pidfile. || true: a container that died underneath the session
    # must not turn a clean exit into a crash. Honest limit: if the launcher
    # itself is SIGKILLed mid-session, the tunnels survive until the container
    # stops (nothing host-side is left to run this cleanup).
    if [[ -n "$tunnel_dir" ]]; then
        docker_exec_path "$DEV_CONTAINER" sh -c '
            if [ -f "$1/tunnels.pid" ]; then
                while IFS= read -r p; do kill "$p" 2>/dev/null || true; done < "$1/tunnels.pid"
            fi
            rm -rf "$1"
        ' sh "$tunnel_dir" || true
    fi

    return "$rc"
}

# ---------------------------------------------------------------------------
# aegis allow — the egress allowlist (T27). The user's own domains live in
# ~/.aegis/allowlist.custom.json, OUTSIDE every container mount, and
# scripts/generate-allowlist.sh combines them with the template's. Only the host
# can widen the egress: from inside the container none of this is reachable, so
# an agent cannot open itself a way out (see config/squid.conf).
# ---------------------------------------------------------------------------
cmd_allow() {
    local action="${1:-list}"
    [[ $# -gt 0 ]] && shift || true
    case "$action" in
        list)   cmd_allow_list ;;
        add)    cmd_allow_add "$@" ;;
        remove) cmd_allow_remove "$@" ;;
        reload) cmd_allow_reload ;;
        denied) cmd_allow_denied "$@" ;;
        test)   cmd_allow_test "$@" ;;
        *)
            err "usage: aegis allow list"
            err "       aegis allow add <domain> [--reason \"...\"] [--for 30m|2h|7d] [--ip]"
            err "       aegis allow add <domain> --port <n> [--reason \"...\"]   (permanent pair: CONNECT to that host:port only; 'host' = this machine)"
            err "       aegis allow add --port <n> --for 30m|2h|7d [--to <host>] [--reason \"...\"]   (T40.3: port window; T40.4: --to seeds its auto-tunnel)"
            err "       aegis allow remove <domain>"
            err "       aegis allow remove --port <n>   (T40.3: take that port window back out)"
            err "       aegis allow reload"
            err "       aegis allow denied [--last <log-lines>]"
            err "       aegis allow test <url>"
            exit 2
            ;;
    esac
}

# node is what reads and writes the JSON; the file lives on the host, never in a
# container, which is the point: only the host widens the egress.
cmd_allow_need_node() {
    if ! command -v node >/dev/null 2>&1 || [[ ! -f "$ALLOWLIST_JS" ]]; then
        err "node is required for 'aegis allow' (the entries are a JSON file)."
        return 1
    fi
}

# Reloads the RUNNING egress proxy so it re-reads squid.conf and, with it, the
# allowlist the host just rewrote. Two facts make that enough, and the isolated
# harness checks both: the generator writes that file IN PLACE (same inode — a
# replace-by-rename would leave the container bound to the old file forever),
# and `squid -k reconfigure` re-reads the ACL file, not only the main config.
# Reconfigure is a signal, not a restart: the container is never recreated and
# established connections stay up, which is the whole point of T27's slice 3.
# Nothing running means nothing to reload, and that is not an error: the next
# 'aegis up' reads the file fresh.
proxy_reload() {
    if ! command -v docker >/dev/null 2>&1; then
        log "docker is not available here: the proxy reads the new allowlist the next time you run 'aegis up'."
        return 0
    fi
    local running
    running="$(docker inspect -f '{{.State.Running}}' "$PROXY_CONTAINER" 2>/dev/null || true)"
    if [[ "$running" != "true" ]]; then
        log "the egress proxy is not running: nothing to reload (the next 'aegis up' reads the allowlist fresh)."
        return 0
    fi
    # squid lives in /usr/sbin, on root's PATH inside the official image; the
    # full path is the fallback for an image that trims it.
    if docker exec "$PROXY_CONTAINER" sh -c 'command -v squid >/dev/null 2>&1 && squid -k reconfigure || /usr/sbin/squid -k reconfigure' >/dev/null 2>&1; then
        log "egress proxy reloaded — nothing recreated, no connection dropped."
        return 0
    fi
    err "the egress proxy did not take the reload."
    err "your change is already in the file; 'aegis up' applies it by restarting the proxy."
    return 1
}

# Rewrites the effective allowlist from the template + the manifest + your own
# entries, and then makes the running proxy read it (T27, slice 3).
# egress-persistent-pairs (T4): one extra_hosts entry per REAL external pair
# domain, so ITS OWN connection string resolves inside Aegis unchanged — the
# same trick the static `host` alias gets for free, extended to a domain that
# is not known ahead of time. The reserved alias itself is excluded: nothing
# ever dials the literal "host.docker.internal" from inside a session, only
# the compose-time constant "host" does, and that already has its mapping.
# Returns 0 when the file's content actually CHANGED (the caller decides
# whether that is worth recreating the container for), 1 on a write failure.
cmd_allow_regenerate_extra_hosts() {
    cmd_allow_need_node || return 1
    local -a domains=()
    if [[ -f "$AEGIS_ALLOWLIST_CUSTOM_FILE" ]]; then
        local _eh _ep
        while IFS=$'\t' read -r _eh _ep; do
            [[ -n "$_eh" && "$_eh" != "host.docker.internal" ]] || continue
            case " ${domains[*]:-} " in *" ${_eh} "*) continue ;; esac
            domains+=("$_eh")
        done < <(node "$ALLOWLIST_JS" ports "$AEGIS_ALLOWLIST_CUSTOM_FILE" 2>/dev/null || true)
    fi
    local target="$AEGIS_EXTRA_HOSTS_FILE"
    local before="" after=""
    [[ -f "$target" ]] && before="$(cat "$target" 2>/dev/null || true)"
    if [[ "${#domains[@]}" -eq 0 ]]; then
        rm -f "$target" 2>/dev/null || true
    else
        mkdir -p "$(dirname "$target")" 2>/dev/null
        # Domain validation (aegis-allowlist.js) never rejects a literal `"`
        # or `\` — those are fine in a squid dstdomain ACL but NOT inside a
        # double-quoted YAML scalar, where an unescaped one breaks the whole
        # file. compose() loads this file on EVERY compose() call once it
        # exists, so a broken write here fails 'aegis up/down/stop/status'
        # fleet-wide, not just this one pair — escape first, write to a temp
        # file in the same directory and rename into place (atomic: a crash
        # mid-write leaves the old file intact, not a half-written one that
        # would cause that exact fleet-wide breakage).
        local tmp="${target}.tmp.$$"
        {
            printf '%s\n' \
                '# Generated by aegis allow add/remove/reload — do not edit, do not commit.' \
                '# One entry per external-domain pair: its own connection string resolves' \
                '# here to the container loopback, where that pair'"'"'s auto-tunnel listens.' \
                'services:' \
                '  dev:' \
                '    extra_hosts:'
            local _d _esc
            for _d in "${domains[@]}"; do
                _esc="${_d//\\/\\\\}"
                _esc="${_esc//\"/\\\"}"
                printf '      - "%s:127.0.0.1"\n' "$_esc"
            done
        } >"$tmp" && mv -f "$tmp" "$target" || {
            rm -f "$tmp" 2>/dev/null
            err "WARNING: could not write ${target} — external pair domains will not resolve inside Aegis until this is retried."
            return 1
        }
    fi
    [[ -f "$target" ]] && after="$(cat "$target" 2>/dev/null || true)"
    [[ "$before" != "$after" ]]
}

# Shared by add/remove/reload: regenerate the extra_hosts override, and only
# if that actually changed something AND a dev container is running, recreate
# it so Docker's daemon re-applies the new DNS mapping — nothing inside a
# running container can rewrite its own /etc/hosts (see
# odd/tasks/egress-persistent-pairs.md). This is the one action in this whole
# feature that can interrupt an open session; the user accepted that cost
# explicitly for being the sole user of their own Aegis instance. It is NEVER
# silent: told before it happens, told again if it fails.
_allow_apply_extra_hosts() {
    cmd_allow_regenerate_extra_hosts || return 0
    is_up || return 0
    log "recreando el contenedor de Aegis para que la nueva regla de dominio resuelva adentro — esto corta tu sesión activa (reabrila al terminar; tus archivos no se pierden, es el mismo volumen)."
    local recreate_rc=0
    pg_watch_start services _pg_compose_counts dev
    compose up -d --wait --no-build dev >"${BUILD_LOG_DIR%/}/extra-hosts-$(date -u +%Y%m%dT%H%M%SZ).log" 2>&1 || recreate_rc=$?
    pg_watch_stop
    if [[ "$recreate_rc" -eq 0 ]]; then
        log "contenedor recreado."
    else
        err "WARNING: no se pudo recrear el contenedor — el dominio no va a resolver hasta 'aegis up'."
    fi
}

cmd_allow_regenerate() {
    if [[ -f "$GEN_ALLOWLIST_SH" ]]; then
        if bash "$GEN_ALLOWLIST_SH" >>"${BUILD_LOG_DIR%/}/allowlist-$(date -u +%Y%m%dT%H%M%SZ).log" 2>&1; then
            log "allowlist regenerated (own entries: $(node "$ALLOWLIST_JS" valid "$AEGIS_ALLOWLIST_CUSTOM_FILE" 2>/dev/null | grep -c . || true))"
        else
            err "the allowlist could not be regenerated — see ${BUILD_LOG_DIR%/}/allowlist-*.log"
            return 1
        fi
    fi
    proxy_reload
}

# Applies whatever is on disk right now (regenerate + reload) without touching
# the entries: the way back when a reload failed, or after editing by hand.
cmd_allow_reload() {
    cmd_allow_need_node || return 1
    cmd_allow_regenerate
    _allow_apply_extra_hosts
}

# `aegis allow denied` — what squid actually blocked, straight from its own
# access log, so the answer is the proxy's decision and not a guess against the
# file. Two facts about reading that log, both verified against the real
# container: it is -rw-r----- owned by the proxy uid, and the proxy drops every
# capability, so root has no CAP_DAC_OVERRIDE to bypass it — reading it means
# `docker exec -u <proxy-uid>`. Parsing is awk over squid's own columns, no
# node and no jq.
# `aegis allow add|remove|test` each take exactly ONE value. Extra values are
# refused NAMING what arrived, because there is nothing else the tool can do:
# when the shell expands a metacharacter, the tool never sees it.
#
# Measured on this host (2026-10-01): `bash.exe -c 'printf ...' _ *` started from
# PowerShell receives LICENSE NOTICE README.md config docs odd scripts templates —
# Git for Windows' MSYS runtime globs the command line ITSELF, before argv exists,
# so `aegis allow add *` arrives here as that list of names, and quoting in
# PowerShell cannot help (PowerShell strips the quotes before cmd.exe sees them).
# See docs/11-aegis-cli.md, section 3.
allow_one_value() {
    local what="$1" count="$2" received="$3"
    if [[ "$count" -le 1 ]]; then
        return 0
    fi
    err "expected one $what, got $count: $received"
    err "if you typed a wildcard (*), the shell expanded it into those names before aegis ran —"
    err "quoting in PowerShell cannot stop that (it strips the quotes before cmd.exe sees them)."
    err "Pass one concrete $what; in Git Bash a single-quoted '*' reaches the validator instead."
    exit 2
}

cmd_allow_denied() {
    local lines=3000
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --last) [[ -n "${2:-}" ]] || { err "--last needs a number of log lines"; exit 2; }; lines="$2"; shift 2 ;;
            *) err "unknown option for 'aegis allow denied': $1"; exit 2 ;;
        esac
    done
    [[ "$lines" =~ ^[1-9][0-9]*$ ]] || { err "--last must be a positive integer number of log lines"; exit 2; }

    if ! command -v docker >/dev/null 2>&1; then
        err "docker is not available here: this reads the proxy's own log."
        return 1
    fi
    local running
    running="$(docker inspect -f '{{.State.Running}}' "$PROXY_CONTAINER" 2>/dev/null || true)"
    if [[ "$running" != "true" ]]; then
        err "the egress proxy is not running: there is no log to read yet."
        return 1
    fi

    # The log's owner is the uid squid drops to (cache_effective_user "proxy");
    # asking instead of assuming survives an image that changes it.
    local owner_uid
    owner_uid="$(docker exec "$PROXY_CONTAINER" sh -c 'stat -c %u /var/log/squid/access.log' 2>/dev/null || true)"
    [[ "$owner_uid" =~ ^[0-9]+$ ]] || owner_uid=13

    local raw
    raw="$(MSYS_NO_PATHCONV=1 docker exec -u "$owner_uid" "$PROXY_CONTAINER" \
        sh -c 'tail -n "$1" /var/log/squid/access.log' sh "$lines" 2>/dev/null || true)"
    if [[ -z "$raw" ]]; then
        err "could not read the proxy's access log (it lives on a tmpfs, so a freshly started proxy has nothing yet)."
        return 1
    fi

    # Columns: 1=epoch.ms 2=elapsed 3=client 4=result/status 5=bytes 6=method
    # 7=destination — an absolute URL for plain HTTP, host:port after CONNECT.
    local denied
    denied="$(printf '%s\n' "$raw" | awk '$4 ~ /^TCP_DENIED/ { print $7 }' |
        sed -E 's#^[a-zA-Z]+://##; s#/.*$##; s#:[0-9]+$##' |
        grep -v '^-$' | sort | uniq -c | sort -rn)"

    if [[ -z "$denied" ]]; then
        log "nothing was denied in the last $lines log lines. Nothing to add."
        return 0
    fi

    echo
    log "denied by the proxy (last $lines log lines, most frequent first):"
    echo
    local count domain
    while read -r count domain; do
        [[ -n "$domain" ]] || continue
        printf '  %-4s %s\n' "$count" "$domain"
        if [[ "$domain" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            printf '       aegis allow add %s --ip --reason "<por que>"\n\n' "$domain"
        else
            printf '       aegis allow add %s --reason "<por que>"\n' "$domain"
            printf '       (a leading dot — .%s — only if you also need its subdomains)\n\n' "$domain"
        fi
    done <<<"$denied"
    log "nothing is added by this command: it prints, you decide."
}

# `aegis allow test <url>` — answers "would the proxy let this through?" in two
# steps that answer different questions. First the file squid loads: a plain
# entry matches the exact host while a leading-dot entry matches the host and
# its subdomains, so this mirrors that rule instead of a naive substring test.
# Then, if the proxy is running, a real probe through it — made INSIDE the proxy
# container with bash's /dev/tcp, because that image ships neither curl nor nc —
# and squid's own answer settles it: 403 is a denial, anything else means the
# ACL let it through.
cmd_allow_test() {
    allow_one_value "url" "$#" "$*"
    local url="${1:-}"
    if [[ -z "$url" ]]; then
        err "usage: aegis allow test <url>   (e.g. aegis allow test https://registry.npmjs.org/)"
        exit 2
    fi

    local scheme host
    if [[ "$url" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]]; then
        scheme="${url%%://*}"
        host="${url#*://}"
    else
        scheme="https"
        host="$url"
        log "no scheme given: testing it as https://$url"
    fi
    host="${host%%/*}"   # path
    host="${host%%\?*}"  # query
    host="${host##*@}"   # userinfo
    local port="${host##*:}"
    if [[ "$port" == "$host" ]]; then
        case "$scheme" in
            https) port=443 ;;
            http)  port=80 ;;
            ssh)   port=22 ;;
            *)     port=443 ;;
        esac
    else
        host="${host%:*}"
    fi
    host="${host,,}"
    host="$(_allow_resolve_host_alias "$host")"

    echo
    log "host: $host   port: $port   scheme: $scheme"
    echo

    # `hit` is reused below by the T40.3 window fallback: a window only opens
    # this port for hosts ALREADY in the loaded list (gate = allowed_https_dst).
    local hit=""
    if [[ -f "$AEGIS_ALLOWLIST_FILE" ]]; then
        hit="$(awk -v h="$host" '
            !/^[ \t]*#/ && NF {
                e = $1
                if (e == h) { print e; exit }
                if (substr(e, 1, 1) == ".") {
                    bare = substr(e, 2)
                    if (h == bare) { print e; exit }
                    if (length(h) > length(bare) && substr(h, length(h) - length(bare)) == "." bare) { print e; exit }
                }
            }' "$AEGIS_ALLOWLIST_FILE")"
        if [[ -n "$hit" ]]; then
            local origin="" origins="${AEGIS_ALLOWLIST_FILE%.txt}.origins.tsv"
            [[ -f "$origins" ]] && origin="$(awk -F'\t' -v d="$hit" '$1 == d { print $2; exit }' "$origins")"
            log "the loaded allowlist: MATCHES ${hit}${origin:+ (origin: $origin)}"
        else
            log "the loaded allowlist: does NOT match — the proxy would deny it (403)."
            log "add it with: aegis allow add $host --reason \"<por que>\""
        fi
    else
        err "the effective allowlist has not been generated yet: run 'aegis up' once."
    fi

    # T40: a port outside the fixed rules lives ONLY as a (host,port) pair, so
    # for those the allowlist answer above is not the whole story. Report the
    # pair against the generated ports file BEFORE probing — same two-step
    # logic: what the file says first, the proxy's own answer after.
    local fixed_port=""
    case "$port" in
        443|22|2022) fixed_port="yes" ;;
        80)          [[ "$scheme" == "http" ]] && fixed_port="yes" ;;
    esac
    if [[ -z "$fixed_port" ]]; then
        local pair_hit=""
        if [[ -f "$AEGIS_ALLOWLIST_PORTS_FILE" ]]; then
            pair_hit="$(awk -v h="$host" -v p="$port" '
                $1 == "acl" && $2 ~ /^aegis_dst_/ && ($3 == "dst" || $3 == "dstdomain") { acl[$2] = $3 " " $4; next }
                $1 == "http_access" && $2 == "allow" && $3 == "CONNECT" && $5 == "aegis_port_" p && ($4 in acl) {
                    split(acl[$4], v, " ")
                    if (v[1] == "dst" && v[2] == h) { print h ":" p " (dst)"; exit }
                    if (v[1] == "dstdomain") {
                        e = v[2]
                        if (e == h) { print h ":" p " (dstdomain)"; exit }
                        if (substr(e, 1, 1) == ".") {
                            bare = substr(e, 2)
                            if (h == bare || (length(h) > length(bare) && substr(h, length(h) - length(bare)) == "." bare)) { print h ":" p " via dstdomain " e; exit }
                        }
                    }
                }' "$AEGIS_ALLOWLIST_PORTS_FILE")"
        fi
        if [[ -n "$pair_hit" ]]; then
            log "the ports file (T40): MATCHES $pair_hit — CONNECT to that exact pair is open."
        else
            # T40.3: the same file can open this port for EVERY host in the
            # loaded list through a window (the gate is allowed_https_dst,
            # never "any"), so the pair being absent says nothing on its own.
            # Both sources are the ones this command already reads: the rule
            # lives in the generated ports file, the expiry in the store's
            # `windows` (a window the store no longer sees as live is a stale
            # generate — said here instead of hidden).
            local window_open=""
            if [[ -n "$hit" ]] && [[ -f "$AEGIS_ALLOWLIST_PORTS_FILE" ]] &&
                grep -q "^acl aegis_gport_${port} port ${port}\$" "$AEGIS_ALLOWLIST_PORTS_FILE"; then
                window_open="abierto por ventana :${port}"
                if [[ -f "$AEGIS_ALLOWLIST_CUSTOM_FILE" ]] && command -v node >/dev/null 2>&1 && [[ -f "$ALLOWLIST_JS" ]]; then
                    local wline wexp wto
                    wline="$(node "$ALLOWLIST_JS" windows "$AEGIS_ALLOWLIST_CUSTOM_FILE" 2>/dev/null |
                        awk -F'\t' -v p="$port" '$1 == p { print; exit }')"
                    wexp="$(printf '%s\n' "$wline" | awk -F'\t' '{ print $2 }')"
                    # T40.4 (D6): the store's third column is the window's seed,
                    # and the promise it makes is about ONE destination. Say
                    # "tunnel at session start" only when the host being tested
                    # IS that seed — the same port opened for another listed host
                    # is still the plain window answer, because no tunnel dials it.
                    wto="$(printf '%s\n' "$wline" | awk -F'\t' '{ print $3 }')"
                    if [[ -n "$wto" && "${wto,,}" == "${host,,}" ]]; then
                        window_open="abierto por ventana (tunel automatico activo al abrir sesion)"
                    fi
                    if [[ -n "$wexp" ]]; then
                        window_open="${window_open} (vence ${wexp})"
                    else
                        window_open="${window_open} (vencida: el archivo generado la sigue cargando hasta el próximo regenerate)"
                    fi
                fi
            fi
            if [[ -n "$window_open" ]]; then
                log "the ports file (T40.3): $host:$port $window_open — entra por la ventana global, no por un par declarado."
            else
                local suggest="aegis allow add --port $port --for 2h"
                local ip_flag=""
                [[ "$host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && ip_flag=" --ip"
                log "the ports file (T40): NO rule for $host:$port — the proxy would deny this pair (403)."
                log "open the port with a window: $suggest — habilita $port para TODOS los hosts de la allowlist; $host debe estar en la lista (si falta: aegis allow add $host$ip_flag)"
            fi
        fi
    fi

    local running
    running="$(docker inspect -f '{{.State.Running}}' "$PROXY_CONTAINER" 2>/dev/null || true)"
    if [[ "$running" != "true" ]]; then
        log "the egress proxy is not running, so nothing was actually tried through it."
        return 0
    fi

    local probe_line
    if [[ "$scheme" == "https" ]]; then
        probe_line="CONNECT $host:$port HTTP/1.0"
    else
        probe_line="GET $url HTTP/1.0"
    fi

    # Which address to probe: NOT 127.0.0.1. The probe runs inside the proxy
    # container, and a connection to its own loopback arrives with 127.0.0.1 as
    # the client, which squid's `http_access deny !localnet` rejects before the
    # allowlist is ever consulted — every domain would come back 403 and the
    # probe would be worse than useless. Connecting to the proxy's own devnet
    # address (read from the host, where the networks are knowable) makes the
    # client address a devnet one, so the same ACL rules a real client hits are
    # the ones being tested.
    local proxy_ip
    proxy_ip="$(docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}={{$v.IPAddress}} {{end}}' "$PROXY_CONTAINER" 2>/dev/null |
        tr ' ' '\n' | awk -F= '/devnet/ && $2 != "" { print $2; exit }')"
    if [[ -z "$proxy_ip" ]]; then
        proxy_ip="$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' "$PROXY_CONTAINER" 2>/dev/null | awk '{print $1}')"
    fi
    if [[ -z "$proxy_ip" ]]; then
        log "could not work out the proxy's own devnet address, so nothing was actually tried through it."
        return 0
    fi

    local script
    script="$(cat <<EOF
exec 3<>/dev/tcp/${proxy_ip}/3128 || exit 9
printf '${probe_line}\\r\\nHost: ${host}\\r\\n\\r\\n' >&3
read -t 8 -r line <&3 || exit 8
printf '%s' "\$line"
EOF
)"

    local answer
    answer="$(docker_exec_path "$PROXY_CONTAINER" bash -c "$script" 2>/dev/null || true)"
    if [[ -z "$answer" ]]; then
        err "the proxy did not answer the probe (no status line; it may still be starting)."
        return 1
    fi

    if [[ "$answer" == *" 403"* ]]; then
        log "the proxy's own answer: DENIED — $answer"
        log "add it with: aegis allow add $host --reason \"<por que>\""
    elif [[ "$answer" == *" 200"* ]]; then
        log "the proxy's own answer: ALLOWED — $answer"
    else
        log "the proxy's own answer: $answer"
        log "(not a denial: the ACL let it through, and whatever failed happened past the proxy)"
    fi
}

# egress-persistent-pairs (S2): `host` is the one reserved alias, meaning "the
# machine Aegis itself runs on" — host.docker.internal under the hood. It
# exists ONLY so the user never has to type or think about that Docker-internal
# name: the allow/remove/test surface accepts the short word, but everything
# that reaches squid or the tunnel (the ACL, _tunnel_rule_covers, the auto-
# tunnel's real dial target) uses the real name, because that is what actually
# travels in a CONNECT request — "host" itself is never a routable destination,
# it only resolves (via the static `extra_hosts` in docker-compose.yml) to this
# container's own loopback, where the pair's auto-tunnel listens.
_allow_resolve_host_alias() {
    # Writes the resolved name to stdout (the caller captures it with $(...)),
    # so the substitution note goes to stderr directly — never through log(),
    # which echoes to stdout and would corrupt the captured value.
    if [[ "${1,,}" == "host" ]]; then
        echo "aegis: 'host' es el alias reservado para la máquina donde corre Aegis -> host.docker.internal" >&2
        printf 'host.docker.internal'
        return
    fi
    printf '%s' "$1"
}

# T40.4 (D5): can a session actually reach this host? The window's own gate is
# the LOADED allowlist (allowed_https_dst), so that file is the answer; the
# custom store is consulted as well, because a host added moments ago whose
# regenerate failed would otherwise draw a false warning. Exact host or a
# leading-dot entry covering it — the match `cmd_allow_test` mirrors.
_allow_has_host() {
    local host="$1"
    if [[ -f "$AEGIS_ALLOWLIST_FILE" ]] && awk -v h="$host" '
        !/^[ \t]*#/ && NF {
            e = $1
            if (e == h) { found = 1; exit }
            if (substr(e, 1, 1) == ".") {
                bare = substr(e, 2)
                if (h == bare) { found = 1; exit }
                if (length(h) > length(bare) && substr(h, length(h) - length(bare)) == "." bare) { found = 1; exit }
            }
        }
        END { exit found ? 0 : 1 }' "$AEGIS_ALLOWLIST_FILE"; then
        return 0
    fi
    [[ -f "$AEGIS_ALLOWLIST_CUSTOM_FILE" ]] || return 1
    node "$ALLOWLIST_JS" valid "$AEGIS_ALLOWLIST_CUSTOM_FILE" 2>/dev/null | grep -Fxq "$host"
}

cmd_allow_add() {
    local domain="" reason="" for_duration="" allow_ip="no" port="" to=""
    local seen=0 received=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --reason) [[ -n "${2:-}" ]] || { err "--reason needs a value"; exit 2; }; reason="$2"; shift 2 ;;
            --for)    [[ -n "${2:-}" ]] || { err "--for needs a value: 30m, 2h, 7d"; exit 2; }; for_duration="$2"; shift 2 ;;
            --ip)     allow_ip="yes"; shift ;;
            --port)   [[ -n "${2:-}" ]] || { err "--port needs a number: 1..65535"; exit 2; }; port="$2"; shift 2 ;;
            # T40.4: the window's tunnel seed. An empty value is the same mistake
            # as an absent one, and --to without a window is refused below.
            --to)     [[ -n "${2:-}" ]] || { err "--to needs the host the auto-tunnel will dial (a hostname or IPv4)"; exit 2; }; to="$2"; shift 2 ;;
            -*)       err "unknown option for 'aegis allow add': $1"; exit 2 ;;
            *)        seen=$((seen + 1)); received="${received}${received:+ }$1"
                      [[ -n "$domain" ]] || domain="$1"
                      shift ;;
        esac
    done
    allow_one_value "domain" "$seen" "$received"
    [[ -n "$domain" ]] && domain="$(_allow_resolve_host_alias "$domain")"
    # T40.4 (D1): --to belongs to a port window and to nothing else. Without
    # --port there is no window to bind the tunnel to, and the pair shape the
    # flag might have meant is no longer creatable — so refuse, never guess.
    if [[ -n "$to" && -z "$port" ]]; then
        err "--to solo tiene sentido en una ventana de puerto: aegis allow add --port <n> --for 30m|2h|7d --to $to"
        err "sin --port no hay ventana que tunelizar (un destino pelado se agrega con: aegis allow add $to)"
        exit 2
    fi
    # The same shape the store repeats on its side (two-line rule, like --port):
    # one dialable host, nothing that would survive into the exec -d line.
    if [[ -n "$to" ]] && [[ ! "$to" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$ ]]; then
        err "--to needs a bare hostname or IPv4 literal (no wildcard, no space, no port, no path, no IPv6): $to"
        exit 2
    fi
    # T40.3: the host-less shape is a PORT WINDOW — --port says so, and only
    # --port says so. Without either it stays the old usage error. --for is
    # REQUIRED here (the store repeats it): a global window that never expires
    # is exactly what the perimeter cannot carry.
    if [[ -z "$domain" && -z "$port" ]]; then
        err "usage: aegis allow add <domain> [--reason \"...\"] [--for 30m|2h|7d] [--ip]"
        err "       aegis allow add <domain> --port <n> [--reason \"...\"]   (permanent pair: CONNECT to that host:port only)"
        err "       aegis allow add --port <n> --for 30m|2h|7d [--to <host>] [--reason \"...\"]   (port window; --to seeds its auto-tunnel)"
        exit 2
    fi
    if [[ -z "$domain" && -z "$for_duration" ]]; then
        err "a port window without --for is refused: global windows are temporary by design (--for 30m|2h|7d)"
        exit 2
    fi
    # T40 first line of the port check (the store repeats it, like the domain).
    # The fixed rules already open these ports: re-asking for one would only
    # duplicate a grant under a second mechanism, so it is refused.
    if [[ -n "$port" ]]; then
        if [[ ! "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
            err "--port takes a number 1..65535, not \"$port\""
            exit 2
        fi
        case "$port" in
            443|80|22|2022)
                err "port $port is already covered by the fixed rules (443, 80, 22, 2022) — add the host without --port"
                exit 2 ;;
        esac
    fi
    # The pair shape `add <domain> --port <n>` (T40) was RETRACTED on 2026-10-13
    # and RESTORED on 2026-10-24 (egress-persistent-pairs): a domain+port pair
    # is a PERMANENT, SCOPED grant — CONNECT to that exact (host, port), never
    # the whole allowlist like a host-less window. The engine (aegis-allowlist.js)
    # never actually dropped pair support; only this CLI guard blocked creation.
    if [[ -n "$domain" && -n "$port" ]]; then
        if [[ -n "$to" ]]; then
            err "--to no aplica a un par con dominio: $domain ya ES el destino del túnel."
            err "       aegis allow add $domain --port $port"
            exit 2
        fi
        if [[ -n "$for_duration" ]]; then
            err "un par con dominio no vence: ya está acotado a $domain:$port, a diferencia de una ventana global."
            err "       aegis allow add $domain --port $port"
            exit 2
        fi
    fi
    cmd_allow_need_node || return 1

    # T40.3 warn (informational, not a confirmation): the point of a window is
    # breadth, so say out loud how broad it is before writing it. T40.4 adds the
    # seed: the port is still open for every listed host, and one of them now
    # also gets a tunnel on every session start.
    if [[ -z "$domain" ]]; then
        if [[ -n "$to" ]]; then
            log "ventana de puerto :$port con destino $to — el puerto se habilita para TODOS los hosts de la allowlist durante $for_duration, y cada sesión abrirá un túnel localhost:$port -> $to:$port"
        else
            log "ventana de puerto :$port — habilita ese puerto para TODOS los hosts de la allowlist durante $for_duration; para alcanzar un destino puntual desde clientes sin proxy: aegis shell <ruta> --tunnel <host>:$port (o agrega --to <host> a esta ventana)"
        fi
    elif [[ -n "$port" ]]; then
        log "par permanente $domain:$port — CONNECT solo a ese destino (no ensancha el resto de la allowlist); cada sesión abrirá el túnel local."
    fi
    # T40.4 (D5): the gate of a window is the loaded allowlist (allowed_https_dst),
    # so a --to that is not in it means the auto-tunnel's own CONNECT is the one
    # draw that earns a 403. Said as a warning with the command that would fix
    # it — this NEVER auto-adds: widening the destination list is its own act.
    if [[ -n "$to" ]] && ! _allow_has_host "$to"; then
        local to_ip_flag=""
        [[ "$to" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && to_ip_flag=" --ip"
        err "WARNING: $to no está en la allowlist cargada — la ventana abre el puerto :$port, pero el túnel automático hacia $to irá a 403."
        err "si de verdad quieres salir hacia ahí, decláralo: aegis allow add $to$to_ip_flag (esto no lo agrega por ti)."
    fi

    if [[ -f "$AEGIS_ALLOWLIST_CUSTOM_FILE" ]]; then
        local already want="$domain"
        [[ -n "$port" ]] && want="$domain:$port"
        # detail labels a window's first column `:<port> [window]` — match it.
        [[ -z "$domain" ]] && want="$domain:$port [window]"
        already="$(node "$ALLOWLIST_JS" detail "$AEGIS_ALLOWLIST_CUSTOM_FILE" 2>/dev/null |
            awk -F'\t' -v d="$want" '$1 == d { print $2 }')"
        [[ -n "$already" ]] && log "it is already there (${already}): this REPLACES it."
    fi

    if ! node "$ALLOWLIST_JS" add "$AEGIS_ALLOWLIST_CUSTOM_FILE" "$domain" "$reason" "$for_duration" "$allow_ip" "$port" "$to"; then
        err "nothing was written."
        return 1
    fi
    cmd_allow_regenerate
    # egress-persistent-pairs (T4): a NEW real-domain pair needs its own
    # extra_hosts entry to resolve inside Aegis, and that can only take effect
    # on a running session by recreating the container (see
    # _allow_apply_extra_hosts) — everything else about a pair's auto-tunnel
    # (T40.2, restored 2026-10-24) hooks into the session-start path in
    # _exec_in_container instead, not here. A window never had a hint either
    # (T40.3 decision 7: no host to tunnel to).
    if [[ -n "$domain" && -n "$port" ]]; then
        _allow_apply_extra_hosts
    fi
}

cmd_allow_remove() {
    local domain="" port=""
    local seen=0 received=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --port) [[ -n "${2:-}" ]] || { err "--port needs a number: 1..65535"; exit 2; }; port="$2"; shift 2 ;;
            -*)     err "unknown option for 'aegis allow remove': $1"; exit 2 ;;
            *)      seen=$((seen + 1)); received="${received}${received:+ }$1"
                    [[ -n "$domain" ]] || domain="$1"
                    shift ;;
        esac
    done
    allow_one_value "domain" "$seen" "$received"
    [[ -n "$domain" ]] && domain="$(_allow_resolve_host_alias "$domain")"
    if [[ -z "$domain" && -z "$port" ]]; then
        err "usage: aegis allow remove <domain>"
        err "       aegis allow remove --port <n>   (T40.3: take that port window back out)"
        exit 2
    fi
    # The two shapes are deliberately exclusive: <domain> is the T27/T40 "all
    # of this host" (pairs included) and --port alone is the T40.3 window.
    # Naming them together could only guess which one was meant.
    if [[ -n "$domain" && -n "$port" ]]; then
        err "aegis allow remove: <domain> already takes out every entry of that host (its pairs too)"
        err "use 'remove <domain>' for a host or 'remove --port <n>' for a port window, not both"
        exit 2
    fi
    cmd_allow_need_node || return 1
    if [[ ! -f "$AEGIS_ALLOWLIST_CUSTOM_FILE" ]]; then
        err "there are no entries of your own yet ($(tildify "$AEGIS_ALLOWLIST_CUSTOM_FILE") does not exist)."
        return 1
    fi
    if [[ -z "$domain" ]]; then
        # T40.3: the store matches port + window:true only — pairs and plain
        # entries of any host survive. No session hint: a tunnel is only ever
        # started explicitly by --tunnel at session start (the auto-tunnels
        # were retracted 2026-10-13) and a window has no host for one
        # (decision 7), so the reload above is the whole story.
        if ! node "$ALLOWLIST_JS" remove "$AEGIS_ALLOWLIST_CUSTOM_FILE" "" "$port"; then
            return 1
        fi
        cmd_allow_regenerate
        return 0
    fi
    # T40.2: is the domain also carrying PAIR entries? The store's `remove`
    # takes the whole domain (T27 semantics when no port is given), so this is
    # read BEFORE the deletion — afterwards there is nothing to ask.
    local had_port=0
    if node "$ALLOWLIST_JS" detail "$AEGIS_ALLOWLIST_CUSTOM_FILE" 2>/dev/null | awk -F'\t' -v d="$domain" '
        { p = substr($1, length(d) + 2)
          if (substr($1, 1, length(d) + 1) == d ":" && p ~ /^[0-9]+$/) { found = 1; exit } }
        END { exit found ? 0 : 1 }'; then
        had_port=1
    fi
    if ! node "$ALLOWLIST_JS" remove "$AEGIS_ALLOWLIST_CUSTOM_FILE" "$domain"; then
        return 1
    fi
    cmd_allow_regenerate
    # T40.2 hint, remove-shaped (the converse of add's): open sessions still
    # hold the tunnels they started with — a rule removed here does not reach
    # them, and the proxy will start refusing only new connections.
    if [[ "$had_port" == "1" ]]; then
        is_up && log "sesiones abiertas no ven este cambio — reavísalas: los túneles de las reglas removidas viven hasta que se cierren."
        # egress-persistent-pairs (T4): drop the stale extra_hosts entry too,
        # if this domain had one — see _allow_apply_extra_hosts.
        _allow_apply_extra_hosts
    fi
}

cmd_allow_list() {
    local origins="${AEGIS_ALLOWLIST_FILE%.txt}.origins.tsv"

    if [[ ! -f "$AEGIS_ALLOWLIST_FILE" ]]; then
        err "the effective allowlist has not been generated yet: run 'aegis up' once."
        return 1
    fi
    if [[ ! -f "$origins" ]]; then
        err "the origins sidecar is missing ($(tildify "$origins")): run 'aegis up' once with this version."
        return 1
    fi

    log "effective list:  $(tildify "$AEGIS_ALLOWLIST_FILE")"
    log "your own entries: $(tildify "$AEGIS_ALLOWLIST_CUSTOM_FILE")"
    echo

    local own fixed
    own="$(awk -F'\t' '$2 == "own" { print $1 }' "$origins")"
    fixed="$(awk -F'\t' '$2 != "own" { print $1 "\t" $2 }' "$origins")"

    # T40.3: the sidecar names a window `:<port>` (origin only). The store's
    # `windows` verb carries the expiry, computed once for the whole list.
    local ownwindows=""
    if [[ -f "$AEGIS_ALLOWLIST_CUSTOM_FILE" ]] && command -v node >/dev/null 2>&1 && [[ -f "$ALLOWLIST_JS" ]]; then
        ownwindows="$(node "$ALLOWLIST_JS" windows "$AEGIS_ALLOWLIST_CUSTOM_FILE" 2>/dev/null || true)"
    fi

    if [[ -n "$own" ]]; then
        log "yours:"
        while IFS= read -r d; do
            [[ -n "$d" ]] || continue
            if [[ "$d" == :* ]]; then
                local wexp="" wto=""
                if [[ -n "$ownwindows" ]]; then
                    wexp="$(printf '%s\n' "$ownwindows" | awk -F'\t' -v p="${d#:}" '$1 == p { print $2; exit }')"
                    wto="$(printf '%s\n' "$ownwindows" | awk -F'\t' -v p="${d#:}" '$1 == p && NF >= 3 { print $3; exit }')"
                fi
                # Empty wexp here means the generated sidecar still shows a window
                # the store no longer considers live: it dies at the next
                # regenerate (honest limit of in-place generation).
                # T40.4 (D6): a window carrying a seed says what it now opens —
                # the tunnel every session will start at its localhost port.
                if [[ -n "$wto" ]]; then
                    printf '  %-36s %s\n' "$d [window]" "tunel -> $wto vence ${wexp:-<vencida: muere al próximo regenerate>}"
                else
                    printf '  %-36s %s\n' "$d" "ventana hasta ${wexp:-<vencida: muere al próximo regenerate>}"
                fi
                continue
            fi
            local extra=""
            if [[ -f "$AEGIS_ALLOWLIST_CUSTOM_FILE" ]] && command -v node >/dev/null 2>&1 && [[ -f "$ALLOWLIST_JS" ]]; then
                extra="$(node "$ALLOWLIST_JS" detail "$AEGIS_ALLOWLIST_CUSTOM_FILE" 2>/dev/null |
                    awk -F'\t' -v d="$d" '$1 == d { printf "%s%s%s%s", $2, ($3 ? " — " $3 : ""), ($4 ? " (" $4 ")" : ""), ($5 ? " expires " $5 : "") }')"
            fi
            printf '  %-36s %s\n' "$d" "${extra:-active}"
        done <<<"$own"
        echo
    else
        log "yours: (none — they go in $(tildify "$AEGIS_ALLOWLIST_CUSTOM_FILE"))"
        echo
    fi

    log "from the template (fixed, and by language when that language is in the manifest):"
    if [[ -n "$fixed" ]]; then
        printf '%s\n' "$fixed" | awk -F'\t' '{ printf "  %-36s %s\n", $1, $2 }'
    fi
    echo
    log "total: $(printf '%s\n' "$fixed" | grep -c . || true) from the template + $(printf '%s\n' "$own" | grep -c . || true) yours"
}



# ---------------------------------------------------------------------------
# aegis account — the licence, and nothing else.
#
# This group used to administer git/Azure DevOps credentials: a name→org/host map
# in ~/.aegis/accounts.json whose tokens lived in the Windows Credential Manager,
# exported to a session as AEGIS_TOKEN_<NAME>. That whole path is gone (see
# docs/11-aegis-cli.md §8): GitHub, Azure DevOps and the Azure CLI authenticate
# themselves through their own browser/device flow, a session's SSH key comes from
# the vault (--secret) and a variable or token from --env. What a person typing
# `aegis account` is actually asking is what THIS machine is entitled to, and that
# is the licence report — the same code `aegis license` reaches by its own name.
# ---------------------------------------------------------------------------
cmd_account() {
    # The license messages below name the spelling the user typed. `license`
    # is the primary spelling (client-redesign L4); `account` stays as an
    # alias, and the dispatcher sets _LICENSE_CMD before calling this.
    _LICENSE_CMD="${_LICENSE_CMD:-license}"
    local action="${1:-license}"
    [[ $# -gt 0 ]] && shift || true
    case "$action" in
        add|list|rotate|remove|show|_token)
            err "'aegis account $action' no longer exists: the launcher stopped managing git credentials."
            err "  identity for github/azure-devops/azure: their own flow on this machine (GCM, gh auth login, az login)"
            err "  an SSH key for one session:  aegis shell --secret <name>  (aegis secret list)"
            err "  a variable or token:         aegis shell --env auto | --env <name>"
            err "  what this machine is licensed for:  aegis account"
            exit 2
            ;;
        license) cmd_license "$@" ;;
        activate|renew|heartbeat|retire) cmd_license "$action" "$@" ;;
        # `aegis account --file <path>`: an option, not a verb — the default
        # (show) with it, the same as `aegis license --file <path>`.
        -*) cmd_license "$action" "$@" ;;
        *)
            err "unknown 'aegis account' subcommand: ${action:-<none>}"
            err "usage: aegis ${_LICENSE_CMD} [license|activate|renew|heartbeat|retire] — the licence, nothing else"
            exit 2
            ;;
    esac
}

# T28 activation: the one ONLINE step in the licence flow. This shell only
# locates the helper and passes non-secret arguments; aegis-activate.js talks to
# the service and writes BOTH the license file and the device credential itself,
# so the credential never exists in this process's argv, variables, or output
# (SEC-24: no secret is ever logged).
cmd_license_activate() {
    local license_id="${1:-}" url=""
    [[ -n "$license_id" ]] && shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --url) url="${2:-}"; [[ -z "$url" ]] && { err "usage: aegis ${_LICENSE_CMD} activate <license-id> [--url <url>]"; exit 2; }; shift 2 ;;
            *) err "unknown option: $1"; exit 2 ;;
        esac
    done
    if [[ -z "$license_id" ]]; then
        err "usage: aegis ${_LICENSE_CMD} activate <license-id> [--url <url>]"
        exit 2
    fi
    require_activate_helper
    # Paths travel as environment VARIABLES, not argv: Git Bash/MSYS silently
    # rewrites an argv value that looks like a standalone POSIX absolute path,
    # and environment variable values are not subject to that conversion (the
    # same reason AEGIS_GIT_CREDENTIAL_HELPER_PATH is read from the environment).
    # They are converted to native form because Node on Windows does not
    # understand `/c/...`, and because it is Node -- not bash -- that writes the
    # files. AEGIS_LICENSE_API_URL is forwarded explicitly for the same reason
    # the two file paths are: without this line a value set in the user's shell
    # never reaches the helper and the production default is used silently. It is
    # a URL, not a path, so it is NOT run through _to_native_path.
    MSYS_NO_PATHCONV=1 \
    AEGIS_LICENSE_FILE="$(_to_native_path "$AEGIS_LICENSE_FILE")" \
    AEGIS_DEVICE_CREDENTIAL_FILE="$(_to_native_path "$AEGIS_DEVICE_CREDENTIAL_FILE")" \
    AEGIS_LICENSE_API_URL="$AEGIS_LICENSE_API_URL" \
    node "$(_to_native_path "$ACTIVATE_JS")" "$license_id" ${url:+"--url" "$url"}
}

# The three online steps an ALREADY ACTIVATED machine can take share one call:
# renew (re-sign under the key in use today), heartbeat (this machine is alive),
# retire (free the seat). The helper reads the device credential itself and owns
# the network, so the secret never exists in this process's argv, variables or
# output (SEC-24). Paths travel as environment variables in native form for the
# reasons cmd_license_activate documents; the trust list is forwarded because
# `renew` refuses to install a token this machine cannot verify.
_license_api_call() {
    local verb="$1" url="" yes=""
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --url) url="${2:-}"; [[ -z "$url" ]] && { err "usage: aegis ${_LICENSE_CMD} $verb [--url <url>]"; exit 2; }; shift 2 ;;
            --yes) yes="--yes"; shift ;;
            *) err "unknown option: $1"; exit 2 ;;
        esac
    done
    require_license_api_helper
    MSYS_NO_PATHCONV=1 \
    AEGIS_LICENSE_FILE="$(_to_native_path "$AEGIS_LICENSE_FILE")" \
    AEGIS_DEVICE_CREDENTIAL_FILE="$(_to_native_path "$AEGIS_DEVICE_CREDENTIAL_FILE")" \
    AEGIS_LICENSE_KEYS_FILE="$(_to_native_path "$AEGIS_LICENSE_KEYS_FILE")" \
    AEGIS_LICENSE_API_URL="$AEGIS_LICENSE_API_URL" \
    node "$(_to_native_path "$LICENSE_API_JS")" "$verb" ${url:+"--url" "$url"} ${yes:+"$yes"}
}

cmd_license_renew()     { _license_api_call renew "$@"; }
cmd_license_heartbeat() { _license_api_call heartbeat "$@"; }
cmd_license_retire()    { _license_api_call retire "$@"; }

# Runs ONE command that holds a throwaway credential directory, and removes that
# directory on EVERY way out: the normal end, a failure, a Ctrl-C and a SIGTERM.
#
# The EXIT trap is the part that does the work, and the reason this exists: the
# callers used to `rm -rf` the directory after their command, a line a Ctrl-C never
# reaches. Verified on Linux that a non-interactive bash DOES run its EXIT trap for
# the SIGINT a Ctrl-C sends to the whole foreground process group — so a test that
# interrupts has to signal the GROUP, which is what interruptOnceRunning does.
#
# INT and TERM are trapped explicitly anyway, for the shell this cannot be measured
# on: Git Bash/MSYS on Windows, where a console interrupt may not give the EXIT trap
# a turn. On Linux those two handlers are redundant — removing them is caught by no
# test — and they cost nothing: they clean and leave with the conventional code.
#
# The launcher's own single EXIT trap (telemetry's) is deliberately left alone
# rather than widened into the credential business, and an empty directory argument
# means "no credential to clean", which keeps the callers that only sometimes have
# one from duplicating their command line.
_run_with_throwaway_config() {
    local dir="$1"
    shift
    (
        trap '[[ -n "$dir" ]] && rm -rf "$dir"; exit 130' INT
        trap '[[ -n "$dir" ]] && rm -rf "$dir"; exit 143' TERM
        trap '[[ -n "$dir" ]] && rm -rf "$dir"' EXIT
        "$@"
    )
}

# Writes the download token into a throwaway docker config, as the classic `auths` entry.
#
# Deliberately NOT `docker login`: on Windows that command hands the credential to the Credential
# Manager and leaves only a POINTER in the file (`credsStore: docker-credential-wincred`). The
# throwaway cosign container is Linux and that helper is a Windows binary, so the mount would arrive
# carrying a promise nobody there can keep — which is exactly how the first real verify failed:
# "exec: docker-credential-wincred: executable file not found". A config that CARRIES the credential
# travels: docker reads it natively, and so does cosign. It is also the reason the token never needs
# to appear in an argv or an environment variable of a container.
_write_registry_config() {
    local dir="$1" token="$2"
    printf '{"auths":{"%s":{"auth":"%s"}}}' \
        "$AEGIS_IMAGE_REGISTRY" \
        "$(printf 'aegis:%s' "$token" | base64 | tr -d '\n')" > "${dir}/config.json" || return 1
    chmod 600 "${dir}/config.json" || return 1
}

# Asks the licensing helper for a download token and prints it on stdout.
#
# One helper because pull, verify and `aegis up` all obtained it the same way,
# and two drifting copies of a credential path is how one of them quietly stops
# matching the others. The empty-token message is the only wording that differed
# between the callers ("log in" vs "authenticate"), so the verb is an argument
# rather than a second copy of the whole block. Everything on stderr; the token
# is the only thing on stdout, so callers capture just it.
_image_download_token() {
    local token
    require_license_api_helper
    token="$(MSYS_NO_PATHCONV=1 \
        AEGIS_LICENSE_FILE="$(_to_native_path "$AEGIS_LICENSE_FILE")" \
        AEGIS_DEVICE_CREDENTIAL_FILE="$(_to_native_path "$AEGIS_DEVICE_CREDENTIAL_FILE")" \
        AEGIS_LICENSE_API_URL="$AEGIS_LICENSE_API_URL" \
        node "$(_to_native_path "$LICENSE_API_JS")" token)" \
        || { err "could not obtain a download token (the message above says why)"; exit 1; }
    if [[ -z "$token" ]]; then
        err "the service returned an empty token; refusing to $1 with nothing"
        exit 1
    fi
    printf '%s' "$token"
}

# Proves that a locally present image was signed by a run of this project's CI.
#
# <ref> is what cosign is given — normally registry/repo@digest. Resolving the
# digest belongs to the caller (cmd_image_verify owns its "no local digest"
# message), so this helper is only the throwaway credential and the cosign run;
# `aegis up` reuses exactly those two steps. Failure is a non-zero RETURN, not
# an exit, so the caller can phrase its own refusal.
_verify_local_image() {
    local ref="$1" config config_native token rc=0
    command -v docker >/dev/null 2>&1 || { err "docker is required to verify the image"; exit 1; }

    token="$(_image_download_token "authenticate")"
    config="$(mktemp -d)" || { err "mktemp failed"; exit 1; }
    config_native="$(_to_native_path "$config")"
    if ! _write_registry_config "$config" "$token"; then
        token=""
        rm -rf "$config"
        err "could not write the throwaway docker config"
        exit 1
    fi
    token=""

    log "verifying ${ref}"
    # Flags only as the PINNED cosign documents them. A previous attempt added
    # --registry-referrers-mode=legacy here: it exists on `sign` (and in the docs of cosign's `main`),
    # not on this version's `verify`, which answered "unknown flag" and died before reaching the
    # registry. What the lookup actually is came from the registry's own logs (2026-10-07): v3.1.3
    # asks for the tag `sha256-<digest>` — NO `.sig` suffix — and falls back past the referrers API,
    # which answers 404 here. An earlier version of this comment claimed the `.sig` shape: wrong.
    #
    # cosign prints its own human-readable "Verification for ... -- The
    # following checks were performed" summary on STDERR even on SUCCESS (this
    # was the single noisiest block in a friendly `aegis update`/`up` run,
    # bigger than a signed-JSON stdout line ever was) — both streams go to one
    # throwaway file, shown only on failure, where it is genuinely the part
    # that explains what went wrong.
    out="$(mktemp)" || { err "mktemp failed"; exit 1; }
    # The credential directory goes away on every exit: see _run_with_throwaway_config.
    # The credential directory is 0700/0600 by design. The pinned cosign image
    # runs as uid 65532; on a real Linux host that uid cannot read the temp
    # config (Windows bind mounts ignore the mode, which is why the Linux
    # acceptance found this and Windows did not). Run only this throwaway
    # verifier as root: it mounts the read-only config, has no Docker socket,
    # and the token is short-lived and scoped to the registry. The alternative
    # (world-readable config) would leak the token to other local users.
    pg_spin_start "verifying the image signature"
    _run_with_throwaway_config "$config" env MSYS_NO_PATHCONV=1 docker run --rm \
        --user 0:0 \
        --volume "${config_native}:/cosign-config:ro" \
        --env DOCKER_CONFIG=/cosign-config \
        "$AEGIS_COSIGN_IMAGE" verify \
            --certificate-oidc-issuer "$AEGIS_IMAGE_OIDC_ISSUER" \
            --certificate-identity-regexp "$AEGIS_IMAGE_IDENTITY_REGEXP" \
            "${ref}" >"$out" 2>&1 || rc=$?
    pg_spin_stop

    if [[ "$rc" -ne 0 ]]; then
        err "the signature did NOT verify: this image was not signed by a run of"
        err "  identity: ${AEGIS_IMAGE_IDENTITY_REGEXP}"
        err "  issuer:   ${AEGIS_IMAGE_OIDC_ISSUER}"
        err "cosign said:"
        sed 's/^/  /' "$out" >&2
        err "do not run it."
        rm -f "$out"
        return "$rc"
    fi
    rm -f "$out"

    # Who signed it, in words. The certificate names the WORKFLOW RUN, so the identity is a pattern
    # with a URL inside — printing that pattern at a person is noise. When the pattern is the one
    # derived from the repository (the normal case), the repository is the answer they want; when it
    # was set by hand, we say that instead of pretending to know what it means.
    if [[ -z "${AEGIS_IMAGE_IDENTITY_REGEXP_WAS_SET:-}" ]]; then
        log "signature verified — signed by a run of github.com/${AEGIS_IMAGE_REPO}"
    else
        log "signature verified — the certificate identity matches the pattern configured here (${AEGIS_IMAGE_OIDC_ISSUER})"
    fi
}

# Pulls and verifies the `aegis secret edit` editor image with exactly the
# licensed flow the workstation image gets: one download token, a throwaway
# docker config for the pull, then the client-shaped keyless cosign verify of
# the LOCAL digest (a tag can move; the digest is the bytes that would run).
# The value being edited passes through this container's tmpfs, so an editor
# that was not signed by this project's CI never runs. Fails closed with a
# non-zero return; the caller refuses the edit.
secret_edit_editor_ready() {
    local ref="${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${AEGIS_SECRET_EDIT_IMAGE_TAG}"
    local config config_native token digest rc=0
    command -v docker >/dev/null 2>&1 || { err "docker is required to start the editor"; exit 1; }

    token="$(_image_download_token "authenticate")"
    config="$(mktemp -d)" || { err "mktemp failed"; exit 1; }
    config_native="$(_to_native_path "$config")"
    if ! _write_registry_config "$config" "$token"; then
        token=""
        rm -rf "$config"
        err "could not write the throwaway docker config"
        exit 1
    fi
    token=""

    log "pulling ${ref}"
    _run_with_throwaway_config "$config" env "DOCKER_CONFIG=$config_native" docker pull "$ref" || rc=$?
    [[ "$rc" -eq 0 ]] || return "$rc"

    digest="$(docker inspect --format='{{index .RepoDigests 0}}' "$ref" 2>/dev/null | sed 's/.*@//')" || digest=""
    if [[ -z "$digest" ]]; then
        err "no local digest for ${ref} after the pull; refusing to edit"
        return 1
    fi
    _verify_local_image "${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}@${digest}"
}

# aegis image pull [--tag <tag>] — S5 piece 3: ask the API for a download token and pull the licensed
# image from our own registry, which caches GHCR and refuses every pull that does not carry a live
# token. Without a token there is no image, which is the whole point of the gate.
#
# The token travels from the helper's stdout straight into `docker login --password-stdin`: it never
# reaches the terminal, a log, or this script's argv. Docker's credential store is redirected to a
# throwaway directory on purpose — `docker login` would otherwise persist a credential that lives
# sixty minutes into ~/.docker/config.json, where it would outlive its usefulness in a file nobody
# thinks to clean.
# _pull_final_line <pull log> <elapsed seconds>: the one curated line a
# successful pull prints, shared by every caller of cmd_image_pull (S4) —
# the same wording for `aegis up`, `aegis install` and the update's rebuild.
# Docker's own final status marker is authoritative (S3): 'Image is up to
# date' means nothing moved, whatever the layer lines say; 'Downloaded newer
# image' means a download, whatever the counts say. Without a marker (older
# docker, interrupted log) the transferred-layer count decides. The warm case
# never claims a download or a byte count; it names the outcome — the ref was
# already named by the 'pulling <reference>' line above — and verification
# still runs afterwards in every real call path, unconditionally.
_pull_final_line() {
    local log=$1 elapsed=$2 status layers outcome noun
    layers="$(grep -cE ': Pull complete$' "$log" 2>/dev/null || true)"
    status="$(grep -E '^Status: (Image is up to date|Downloaded newer image) for ' "$log" 2>/dev/null | tail -n1 || true)"
    if [[ "$status" == "Status: Image is up to date"* ]]; then
        outcome=local
    elif [[ "$status" == "Status: Downloaded newer image"* ]]; then
        outcome=downloaded
    elif (( ${layers:-0} > 0 )); then
        outcome=downloaded
    else
        outcome=local
    fi
    if [[ "$outcome" == local ]]; then
        printf 'image already present locally, nothing downloaded (%ss)\n' "$elapsed"
    elif (( ${layers:-0} > 0 )); then
        noun="layers"
        (( layers == 1 )) && noun="layer"
        printf 'image downloaded (%ss, %s %s)\n' "$elapsed" "$layers" "$noun"
    else
        # The marker said a download happened but its layer lines are gone
        # (truncated log): claim the download, not a count we cannot read.
        printf 'image downloaded (%ss)\n' "$elapsed"
    fi
}

cmd_image_pull() {
    local tag="$AEGIS_IMAGE_TAG" reference config token rc=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tag) tag="${2:-}"; [[ -z "$tag" ]] && { err "usage: aegis image pull [--tag <tag>]"; exit 2; }; shift 2 ;;
            *) err "unknown option for 'aegis image pull': $1"; exit 2 ;;
        esac
    done

    command -v docker >/dev/null 2>&1 || { err "docker is required to pull the image"; exit 1; }

    token="$(_image_download_token "log in")"

    config="$(mktemp -d)" || { err "mktemp failed"; exit 1; }
    # Docker Desktop is a Windows binary: handed a POSIX path it resolves it against the current
    # drive (C:\tmp\...), which is NOT the directory this shell's rm will delete. The credential
    # would be written somewhere nobody looks, and survive the cleanup that claims to remove it.
    config_native="$(_to_native_path "$config")"
    if ! _write_registry_config "$config" "$token"; then
        token=""
        rm -rf "$config"
        err "could not write the throwaway docker config"
        exit 1
    fi
    token=""

    reference="${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${tag}"
    log "pulling ${reference}"
    # Friendly CLI flow: a raw `docker pull` streams one line per layer
    # (`1e4762e943be: Pull complete`) plus the final digest straight to the
    # terminal — meaningless to an end user and the single biggest source of
    # noise in `aegis update`. Captured to a log, one curated line on success,
    # the log tail on failure — same convention as every other internal
    # command in this launcher (generate-allowlist.sh, the rebuild's compose up).
    local pull_log="${BUILD_LOG_DIR%/}/pull-$(date -u +%Y%m%dT%H%M%SZ).log"
    mkdir -p "${BUILD_LOG_DIR%/}"
    local started
    started="$(date +%s)"
    pg_watch_start layers _pg_pull_counts "$pull_log"
    _run_with_throwaway_config "$config" env "DOCKER_CONFIG=$config_native" docker pull "$reference" >"$pull_log" 2>&1 || rc=$?
    pg_watch_stop
    if [[ "$rc" -eq 0 ]]; then
        log "$(_pull_final_line "$pull_log" "$(( $(date +%s) - started ))")"
    else
        err "the pull failed; last lines (${pull_log}):"
        tail -n 20 "$pull_log" | sed 's/^/  /' >&2
    fi
    return "$rc"
}

# aegis image verify [--tag <tag>] — T29's other half: prove that the image sitting locally was built
# and signed by this project's CI, before anything runs it. Without this the signature is a seal
# nobody checks.
#
# Keyless signing binds the signature to the workflow run that produced it, so what this proves is an
# IDENTITY and an ISSUER — not possession of a key we would have to distribute and rotate. cosign
# runs from its own pinned image in a throwaway container: nothing to install on Windows, and the
# same credential the pull already uses, mounted read-only for the length of the check.
#
# It verifies the DIGEST that is here, not the tag: a tag can be moved, so checking one would prove
# something about a name rather than about the bytes that would run.
cmd_image_verify() {
    local tag="$AEGIS_IMAGE_TAG" reference digest

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tag) tag="${2:-}"; [[ -z "$tag" ]] && { err "usage: aegis image verify [--tag <tag>]"; exit 2; }; shift 2 ;;
            *) err "unknown option for 'aegis image verify': $1"; exit 2 ;;
        esac
    done

    # Resolving the local digest stays here: it is this command's own message
    # ("no local digest ... pull it first") and the digest — not the tag — is
    # what gets verified. The throwaway credential and the cosign run are shared
    # with `aegis up` through _verify_local_image.
    command -v docker >/dev/null 2>&1 || { err "docker is required to verify the image"; exit 1; }

    reference="${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${tag}"
    digest="$(docker inspect --format='{{index .RepoDigests 0}}' "$reference" 2>/dev/null | sed 's/.*@//')"
    if [[ -z "$digest" ]]; then
        err "no local digest for ${reference} — pull it first (aegis image pull): what gets verified"
        err "is the image that is here, and nothing here answers to that reference"
        exit 1
    fi

    _verify_local_image "${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}@${digest}"
}

cmd_image() {
    local verb="${1:-}"
    case "$verb" in
        # Client-redesign L4: `image pull` died as a journey command — `aegis
        # install` and `aegis up` pull (and verify) the signed image by
        # themselves. `image verify` stays, as a diagnostic next to `audit`.
        pull)
            err "'aegis image pull' was retired: 'aegis up' (or 'aegis install') pulls and verifies the signed image by itself."
            exit 2
            ;;
        verify) shift; cmd_image_verify "$@" ;;
        *) err "usage: aegis image verify [--tag <tag>]"; exit 2 ;;
    esac
}

# T28: verify the signed license OFFLINE and say what it entitles. Nothing here
# touches the network; the signature is checked against the public keys shipped
# in config/license-keys.json, and an unknown kid is refused rather than
# trusted. The report (including how long is left) comes from aegis-license.js;
# this function only locates the two files and propagates the verdict.
cmd_license() {
    case "${1:-}" in
        activate|renew|heartbeat|retire)
            local verb="$1"
            shift
            case "$verb" in
                activate)  cmd_license_activate "$@" ;;
                renew)     cmd_license_renew "$@" ;;
                heartbeat) cmd_license_heartbeat "$@" ;;
                retire)    cmd_license_retire "$@" ;;
            esac
            return
            ;;
        show) shift ;;
        ''|-*) ;;
        *)
            err "unknown 'aegis ${_LICENSE_CMD}' subcommand: $1"
            err "usage: aegis ${_LICENSE_CMD} [show] | activate <license-id> | renew | heartbeat | retire [--file <path>]"
            exit 2
            ;;
    esac
    local file="$AEGIS_LICENSE_FILE"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --file) file="${2:-}"; [[ -z "$file" ]] && { err "usage: aegis ${_LICENSE_CMD} [--file <path>]"; exit 2; }; shift 2 ;;
            *) err "unknown option: $1"; exit 2 ;;
        esac
    done
    require_license_helper
    if [[ ! -f "$file" ]]; then
        err "no license on this machine — expected $(tildify "$file")."
        err "obtain a signed license from the licensing service, or point at one with --file <path>."
        exit 1
    fi
    if [[ ! -f "$AEGIS_LICENSE_KEYS_FILE" ]]; then
        err "the configuration is incomplete - the accepted license keys are missing: $AEGIS_LICENSE_KEYS_FILE"
        exit 1
    fi
    node "$LICENSE_JS" verify "$file" "$AEGIS_LICENSE_KEYS_FILE"
}

cmd_connect() {
    local net="${1:-$DEFAULT_SERVICES_NETWORK}"
    ensure_up

    if docker network inspect "$net" >/dev/null 2>&1; then
        local internal
        internal="$(docker network inspect "$net" --format '{{.Internal}}')"
        if [[ "$internal" != "true" ]]; then
            err "refusing to connect to network '$net' — it is not internal:true."
            err "a non-internal bridge network has an Internet route by default, which"
            err "would let the dev container bypass the egress proxy entirely. Create a"
            err "dedicated internal network instead (e.g. 'docker network create --internal"
            err "$net'), or attach your service containers to one that already is internal."
            exit 1
        fi
    else
        log "network '$net' does not exist — creating it as internal:true."
        docker network create --internal "$net" >/dev/null
    fi

    if docker network inspect "$net" --format '{{range $k, $v := .Containers}}{{$v.Name}}{{"\n"}}{{end}}' \
            | grep -qxF "$DEV_CONTAINER"; then
        log "already connected to '$net'."
    else
        docker network connect "$net" "$DEV_CONTAINER"
        log "connected $DEV_CONTAINER to '$net'."
    fi
    log "attach your own service containers with: docker network connect $net <service-container-name>"
    log "then reach them from inside the workstation by that container's name (e.g. postgres:5432)."
}

cmd_disconnect() {
    local net="${1:-$DEFAULT_SERVICES_NETWORK}"
    docker network disconnect "$net" "$DEV_CONTAINER"
    log "disconnected $DEV_CONTAINER from '$net'."
}

cmd_stop() {
    compose stop
    log "stack stopped (containers only — volumes and networks untouched)."
}

cmd_down() {
    compose down
    log "stack removed (containers/networks only — volumes are kept; 'docker volume ls' still lists them)."
}

# --- T18: install the host-side configuration --------------------------------

# Copies the template tree — compose, Dockerfile, scripts, config, profiles and
# AGENTS.md, i.e. the whole build context, because the compose file builds with
# this tree as its context — into AEGIS_INSTALL_DIR, OUTSIDE every mount. From
# then on `aegis up` and `aegis audit` run THAT copy, so nothing the host
# executes lives in a folder the workstation can see.
#
# Safety: it backs up whatever was installed before, it refuses to copy the
# installed dir onto itself, and it verifies the copy actually has every file
# the launcher resolves before declaring success — finding out on the next
# `aegis up` would be much worse.
# --- T23: aegis update --------------------------------------------------------

# cmd_update_client (below) brings the launcher and the configuration up to
# date from aegis-cli's signed releases and the signed bundle. 2026-11-04: the
# only other update mechanism this launcher ever had -- a git-fetch self-update
# against a checkout, for AEGIS_CLI_MODE=dev -- is retired; every real
# invocation, including the owner's own machine, runs as a client.

# Whether the caller chose the bin directory (the client update writes next to
# the RUNNING launcher otherwise — review finding R3-004).
AEGIS_BIN_DIR_EXPLICIT="${AEGIS_BIN_DIR:+1}"
AEGIS_BIN_DIR="${AEGIS_BIN_DIR:-$HOME/bin}"

# --- T24: aegis secret --------------------------------------------------------

# THE VAULT IS NEVER MOUNTED INTO `dev` (D3). Every operation goes through a
# throwaway container: --rm, no network, read-only rootfs, and the volume mounted
# read-only for the read commands. It runs as ROOT deliberately, and only there:
# the vault is root:root 0700, so a non-root container could not read a single
# name (verified against the volume on 2026-09-30). Inside that container root can
# only READ — there is nothing to write and nowhere to send it but stdout.
#
# The secret side is `keys/`; `data/` holds material that is not secret, is listed
# as such and is never read as a secret (D2).
#
# Not here yet (slice 2): `put` (which is also the UPDATE path: it replaces when
# the name exists) and `rm`. They need the volume mounted read-write, so they are
# deliberately a separate slice with their own confirmation.

AEGIS_VAULT_VOLUME="${AEGIS_VAULT_VOLUME:-aegis-workstation-secrets}"
# Pinned by digest: the same image backup/restore already use.
AEGIS_VAULT_IMAGE="${AEGIS_VAULT_IMAGE:-$BACKUP_IMAGE}"
# The `secret edit` editor image (alpine + nano) lives in the SAME repository
# as the workstation image — the download token only covers this repo — under
# its own tag, built and signed by the publish-editor CI job. Bump editor-v1
# (Dockerfile.editor + a publish-editor dispatch) when the editor changes.
AEGIS_SECRET_EDIT_IMAGE_TAG="${AEGIS_SECRET_EDIT_IMAGE_TAG:-editor-v1}"

# vault_run <ro|rw> <command...> — NEVER attaches stdin. The T39 migration
# documented the lesson in its own copy: docker run with -i drains the host's
# stdin (prompts, pasted context) even when the container ignores it, so the
# migration's vault_run carries `< /dev/null` and only vault_run_i — the
# explicit pipe-on-purpose variant — goes without it. This launcher's copy was
# missing the redirect (hardened in vault-seal-windows, 2026-10-14).
vault_run() {
    local mode="$1"
    shift
    MSYS_NO_PATHCONV=1 docker run --rm --network none --read-only \
        -v "${AEGIS_VAULT_VOLUME}:/vault:${mode}" \
        "$AEGIS_VAULT_IMAGE" "$@" < /dev/null
}

# A name is only ever a name under keys/: never absolute, never with '..', and
# never the non-secret side (D2).
vault_require_name() {
    local name="$1" usage="$2"
    if [[ -z "$name" ]]; then
        err "usage: ${usage}"
        exit 2
    fi
    case "$name" in
        /*|*..*|data|data/*|keys|keys/*)
            err "refusing: '${name}' is not a name under keys/"
            exit 2
            ;;
    esac
}

vault_confirm() {
    local question="$1" answer
    printf 'aegis: %s [y/N] ' "$question"
    read -r answer
    case "$answer" in
        y|Y|yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

# The UPDATE path as well, and that is on purpose: when the name already exists
# this REPLACES its content, and it says so before touching anything.
#
# How the content gets IN without crossing the terminal: the host file is mounted
# read-only inside the throwaway container, so its bytes travel through the mount
# and never through a pipe or a string. The vault is mounted read-write for this
# one operation, the file lands as root:root with mode 600 — the same shape the
# loaded material already has — and only the name is printed back.
# --- T24 (D4, D5): the per-session injection ----------------------------------

# Reads a metadata file that may not exist: empty output, never an error.
vault_read_optional() {
    [[ "$(vault_state "$1")" == missing ]] && return 0
    vault_open "$1"
}

# --- BEGIN T39 vault at rest (extracted by odd/t39/at-rest-test.sh) ---
#
# --- T39: `keys/` encrypted at rest; the passphrase exists only in the dev's
#      head (ADR 0012, amended A+C 2026-10-04; host-crypto enmienda below) ----
#
# Format: `openssl enc` armored AES-256-CBC + PBKDF2-SHA512 (iterations in
# AEGIS_VAULT_ITER). WHY openssl and not age: `age`/`rage` passphrase mode
# provably refuses a piped passphrase (pinentry/tty — verified 2026-10-04).
# Path C (age *recipients* with T21's hardware identity) stays the future.
#
# WHERE THE CRYPTO RUNS — this launcher's process, NOT the vault container.
# The pinned alpine base carries the openssl LIBRARIES (apk links them) but not
# the CLI; the first real migration run proved it (`openssl: not found` inside
# the container, 2026-10-04). Git for Windows ships its own openssl, so the
# bytes pipe vault -> container stdout -> host openssl -> container stdin and
# the container does pure file I/O, still --rm -i --network none --read-only
# with the image pinned (D3 unchanged). Two verified facts pin this shape:
# `-pass fd:0` cannot share stdin between passphrase and data in openssl 3, and
# host temp files would put secrets on NTFS — the very disk this protects.
#
# The passphrase: this shell's memory (VAULT_PASS), and during each openssl
# call the child's environment (-pass env:VAULT_PASS) — memory of same-uid
# processes, the exposure D8 already concedes for the session itself (the
# launcher variable is just as readable by a same-uid process). It never
# touches argv (visible in ps), docker run -e (persisted in daemon config on
# the protected disk), or any file, host or in the volume.
AEGIS_VAULT_ITER="${AEGIS_VAULT_ITER:-1000000}"

# enc | plain | missing — looks at the FIRST 8 BYTES only (openssl armor starts
# with the base64 of "Salted__"), never at the secret itself. A plain file is a
# pre-migration legacy: readable, and every read path warns about it once.
vault_state() {
    vault_run ro sh -c '
        f="/vault/keys/$1"
        [ -e "$f" ] || { echo missing; exit 0; }
        [ -f "$f" ] || { echo dir; exit 0; }
        if [ "$(head -c 8 "$f" 2>/dev/null)" = "U2FsdGVk" ]; then echo enc; else echo plain; fi
    ' sh "$1"
}

# One prompt per operation. The answer goes to VAULT_PASS (shell memory only)
# and stays for the rest of the operation (a session injection reads several
# files but asks once); clear it when the operation ends.
vault_prompt_pass() {
    local pass=""
    printf 'aegis: vault passphrase: ' >&2
    IFS= read -rs pass || { echo >&2; return 1; }
    echo >&2
    [[ -n "$pass" ]] || { err "empty passphrase: refused."; return 1; }
    VAULT_PASS="$pass"
}

# One hidden line, terminal-first (T39.1), MASKED (T39.2, vault-seal-windows).
# A `put --stdin` operation carries the SECRET on stdin, so the passphrase
# must not be read from it: /dev/tty is the very terminal stdin came from when
# there is one. With no terminal at all this falls back to stdin — the
# pre-T39.1 behavior (and what the tests exercise, in a tty-less container).
#
# The input is masked: one '*' per typed byte, Backspace/DEL erases with
# '\b \b', Enter (\r or \n) ends the line, and a failed read (Ctrl-C on a
# tty, EOF/Ctrl-D) aborts with rc != 0 and NO value at all — a half-typed
# line must never reach VAULT_PASS.
#
# The mask prints to REAL stderr, which is why the tty is opened on its own
# fd exactly once, quietly: the old inline `2>/dev/null </dev/tty` silenced
# stderr for the whole read, so the failed-open message never showed — but
# neither would the mask. `{ exec 3</dev/tty; } 2>/dev/null` scopes the
# silence to the open attempt: fd 3 survives the group, the silenced stderr
# does not, and under set -e a failed open only fails the condition (a bare
# `exec 3</dev/tty` would END a set -e shell). fd 3 is closed on the one
# exit path; no new trap is added (the launcher keeps exactly ONE).
#
# Caveat: bash reads BYTES (-N 1), so a multi-byte UTF-8 key paints one '*'
# per byte and arrow/function keys paint escape sequences — the value itself
# is byte-exact either way. -N (not -n) keeps \r and \n as real characters,
# so both Enter flavors are detectable.
vault_read_hidden_line() {
    local outvar="$1" buf="" key rc=0 tty=0
    if { exec 3</dev/tty; } 2>/dev/null; then
        tty=1
    fi
    while :; do
        if [[ "$tty" -eq 1 ]]; then
            IFS= read -rs -N 1 key <&3 || { rc=$?; break; }
        else
            IFS= read -rs -N 1 key || { rc=$?; break; }
        fi
        case "$key" in
            $'\n'|$'\r') break ;;
            $'\x7f'|$'\x08'|$'\b')        # Backspace/DEL (and Ctrl-H): erase
                if [[ -n "$buf" ]]; then
                    buf="${buf%?}"
                    printf '\b \b' >&2
                fi
                ;;
            $'\x03'|$'\x04')              # Ctrl-C/D as literal bytes (a pipe): abort
                rc=130
                break
                ;;
            *)                            # Ctrl-C on a tty is SIGINT: read fails above
                buf+="$key"
                printf '*' >&2
                ;;
        esac
    done
    [[ "$tty" -eq 1 ]] && exec 3<&-
    if [[ "$rc" -ne 0 ]]; then
        printf '\n' >&2                   # close the prompt line even on abort
        return "$rc"                      # NO assignment: a partial line is not a passphrase
    fi
    printf '\n' >&2                       # end the masked entry: the next prompt gets its own line
    printf -v "$outvar" '%s' "$buf"
}

# For WRITES: typed twice. A typo while sealing means the secret is locked out
# of the very protection it bought, so there is no one-shot path into `put`.
vault_prompt_pass_seal() {
    local pass="" again=""
    printf 'aegis: new vault passphrase for keys/%s: ' "$1" >&2
    vault_read_hidden_line pass || { echo >&2; return 1; }
    echo >&2
    printf 'aegis: repeat it: ' >&2
    vault_read_hidden_line again || { echo >&2; return 1; }
    echo >&2
    [[ -n "$pass" ]] || { err "empty passphrase: nothing was written."; return 1; }
    [[ "$pass" == "$again" ]] || { err "the two VAULT passphrase entries did not match: nothing was written (the secret value was not the problem — run the command again)."; return 1; }
    VAULT_PASS="$pass"
}

vault_have_ssl() {
    command -v openssl >/dev/null || {
        err "openssl not found on the host PATH (it ships with Git for Windows)."
        return 1
    }
}

# One container for many names: exit 0 if ANY of them exists and is sealed.
# Names are relative to keys/.
vault_any_sealed() {
    vault_run ro sh -c '
        for n in "$@"; do
            f="/vault/keys/$n"
            [ -f "$f" ] || continue
            [ "$(head -c 8 "$f" 2>/dev/null)" = "U2FsdGVk" ] && exit 0
        done
        exit 1
    ' sh "$@"
}

# vault_ensure_pass <name...> — THE only place an operation asks for the
# passphrase, and it MUST run in the parent shell: pipelines and $( ) capture
# the output but their assignments die with the subshell, and a vault_open
# that prompts inside one will prompt AGAIN for every file of the same
# operation (the real session smoke caught exactly that: four prompts for
# ssh/personal + .host + .hostname + .known_hosts, 2026-10-04). Call this
# once up front with every name the operation will touch; then each vault_open
# finds VAULT_PASS already in place — inherited by every subshell. All-plain
# or all-missing lists never prompt at all.
vault_ensure_pass() {
    [[ -n "${VAULT_PASS:-}" ]] && return 0
    vault_any_sealed "$@" || return 0
    vault_prompt_pass
}

# vault_run_i <ro|rw> <command...> — vault_run with stdin attached: how
# ciphertext bytes travel in and out of the container through a pipe.
vault_run_i() {
    local mode="$1"
    shift
    MSYS_NO_PATHCONV=1 docker run -i --rm --network none --read-only \
        -v "${AEGIS_VAULT_VOLUME}:/vault:${mode}" \
        "$AEGIS_VAULT_IMAGE" "$@"
}

# Content of one vault file on stdout, decrypting when needed. Plain files pass
# through, so the CLI keeps working file by file while files remain unmoved by
# the migration; the legacy plain case says so once, on stderr.
#
# NEVER prompts: the operation must have called vault_ensure_pass (parent
# shell) first. A prompt here would die in this function's own subshell when
# it is piped — VAULT_PASS empty means the caller skipped its up-front ask.
#
# The decrypted bytes are BUFFERED, never streamed: `openssl enc -d` with a
# wrong passphrase emits random garbage for every block it decrypted before it
# dies on the final padding check — streaming would write that garbage into the
# session tmpfs (and onto the terminal) with a nonzero rc only AFTER the fact.
# Nothing is emitted unless the whole decryption returned clean. The one-byte
# caveat of buffering: trailing newlines are normalised to exactly one, which
# PEM keys, known_hosts lines and .env files all tolerate.
vault_open() {
    local name="$1" state out
    state="$(vault_state "$name")"
    case "$state" in
        missing|dir) return 1 ;;
        plain)
            log "NOTE: keys/${name} is still stored IN CLEAR (T39 migration pending)." >&2
            vault_run ro sh -c 'cat "/vault/keys/$1"' sh "$name" ;;
        enc)
            [[ -n "${VAULT_PASS:-}" ]] || {
                err "internal error: no passphrase prepared for this operation (vault_ensure_pass must run first)."
                return 1
            }
            vault_have_ssl || return 1
            out="$( vault_run ro sh -c 'cat "/vault/keys/$1"' sh "$name" |
                    ( export VAULT_PASS
                      openssl enc -d -a -aes-256-cbc -pbkdf2 -md sha512 \
                          -iter "$AEGIS_VAULT_ITER" -pass env:VAULT_PASS ) )" || return 1
            printf '%s\n' "$out" ;;
        *) return 1 ;;
    esac
}

# sha256_file <path> — sha256 of a file's CONTENT, parsed free of filename
# baggage. GNU coreutils sha256sum escapes its ENTIRE output line with a
# leading '\' when the PATH contains backslashes (`\HASH  C:\\temp\\f.txt`),
# so `sha256sum "$f" | cut -d' ' -f1` returns a poisoned hash for any
# Windows-style path — the vault-seal-windows bug (2026-10-14): the seal's
# round-trip compared a clean sha_out against `\2c43c95d…` and the byte-perfect
# tmp was deleted as a "mismatch". Reading the bytes through stdin instead
# makes coreutils print the filename as a bare `-`: no escaping, whatever the
# path style (C:\…, /c/…, spaces, newlines). A failed open/sum propagates a
# nonzero rc to the caller under set -euo pipefail.
sha256_file() {
    sha256sum < "$1" | cut -d' ' -f1
}

# Encrypt the host file $2 INTO the vault as keys/$1, verify-before-replace:
# ciphertext is piped (never through a host file) to a volume tmp, the tmp is
# decrypted back and hash-compared against the original, and only then renamed
# atomically with 600 file / 700 folder — the same shape T24 slice 2 had to fix
# after the 755-folder bug. Content never crosses the terminal.
vault_seal() {
    local name="$1" from="$2" sha_in
    vault_have_ssl || return 1
    sha_in="$(sha256_file "$from")" || return 1
    if ! {   ( export VAULT_PASS
                openssl enc -a -aes-256-cbc -pbkdf2 -md sha512 \
                    -iter "$AEGIS_VAULT_ITER" -pass env:VAULT_PASS -in "$from" ) |
            vault_run_i rw sh -c '
                d="/vault/keys/$(dirname "$1")"; t="/vault/keys/$1.tmp-at-rest"
                mkdir -p "$d" && chmod 700 "$d" || exit 1
                cat > "$t" || exit 1
            ' sh "$name" ; }; then
        vault_run rw sh -c 'rm -f "/vault/keys/$1.tmp-at-rest"' sh "$name"
        err "sealing keys/${name} failed: nothing was written."
        return 1
    fi
    _vault_finalize_seal "$name" "$sha_in"
}

# _vault_finalize_seal <name> <sha-of-plaintext> — the verify-before-replace
# back half of a seal, shared by the file and stdin paths: decrypt the tmp
# that was just written, hash-compare it against the plaintext, and only then
# chmod 600 + rename atomically. Any failure removes the tmp — and says WHICH
# failure it was. The generic "nothing was written" used to cover three
# different causes (empty tmp, dead ciphertext, real mismatch) and sent the
# vault-seal-windows diagnosis down the wrong path for hours; each cause now
# gets its own message.
_vault_finalize_seal() {
    local name="$1" sha_in="$2" sha_out
    # Fail fast when the write phase never delivered bytes: a missing or empty
    # tmp means docker received no stdin — there is nothing to verify, and
    # decrypting an empty tmp below would only manufacture a confusing message.
    if ! vault_run ro sh -c '[ -s "/vault/keys/$1.tmp-at-rest" ]' sh "$name"; then
        vault_run rw sh -c 'rm -f "/vault/keys/$1.tmp-at-rest"' sh "$name"
        err "sealing keys/${name} failed: the vault tmp is empty — docker received no stdin (write phase)."
        return 1
    fi
    sha_out="$( ( export VAULT_PASS
                  vault_run ro sh -c 'cat "/vault/keys/$1.tmp-at-rest"' sh "$name" |
                  openssl enc -d -a -aes-256-cbc -pbkdf2 -md sha512 \
                      -iter "$AEGIS_VAULT_ITER" -pass env:VAULT_PASS 2>/dev/null ) |
                sha256sum | cut -d' ' -f1 )"
    if [[ -z "$sha_out" || "$sha_in" != "$sha_out" ]]; then
        vault_run rw sh -c 'rm -f "/vault/keys/$1.tmp-at-rest"' sh "$name"
        # The SHA-256 of zero bytes is what the pipeline hashes when openssl
        # died before emitting one (bad/garbage ciphertext): that is a
        # write-survival failure, not a hash comparison failure. The decrypt's
        # stderr stays silenced and the plaintext stays UNBUFFERED on purpose —
        # hashing the stream keeps trailing-newline semantics identical to the
        # write phase, and this empty-hash signature is the decrypt detector.
        if [[ "$sha_out" == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ]]; then
            err "sealing keys/${name} failed: decryption produced no bytes — the ciphertext did not survive the write."
        else
            err "sealing keys/${name} failed: round-trip hash mismatch — the volume content does not decrypt to the source bytes."
        fi
        return 1
    fi
    if ! vault_run rw sh -c '
            chmod 600 "/vault/keys/$1.tmp-at-rest" \
                && mv -f "/vault/keys/$1.tmp-at-rest" "/vault/keys/$1"
        ' sh "$name"; then
        vault_run rw sh -c 'rm -f "/vault/keys/$1.tmp-at-rest"' sh "$name"
        return 1
    fi
    echo "sealed: keys/${name} (openssl AES-256-CBC, PBKDF2-SHA512, iter ${AEGIS_VAULT_ITER})"
}

# vault_seal_stdin <name> — seal the bytes on this function's stdin INTO the
# vault as keys/<name>, with the same verify-before-replace as vault_seal.
# This is how `put --stdin` and `host set` write without a clear-text copy
# ever existing on the host disk (the reason host temp files were ruled out
# in the header above): the plaintext lives in THIS shell's memory for the
# duration of the call — the same same-uid process-memory class D8 already
# concedes for VAULT_PASS — and the ciphertext travels straight into the
# volume tmp via vault_run_i.
#
# The buffering caveat is vault_open's, mirrored (see its comment): trailing
# newlines normalise to exactly one and NUL bytes do not survive — keys,
# known_hosts lines and .env files all tolerate that. Empty input refuses
# rather than sealing 0 bytes: an empty pipe is an upstream failure, not a
# secret.
vault_seal_stdin() {
    local name="$1" kind="${2:-}" plain sha_in
    vault_have_ssl || return 1
    plain="$(cat)" || { err "reading stdin for keys/${name} failed: nothing was written."; return 1; }
    # PowerShell/cmd pipes carry \r\n: the CR would be sealed invisible and the
    # value would never match what the owner pasted. Strip before sealing.
    plain="${plain//$'\r'/}"
    [[ -n "$plain" ]] || { err "empty input — the shell did not pipe anything (PowerShell/cmd must pass piped input through), or the source file was empty: refusing to seal an empty keys/${name}."; return 1; }
    # T39.3: --stdin validates per kind too — same rules as --from, but the
    # plaintext lives in THIS shell's memory (never written anywhere to check it).
    if [[ -n "$kind" ]]; then
        secret_kind_validate_text "$kind" "$plain" || return 1
    fi
    sha_in="$(printf '%s\n' "$plain" | sha256sum | cut -d' ' -f1)" || return 1
    if ! {   ( export VAULT_PASS
                printf '%s\n' "$plain" |
                openssl enc -a -aes-256-cbc -pbkdf2 -md sha512 \
                    -iter "$AEGIS_VAULT_ITER" -pass env:VAULT_PASS ) |
            vault_run_i rw sh -c '
                d="/vault/keys/$(dirname "$1")"; t="/vault/keys/$1.tmp-at-rest"
                mkdir -p "$d" && chmod 700 "$d" || exit 1
                cat > "$t" || exit 1
            ' sh "$name" ; }; then
        vault_run rw sh -c 'rm -f "/vault/keys/$1.tmp-at-rest"' sh "$name"
        err "sealing keys/${name} failed: nothing was written."
        return 1
    fi
    _vault_finalize_seal "$name" "$sha_in"
}
# --- END T39 vault at rest ---

# --- BEGIN T39 list marks (extracted by odd/t39/migrate-test.sh) ---
#
# The keys/ section of `aegis secret list`, as one extractable POSIX sh script
# ($1 = vault root): every file carries its at-rest state, so `list` doubles as
# the migration progress report (T39 slice 2). [clear] is the pre-migration
# legacy the slice-2 script moves; the tree keeps the T35 shape.
LIST_MARK_SH='
base=$1
if [ -d "$base/keys" ] && [ -n "$(ls -A "$base/keys" 2>/dev/null)" ]; then
    echo "secret material (keys/) — [kind] = namespace type; sealed = encrypted at rest:"
    find "$base/keys" -mindepth 1 | sort | while IFS= read -r f; do
        if [ -d "$f" ]; then echo "  ${f#"$base"/}/"; continue; fi
        rel=${f#"$base"/}
        r=${rel#keys/}
        case $r in
            git-ssh/*) k=git-ssh ;;
            server/*) k=server ;;
            env/*) k=env ;;
            ssh/*) k=legacy-ssh ;;
            servers/*) k=legacy-servers ;;
            envs/*) k=legacy-envs ;;
            */*) k=other ;;
            *) k=token ;;
        esac
        if [ "$(head -c 8 "$f" 2>/dev/null)" = U2FsdGVk ]; then
            echo "  [sealed] [$k] $rel"
        else
            echo "  [clear]  [$k] $rel"
        fi
    done
    if [ -d "$base/keys/ssh" ] || [ -d "$base/keys/servers" ] || [ -d "$base/keys/envs" ]; then
        echo "  legacy namespaces present — rename them with: aegis secret migrate-kinds"
    fi
else
    echo "secret material (keys/): (empty)"
fi
'
# --- END T39 list marks ---

# --- secret-kinds K2: the consumers gate themselves --------------------------
# --secret carries SSH identities: git-ssh/ and server/ only (legacy namespaces
# keep working with a migrate hint until migrate-kinds runs). --env loads
# KEY=VALUE env-files: env/ and root tokens only. Fail-closed, fix in message.

secret_kind_gate_secret() {
    local name="$1" kind
    kind="$(secret_kind_of "$name")"
    case "$kind" in
        git-ssh|server) return 0 ;;
        legacy-ssh)
            log "keys/${name} is a legacy namespace: 'aegis secret migrate-kinds' moves it to git-ssh/."
            return 0 ;;
        legacy-servers)
            log "keys/${name} is a legacy namespace: 'aegis secret migrate-kinds' moves it to server/."
            return 0 ;;
        env)
            err "--secret carries SSH identities; keys/${name} is kind 'env': inject it with --env instead."
            return 1 ;;
        token)
            err "--secret carries SSH identities; keys/${name} is kind 'token' (root): seal it as VAR=value and inject it with --env instead."
            return 1 ;;
        *)
            err "--secret carries SSH identities; keys/${name} has no known kind (git-ssh/ and server/ namespaces only)."
            return 1 ;;
    esac
}

secret_kind_gate_env() {
    local name="$1" kind
    kind="$(secret_kind_of "$name")"
    case "$kind" in
        env|token) return 0 ;;
        legacy-envs)
            log "keys/${name} is a legacy namespace: 'aegis secret migrate-kinds' moves it to env/."
            return 0 ;;
        git-ssh|server)
            err "--env loads KEY=VALUE env-files; keys/${name} is kind '${kind}': inject it with --secret instead."
            return 1 ;;
        *)
            err "--env loads KEY=VALUE env-files; keys/${name} has no known kind (env/ or root token only)."
            return 1 ;;
    esac
}

# Moves ONE secret from the vault into the session's tmpfs WITHOUT ever writing a
# host file: the bytes go vault -> stdout -> `docker exec -i` stdin -> tmpfs. The
# key never exists on disk anywhere, and the wrapper that runs the session removes
# it when the session ends (D4).
#
# The metadata comes by convention, next to the key:
#   keys/<name>             the private key — <name> may be nested by purpose
#                           (T35): keys/ssh/personal, keys/servers/<...>,
#                           keys/envs/<...>; the session is opened with
#                           `--secret ssh/personal`
#   keys/<name>.host        the host to configure (optional — without it nothing
#                           uses the key, and the command says so)
#   keys/<name>.known_hosts the host key, provided from outside; without it ssh
#                           refuses. Deny by default, no trust-on-first-use (D5)
session_inject_secret() {
    local name="$1" dir="$2"
    vault_require_name "$name" "aegis shell --secret <name>"
    secret_kind_gate_secret "$name" || return 1
    # ONE prompt for the whole secret, asked HERE (parent shell) before any
    # pipeline or $( ) subshell runs: the key and every sidecar decrypt with
    # the VAULT_PASS this sets. A later --secret reuses it. The process owns
    # the value until it exits; nothing is written anywhere.
    vault_ensure_pass "$name" "${name}.host" "${name}.hostname" \
        "${name}.known_hosts" "${name}.port" "${name}.user"
    local id="id_$(printf '%s' "$name" | tr '/.' '__')"
    local host hostname known port user
    host="$(vault_read_optional "${name}.host")"
    # keys/<name>.hostname is OPTIONAL and it is what makes host aliases work: with
    # several accounts on the same real server (two GitHub identities, say), each has
    # its own alias (`Host github.com-personal`) and this is where ssh actually
    # connects. Without it the alias IS the real host, which is the one-key case.
    hostname="$(vault_read_optional "${name}.hostname")"
    known="$(vault_read_optional "${name}.known_hosts")"
    # keys/<name>.port is OPTIONAL: the ssh port for this key. Forges answer on 22;
    # a server of your own may be on something else (2022, say). Whatever port it is,
    # it also has to be in the proxy's acl SSH_ports (config/squid.conf).
    port="$(vault_read_optional "${name}.port")"
    # keys/<name>.user is OPTIONAL: the login user. A forge answers as `git` (and the
    # remote URL says it anyway); a server of your own is whatever it is — azureuser,
    # deploypod01, eagonzalez. Without it ssh offers your local username, which is
    # almost never the right one for a server.
    user="$(vault_read_optional "${name}.user")"

    # The session's own directory: created here, owned by the dev user, readable
    # only by it, and everything this function writes stays inside it.
    docker_exec_path "$DEV_CONTAINER" sh -c 'mkdir -p "$1" && chmod 700 "$1"' sh "$dir"

    # The tunnel helper, for this session only: the container has no route out
    # except the egress proxy, so ssh needs a ProxyCommand to go through it.
    if [[ -f "$SSH_PROXY_JS" ]]; then
        docker_exec_path -i "$DEV_CONTAINER" sh -c \
            'cat > "$1" && chmod 700 "$1"' sh "${dir}/ssh-egress-proxy.js" < "$SSH_PROXY_JS"
    fi

    # T39: the passphrase was asked ONCE up front (vault_ensure_pass above);
    # vault_open decrypts with the inherited VAULT_PASS and the bytes still
    # travel vault -> stdout -> exec stdin -> tmpfs, never a path.
    vault_open "$name" |
        docker_exec_path -i "$DEV_CONTAINER" sh -c \
            'cat > "$1" && chmod 600 "$1"' sh "${dir}/${id}"

    docker_exec_path -i "$DEV_CONTAINER" sh -c '
        if [ -n "$1" ]; then
            {
                echo "Host $1"
                if [ -n "$5" ]; then
                    echo "  HostName $5"
                fi
                if [ -n "$6" ]; then
                    echo "  Port $6"
                fi
                if [ -n "$7" ]; then
                    echo "  User $7"
                fi
                # -f, not -x: the tmpfs is mounted noexec (see D4 and the T22 note
                # about exec-capable tmpfs dirs), so nothing in it is ever
                # executable. node is invoked explicitly by the ProxyCommand, so
                # the bit does not matter — and testing it skipped the whole line.
                if [ -f "$2/ssh-egress-proxy.js" ]; then
                    echo "  ProxyCommand node $2/ssh-egress-proxy.js %h %p"
                fi
                echo "  IdentityFile $3"
                echo "  IdentitiesOnly yes"
                echo "  UserKnownHostsFile $4"
                echo "  StrictHostKeyChecking yes"
            } >> "$2/config"
        fi
        cat >> "$2/known_hosts"
    ' sh "$host" "$dir" "${dir}/${id}" "${dir}/known_hosts" "$hostname" "$port" "$user" <<<"$known"

    if [[ -n "$host" ]]; then
        if [[ -n "$hostname" ]]; then
            log "injected ${name} for ${host} — ${hostname} — this session only."
        else
            log "injected ${name} for host ${host} — this session only."
        fi
    else
        log "injected ${name}, but keys/${name}.host is missing: nothing will use this key until you set it."
    fi
}

# --- env injection (`aegis shell --env`) --------------------------------------
#
# The vault holds env files under keys/envs/<project>/<app> (T35), in a plain
# KEY=VALUE format. They reach a session the same way a key does — vault ->
# stdout -> `docker exec -i` stdin -> this session's tmpfs directory, never a
# host file, never argv or `-e` — and the session wrapper below turns them into
# exported variables and deletes them before the session command starts.
#
# What that does NOT hide: the variables live in the session's environment, so
# every process in it — the agent included — can read them (`env`). Same
# property as an injected key (docs/12-secretos.md §8, D6).

# session_env_auto_names <target> — `--env auto`. The project names its env
# files in its .envrc, as a COMMENT so direnv keeps working:
#     # aegis-env: app1, app2
# and each app resolves to envs/<basename of the folder holding the .envrc>/<app>.
# The nearest .envrc wins: the search walks up from the session directory and
# stops at /workspace. Prints one vault name per line; returns 1 (reason on
# stderr) when there is nothing to load — `auto` that loads nothing is an error.
session_env_auto_names() {
    local target="$1" found dir base line app
    local -a apps=() names=()
    # The .envrc lives in a volume the host cannot see, so it is read in `dev`.
    # Answer: first line is the folder that holds it, the rest is the file.
    if ! found="$(docker_exec_path "$DEV_CONTAINER" sh -c '
            d="$1"
            while :; do
                if [ -f "$d/.envrc" ]; then printf "%s\n" "$d"; cat "$d/.envrc"; exit 0; fi
                case "$d" in
                    /workspace/*) d="${d%/*}" ;;
                    *) exit 3 ;;
                esac
            done
        ' sh "$target")"; then
        err "--env auto: no .envrc found from ${target} up to /workspace — the session was not started."
        err "add one to the project with a line '# aegis-env: <app>[, <app>...]', or name the env: --env envs/<project>/<app>"
        return 1
    fi
    dir="${found%%$'\n'*}"
    base="${dir##*/}"
    while IFS= read -r line; do
        line="${line%$'\r'}"
        [[ "$line" =~ ^[[:space:]]*#[[:space:]]*aegis-env:(.*)$ ]] || continue
        IFS=',' read -ra apps <<<"${BASH_REMATCH[1]}"
        for app in "${apps[@]}"; do
            app="${app#"${app%%[![:space:]]*}"}"
            app="${app%"${app##*[![:space:]]}"}"
            [[ -n "$app" ]] || continue
            if [[ ! "$app" =~ ^[A-Za-z0-9._-]+$ || "$app" == "." || "$app" == ".." ]]; then
                err "--env auto: '${app}' in ${dir}/.envrc is not an app name (letters, digits, '.', '_', '-') — the session was not started."
                return 1
            fi
            names+=("envs/${base}/${app}")
        done
    done <<<"${found#"$dir"}"
    if [[ "${#names[@]}" -eq 0 ]]; then
        err "--env auto: ${dir}/.envrc has no '# aegis-env: <app>[, <app>...]' line — the session was not started."
        return 1
    fi
    log "--env auto: ${dir}/.envrc -> ${names[*]}" >&2
    printf '%s\n' "${names[@]}"
}

# session_inject_env <session-dir> <name...> — streams each env file into the
# session directory as env.001, env.002, ... (load order: a later file wins on
# a repeated key). Any failure removes the directory — with whatever --secret
# already put there — and stops: a session must not start half-loaded.
session_inject_env() {
    local dir="$1"
    shift
    local name i=0 missing
    for name in "$@"; do
        vault_require_name "$name" "aegis shell --env auto|<name>"
        secret_kind_gate_env "$name" || return 1
    done
    _session_env_abort() {
        docker_exec_path "$AEGIS_SESSION_CONTAINER" rm -rf "$dir" >/dev/null 2>&1 || true
        exit 1
    }
    # One throwaway container answers for every name, before any prompt.
    missing="$(vault_run ro sh -c 'for n in "$@"; do [ -f "/vault/keys/$n" ] || echo "$n"; done' sh "$@")"
    if [[ -n "$missing" ]]; then
        local m
        while IFS= read -r m; do
            err "--env: keys/${m} is not in the vault (see: aegis secret list) — the session was not started."
        done <<<"$missing"
        _session_env_abort
    fi
    # Parent shell, once: shared with --secret (an earlier prompt is reused).
    vault_ensure_pass "$@"
    docker_exec_path "$AEGIS_SESSION_CONTAINER" sh -c 'mkdir -p "$1" && chmod 700 "$1"' sh "$dir"
    for name in "$@"; do
        i=$((i + 1))
        if ! vault_open "$name" |
                docker_exec_path -i "$AEGIS_SESSION_CONTAINER" sh -c \
                    'umask 077 && cat > "$1"' sh "${dir}/env.$(printf '%03d' "$i")"; then
            err "--env: could not load keys/${name} (wrong passphrase?) — the session was not started."
            _session_env_abort
        fi
        log "loaded env ${name} — this session only; every process in it, the agent included, can read it."
    done
}

# session_inject_secret_env <session-dir> <name...> — T8: inject a vault secret's
# CONTENT as the value of an environment variable whose name IS <name> (so
# <name> must be a valid shell variable name, unlike an --env vault path). This
# is how a model credential travels into the sandbox: `aegis sandbox <repo>
# --secret ANTHROPIC_API_KEY` reads keys/ANTHROPIC_API_KEY and exports
# ANTHROPIC_API_KEY for the session only. The bytes take the same path as
# session_inject_env — vault -> stdout -> `docker exec -i` stdin -> the
# session's tmpfs (secret.NNN), never argv, never a host file, never disk that
# outlives the session — and the wrapper below exports it and deletes the file
# before the command starts. Values are single-line: a newline would end the
# KEY=VALUE line.
session_inject_secret_env() {
    local dir="$1"
    shift
    local name i=0 missing
    for name in "$@"; do
        vault_require_name "$name" "aegis sandbox --secret <VAR_NAME>"
        if [[ ! "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            err "--secret '${name}' must be a valid environment variable name (letters, digits, '_'; not starting with a digit)."
            exit 2
        fi
    done
    _session_env_abort() {
        docker_exec_path "$AEGIS_SESSION_CONTAINER" rm -rf "$dir" >/dev/null 2>&1 || true
        exit 1
    }
    missing="$(vault_run ro sh -c 'for n in "$@"; do [ -f "/vault/keys/$n" ] || echo "$n"; done' sh "$@")"
    if [[ -n "$missing" ]]; then
        local m
        while IFS= read -r m; do
            err "--secret: keys/${m} is not in the vault (see: aegis secret list) — the session was not started."
        done <<<"$missing"
        _session_env_abort
    fi
    vault_ensure_pass "$@"
    docker_exec_path "$AEGIS_SESSION_CONTAINER" sh -c 'mkdir -p "$1" && chmod 700 "$1"' sh "$dir"
    for name in "$@"; do
        i=$((i + 1))
        if ! { printf '%s=' "$name"; vault_open "$name"; } |
                docker_exec_path -i "$AEGIS_SESSION_CONTAINER" sh -c \
                    'umask 077 && cat > "$1"' sh "${dir}/secret.$(printf '%03d' "$i")"; then
            err "--secret: could not load keys/${name} (wrong passphrase?) — the session was not started."
            _session_env_abort
        fi
        log "injected ${name} as an env var — this session only; every process in it, the agent included, can read it."
    done
}

# --- BEGIN session wrapper (extracted by test/shell-env.test.js) ---
#
# The session's entry command when it carries --secret and/or --env, run by the
# container's /bin/sh (dash) as:  sh -c "$SESSION_WRAPPER_SH" _ <entry> [args...]
#
# - The EXIT trap removes only THIS session's directory (AEGIS_SSH_DIR); the
#   fallback path keeps an unset variable from widening the `rm -rf`.
# - Each env.NNN (and, since T8, secret.NNN) file is opened, then deleted, then
#   parsed: the values are out of the tmpfs before the session command starts.
#   The format is KEY=VALUE per line; blank lines and `#` comments are skipped,
#   `export ` is optional, one pair of surrounding "..." or '...' is stripped,
#   and the value is taken literally ($VAR is not expanded, the file is never
#   sourced). Keys must be shell names; AEGIS_* (the session's own) and
#   _aegis_* (this loop's) are refused. A bad line is reported by number only —
#   never its content. secret.NNN loads after every env.NNN, so a --secret wins
#   over an --env that defines the same variable.
# - "$@" runs WITHOUT exec, so the trap still fires when it returns.
read -r -d '' SESSION_WRAPPER_SH <<'AEGIS_SESSION_WRAPPER' || true
trap 'rm -rf "${AEGIS_SSH_DIR:-/run/ssh-session/__never__}"' EXIT
if [ -n "${AEGIS_SSH_DIR:-}" ]; then
    _aegis_cr=$(printf '\r')
    for _aegis_f in "$AEGIS_SSH_DIR"/env.* "$AEGIS_SSH_DIR"/secret.*; do
        [ -f "$_aegis_f" ] || continue
        exec 3< "$_aegis_f"
        rm -f "$_aegis_f"
        _aegis_n=0
        while IFS= read -r _aegis_l <&3 || [ -n "$_aegis_l" ]; do
            _aegis_n=$((_aegis_n + 1))
            _aegis_l=${_aegis_l%"$_aegis_cr"}
            _aegis_l=${_aegis_l#"${_aegis_l%%[![:space:]]*}"}
            case $_aegis_l in
                ''|'#'*) continue ;;
                export[[:space:]]*)
                    _aegis_l=${_aegis_l#export}
                    _aegis_l=${_aegis_l#"${_aegis_l%%[![:space:]]*}"} ;;
            esac
            case $_aegis_l in
                *=*) ;;
                *) echo "aegis: env: ${_aegis_f##*/} line ${_aegis_n} is not KEY=VALUE — skipped." >&2
                   continue ;;
            esac
            _aegis_k=${_aegis_l%%=*}
            _aegis_k=${_aegis_k%"${_aegis_k##*[![:space:]]}"}
            _aegis_v=${_aegis_l#*=}
            _aegis_v=${_aegis_v#"${_aegis_v%%[![:space:]]*}"}
            _aegis_v=${_aegis_v%"${_aegis_v##*[![:space:]]}"}
            case $_aegis_k in
                ''|[0-9]*|*[!A-Za-z0-9_]*)
                    echo "aegis: env: ${_aegis_f##*/} line ${_aegis_n} has an invalid name — skipped." >&2
                    continue ;;
                AEGIS_*|_aegis_*)
                    echo "aegis: env: ${_aegis_f##*/} line ${_aegis_n}: ${_aegis_k} is reserved — skipped." >&2
                    continue ;;
            esac
            case $_aegis_v in
                \"*\") _aegis_v=${_aegis_v#\"}; _aegis_v=${_aegis_v%\"} ;;
                \'*\') _aegis_v=${_aegis_v#\'}; _aegis_v=${_aegis_v%\'} ;;
            esac
            export "$_aegis_k=$_aegis_v"
        done
        exec 3<&-
    done
fi
unset _aegis_cr _aegis_f _aegis_n _aegis_l _aegis_k _aegis_v
"$@"
AEGIS_SESSION_WRAPPER
# --- END session wrapper ---

# --- secret kinds (T39.3): the kind IS the namespace -------------------------
# The prefixes used to be paint — nothing dispatched on them. Now they are the
# type system: the kind picks the namespace at write time, the content is
# validated per kind BEFORE the passphrase prompt, and each consumer (--secret
# / --env) accepts only its kinds. Seals are content-only, so renames are
# plain `mv` inside the volume (aegis secret migrate-kinds) and survive.

secret_kind_of() {
    local name="$1"
    case "$name" in
        git-ssh/*) echo "git-ssh" ;;
        server/*)  echo "server" ;;
        env/*)     echo "env" ;;
        ssh/*)     echo "legacy-ssh" ;;
        servers/*) echo "legacy-servers" ;;
        envs/*)    echo "legacy-envs" ;;
        */*)       echo "" ;;
        *)         echo "token" ;;
    esac
}

secret_kind_namespace() {
    case "$1" in
        git-ssh) echo "git-ssh/" ;;
        server)  echo "server/" ;;
        env)     echo "env/" ;;
        token)   echo "" ;;
        *)       return 1 ;;
    esac
}

# secret_kind_resolve <kind> <name> — the final vault name for a write. A name
# already carrying the kind's namespace passes through; a legacy name maps to
# its typed kind unchanged (transition: migration moves it later); a bare name
# gets the namespace prepended; anything else is a conflict and dies loudly.
secret_kind_resolve() {
    local kind="$1" name="$2" ns mine
    # NOTE: runs inside $( ) at the call site — failures RETURN 2 (never exit),
    # the caller turns the substitution's rc into the process exit code.
    ns="$(secret_kind_namespace "$kind")" || {
        err "unknown kind '${kind}' — valid: git-ssh, server, env, token."
        return 2
    }
    mine="$(secret_kind_of "$name")"
    case "$kind" in
        git-ssh) [[ "$mine" == "legacy-ssh" ]] && { printf '%s\n' "$name"; return 0; } ;;
        server)  [[ "$mine" == "legacy-servers" ]] && { printf '%s\n' "$name"; return 0; } ;;
        env)     [[ "$mine" == "legacy-envs" ]] && { printf '%s\n' "$name"; return 0; } ;;
    esac
    if [[ "$mine" == "$kind" ]]; then printf '%s\n' "$name"; return 0; fi
    if [[ -z "$ns" ]]; then
        err "kind 'token' writes at the keys/ root: '${name}' is not a bare name."
        err "use a bare name, or the --kind that matches its namespace."
        return 2
    fi
    case "$name" in
        "$ns"*) printf '%s\n' "$name"; return 0 ;;
    esac
    if [[ -n "$mine" && "$mine" != "token" ]]; then
        err "'${name}' carries the '${mine}' namespace; --kind ${kind} writes under '${ns}'."
        err "either drop --kind, or pass a bare name to place it under ${ns}."
        return 2
    fi
    printf '%s\n' "${ns}${name}"
}

# secret_kind_ask <outvar> <name> — the interactive "what are you saving?"
# menu (operator request: the CLI asks what it is sealing). Reads stdin like
# vault_confirm; NOT usable on the --stdin path (that one must pass --kind).
secret_kind_ask() {
    local __var="$1" name="$2" answer
    cat >&2 <<'KINDMENU'
aegis: what are you sealing?
  1) git-ssh   a git SSH key
  2) server    an SSH server key (+ host/port sidecars via 'secret host set')
  3) env       a project .env (KEY=VALUE lines)
  4) token     one line VAR=value (a PAT / API token)
aegis: kind [1-4]:
KINDMENU
    IFS= read -r answer || { err "no kind given: nothing was written."; return 1; }
    case "$answer" in
        1|git-ssh) printf -v "$__var" '%s' "git-ssh" ;;
        2|server)  printf -v "$__var" '%s' "server" ;;
        3|env)     printf -v "$__var" '%s' "env" ;;
        4|token)   printf -v "$__var" '%s' "token" ;;
        *) err "unknown kind answer: ${answer} (1-4)"; return 1 ;;
    esac
}

# secret_kind_validate_text <kind> <text> — content rules for the --stdin path
# (the plaintext is IN MEMORY here; never written anywhere to validate it).
secret_kind_validate_text() {
    local kind="$1" text="$2"
    [[ -n "$text" ]] || { err "content is EMPTY — nothing to seal."; return 1; }
    case "$kind" in
        env)
            if printf '%s\n' "$text" | grep -Ev '^[[:space:]]*(#|$)' | grep -qEv '^[A-Za-z_][A-Za-z0-9_]*='; then
                err "kind 'env' requires every line to be KEY=VALUE (comments and blank lines allowed)."
                return 1
            fi
            ;;
        token)
            if [[ "$(printf '%s' "$text" | grep -c '')" -ne 1 ]]; then
                err "kind 'token' is ONE line of VAR=value — multi-line content is kind 'env'."
                return 1
            fi
            if [[ ! "$text" =~ ^[A-Za-z_][A-Za-z0-9_]*=.+$ ]]; then
                err "kind 'token' requires VAR=value (for example: AZURE_DEVOPS_PAT=…)."
                return 1
            fi
            ;;
        git-ssh|server)
            if [[ "$text" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
                err "this looks like an env — use --kind env (git-ssh/server carry key material, not VAR=value)."
                return 1
            fi
            ;;
        *)
            err "unknown kind '${kind}' — valid: git-ssh, server, env, token."
            return 1
            ;;
    esac
}

# secret_kind_validate <kind> <file> — content rules for the --from path (the
# file already exists on the host; this only READS it before the confirm).
secret_kind_validate() {
    local kind="$1" file="$2" first bad
    [[ -s "$file" ]] || { err "content is EMPTY (0 bytes) — nothing to seal."; return 1; }
    case "$kind" in
        env)
            bad="$(grep -Ev '^[[:space:]]*(#|$)' "$file" | grep -Ev '^[A-Za-z_][A-Za-z0-9_]*=' | head -n 1)"
            if [[ -n "$bad" ]]; then
                err "kind 'env' requires every line to be KEY=VALUE (offending line: ${bad})."
                return 1
            fi
            ;;
        token)
            if [[ "$(grep -c '' "$file")" -ne 1 ]]; then
                err "kind 'token' is ONE line of VAR=value — multi-line content is kind 'env'."
                return 1
            fi
            first="$(head -n 1 "$file")"
            if [[ ! "$first" =~ ^[A-Za-z_][A-Za-z0-9_]*=.+$ ]]; then
                err "kind 'token' requires VAR=value (for example: AZURE_DEVOPS_PAT=…)."
                return 1
            fi
            ;;
        git-ssh|server)
            first="$(head -n 1 "$file")"
            if [[ "$first" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
                err "this looks like an env — use --kind env (git-ssh/server carry key material, not VAR=value)."
                return 1
            fi
            ;;
        *)
            err "unknown kind '${kind}' — valid: git-ssh, server, env, token."
            return 1
            ;;
    esac
}

cmd_secret_put() {
    local name="" from="" piped=0 kind="" promptmode=0 varname=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from) [[ -n "${2:-}" ]] || { err "--from requires a file"; exit 2; }; from="$2"; shift 2 ;;
            --kind) [[ -n "${2:-}" ]] || { err "--kind requires a value (git-ssh|server|env|token)"; exit 2; }; kind="$2"; shift 2 ;;
            --stdin) piped=1; shift ;;
            --prompt) promptmode=1; shift ;;
            --var) [[ -n "${2:-}" ]] || { err "--var requires a variable name"; exit 2; }; varname="$2"; shift 2 ;;
            -*) err "unknown option for 'aegis secret put': $1"; exit 2 ;;
            *) name="$1"; shift ;;
        esac
    done
    vault_require_name "$name" "aegis secret put <name> --from <host-file>  (or:  cat <file> | aegis secret put <name> --stdin)"
    if [[ -n "$from" && "$piped" -eq 1 ]]; then
        err "--from and --stdin cannot be combined: pick one source for keys/${name}."
        exit 2
    fi
    if [[ -n "$from" && "$promptmode" -eq 1 ]]; then
        err "--from and --prompt cannot be combined: --prompt types the value; --from reads it from a file."
        exit 2
    fi
    if [[ "$piped" -eq 1 && "$promptmode" -eq 1 ]]; then
        err "--stdin and --prompt cannot be combined: stdin carries the bytes; --prompt reads the terminal."
        exit 2
    fi
    if [[ -z "$from" && "$piped" -eq 0 && "$promptmode" -eq 0 ]]; then
        if [[ -t 0 ]]; then
            promptmode=1   # interactive terminal with no source: ask, do not scold
        else
            err "usage: aegis secret put <name> --from <host-file>"
            err "       or seal from a pipe:  cat <file> | aegis secret put <name> --stdin"
            err "       or run it interactively from a terminal:  aegis secret put <name> --prompt"
            exit 2
        fi
    fi

    # T39.3 kinds: the kind IS the namespace. Scripts pass --kind; a name that
    # already carries a known (or legacy) namespace implies its kind; anything
    # else is asked interactively. --stdin cannot ask — stdin carries the
    # secret, so it REQUIRES --kind. Content is validated per kind before any
    # passphrase prompt: a wrong-typed secret never reaches the seal.
    if [[ "$piped" -eq 1 && -z "$kind" ]]; then
        err "--stdin carries the secret — the CLI cannot ask what it is: pass --kind <git-ssh|server|env|token>."
        exit 2
    fi
    local pre_kind
    pre_kind="$(secret_kind_of "$name")"
    if [[ -z "$kind" ]]; then
        case "$pre_kind" in
            git-ssh|server|env) kind="$pre_kind" ;;
            legacy-ssh) kind="git-ssh" ;;
            legacy-servers) kind="server" ;;
            legacy-envs) kind="env" ;;
            *) secret_kind_ask kind "$name" || exit 2 ;;
        esac
    fi
    name="$(secret_kind_resolve "$kind" "$name")" || exit $?
    case "$pre_kind" in
        legacy-*) log "keys/${name} uses a legacy namespace — 'aegis secret migrate-kinds' moves it to the typed one." ;;
    esac

    # T39.1: the same seal, from a pipe — no clear-text copy on the host at all.
    # The bytes travel <file or pipe> -> this process memory -> openssl -> the
    # volume tmp (vault_seal_stdin); the passphrase is still typed twice, but
    # read from the TERMINAL: stdin here carries the secret, not the answer
    # (vault_read_hidden_line). There is no vault_confirm on this path because
    # it would read the same stdin the data is arriving on; a scripted
    # `cat <file> | aegis secret put <name> --stdin` is the point of the flag,
    # and the replace warning below is said out loud instead.
    if [[ "$promptmode" -eq 1 ]]; then
        # T39.5: the owner types the value — masked twice, in memory only, the
        # same seal as --stdin. Only one-line token secrets: everything else is
        # multi-line and belongs to --from.
        [[ "$kind" == "token" ]] || {
            err "put --prompt seals ONE-LINE token secrets (VAR=value)."
            err "for git-ssh, server or env (multi-line), seal from a host file: aegis secret put ${name} --kind <k> --from <file>."
            exit 2
        }
        if [[ -z "$varname" ]]; then
            printf 'variable name (e.g. AEGIS_RELEASE_PASSPHRASE): ' >&2
            IFS= read -r varname
            [[ -n "$varname" ]] || { err "empty variable name: nothing was written."; exit 2; }
        fi
        local v1 v2
        printf 'value for %s: ' "$varname" >&2
        vault_read_hidden_line v1 || { err "no value entered: nothing was written."; exit 2; }
        [[ -n "$v1" ]] || { err "empty value: nothing was written."; exit 2; }
        printf 'repeat: ' >&2
        vault_read_hidden_line v2 || { err "no repeat entered: nothing was written."; exit 2; }
        if [[ "$v1" != "$v2" ]]; then
            err "the two entries do not match: keys/${name} was NOT written."
            exit 2
        fi
        local varvalue="${varname}=${v1}"
        vault_prompt_pass_seal "$name" || exit 1
        local prc=0
        vault_seal_stdin "$name" "$kind" <<<"$varvalue" || prc=$?
        VAULT_PASS=""
        [[ $prc -eq 0 ]] || exit $prc
        log "keys/${name} sealed (token, VAR=value — the value was typed, never stored in the clear)."
        return 0
    fi

    if [[ "$piped" -eq 1 ]]; then
        if [[ -t 0 ]]; then
            err "--stdin has no piped data. Pipe the secret in:"
            err "  cat <file> | aegis secret put ${name} --stdin"
            exit 2
        fi
        if vault_run ro sh -c '[ -d "/vault/keys/$1" ] && echo yes || echo no' sh "$name" | grep -q yes; then
            err "keys/${name} is a FOLDER in the vault (a client folder holds its projects' secrets)."
            err "pick another name for the account key — for example 'sbp-github' — and try again."
            exit 1
        fi
        if vault_run ro sh -c '[ -e "/vault/keys/$1" ] && echo yes || echo no' sh "$name" | grep -q yes; then
            log "keys/${name} already exists: this REPLACES its content."
        fi
        vault_prompt_pass_seal "$name" || exit 1
        local rc=0
        vault_seal_stdin "$name" "$kind" || rc=$?
        VAULT_PASS=""
        [[ "$rc" -eq 0 ]] || exit "$rc"
        return 0
    fi

    # vault-seal-windows: a Windows-style path (`C:\temp\probe.txt`) is VALID
    # input — the seal works on the file's bytes whatever style names it. When
    # cygpath exists (Git for Windows), normalize first so the confirm line and
    # tildify show the POSIX path the shell actually opens; keep the original
    # if cygpath cannot convert it.
    if command -v cygpath >/dev/null 2>&1; then from="$(cygpath -u "$from" 2>/dev/null || printf '%s' "$from")"; fi
    if [[ ! -f "$from" ]]; then
        err "no such file: ${from}"
        exit 1
    fi
    # T39.3: the kind's content rules run BEFORE the confirm — a wrong-typed
    # secret must never reach the passphrase prompt (fail-closed, says how to fix).
    secret_kind_validate "$kind" "$from" || exit 1

    # A name that already exists as a FOLDER cannot hold a key: client folders hold
    # their projects' secrets (keys/sbp/proyecto_sac/...), and `cp` into one would
    # silently write keys/<name>/in and report success. Say it instead of doing that.
    if vault_run ro sh -c '[ -d "/vault/keys/$1" ] && echo yes || echo no' sh "$name" | grep -q yes; then
        err "keys/${name} is a FOLDER in the vault (a client folder holds its projects' secrets)."
        err "pick another name for the account key — for example 'sbp-github' — and try again."
        exit 1
    fi
    if vault_run ro sh -c '[ -e "/vault/keys/$1" ] && echo yes || echo no' sh "$name" | grep -q yes; then
        log "keys/${name} already exists: this REPLACES its content."
    fi
    # An empty source is almost always a command upstream that failed quietly (an
    # ssh-keyscan that could not agree on a KEX, say). Storing it would leave a
    # broken secret that ssh refuses to use, so it is called out before confirming.
    local empty_note=""
    if [[ ! -s "$from" ]]; then
        empty_note="  <-- WARNING: the source file is EMPTY (0 bytes)"
    fi
    if ! vault_confirm "write $(tildify "$from") to keys/${name}?${empty_note}"; then
        log "cancelled: nothing was written."
        exit 0
    fi

    # T39: everything written through this path is SEALED, never copied plain.
    # The passphrase is typed twice by whoever writes, lives only in this
    # shell's memory and the openssl child's env, and is cleared right after.
    vault_prompt_pass_seal "$name" || exit 1
    local rc=0
    vault_seal "$name" "$from" || rc=$?
    VAULT_PASS=""
    [[ "$rc" -eq 0 ]] || exit "$rc"
}

# T39.1 — the sidecars, SEALED on their way in. T39 closed the thread "the
# sidecar has no write path from the CLI: hand-written, a new one stays
# [clear] until the next migration": `host set` writes keys/<name>.host,
# .hostname, .user, .port and .known_hosts through vault_seal_stdin, so every
# file this command touches is encrypted before it lands. The main file is
# NOT touched (decision 1): sidecars describe a key that must already exist.
#
# Values that are metadata (host/hostname/user/port) travel as flags — the
# same treatment a ~/.ssh/config line gets (decision 3). known_hosts is
# sensitive material and travels by FILE, piped into the seal: the file was
# already clear on the host (the dev put it there — ssh-keyscan output, say),
# and this command never writes a new clear copy anywhere.
#
# One prompt for the whole invocation (D7-ter): vault_prompt_pass_seal once,
# VAULT_PASS cleared on every path out of the seal loop — explicitly, not in
# a trap, because the launcher keeps exactly ONE EXIT trap (_telemetry_on_exit)
# and a second one would replace it.
cmd_secret_edit() {
    local name="${1:-}"
    vault_require_name "$name" "aegis secret edit <name>"
    # Guard-first (T39.1 D1's pattern): a wrong target never reaches a prompt.
    if vault_run ro sh -c '[ -d "/vault/keys/$1" ] && echo yes || echo no' sh "$name" | grep -q yes; then
        err "keys/${name} is a FOLDER in the vault (a client folder holds its projects' secrets)."
        exit 1
    fi
    if ! vault_run ro sh -c '[ -e "/vault/keys/$1" ] && echo yes || echo no' sh "$name" | grep -q yes; then
        err "no such secret: keys/${name} — create one with 'aegis secret put'."
        exit 2
    fi

    # Owner decisions (2026-10-19): the edit opens an editor INSIDE the
    # terminal, in a throwaway container that is RAM ONLY (--tmpfs, read-only
    # rootfs, no network) and carries NO vault volume — the decrypted value
    # never enters any container that can reach the secrets, never touches
    # host disk, and never becomes an image layer. The plaintext self-destructs
    # with the container (sleep 300 bounds it); the vault passphrase is the
    # authorization, and only the re-sealed ciphertext reaches the volume.
    # The editor is NANO in a dedicated editor image (owner decision,
    # 2026-10-21: busybox vi opens in normal mode — typing does nothing unless
    # you know to press i first — and a secrets editor must never require vi
    # lessons). The image is pulled and signature-verified with the same
    # licensed flow as the workstation image, because the value passes
    # through it. Pull and verify run BEFORE the passphrase prompt: a missing
    # license or a bad signature must fail before asking the human anything.
    local editor_ref="${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${AEGIS_SECRET_EDIT_IMAGE_TAG}"
    log "editing keys/${name}: this opens nano in a throwaway RAM-only container (the new value REPLACES the old one; sidecars are untouched)."
    secret_edit_editor_ready \
        || { err "the editor image could not be pulled and verified; keys/${name} was NOT changed."; exit 1; }
    vault_prompt_pass_seal "$name" || exit 1

    # Decrypt the current value into THIS process's memory (vault_open buffers
    # and never prints uninvited; the passphrase is already prepared).
    local current rc=0
    current="$(vault_open "$name")" || { VAULT_PASS=""; err "could not decrypt keys/${name}: it was NOT changed."; exit 1; }

    local cid
    cid="$(MSYS_NO_PATHCONV=1 docker run -d --rm --network none --read-only \
        --tmpfs /run/secret:size=1m,mode=600 \
        "$editor_ref" sleep 300)" \
        || { VAULT_PASS=""; err "could not start the editor container: keys/${name} was NOT changed."; exit 1; }

    fail_edit() {
        MSYS_NO_PATHCONV=1 docker rm -f "$cid" >/dev/null 2>&1
        VAULT_PASS=""
        err "$*: keys/${name} was NOT changed."
        exit 1
    }

    printf '%s' "$current" | MSYS_NO_PATHCONV=1 docker exec -i "$cid" \
        sh -c 'cat > /run/secret/value && chmod 600 /run/secret/value' \
        || fail_edit "could not hand the value to the editor"
    MSYS_NO_PATHCONV=1 docker exec -it "$cid" nano /run/secret/value \
        || fail_edit "the editor did not finish"
    local v1
    v1="$(MSYS_NO_PATHCONV=1 docker exec "$cid" cat /run/secret/value)" \
        || fail_edit "could not read back the edited value"
    MSYS_NO_PATHCONV=1 docker rm -f "$cid" >/dev/null 2>&1
    [[ -n "$v1" ]] || { VAULT_PASS=""; err "empty value: refusing to edit keys/${name} to nothing — 'aegis secret rm' deletes it."; exit 2; }

    # The kind is fixed by the entry's own namespace (it passed validation when
    # it was created); legacy namespaces map forward, anything else skips
    # content validation rather than re-asking what the vault already knows.
    local kind pre_kind
    pre_kind="$(secret_kind_of "$name")"
    case "$pre_kind" in
        git-ssh|server|env|token) kind="$pre_kind" ;;
        legacy-ssh) kind="git-ssh" ;;
        legacy-servers) kind="server" ;;
        legacy-envs) kind="env" ;;
        *) kind="" ;;
    esac
    vault_seal_stdin "$name" "$kind" <<<"$v1" || rc=$?
    VAULT_PASS=""
    [[ "$rc" -eq 0 ]] || exit "$rc"
    log "keys/${name} updated (sealed)."
}

cmd_secret_host_set() {
    local name="" host="" hostname="" user="" port="" khfile=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --host) [[ -n "${2:-}" ]] || { err "--host requires a value"; exit 2; }; host="$2"; shift 2 ;;
            --hostname) [[ -n "${2:-}" ]] || { err "--hostname requires a value"; exit 2; }; hostname="$2"; shift 2 ;;
            --user) [[ -n "${2:-}" ]] || { err "--user requires a value"; exit 2; }; user="$2"; shift 2 ;;
            --port) [[ -n "${2:-}" ]] || { err "--port requires a value"; exit 2; }; port="$2"; shift 2 ;;
            --known-hosts-from) [[ -n "${2:-}" ]] || { err "--known-hosts-from requires a file"; exit 2; }; khfile="$2"; shift 2 ;;
            -*) err "unknown option for 'aegis secret host set': $1"; exit 2 ;;
            *) name="$1"; shift ;;
        esac
    done
    vault_require_name "$name" "aegis secret host set <name> [--host H] [--hostname H] [--user U] [--port P] [--known-hosts-from FILE]"
    if [[ -z "$host$hostname$user$port$khfile" ]]; then
        err "usage: aegis secret host set <name> [--host H] [--hostname H] [--user U] [--port P] [--known-hosts-from FILE]"
        err "nothing to write: pass at least one field."
        exit 2
    fi
    if [[ -n "$port" && ! "$port" =~ ^[0-9]+$ ]]; then
        err "--port must be a number (aegis shell reads it as the ssh port); got '${port}'."
        exit 2
    fi
    if [[ -n "$khfile" && ! -f "$khfile" ]]; then
        err "no such file: ${khfile}"
        exit 1
    fi
    # Sidecars describe a key; without the main entry there is nothing for
    # them to attach to. enc or plain both count: sealing a sidecar for a
    # not-yet-migrated legacy key is exactly right.
    case "$(vault_state "$name")" in
        enc|plain) ;;
        *)
            err "no such secret: keys/${name}  (see: aegis secret list)"
            err "write the key first — aegis secret put ${name} --from <host-file> — then its sidecars."
            exit 2
            ;;
    esac

    vault_prompt_pass_seal "$name" || exit 1

    # Fixed order (session_inject_secret's convention): .host .hostname
    # .user .port .known_hosts. Atomicity is PER FILE (decision 6): each
    # field is a full verify-before-replace seal on its own, there is NO
    # transaction across files — a later failure leaves the earlier fields
    # sealed, says so, and a re-run of the remaining flags is idempotent.
    local -a sidecars=() sources=() sealed=() side src
    local i rc=0
    [[ -n "$host" ]] && { sidecars+=("${name}.host"); sources+=("$host"); }
    [[ -n "$hostname" ]] && { sidecars+=("${name}.hostname"); sources+=("$hostname"); }
    [[ -n "$user" ]] && { sidecars+=("${name}.user"); sources+=("$user"); }
    [[ -n "$port" ]] && { sidecars+=("${name}.port"); sources+=("$port"); }
    [[ -n "$khfile" ]] && { sidecars+=("${name}.known_hosts"); sources+=("$khfile"); }
    for i in "${!sidecars[@]}"; do
        side="${sidecars[$i]}"; src="${sources[$i]}"
        if vault_run ro sh -c '[ -e "/vault/keys/$1" ] && echo yes || echo no' sh "$side" | grep -q yes; then
            log "keys/${side} already exists: this REPLACES its content."
        fi
        if [[ "$side" == "${name}.known_hosts" ]]; then
            vault_seal_stdin "$side" < "$src" || rc=$?
        else
            printf '%s\n' "$src" | vault_seal_stdin "$side" || rc=$?
        fi
        if [[ "$rc" -ne 0 ]]; then
            VAULT_PASS=""
            err "keys/${side} was not written: sealing stopped at this field."
            if [[ "${#sealed[@]}" -gt 0 ]]; then
                err "already sealed by this command: ${sealed[*]} (each field is atomic on its own; there is no rollback across files)."
            fi
            err "re-run 'aegis secret host set ${name} ...' with only the remaining fields — replacing what already went through is harmless."
            exit 1
        fi
        sealed+=("$side")
    done
    VAULT_PASS=""
    log "sidecars of keys/${name} sealed: ${sealed[*]}"
}

# The one operation with no undo: the vault is not part of `aegis backup` yet, so
# it says that out loud before asking.
cmd_secret_rm() {
    local name="${1:-}"
    vault_require_name "$name" "aegis secret rm <name>"
    log "the vault is not backed up yet: removing this cannot be undone."
    if ! vault_confirm "remove keys/${name}?"; then
        log "cancelled: nothing was removed."
        exit 0
    fi
    vault_run rw sh -c '
        rm -f "/vault/keys/$1" || exit 1
        rmdir "$(dirname "/vault/keys/$1")" 2>/dev/null || true
        echo "removed: keys/$1"
    ' sh "$name"
}

# secret-kinds K4 — aegis secret migrate-kinds: rename the legacy namespaces
# (ssh/ -> git-ssh/, servers/ -> server/, envs/ -> env/) INSIDE the volume.
# Seals are content-only — the name never travels inside the ciphertext — so
# a plain `mv` preserves every seal: nothing is decrypted or re-encrypted,
# no plaintext ever exists, and the round-trip spot-check proves it. One
# passphrase, one confirm, one container for the whole batch; refuses on any
# destination collision; idempotent (nothing legacy -> nothing to do).
cmd_secret_migrate_kinds() {
    local plan coll tree first
    plan="$(vault_run ro sh -c '
        for t in ssh servers envs; do
            [ -d "/vault/keys/$t" ] || continue
            echo "tree $t"
            find "/vault/keys/$t" -type f | sort
        done
    ' sh)"
    if [[ -z "$plan" ]]; then
        log "nothing to migrate: no legacy namespaces (ssh/, servers/, envs/) under keys/."
        return 0
    fi
    echo "$plan"
    coll="$(vault_run ro sh -c 'for t in git-ssh server env; do [ -d "/vault/keys/$t" ] && echo "$t"; done
true' sh)"
    if [[ -n "$coll" ]]; then
        err "refusing: target namespace(s) already exist: ${coll//$'\n'/, }."
        err "resolve by hand (the launcher will not mix typed and legacy trees)."
        return 1
    fi
    [[ -n "${VAULT_PASS:-}" ]] || vault_prompt_pass
    if ! vault_confirm "rename the legacy namespaces above (seals preserved, nothing re-encrypted)?"; then
        log "cancelled: nothing was written."
        return 0
    fi
    if ! vault_run rw sh -c '
        if [ -d /vault/keys/ssh ];     then mv /vault/keys/ssh /vault/keys/git-ssh; fi
        if [ -d /vault/keys/servers ]; then mv /vault/keys/servers /vault/keys/server; fi
        if [ -d /vault/keys/envs ];    then mv /vault/keys/envs /vault/keys/env; fi
    ' sh; then
        err "migration failed midway — inspect keys/ (moves are per-tree; re-run after fixing)."
        return 1
    fi
    local unsealed
    unsealed="$(vault_run ro sh -c '
        find /vault/keys/git-ssh /vault/keys/server /vault/keys/env -type f 2>/dev/null | while IFS= read -r f; do
            [ "$(head -c 8 "$f" 2>/dev/null)" = U2FsdGVk ] || echo "$f"
        done
    ' sh)"
    if [[ -n "$unsealed" ]]; then
        err "post-migration check found UNSEALED files under the new namespaces:"
        err "$unsealed"
        return 1
    fi
    for tree in git-ssh server env; do
        first="$(vault_run ro sh -c 'find "$1" -type f 2>/dev/null | sort | head -n 1' sh "/vault/keys/$tree")"
        [[ -n "$first" ]] || continue
        if ! { ( export VAULT_PASS
                  vault_run ro sh -c 'cat "$1"' sh "$first" |
                  openssl enc -d -a -aes-256-cbc -pbkdf2 -md sha512 \
                      -iter "$AEGIS_VAULT_ITER" -pass env:VAULT_PASS >/dev/null 2>&1 ); }; then
            err "decrypt spot-check FAILED for keys/${first#/vault/keys/} — inspect keys/."
            return 1
        fi
    done
    log "migrated: ssh/ to git-ssh/, servers/ to server/, envs/ to env/ — seals preserved, nothing re-encrypted."
    cat <<'EOF'
aegis: update your references by hand (the launcher cannot see them):
  [ ] aegis shell/herdr lines: --secret ssh/X -> --secret git-ssh/X ; --secret servers/X -> --secret server/X
  [ ] .envrc aegis-env: mappings pointing at envs/... -> env/...
  [ ] scripts/docs quoting the old namespaces
aegis: a second `aegis secret migrate-kinds` is a no-op.
EOF
}

cmd_secret() {
    local action="${1:-list}"
    [[ $# -gt 0 ]] && shift || true
    case "$action" in
        list) cmd_secret_list "$@" ;;
        show) cmd_secret_show "$@" ;;
        put) cmd_secret_put "$@" ;;
        edit) cmd_secret_edit "$@" ;;
        host)
            local sub="${1:-}"
            [[ $# -gt 0 ]] && shift || true
            case "$sub" in
                set) cmd_secret_host_set "$@" ;;
                *)
                    err "unknown 'aegis secret host' subcommand: ${sub:-(none)}"
                    err "usage: aegis secret host set <name> [--host H] [--hostname H] [--user U] [--port P] [--known-hosts-from FILE]"
                    exit 2
                    ;;
            esac
            ;;
        rm) cmd_secret_rm "$@" ;;
        migrate-kinds)
            # Client-redesign L3: retired. The legacy namespaces above (if any
            # are still on disk) keep working with the migrate hint in
            # `secret list`; new secrets are always written kinded.
            err "'aegis secret migrate-kinds' was retired: legacy secret namespaces keep working; new secrets are stored kinded."
            err "  inspect what you have:  aegis secret list"
            exit 2
            ;;
        help|-h|--help) cmd_secret_help ;;
        *)
            err "unknown 'aegis secret' subcommand: $action"
            err "usage: aegis secret [list|show <name>|put <name> --prompt|--put <name> [--kind K] --from <host-file>|put <name> --kind K --stdin (piped)|edit <name>|host set <name> [--host H ...]|migrate-kinds|rm <name>]"
            err "       aegis shell --secret <name> [--secret <name2>] --env auto|--env <vault-name>"
            exit 2
            ;;
    esac
}

cmd_secret_help() {
    cat <<'EOF'
aegis secret — the vault (never mounted into the workstation)

  aegis secret list             What is in the vault: names, sizes and dates of
                                the secret side, and the non-secret folders.
                                Never prints content.
  aegis secret show <name>      Prints ONE secret's content, after a confirmation.
  aegis secret put <name> [--kind git-ssh|server|env|token] --from <host-file>
                                Writes a file into the vault under the kind's
                                namespace (git-ssh/, server/, env/, or the keys/
                                root for tokens). The content is VALIDATED per
                                kind before the passphrase is asked; without
                                --kind the CLI asks what you are sealing. If the
                                name already exists it REPLACES its content (it
                                says so first). The file never crosses the
                                terminal. What is written is SEALED: the
                                passphrase is typed twice, a mismatch writes
                                nothing.
  aegis secret edit <name>      -- see its own block above.
  aegis secret put <name> --prompt [--var NAME] [--kind token]
                                ASKS for the value: masked, typed twice, in
                                the terminal — no host file, no pipe (the
                                recommended flow from PowerShell/cmd, which
                                cannot pipe to bash). One-line token secrets
                                only; multi-line kinds use --from/--stdin.
                                The same seal with the bytes coming from a PIPE
                                instead of a host file — no clear-text copy is
                                ever written:
                                    cat <file> | aegis secret put <name> --kind token --stdin
                                --kind is REQUIRED here: stdin carries the
                                secret, so the CLI cannot ask. The passphrase is
                                still typed twice, read from the terminal (not
                                from the pipe).
  aegis secret edit <name>      Changes ONE secret's value by opening nano in a
                                throwaway RAM-only container (tmpfs, no
                                network, no vault volume): the decrypted
                                content never touches host disk or any image
                                layer, and the container self-destructs after
                                5 minutes. On exit the content is re-sealed
                                with the same verify-before-replace as put.
                                The old value is never printed; sidecars are
                                untouched. Needs an interactive terminal;
                                scripts use put --stdin.
  aegis secret host set <name> [--host H] [--hostname H] [--user U] [--port P]
                               [--known-hosts-from FILE]
                                Writes the SIDECARS of an existing key, SEALED on
                                the spot (T39.1) — a new sidecar never waits for
                                a migration. Metadata travels by flag; sensitive
                                material (known_hosts) only by FILE. One prompt
                                for the whole set. Each field replaces atomically;
                                there is no rollback across fields (re-run says
                                which remain).
  aegis secret rm <name>        Removes one secret. There is no undo: the vault is
                                not part of `aegis backup` yet.
  aegis secret migrate-kinds    Renames the legacy namespaces INSIDE the vault
                                (ssh/ -> git-ssh/, servers/ -> server/, envs/ ->
                                env/). Seals are content-only and survive the
                                move: nothing is decrypted or re-encrypted.
                                Refuses collisions; idempotent; prints the
                                references to update by hand.

The vault lives in the Docker volume aegis-workstation-secrets and is reached
only through a throwaway container (no network, read-only rootfs). Secrets live
under keys/; data/ holds material that is not secret and is never touched here.
T39: keys/ is encrypted at rest (openssl AES-256-CBC + PBKDF2-SHA512). The
passphrase is the dev's alone — typed per operation, never stored anywhere; a
lost passphrase means the secret is unrecoverable, by design. Pre-T39 files
stay readable until the migration seals them (slice 2).

To USE a key in a session:
  aegis shell --secret <name> [--secret <another>] ...
A name is the path under keys/ and carries its KIND as the namespace (T39.3):
--secret git-ssh/personal, --secret server/sbp/<...> (SSH identities);
--env env/<project> and root tokens (VAR=value) go through --env instead.
Legacy namespaces (ssh/, servers/, envs/) keep working with a warning until
'aegis secret migrate-kinds' renames them.
The private key is written into a per-session tmpfs (never into ~/.ssh, which is
persistent) and removed when the session ends. Each session gets its OWN directory
there, so several at once (herdr panes, two shells) never disturb each other. The
metadata it needs lives next to the key: keys/<name>.host (which host to configure)
and keys/<name>.known_hosts (the host key, provided by you — without it ssh refuses,
by design). `aegis secret host set` writes those sidecars sealed (T39.1).
Repeat --secret to bring in more than one key; inside the session,
`ssh -F "$AEGIS_SSH_CONFIG" -T git@<host>` tests the same chain git will use.

To USE env vars from the vault:
  aegis shell --env auto|--env <name> [--env ...] ...
--env envs/sbp/proyecto_sac/webapp: a name under keys/, like --secret.
--env auto: the nearest .envrc, from the session directory up to /workspace,
names the apps in a comment line (direnv ignores it):
    # aegis-env: webapp, worker
and each one loads keys/envs/<name of the folder holding the .envrc>/<app>.
No .envrc, or no such line, is an error: the session does not start.
The file is KEY=VALUE per line: blank lines and # comments are skipped,
`export ` is optional, one pair of surrounding "..." or '...' is stripped, and
the value is literal ($VAR is not expanded; the file is never sourced). One
line, one value. Keys must be shell names; AEGIS_* keys are skipped. A later
--env wins on a repeated key.
The values travel vault -> session tmpfs (mode 600, RAM only) and are never
written to the host or passed as arguments; the session wrapper reads them into
its environment and deletes the files before your shell starts. They ARE
visible to everything in the session — the agent included (`env`) — so load
only what that session needs.
EOF
}

# Names, sizes and dates — metadata only, never content.
cmd_secret_list() {
    log "vault ${AEGIS_VAULT_VOLUME}, read-only through a throwaway container"
    vault_run ro sh -c "$LIST_MARK_SH" sh /vault
    echo
    vault_run ro sh -c '
        echo "not secret (data/), kept as-is:"
        if [ -d /vault/data ] && [ -n "$(ls -A /vault/data 2>/dev/null)" ]; then
            find /vault/data -mindepth 1 -maxdepth 2 -type d 2>/dev/null | sort | sed "s#/vault/##; s/^/  /"
        else
            echo "  (empty)"
        fi
    '
}

# One secret's content, on purpose and with an explicit confirmation: it travels
# over stdout, never through a host path (D3). The name is validated against
# keys/ so nothing in data/ can be pulled out by mistake (D2).
cmd_secret_show() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        err "usage: aegis secret show <name>   (see: aegis secret list)"
        exit 2
    fi
    case "$name" in
        /*|*..*|data|data/*|keys|keys/*)
            err "refusing: '${name}' is not a name under keys/"
            exit 2
            ;;
    esac
    local state
    state="$(vault_state "$name")"
    if [[ "$state" == missing ]]; then
        err "no such secret: keys/${name}  (see: aegis secret list)"
        exit 1
    fi
    local answer
    if [[ "$state" == plain ]]; then
        printf 'aegis: keys/%s is stored IN CLEAR (T39 migration pending) — print it? [y/N] ' "$name"
    else
        printf 'aegis: print the content of keys/%s? [y/N] ' "$name"
    fi
    read -r answer
    case "$answer" in
        y|Y|yes|YES) ;;
        *)
            log "cancelled: nothing was printed."
            exit 0
            ;;
    esac
    vault_ensure_pass "$name"
    vault_open "$name"
}

# Keeps only the newest AEGIS_BACKUP_KEEP timestamped backups of an install
# target (<dst>.bak-<timestamp>), deleting older ones. Called right after a
# fresh backup is created, so that one always survives the prune. Without
# this, every `aegis install`/`update` attempt — including every retry
# during a debugging session — left its own backup forever (confirmed on a
# real machine: 40+ accumulated over two weeks). Never fatal: a stray
# permission error on one old backup is a warning, not a reason to fail an
# install that already succeeded. Lexicographic sort works because the
# `%Y%m%dT%H%M%SZ` timestamp format already sorts chronologically.
AEGIS_BACKUP_KEEP="${AEGIS_BACKUP_KEEP:-3}"
_prune_backups() {
    local dst="$1" keep="${2:-$AEGIS_BACKUP_KEEP}" base dir name
    base="$(basename "${dst%/}")"
    dir="$(dirname "${dst%/}")"
    [[ -d "$dir" ]] || return 0
    local -a backups=()
    for name in "${dir}/${base}.bak-"*; do
        [[ -d "$name" ]] || continue
        backups+=("$name")
    done
    local total="${#backups[@]}"
    (( total > keep )) || return 0
    IFS=$'\n' backups=($(printf '%s\n' "${backups[@]}" | sort)); unset IFS
    local i
    for ((i = 0; i < total - keep; i++)); do
        rm -rf "${backups[$i]}" 2>/dev/null \
            || err "WARNING: could not remove old backup: ${backups[$i]}"
    done
}

# T10 — the sandbox sibling of cmd_install's block below. Same shape (copy the
# template tree OUTSIDE every mount, back up what was there, verify the copy),
# its own source/destination, so `aegis install`/`aegis update` cover BOTH
# templates. The compose the host runs for a sandbox must not live in a folder
# the (RW-mounted, untrusted) sandbox repo can edit — the T18 escape, one
# template over.
#
# A missing source is NOT an error: a host with no checkout (install-only) has
# no sandbox template either, and that must not break `aegis install`.
install_sandbox_template() {
    local dry_run="$1" force="$2"
    local src="${AEGIS_INSTALL_SANDBOX_SOURCE:-}"
    local dst="${AEGIS_SANDBOX_INSTALL_DIR%/}"
    local src_native dst_native
    src_native="$(_to_native_path "$src")"
    dst_native="$(_to_native_path "$dst")"

    if [[ ! -f "${src_native}/.devcontainer/docker-compose.yml" ]]; then
        log "sandbox: no template at ${src} — skipping (nothing to install there)."
        return 0
    fi
    if [[ "${src_native}" == "${dst_native}" ]]; then
        err "sandbox source and destination are the same folder (${dst}) — nothing to copy."
        return 1
    fi
    local probe
    probe="$(dirname "${dst_native%/}")"
    if [[ "${force}" != "1" ]] && git -C "${probe}" rev-parse --show-toplevel >/dev/null 2>&1; then
        err "the sandbox destination is inside a git working tree:"
        err "  $(git -C "${probe}" rev-parse --show-toplevel 2>/dev/null)"
        err "installing there would replace that checkout. Pass --force if it is deliberate."
        return 1
    fi
    if [[ "${dry_run}" == "1" ]]; then
        log "dry run: the sandbox template would be copied to ${dst}."
        return 0
    fi

    mkdir -p "$(dirname "${dst_native}")"
    if [[ -d "${dst_native}" ]]; then
        local backup="${dst_native%/}.bak-$(date -u +%Y%m%dT%H%M%SZ)"
        log "previous sandbox install backed up to: ${backup}"
        mv "${dst_native}" "${backup}"
        _prune_backups "${dst_native}"
    fi
    cp -R "${src_native}" "${dst_native}"

    # T7 (luks-integration): AGENTS.md is part of the signed bundle, so it is
    # replaced on every update. When the user had edited it, the generic
    # "backed up to" line above is too easy to miss — and what gets lost are
    # their own rules. Name it, and say where the previous copy is.
    if [[ -n "${backup:-}" && -f "${backup}/AGENTS.md" && -f "${dst_native}/AGENTS.md" ]] \
        && ! cmp -s "${backup}/AGENTS.md" "${dst_native}/AGENTS.md"; then
        log "AGENTS.md was replaced by the signed bundle — your previous copy is at:"
        log "  ${backup}/AGENTS.md"
        log "  keep your own rules in your repository (code/rules/...), not in this product file."
    fi

    # What the launcher and the sandbox compose resolve from this folder, so a
    # half-copied tree is caught here instead of on the next `aegis sandbox`.
    local missing=0 f
    for f in .devcontainer/docker-compose.yml .devcontainer/Dockerfile \
             config/squid.conf config/allowlist.txt; do
        if [[ ! -e "${dst_native}/${f}" ]]; then
            err "the sandbox copy is missing: ${f}"
            missing=1
        fi
    done
    if [[ "${missing}" != "0" ]]; then
        err "sandbox install incomplete — the previous copy is in the backup printed above."
        return 1
    fi
    log "sandbox template installed: ${dst} (the host runs this copy from now on)."
    return 0
}

# T25 — the build-windows sibling of install_sandbox_template above, same shape
# and same reasons: `aegis build windows` runs `docker build` on this folder, so
# the copy the host builds from must live outside every mount. A missing source
# is not an error (a host with no checkout has none).
install_build_windows_template() {
    local dry_run="$1" force="$2"
    local src="${AEGIS_INSTALL_BUILD_WINDOWS_SOURCE:-}"
    local dst="${AEGIS_BUILD_WINDOWS_INSTALL_DIR%/}"
    local src_native dst_native
    src_native="$(_to_native_path "$src")"
    dst_native="$(_to_native_path "$dst")"

    if [[ ! -f "${src_native}/Dockerfile" ]]; then
        log "build-windows: no template at ${src} — skipping (nothing to install there)."
        return 0
    fi
    if [[ "${src_native}" == "${dst_native}" ]]; then
        err "build-windows source and destination are the same folder (${dst}) — nothing to copy."
        return 1
    fi
    local probe
    probe="$(dirname "${dst_native%/}")"
    if [[ "${force}" != "1" ]] && git -C "${probe}" rev-parse --show-toplevel >/dev/null 2>&1; then
        err "the build-windows destination is inside a git working tree:"
        err "  $(git -C "${probe}" rev-parse --show-toplevel 2>/dev/null)"
        err "installing there would replace that checkout. Pass --force if it is deliberate."
        return 1
    fi
    if [[ "${dry_run}" == "1" ]]; then
        log "dry run: the build-windows template would be copied to ${dst}."
        return 0
    fi

    mkdir -p "$(dirname "${dst_native}")"
    if [[ -d "${dst_native}" ]]; then
        local backup="${dst_native%/}.bak-$(date -u +%Y%m%dT%H%M%SZ)"
        log "previous build-windows install backed up to: ${backup}"
        mv "${dst_native}" "${backup}"
    fi
    cp -R "${src_native}" "${dst_native}"

    local missing=0 f
    for f in Dockerfile entrypoint.sh; do
        if [[ ! -e "${dst_native}/${f}" ]]; then
            err "the build-windows copy is missing: ${f}"
            missing=1
        fi
    done
    if [[ "${missing}" != "0" ]]; then
        err "build-windows install incomplete — the previous copy is in the backup printed above."
        return 1
    fi
    log "build-windows template installed: ${dst} (the host builds from this copy from now on)."
    return 0
}

# Full-length sha256 of a file, with the same portable fallbacks as
# _sandbox_hash (Git Bash ships shasum). The GNU branch hashes via stdin
# (sha256_file) so a backslash path can't poison the hash line with the
# coreutils escape. Prints lowercase hex; returns non-zero when no hashing
# tool exists, so callers can fail closed.
_sha256_file() {
    local file="$1"
    if command -v sha256sum >/dev/null 2>&1; then
        sha256_file "$file"
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$file" | cut -d' ' -f1
    else
        err "no sha256sum/shasum on this machine — cannot verify the bundle."
        return 1
    fi
}

# OD1.2 — client `aegis install` without a checkout. Downloads the bundle from
# AEGIS_INSTALL_URL, verifies its sha256 BEFORE extracting or installing
# anything (fail closed: no hash means no install), and unpacks it into a temp
# dir whose layout mirrors the repository (templates/workstation/... and
# templates/sandbox/...). Sets AEGIS_INSTALL_FETCHED_SRC (the workstation
# template) and AEGIS_INSTALL_TMP (removed by the EXIT trap). It is a plain
# function, not a command substitution: a $(...) would run it in a subshell and
# lose both variables, leaking the temp dir.
_client_fetch_install_bundle() {
    local url="${AEGIS_INSTALL_URL}"
    local expected="${AEGIS_INSTALL_SHA256:-}"

    if [[ -z "$expected" ]]; then
        local hashfile
        hashfile="$(mktemp)" || { err "mktemp failed"; return 1; }
        if ! curl -fsSL "${url}.sha256" -o "$hashfile"; then
            rm -f "$hashfile"
            err "could not fetch the bundle checksum: ${url}.sha256"
            err "set AEGIS_INSTALL_SHA256 to verify ${url}."
            return 1
        fi
        expected="$(awk '{print $1}' "$hashfile" | head -n1)"
        rm -f "$hashfile"
    fi
    if [[ -z "$expected" ]]; then
        err "the bundle checksum is empty — refusing to install ${url}."
        return 1
    fi

    local tmp archive actual
    tmp="$(mktemp -d)" || { err "mktemp failed"; return 1; }
    archive="${tmp}/bundle.tar.gz"
    if ! pg_download "$url" "$archive"; then
        err "could not download the bundle: ${url}"
        rm -rf "$tmp"
        return 1
    fi
    if ! actual="$(_sha256_file "$archive")"; then
        rm -rf "$tmp"
        return 1
    fi
    expected="$(printf '%s' "$expected" | tr 'A-Z' 'a-z')"
    actual="$(printf '%s' "$actual" | tr 'A-Z' 'a-z')"
    if [[ "$actual" != "$expected" ]]; then
        err "the bundle checksum does not match — refusing to install it."
        err "expected: ${expected}"
        err "actual:   ${actual}"
        rm -rf "$tmp"
        return 1
    fi
    if ! tar -xzf "$archive" -C "$tmp"; then
        err "could not extract the bundle archive from ${url}."
        rm -rf "$tmp"
        return 1
    fi
    rm -f "$archive"
    AEGIS_INSTALL_TMP="$tmp"
    AEGIS_INSTALL_FETCHED_SRC="${tmp}/templates/workstation"
    return 0
}

# OD1.3 — client `aegis install` from the REGISTRY, the DEFAULT channel.
#
# The bundle travels as a minimal container image whose filesystem carries the
# tarball at /bundle.tar.gz. The image is signed by THIS repository's CI, so the
# cosign identity the launcher already trusts proves it; and it is pulled with
# the SAME download token that gates the workstation image (aegis-licensing mints
# it). The tarball's entries are the repo-relative paths in client-bundle.txt, so
# extracting into a temp dir yields <tmp>/templates/workstation/... — the same
# layout _client_fetch_install_bundle() produces from AEGIS_INSTALL_URL.
#
# Fail-closed at every step: no docker, no token, a failed pull, no digest, a
# signature that does not verify, a missing /bundle.tar.gz, or a broken archive
# each refuse BEFORE anything is written to the install destination. The tarball
# is read out with `docker create` + `docker cp` — nothing runs inside the image
# (there is no shell to run); the throwaway container is removed on every path.
#
# Reuses the OD1.2 pattern: a temp dir in AEGIS_INSTALL_TMP, removed by the ONE
# EXIT trap (_telemetry_on_exit) — never a second trap, which would replace it.
# Sets AEGIS_INSTALL_FETCHED_SRC for the caller, exactly like the URL path.
_client_fetch_registry_bundle() {
    command -v docker >/dev/null 2>&1 || {
        err "docker is required to install from the registry but was not found in PATH."
        err "install Docker Desktop, or pass --from <folder> to install from a local copy."
        return 1
    }

    local reference="${AEGIS_IMAGE_REGISTRY}/${AEGIS_BUNDLE_REPO}:${AEGIS_BUNDLE_TAG}"
    local config config_native token rc=0

    token="$(_image_download_token "authenticate")"
    config="$(mktemp -d)" || { err "mktemp failed"; return 1; }
    # Native path: Docker Desktop is a Windows binary, and handed a POSIX path it
    # resolves it against the current drive — a directory this shell's rm will
    # never delete (the same reason cmd_image_pull converts it).
    config_native="$(_to_native_path "$config")"
    if ! _write_registry_config "$config" "$token"; then
        token=""
        rm -rf "$config"
        err "could not write the throwaway docker config"
        return 1
    fi
    token=""

    log "pulling ${reference}"
    _run_with_throwaway_config "$config" env "DOCKER_CONFIG=$config_native" docker pull "$reference" || rc=$?
    if [[ "$rc" -ne 0 ]]; then
        err "could not pull the bundle image: ${reference}"
        return 1
    fi

    # Verify the DIGEST that is here — a tag can be moved, so checking one would
    # prove something about a name, not about the bytes that would be installed.
    local digest
    digest="$(docker inspect --format='{{index .RepoDigests 0}}' "$reference" 2>/dev/null | sed 's/.*@//')"
    if [[ -z "$digest" ]]; then
        err "no local digest for ${reference} after the pull — refusing to install unverified bytes."
        return 1
    fi

    # The launcher's ONE signature check, reused: same identity, same issuer,
    # same pinned cosign image as `aegis up` / `aegis image verify`. It returns
    # non-zero on failure, so nothing below runs for an unverified bundle.
    if ! _verify_local_image "${AEGIS_IMAGE_REGISTRY}/${AEGIS_BUNDLE_REPO}@${digest}"; then
        err "the bundle image did not verify — refusing to install it."
        return 1
    fi

    local tmp archive cid=""
    tmp="$(mktemp -d)" || { err "mktemp failed"; return 1; }
    archive="${tmp}/bundle.tar.gz"

    if ! cid="$(docker create "$reference")"; then
        err "could not create a container from ${reference} to read the bundle."
        rm -rf "$tmp"
        return 1
    fi
    if [[ -z "$cid" ]]; then
        err "docker create returned no container id for ${reference}."
        rm -rf "$tmp"
        return 1
    fi
    # MSYS_NO_PATHCONV keeps the in-container '/bundle.tar.gz' from being mangled
    # into a Windows path on Git Bash; the HOST destination is pre-converted.
    if ! MSYS_NO_PATHCONV=1 docker cp "${cid}:/bundle.tar.gz" "$(_to_native_path "$archive")"; then
        err "could not copy /bundle.tar.gz out of ${reference} — is it a bundle image?"
        docker rm "$cid" >/dev/null 2>&1 || true
        rm -rf "$tmp"
        return 1
    fi
    # Always remove the throwaway container, success or failure.
    docker rm "$cid" >/dev/null 2>&1 || true

    if ! tar -xzf "$archive" -C "$tmp"; then
        err "could not extract the bundle archive from ${reference}."
        rm -rf "$tmp"
        return 1
    fi
    rm -f "$archive"
    AEGIS_INSTALL_TMP="$tmp"
    AEGIS_INSTALL_FETCHED_SRC="${tmp}/templates/workstation"
    return 0
}

cmd_install() {
    # Client-redesign L4.2: the complete first journey. Unlicensed, a leading
    # license-id activates FIRST (nothing is installed before the machine has
    # a valid license — "without a license it brings nothing").
    if [[ "$(_client_license_state)" != "valid" ]]; then
        if [[ -n "${1:-}" ]]; then
            log "no license on this machine yet — activating before installing anything..."
            _LICENSE_CMD="license"
            cmd_license activate "$@"
        else
            err "'aegis install' needs a license — run the first journey in one command:"
            err "  aegis install <license-id>"
            err "or the explicit two-step alternative: aegis license activate <license-id>"
            exit 2
        fi
        # The activation must have landed a valid license; anything else stops here.
        [[ "$(_client_license_state)" == "valid" ]] || exit 1
    fi

    local dry_run=0 force=0 source_override=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=1; shift ;;
            --force) force=1; shift ;;
            --from) [[ -n "${2:-}" ]] || { err "--from requires a folder"; exit 2; }; source_override="$2"; shift 2 ;;
            -*) err "unknown option for 'aegis install': $1"; exit 2 ;;
            *) err "usage: aegis install [--from <folder>] [--dry-run] [--force]"; exit 2 ;;
        esac
    done

    local src=""
    # OD1.2: install needs an ACTIVATED machine first — before any download or
    # write. The device credential is the proof; without it there is no
    # license to install with, so nothing is fetched.
    if [[ ! -s "$AEGIS_DEVICE_CREDENTIAL_FILE" ]]; then
        err "this machine is not activated — there is no license to install with."
        err "activate it first: aegis account activate <license-id>"
        exit 1
    fi
    # --from / AEGIS_INSTALL_SOURCE stay available (tests/debug); then the
    # explicit AEGIS_INSTALL_URL; and the REGISTRY is the default channel
    # when neither is set (OD1.3). Precedence is exactly the order below.
    if [[ -n "$source_override" ]]; then
        src="$source_override"
    elif [[ -n "${AEGIS_INSTALL_SOURCE:-}" ]]; then
        src="$AEGIS_INSTALL_SOURCE"
    elif [[ -n "${AEGIS_INSTALL_URL:-}" ]]; then
        _client_fetch_install_bundle || exit 1
        src="$AEGIS_INSTALL_FETCHED_SRC"
    else
        _client_fetch_registry_bundle || exit 1
        src="$AEGIS_INSTALL_FETCHED_SRC"
    fi
    # The bundle keeps the sandbox and build-windows templates next to the
    # workstation one; an explicit override still wins for either.
    AEGIS_INSTALL_SANDBOX_SOURCE="${AEGIS_INSTALL_SANDBOX_SOURCE:-$(dirname "$src")/sandbox}"
    AEGIS_INSTALL_BUILD_WINDOWS_SOURCE="${AEGIS_INSTALL_BUILD_WINDOWS_SOURCE:-$(dirname "$src")/build-windows}"
    local dst="${AEGIS_INSTALL_DIR%/}"
    local src_native dst_native
    src_native="$(_to_native_path "$src")"
    dst_native="$(_to_native_path "$dst")"

    if [[ ! -f "${src_native}/.devcontainer/docker-compose.yml" ]]; then
        err "no .devcontainer/docker-compose.yml in the source: ${src}"
        err "point --from (or AEGIS_INSTALL_SOURCE) at the folder that holds .devcontainer/"
        exit 1
    fi
    if [[ "${src_native}" == "${dst_native}" ]]; then
        err "source and destination are the same folder (${dst}) — nothing to copy."
        exit 1
    fi
    # `aegis install` REPLACES the destination, so a destination inside a git
    # working tree means it would clobber a checkout — exactly the mistake made
    # (by accident) while developing this command, aiming it at a worktree.
    # --force exists for the rare deliberate case.
    local probe
    probe="$(dirname "${dst_native%/}")"
    if [[ "${force}" != "1" ]] && git -C "${probe}" rev-parse --show-toplevel >/dev/null 2>&1; then
        err "the destination is inside a git working tree:"
        err "  $(git -C "${probe}" rev-parse --show-toplevel 2>/dev/null)"
        err "installing there would replace that checkout. Pass --force if it is deliberate."
        exit 1
    fi

    # A truly fresh install: the aegis home (the folder that holds the install
    # destination — ~/.aegis by default, next to license, telemetry.json,
    # logs/, generated/...) does not exist or is empty, AND there is no
    # manifest yet (AEGIS_ENV_FILE may point elsewhere). Only then does it get
    # an explicit manifest with every opt-in tool off. Anything already there
    # means someone used aegis before, even straight from a checkout without
    # ever installing: that keeps reading a missing manifest as "gh and az on"
    # (see scripts/aegis-env.js), so nobody loses a tool without asking.
    local fresh=0 aegis_home other_state
    aegis_home="$(dirname "${dst_native%/}")"
    # Activation writes license/device.json into the aegis home BEFORE install
    # runs. Those are credentials, not a previous install: a machine that
    # activated first is still fresh, and must get the all-off manifest
    # (otherwise its first `add tool` silently turns gh AND az on).
    other_state="$(ls -A "${aegis_home}" 2>/dev/null | grep -vxE 'license|device\.json' || true)"
    if [[ -z "$other_state" && ! -e "$AEGIS_ENV_FILE" ]]; then
        fresh=1
    fi

    log "source:      ${src}"
    log "destination: ${dst}"
    if [[ "${dry_run}" == "1" ]]; then
        if [[ "${fresh}" == "1" ]]; then
            log "dry run: a fresh install would also create $(tildify "$AEGIS_ENV_FILE") with every tool off."
        fi
        install_sandbox_template "1" "${force}" || exit 1
        install_build_windows_template "1" "${force}" || exit 1
        log "dry run: nothing was copied."
        return 0
    fi

    mkdir -p "$(dirname "${dst_native}")"
    local _preserved_data_root=""
    if [[ -d "${dst_native}" ]]; then
        local backup="${dst_native%/}.bak-$(date -u +%Y%m%dT%H%M%SZ)"
        log "previous install backed up to: ${backup}"
        # T14: the copy below replaces the whole configuration tree, .env
        # included, so the launcher state the user accumulated would vanish —
        # and the encrypted mode with it (AEGIS_ENCRYPTED / AEGIS_DATA_ROOT).
        # Carry that block across the replacement.
        if [[ -f "${dst_native}/.devcontainer/.env" ]] \
            && grep -qx '# aegis:data-root' "${dst_native}/.devcontainer/.env" 2>/dev/null; then
            _preserved_data_root="$(sed -n '/^# aegis:data-root$/,$p' "${dst_native}/.devcontainer/.env" \
                | grep -E '^(# aegis:data-root|AEGIS_[A-Z_]+=)' || true)"
        fi
        mv "${dst_native}" "${backup}"
        _prune_backups "${dst_native}"
    fi
    cp -R "${src_native}" "${dst_native}"

    # T14 (cont.): put the encrypted-mode block back, once, and say so.
    if [[ -n "${_preserved_data_root:-}" ]]; then
        local _new_env="${dst_native}/.devcontainer/.env"
        mkdir -p "$(dirname "${_new_env}")"
        if ! grep -qx '# aegis:data-root' "${_new_env}" 2>/dev/null; then
            printf '%s\n' "${_preserved_data_root}" >> "${_new_env}"
            log "kept the encrypted-mode state across the install (${_new_env##*/})."
        fi
    fi

    # Everything the launcher resolves from this folder (see the configuration
    # block at the top of this file), so a half-copied tree is caught here.
    # bin/aegis is deliberately NOT required here (T5): aegis-cli's own signed
    # releases own the launcher since T4, and the bundle no longer carries it
    # (client-bundle.txt) — requiring it would reject every install.
    local missing=0 f
    local -a required_files=(
        .devcontainer/docker-compose.yml .devcontainer/Dockerfile.client
        scripts/aegis-env.js scripts/aegis-allowlist.js
        scripts/generate-build-context.sh scripts/aegis-build-view.js
        scripts/generate-allowlist.sh scripts/audit-container.sh
        config/agent-guard.sh config/license-keys.json
        config/allowlist-ports.conf AGENTS.md
    )
    for f in "${required_files[@]}"; do
        if [[ ! -e "${dst_native}/${f}" ]]; then
            err "the copy is missing: ${f}"
            missing=1
        fi
    done
    if [[ "${missing}" != "0" ]]; then
        err "install incomplete — the previous copy is in the backup printed above."
        exit 1
    fi

    # The helper of the copy just installed, not $ENV_JS: on a first install
    # $ENV_JS still points at whatever the launcher resolved before.
    if [[ "${fresh}" == "1" ]]; then
        if ! command -v node >/dev/null 2>&1; then
            log "warning: node not found — no tools manifest written; gh and az stay on until 'aegis remove tool'."
        elif [[ "$(node "${dst_native}/scripts/aegis-env.js" init-fresh "$AEGIS_ENV_FILE")" == "created" ]]; then
            log "fresh install: created $(tildify "$AEGIS_ENV_FILE") with every tool off (add one with: aegis add tool <name>)"
        fi
    fi

    # Three cases, and they are NOT the same message: a copy that was already
    # in use, an explicit AEGIS_WORKSTATION_DIR (which keeps winning), or the
    # first install — where until now the launcher resolved the repository, so
    # nothing was "set explicitly" and saying so was wrong.
    case "${AEGIS_CONFIG_SOURCE}" in
        installed)
            log "installed. The host executes this copy from now on."
            ;;
        explicit*)
            log "installed, but AEGIS_WORKSTATION_DIR is set explicitly, so that folder is still the one in use."
            ;;
        *)
            log "installed. This copy is what the host executes from now on — confirm with: aegis status"
            ;;
    esac

    # Client-redesign L2/T2.1-T2.2: the templates no longer install here.
    # Their sources persist so the first `aegis sandbox` / `aegis build
    # windows` can install them lazily.
    # The fetched bundle tmp is removed by the EXIT trap, so the lazy source
    # must live somewhere persistent: inside the installed copy itself.
    local lazy_src="${dst_native%/}/template-sources"
    rm -rf "${lazy_src}"
    mkdir -p "${lazy_src}"
    [[ -f "$(_to_native_path "${AEGIS_INSTALL_SANDBOX_SOURCE:-}")/.devcontainer/docker-compose.yml" ]] \
        && cp -R "$(_to_native_path "${AEGIS_INSTALL_SANDBOX_SOURCE}")" "${lazy_src}/sandbox"
    [[ -f "$(_to_native_path "${AEGIS_INSTALL_BUILD_WINDOWS_SOURCE:-}")/Dockerfile" ]] \
        && cp -R "$(_to_native_path "${AEGIS_INSTALL_BUILD_WINDOWS_SOURCE}")" "${lazy_src}/build-windows"
    {
        printf 'AEGIS_INSTALL_SANDBOX_SOURCE=%q\n' "${lazy_src}/sandbox"
        printf 'AEGIS_INSTALL_BUILD_WINDOWS_SOURCE=%q\n' "${lazy_src}/build-windows"
    } > "$(_to_native_path "${dst_native}/template-sources.env")" 2>/dev/null || {
        err "could not persist the template sources — the first 'aegis sandbox' or 'aegis build windows' will not find them."
        exit 1
    }
    log "the sandbox and build-windows templates install on first use (aegis sandbox / aegis build windows)."

    # Client-redesign L4.2: the journey ends pointing at the next command.
    # `aegis up` pulls and verifies the signed image by itself — install never
    # duplicates that pull.
    log "Next: aegis up   (pulls and verifies the signed image, then starts)"

    # Client-redesign L5: the welcome banner crowns a successful install —
    # the one moment a client is glad they downloaded Aegis. Install is rare
    # and end-of-flow, so the art here is information-free by design and
    # welcome; color is decided inside _aegis_banner by TTY.
    _aegis_banner
}

# Client-redesign L2/T2.1-T2.2: the templates do NOT install during
# `aegis install` — each installs lazily, at the first use of the command that
# needs it, after argument validation and before the first docker call. The
# sources chosen at install time persist in template-sources.env so a later
# session can still resolve them.
ensure_sandbox_template() {
    # An explicitly configured AEGIS_SANDBOX_DIR is the user's own choice —
    # nothing to install, nothing to touch.
    [[ "${AEGIS_SANDBOX_SOURCE:-}" == explicit* ]] && return 0
    local dst_native
    dst_native="$(_to_native_path "${AEGIS_SANDBOX_INSTALL_DIR%/}")"
    [[ -f "${dst_native}/.devcontainer/docker-compose.yml" ]] && return 0
    local src="${AEGIS_INSTALL_SANDBOX_SOURCE:-}"
    local sources_file
    if [[ -z "$src" ]]; then
        for sources_file in \
            "$(_to_native_path "${AEGIS_INSTALL_DIR%/}/template-sources.env")" \
            "$(_to_native_path "${AEGIS_WORKSTATION_DIR%/}/template-sources.env")"; do
            if [[ -f "$sources_file" ]]; then
                # shellcheck disable=SC1090
                src="$(. "$sources_file"; printf '%s' "${AEGIS_INSTALL_SANDBOX_SOURCE:-}")"
                [[ -n "$src" ]] && break
            fi
        done
    fi
    if [[ -z "$src" && -f "$sources_file" ]]; then
        # shellcheck disable=SC1090
        src="$(. "$sources_file"; printf '%s' "${AEGIS_INSTALL_SANDBOX_SOURCE:-}")"
    fi
    if [[ -z "$src" || ! -f "$(_to_native_path "$src")/.devcontainer/docker-compose.yml" ]]; then
        err "the sandbox template is not installed and its source is unknown."
        err "run 'aegis install' (or 'aegis update') to fetch the bundle that carries it, then retry."
        return 1
    fi
    log "first run: installing the sandbox template..."
    export AEGIS_INSTALL_SANDBOX_SOURCE="$src"
    install_sandbox_template "0" "0" || {
        err "cannot install the sandbox template — 'aegis sandbox' cannot continue."
        return 1
    }
    return 0
}

ensure_build_windows_template() {
    # An explicitly configured AEGIS_BUILD_WINDOWS_DIR is the user's own
    # choice — nothing to install, nothing to touch.
    [[ "${AEGIS_BUILD_WINDOWS_SOURCE:-}" == explicit* ]] && return 0
    local dst_native
    dst_native="$(_to_native_path "${AEGIS_BUILD_WINDOWS_INSTALL_DIR%/}")"
    [[ -f "${dst_native}/Dockerfile" ]] && return 0
    local src="${AEGIS_INSTALL_BUILD_WINDOWS_SOURCE:-}"
    local sources_file
    if [[ -z "$src" ]]; then
        for sources_file in \
            "$(_to_native_path "${AEGIS_INSTALL_DIR%/}/template-sources.env")" \
            "$(_to_native_path "${AEGIS_WORKSTATION_DIR%/}/template-sources.env")"; do
            if [[ -f "$sources_file" ]]; then
                # shellcheck disable=SC1090
                src="$(. "$sources_file"; printf '%s' "${AEGIS_INSTALL_BUILD_WINDOWS_SOURCE:-}")"
                [[ -n "$src" ]] && break
            fi
        done
    fi
    if [[ -z "$src" && -f "$sources_file" ]]; then
        # shellcheck disable=SC1090
        src="$(. "$sources_file"; printf '%s' "${AEGIS_INSTALL_BUILD_WINDOWS_SOURCE:-}")"
    fi
    if [[ -z "$src" || ! -f "$(_to_native_path "$src")/Dockerfile" ]]; then
        err "the build-windows template is not installed and its source is unknown."
        err "run 'aegis install' (or 'aegis update') to fetch the bundle that carries it, then retry."
        return 1
    fi
    log "first run: installing the build-windows template..."
    export AEGIS_INSTALL_BUILD_WINDOWS_SOURCE="$src"
    install_build_windows_template "0" "0" || {
        err "cannot install the build-windows template — 'aegis build windows' cannot continue."
        return 1
    }
    return 0
}

cmd_status() {
    log "configuration: ${AEGIS_WORKSTATION_DIR} (${AEGIS_CONFIG_SOURCE})"
    compose ps
    echo
    local ids
    ids="$(compose ps -q || true)"
    if [[ -n "$ids" ]]; then
        # shellcheck disable=SC2086
        docker stats --no-stream $ids
    else
        log "no containers running for this stack."
    fi

    echo
    echo "=== Volumes ==="
    # Flat mounts (T13): engram nested under the read-only /data fails when
    # the sources are host binds (LUKS data root).
    if MSYS_NO_PATHCONV=1 docker run --rm --network none \
        -v "$(code_volume_src):/data:ro" \
        -v "$(engram_volume_src):/engram:ro" \
        "$BACKUP_IMAGE" du -sh /data/code /engram 2>/dev/null; then
        :
    else
        log "could not read volume sizes (throwaway container failed)."
    fi

    echo
    echo "=== Last backup ==="
    local marker="${DEFAULT_BACKUP_DIR%/}/.last-backup"
    if [[ -f "$marker" ]]; then
        local last_ts last_name
        last_ts="$(sed -n '1p' "$marker")"
        last_name="$(sed -n '2p' "$marker")"
        echo "timestamp: ${last_ts:-unknown}"
        echo "archive:   ${last_name:-unknown}"
    else
        echo "no backup recorded yet (see: aegis backup) — marker not found at $marker"
    fi
}

cmd_audit() {
    if [[ ! -f "$AUDIT_SCRIPT" ]]; then
        err "audit-container.sh not found at: $AUDIT_SCRIPT"
        exit 1
    fi
    bash "$AUDIT_SCRIPT" "$DEV_CONTAINER"
}

# ---------------------------------------------------------------------------
# aegis backup / restore / export / import — see docs/11-aegis-cli.md
# ---------------------------------------------------------------------------

# host_mkdir_p <windows-path> — plain bash mkdir handles a Windows drive-
# letter path fine under Git Bash (no MSYS_NO_PATHCONV needed: we WANT the
# host-path conversion here, this is a real host path, not an in-container
# one).
host_mkdir_p() {
    mkdir -p "$1"
}

cmd_backup() {
    local dest="$DEFAULT_BACKUP_DIR"
    # BACKUP_PRUNE_SH decides what "build artifacts" means; --full keeps them.
    local mode="skip-build-artifacts"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dest) [[ $# -ge 2 ]] || { err "--dest requires a value"; exit 2; }; dest="$2"; shift 2 ;;
            --full) mode="full"; shift ;;
            *) err "unknown option: $1"; exit 2 ;;
        esac
    done
    host_mkdir_p "$dest"

    local ts archive_name manifest_name
    ts="$(date -u +%Y%m%dT%H%M%SZ)"
    archive_name="aegis-workstation-backup-${ts}.tar.gz"
    manifest_name="aegis-workstation-backup-${ts}.manifest.json"

    # T5c: in the encrypted layout the archive also carries the agent-state
    # volumes, so a migration is one backup -> switch -> restore.
    # T13: FLAT mounts. Mounting engram (or any agent volume) UNDER the
    # read-only /data worked with named volumes, but with host binds runc
    # cannot create a mountpoint inside a read-only mount and the run fails
    # ("mount ... : read-only file system"). Every source now lands at its own
    # /m/<id>, and /m is a plain directory in the image, so nothing nests.
    # The code volume's ROOT holds code/; only that subdir is mounted, at
    # /m/code, so the archive step can use ONE -C /m. BusyBox tar keeps only
    # the last -C (archival/tar.c: a single base_dir), so the former
    # `-C /m/wsroot ... code -C /m ...` looked for /m/code and missed the
    # whole code volume. A named volume needs volume-subpath (Engine 26+);
    # a path-shaped source (AEGIS_CODE_DIR / data root) binds <path>/code.
    local code_src
    local -a code_mnt
    code_src="$(code_volume_src)"
    case "$code_src" in
        */*) code_mnt=(-v "${code_src%/}/code:/m/code:ro") ;;
        *)
            require_volume_subpath_engine "aegis backup" "monta solo code/ del volumen"
            code_mnt=(--mount "type=volume,src=${code_src},dst=/m/code,volume-subpath=code,readonly") ;;
    esac
    local -a mnts=("${code_mnt[@]}" -v "$(engram_volume_src):/m/engram:ro")
    local -a ids=(code engram)
    if agent_state_mode; then
        local _id _src
        while IFS=$'\t' read -r _id _src; do
            [[ -n "$_id" ]] || continue
            mnts+=(-v "${_src}:/m/${_id}:ro")
            ids+=("$_id")
        done < <(agent_state_rows)
        log "backing up the code, engram and agent-state volumes -> ${dest%/}/${archive_name}"
    else
        log "backing up the code and engram volumes -> ${dest%/}/${archive_name}"
    fi
    log "(throwaway container, read-only mounts, --network none — never touches the home/config volumes)."

    # `home` contains the four specific volumes when they are separate binds.
    local -a excludes=(--exclude=home/.claude --exclude=home/.config
                       --exclude=home/.gentle-ai --exclude=home/.engram --exclude=home/.herdr)

    # File counts computed from the SAME read-only mounts, before archiving,
    # so the manifest's counts and the archive's contents can never diverge.
    # The code count leaves out the same build-output directories the archive
    # skips; the last output line is how many directories were skipped.
    local counts
    local -a rest=()
    local _r
    for _r in "${ids[@]}"; do [[ "$_r" == "code" ]] || rest+=("$_r"); done
    pg_step 1 4 "Counting files"
    pg_spin_start "scanning ${ids[*]}"
    counts="$(MSYS_NO_PATHCONV=1 docker run --rm --network none \
        "${mnts[@]}" \
        "$BACKUP_IMAGE" sh -c "${BACKUP_PRUNE_SH}"'
            mode=$1; shift
            : > /tmp/aegis-skip
            if [ "$mode" != full ]; then
                aegis_bk_prune_list /m | sed "s|^|/m/|; s|\$|/|" > /tmp/aegis-skip
            fi
            if [ -s /tmp/aegis-skip ]; then
                n=$(find /m/code -type f 2>/dev/null | grep -vF -f /tmp/aegis-skip | wc -l)
            else
                n=$(find /m/code -type f 2>/dev/null | wc -l)
            fi
            echo "${n:-0}"
            for d in "$@"; do
                find "/m/$d" -type f 2>/dev/null | wc -l
            done
            wc -l < /tmp/aegis-skip
        ' sh "$mode" "${rest[@]}")"
    pg_spin_stop
    pg_done 1

    # The bar total is the file count just measured; tar -v prints one line
    # per archived entry (directories end in "/" and are not counted).
    local total_files=0 _c _k
    for (( _k = 1; _k <= ${#ids[@]}; _k++ )); do
        _c="$(sed -n "${_k}p" <<<"$counts" | tr -d '[:space:]')"
        total_files=$(( total_files + ${_c:-0} ))
    done
    pg_step 2 4 "Archiving"

    # tar -X reads fnmatch patterns, so glob characters in a skipped path are
    # escaped to match only that literal directory.
    pg_run_counted "$total_files" files -- env MSYS_NO_PATHCONV=1 docker run --rm --network none \
        "${mnts[@]}" \
        -v "${dest}:/backup" \
        "$BACKUP_IMAGE" sh -c "${BACKUP_PRUNE_SH}"'
            out=$1; mode=$2; shift 2
            : > /tmp/aegis-skip
            if [ "$mode" != full ]; then
                aegis_bk_prune_list /m | sed "s/[][*?\\]/\\\\&/g" > /tmp/aegis-skip
            fi
            exec tar czvf "$out" -X /tmp/aegis-skip "$@"
        ' sh "/backup/${archive_name}" "$mode" \
        -C /m "${excludes[@]}" "${ids[@]}"
    pg_done 2

    local archive_path="${dest%/}/${archive_name}"
    local sha256 size_bytes
    pg_step 3 4 "Hashing the archive"
    pg_spin_start "sha256"
    sha256="$(sha256_file "$archive_path")"
    size_bytes="$(wc -c < "$archive_path" | tr -d '[:space:]')"
    pg_spin_stop
    pg_done 3
    pg_step 4 4 "Writing the manifest"

    # Built directly with printf, not node -e (every value here is either
    # generated by this script itself or a fixed literal — never
    # user/archive-controlled content — so no JSON string-escaping is
    # needed).
    # T5c: manifest v2 carries every archived volume with its own count; v1
    # consumers (older launchers) still read code/engram from this shape.
    local counts_json volumes_json i n
    counts_json=""; volumes_json=""
    for i in "${!ids[@]}"; do
        n="$(sed -n "$((i + 1))p" <<<"$counts" | tr -d '[:space:]')"
        n="${n:-0}"
        [[ -n "$counts_json" ]] && counts_json="${counts_json}, "
        [[ -n "$volumes_json" ]] && volumes_json="${volumes_json}, "
        counts_json="${counts_json}\"${ids[$i]}\": ${n}"
        volumes_json="${volumes_json}\"${ids[$i]}\": \"backup\""
    done
    local _ver=1
    agent_state_mode && _ver=2
    local artifacts="skipped"
    [[ "$mode" == "full" ]] && artifacts="included"
    printf '{\n  "version": %s,\n  "timestamp": "%s",\n  "archive": "%s",\n  "sha256": "%s",\n  "size_bytes": %s,\n  "image": "%s",\n  "build_artifacts": "%s",\n  "volumes": {%s},\n  "file_counts": {%s}\n}\n' \
        "$_ver" "$ts" "$archive_name" "$sha256" "$size_bytes" "$BACKUP_IMAGE" \
        "$artifacts" "$volumes_json" "$counts_json" \
        > "${dest%/}/${manifest_name}"

    printf '%s\n' "$ts" > "${dest%/}/.last-backup"
    printf '%s\n' "$archive_name" >> "${dest%/}/.last-backup"
    pg_done 4

    echo
    log "archive: $archive_path"
    log "size: ${size_bytes} bytes"
    log "sha256: $sha256"
    log "manifest: ${dest%/}/${manifest_name}"
    local _summary="" _n _i
    for _i in "${!ids[@]}"; do
        _n="$(sed -n "$((_i + 1))p" <<<"$counts" | tr -d '[:space:]')"
        _summary="${_summary}${ids[$_i]}=${_n:-0} "
    done
    log "file counts — ${_summary% }"
    if [[ "$mode" == "full" ]]; then
        log "build artifacts included (--full)."
    else
        local _skipped
        _skipped="$(sed -n "$((${#ids[@]} + 1))p" <<<"$counts" | tr -d '[:space:]')"
        log "skipped ${_skipped:-0} build-output directories (node_modules, dist, publish, bin/obj, target, build, caches) — use --full to include them."
    fi
}

# T10 (luks-integration): move volumes that already exist in the daemon into the
# vault. The backup/restore pair can only carry what it can mount, so volumes
# created before the encrypted layout had no clean path into it.
cmd_volume() {
    # main() already removed the subcommand word, so "$@" starts at the
    # nested verb (migrate-to-vault).
    local sub="${1:-}"
    shift || true
    case "$sub" in
        migrate-to-vault) cmd_volume_migrate_to_vault "$@" ;;
        ""|-h|--help)
            cat >&2 <<'USAGE'
usage: aegis volume migrate-to-vault [--root <dir>] [--only <id>]... [--replace]

Moves the agent-state volumes (home, claude, opencode, gentle-ai, herdr) from
the Docker daemon into the encrypted vault. Requires: the vault mounted, the
stack down, and a target root (--root, AEGIS_DATA_ROOT, or the recorded mode).

Nothing is deleted from the daemon: this is a copy, verify-then-cutover.
USAGE
            [[ -z "$sub" ]] && return 2 || return 0 ;;
        *) err "unknown 'aegis volume' subcommand: $sub"; return 2 ;;
    esac
}

cmd_volume_migrate_to_vault() {
    local root="${AEGIS_DATA_ROOT:-}" replace=0
    local -a only=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root) [[ $# -ge 2 ]] || { err "--root requires a value"; exit 2; }; root="$2"; shift 2 ;;
            --only) [[ $# -ge 2 ]] || { err "--only requires a value"; exit 2; }; only+=("$2"); shift 2 ;;
            --replace) replace=1; shift ;;
            *) err "unknown option: $1"; exit 2 ;;
        esac
    done
    [[ -n "$root" ]] || root="$(state_get AEGIS_DATA_ROOT)"
    # T11: the installer wizard records the choice before the workstation (and
    # its .env) exists. That file is what makes "install the CLI, then the WS"
    # land on encrypted persistence instead of the named volumes.
    if [[ -z "$root" ]]; then
        local _mode="${XDG_STATE_HOME:-$HOME/.local/state}/aegis/mode"
        if [[ -f "$_mode" ]] && grep -qx 'AEGIS_ENCRYPTED=1' "$_mode" 2>/dev/null; then
            root="$(sed -n 's/^AEGIS_DATA_ROOT=//p' "$_mode" | head -n1)"
            # No log here: derive_data_root runs for EVERY command and a stray
            # line would pollute version/status output. `up` reports it.
            [[ -n "$root" ]] && _AEGIS_ADOPTED_MODE=1
        fi
    fi
    [[ -n "$root" ]] || { err "no target root: pass --root <dir> (inside the mounted vault) or set AEGIS_DATA_ROOT."; exit 2; }
    case "$root" in /*) ;; *) err "--root must be an absolute path (got: $root)"; exit 2 ;; esac
    root="${root%/}"

    # Same rule as `up`: with the vault sealed, the target directory does not
    # exist and a copy would land on the underlying filesystem, unencrypted.
    local mnt="${AEGIS_VOLUME_MNT:-/mnt/aegis_secure}"
    case "${root%/}/" in
        "${mnt%/}"/*) mountpoint -q "$mnt" 2>/dev/null || {
            err "the Aegis secure volume is sealed — '${mnt}' is not mounted."
            err "open it first:  sh ~/mount-aegis.sh"
            exit 1
        } ;;
    esac

    if is_up && [[ "$replace" -ne 1 ]]; then
        err "the workstation is running — run 'aegis stop' first (nothing should write during the copy)."
        exit 1
    fi

    local -a ids=("${only[@]:-}")
    if [[ ${#ids[@]} -eq 0 || -z "${ids[0]:-}" ]]; then
        ids=(home claude opencode gentle-ai herdr)
    fi

    local id src dst before after
    local step_n=0
    for id in "${ids[@]}"; do
        step_n=$(( step_n + 1 ))
        case "$id" in
            home|claude|opencode|gentle-ai|herdr) ;;
            code|engram)
                err "$id: use 'aegis backup' + 'aegis restore' for code and engram (they already follow the mode)."
                exit 2 ;;
            *) err "unknown volume: $id"; exit 2 ;;
        esac
        # The SOURCE is the named volume that already exists in the daemon; the
        # destination is the bind the encrypted layout uses.
        src="aegis-workstation-$(case "$id" in home) printf 'home';; claude) printf 'claude-config';; opencode) printf 'opencode-config';; gentle-ai) printf 'gentle-ai-state';; herdr) printf 'herdr-state';; esac)"
        dst="${root}/${id}"

        if docker volume inspect "$src" >/dev/null 2>&1; then :; else
            log "$id: no named volume ($src) — nothing to migrate"
            continue
        fi
        before="$(docker run --rm --network none -v "${src}:/src:ro" "$BACKUP_IMAGE" sh -c 'find /src -type f 2>/dev/null | wc -l' | tr -d '[:space:]')"
        if [[ "${before:-0}" -eq 0 ]]; then
            log "$id: the named volume is empty — nothing to migrate"
            continue
        fi
        mkdir -p "$dst" 2>/dev/null || true
        if [[ "$replace" -ne 1 ]] && [[ -n "$(ls -A "$dst" 2>/dev/null)" ]]; then
            err "$id: ${dst} already has content — refusing to merge into it (pass --replace to overlay)."
            exit 1
        fi
        log "$id: copying ${before} file(s) from ${src} -> ${dst}"
        pg_step "$step_n" "${#ids[@]}" "Migrating $id"
        pg_run_counted 0 items -- env MSYS_NO_PATHCONV=1 docker run --rm --network none \
            -v "${src}:/src:ro" -v "${dst}:/dst" "$BACKUP_IMAGE" \
            sh -c 'echo "@@aegis-total $(find /src -mindepth 1 | wc -l)"; cp -av /src/. /dst/' || { err "$id: copy failed"; exit 1; }
        pg_done "$step_n"
        after="$(find "$dst" -type f 2>/dev/null | wc -l | tr -d '[:space:]')"
        if [[ "${after:-0}" -lt "${before:-0}" ]]; then
            err "$id: copied ${after:-0} file(s) but the source had ${before} — do NOT cut over yet."
            exit 1
        fi
        log "$id: ok (${after} file(s) in place)"
    done

    log "done. The named volumes were NOT deleted: verify, then switch on with"
    log "  AEGIS_ENCRYPTED=1 AEGIS_DATA_ROOT=${root} aegis up"
}

cmd_restore() {
    local archive="${1:-}"
    [[ -z "$archive" ]] && { err "usage: aegis restore <archive> [--only code|engram] [--replace] [--force]"; exit 2; }
    shift
    local only="" replace=0 force=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --only) [[ $# -ge 2 ]] || { err "--only requires a value (code|engram|home|claude|opencode|gentle-ai|herdr)"; exit 2; }; only="$2"; shift 2 ;;
            --replace) replace=1; shift ;;
            --force) force=1; shift ;;
            *) err "unknown option: $1"; exit 2 ;;
        esac
    done
    if [[ ! -f "$archive" ]]; then
        err "archive not found: $archive"
        exit 1
    fi

    case "$only" in
        ""|code|engram) ;;
        memories)
            err "--only memories no longer exists: the workstation uses a single code volume (2026-11-04)."
            err "Your old memories content lives under /workspace/code — see docs/10-workstation.md (single-code-volume)."
            exit 2
            ;;
        *) err "--only must be one of: code, engram, home, claude, opencode, gentle-ai, herdr"; exit 2 ;;
    esac

    if is_up && [[ "$force" -ne 1 ]]; then
        err "the workstation stack is running — run 'aegis stop' first (safer: nothing else writes to the volumes during restore), or pass --force to override at your own risk."
        exit 1
    fi

    # Verify sha256 against a manifest, if one sits next to the archive
    # (same basename, .manifest.json suffix instead of .tar.gz — see
    # cmd_backup). Missing manifest is a NOTE, not a refusal (a user-supplied
    # archive from elsewhere may not have one).
    local manifest="${archive%.tar.gz}.manifest.json"
    local n_steps=1 step=1
    [[ -f "$manifest" ]] && n_steps=2
    if [[ -f "$manifest" ]]; then
        local expected actual
        pg_step "$step" "$n_steps" "Verifying the checksum"
        step=$(( step + 1 ))
        expected="$(node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).sha256)' "$manifest" 2>/dev/null || true)"
        pg_spin_start "sha256"
        actual="$(sha256_file "$archive")"
        pg_spin_stop
        if [[ -n "$expected" && "$expected" != "$actual" ]]; then
            err "sha256 mismatch: manifest says $expected, archive is $actual — refusing to restore a possibly corrupted/tampered archive."
            exit 1
        fi
        log "sha256 verified against manifest: $manifest"
        pg_done 1
    else
        log "no manifest found next to archive ($manifest) — skipping sha256 verification."
    fi

    # T5c slice 2: a v2 backup carries the agent-state volumes too. The manifest
    # is what tells us (the archive itself is opaque), so a v1 keeps the old
    # code+engram behavior and a v2 restores what it actually holds.
    local _v2=0
    if [[ -f "$manifest" ]] && grep -qE '"version"[[:space:]]*:[[:space:]]*2' "$manifest" 2>/dev/null \
        && grep -q '"home"' "$manifest" 2>/dev/null; then
        _v2=1
    fi
    local -a members=(code engram)
    [[ "$_v2" -eq 1 ]] && members=(code engram home claude opencode gentle-ai herdr)
    [[ -n "$only" ]] && members=("$only")
    local -a mounts=()
    local m
    for m in "${members[@]}"; do
        case "$m" in
            # single-code-volume: the code volume's root holds the repos under
            # code/ inside it, so it mounts at /data (the archive's code/
            # member extracts straight into it); the engram volume mounts at
            # /data/engram exactly like before.
            code) mounts+=(-v "$(code_volume_src):/data") ;;
            engram) mounts+=(-v "$(engram_volume_src):/data/engram") ;;
            # Same layout the backup used: each agent volume mounts at its own
            # /data/<id> and the archive member of the same name extracts there.
            *)
                if agent_state_source "$m" >/dev/null 2>&1; then
                    mounts+=(-v "$(agent_state_source "$m"):/data/${m}")
                else
                    err "unknown volume for --only: $m"
                    exit 2
                fi
                ;;
        esac
    done

    local restore_mode="merge"   # never overwrite an existing file (default)
    [[ "$replace" -eq 1 ]] && restore_mode="replace"

    log "restoring [${members[*]}] from $archive (mode: $([[ "$replace" -eq 1 ]] && echo REPLACE || echo merge/keep-existing))."
    local archive_dir archive_base
    archive_dir="$(dirname "$archive")"
    archive_base="$(basename "$archive")"

    local extract_targets=""
    for m in "${members[@]}"; do extract_targets="$extract_targets $m"; done

    # RESTORE_SH keeps existing files itself in merge mode, so ANY non-zero
    # exit is a real failure in both modes. (The former `tar -k` treated every
    # non-zero exit as "a file was kept" — but busybox tar -k aborts at the
    # first existing file, so that message hid a half-done restore.)
    # The archive basename travels as an env value, never interpolated into
    # the script: a filename is user input and may contain quotes or shell
    # metacharacters.
    # Bar total: the file counts the backup recorded for these members (0 when
    # there is no manifest: the bar then shows the count without a percent).
    local total_files=0
    if [[ -f "$manifest" ]]; then
        total_files="$(node -e '
            const m = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
            const c = m.file_counts || {};
            let t = 0;
            for (const k of process.argv.slice(2)) t += Number(c[k]) || 0;
            console.log(t);
        ' "$manifest" "${members[@]}" 2>/dev/null || echo 0)"
    fi
    pg_step "$step" "$n_steps" "Restoring [${members[*]}]"
    local tar_status=0
    pg_run_counted "${total_files:-0}" files -- env MSYS_NO_PATHCONV=1 docker run --rm --network none \
        "${mounts[@]}" \
        -v "${archive_dir}:/restore-src:ro" \
        -e AEGIS_RESTORE_ROOT=/data \
        -e AEGIS_RESTORE_ARCHIVE="/restore-src/${archive_base}" \
        -e AEGIS_RESTORE_MODE="$restore_mode" \
        -e AEGIS_RESTORE_TARGETS="$extract_targets" \
        "$BACKUP_IMAGE" sh -c "$RESTORE_SH" || tar_status=$?

    if [[ "$tar_status" -ne 0 ]]; then
        pg_fail "$step" "exit ${tar_status}"
        err "restore failed (${restore_mode} mode, exit ${tar_status}) — see the output above. Files already written stay in place; nothing was deleted."
        exit 1
    fi

    pg_done "$step"
    log "restore complete: [${members[*]}]."
}

cmd_export() {
    local rel="${1:-}"
    [[ -z "$rel" ]] && { err "usage: aegis export <code>/<path> [--dest <dir>]"; exit 2; }
    shift
    local dest="$DEFAULT_EXPORT_DIR"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dest) [[ $# -ge 2 ]] || { err "--dest requires a value"; exit 2; }; dest="$2"; shift 2 ;;
            *) err "unknown option: $1"; exit 2 ;;
        esac
    done
    local vol sub resolved
    # Captured as a plain assignment (not piped into `read`) so a failure
    # inside resolve_data_path -- an `exit 1` from the command-substitution
    # SUBSHELL it runs in -- is actually observed here. `read -r ... <<<
    # "$(resolve_data_path ...)"` would silently discard that exit status
    # (only `read`'s own status would be checked) and let this function keep
    # going with empty vol/sub — a real bug found in this session's own
    # end-to-end test (a rejected ".."/absolute path still reached docker).
    resolved="$(resolve_data_path "$rel")" || exit 1
    read -r vol sub <<<"$resolved"
    local base
    base="$(basename "${sub:-$rel}")"
    # Refuse BEFORE any Docker call: the throwaway `cp -a` NESTS the copy when
    # the destination already exists (the acceptance handoff hit exactly that
    # with a stale kit dir), and silently creating base/base is never what the
    # caller meant. Removing the old copy is the caller's explicit decision.
    if [[ -e "${dest%/}/${base}" ]]; then
        err "the export destination already exists: ${dest%/}/${base}"
        err "remove it (or pick another --dest) and run the export again."
        exit 1
    fi
    pg_step 1 2 "Checking symlinks"
    check_no_symlink_escape "$vol" "$sub"
    pg_done 1
    host_mkdir_p "$dest"

    log "exporting /workspace/$rel -> ${dest%/}/${base} (throwaway container, read-only source, --network none)."
    pg_step 2 2 "Copying out"
    pg_run_counted 0 items -- env MSYS_NO_PATHCONV=1 docker run --rm --network none \
        -e SRC="/data${sub:+/$sub}" -e DST_BASE="$base" \
        -v "$(data_mount_src "$vol"):/data:ro" \
        -v "${dest}:/export" \
        "$BACKUP_IMAGE" sh -c '
            [ -e "$SRC" ] || { echo "aegis: nothing at that path" >&2; exit 1; }
            echo "@@aegis-total $(find "$SRC" | wc -l)"
            cp -av "$SRC" "/export/$DST_BASE"
        '
    pg_done 2
    log "exported to: ${dest%/}/${base}"
}

cmd_import() {
    local host_path="" rel="" replace=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --replace) replace=1; shift ;;
            -*) err "unknown option for 'aegis import': $1"; exit 2 ;;
            *)
                if [[ -z "$host_path" ]]; then host_path="$1"
                elif [[ -z "$rel" ]]; then rel="$1"
                else err "usage: aegis import <host-path> <code>/<path> [--replace]"; exit 2
                fi
                shift ;;
        esac
    done
    [[ -z "$host_path" || -z "$rel" ]] && { err "usage: aegis import <host-path> <code>/<path> [--replace]"; exit 2; }
    if [[ ! -e "$host_path" ]]; then
        err "host path not found: $host_path"
        exit 1
    fi
    local vol sub resolved
    resolved="$(resolve_data_path "$rel")" || exit 1
    read -r vol sub <<<"$resolved"

    local host_abs host_dir host_base
    host_abs="$(cd "$(dirname "$host_path")" && pwd)/$(basename "$host_path")"
    host_dir="$(dirname "$host_abs")"
    host_base="$(basename "$host_abs")"

    log "importing $host_path -> /workspace/$rel (throwaway container, --network none)."
    # DEST/SRC_BASE/REPLACE/REL passed as env vars (like check_no_symlink_escape's
    # TARGET above) so the inner script stays single-quoted and never has to
    # re-expand a bash variable inside an already-substituted string.
    #
    # Importing onto a path that ALREADY exists must never be a silent
    # `cp -a src dest`: with dest present, cp copies the source INSIDE it, so
    # the result is a nested <dest>/<name>/... that looks imported but is not
    # where anything expects it. That is exactly what happened on 2026-10-03,
    # when a re-import left a copy one level down and the build could no longer
    # find its .sln. So: refuse, and make --replace the explicit way to swap it
    # (this throwaway container is a plain docker run, so it does have the
    # capabilities needed to remove the previous copy).
    local rc=0
    pg_step 1 2 "Copying in"
    pg_run_counted 0 items -- env MSYS_NO_PATHCONV=1 docker run --rm --network none \
        -e DEST="/data${sub:+/$sub}" -e SRC_BASE="$host_base" -e REPLACE="$replace" \
        -e REL="/workspace/$rel" \
        -v "$(data_mount_src "$vol"):/data" \
        -v "${host_dir}:/import-src:ro" \
        "$BACKUP_IMAGE" sh -c '
            # Fail closed (T21-era hardening, 2026-10-20): without set -e, a
            # failed `cp` (a long Windows host path can exceed what the 9p
            # mount resolves) was MASKED by the `chown` that followed — the
            # container exited 0 and the launcher said "imported" over an
            # empty target. set -e makes the cp failure the container exit.
            set -eu
            parent="$(dirname "$DEST")"
            if [ -e "$DEST" ]; then
                if [ "$REPLACE" != "1" ]; then
                    echo "aegis: $REL already exists, and importing onto it would nest a copy inside it ($REL/$SRC_BASE/...)." >&2
                    echo "aegis: pass --replace to swap it for this source copy, or import to a new path." >&2
                    exit 3
                fi
                rm -rf "$DEST"
            fi
            mkdir -p "$parent"
            echo "@@aegis-total $(find "/import-src/$SRC_BASE" | wc -l)"
            cp -av "/import-src/$SRC_BASE" "$DEST"
            # chown the PARENT tree, not just $DEST: mkdir -p above runs as
            # root (this throwaway container has no non-root user), so any
            # newly created intermediate directory would otherwise stay
            # root-owned — the non-root "dev" user (no CAP_CHOWN, no sudo,
            # in the real container) could then never delete/rename what it
            # just imported. Real defect found in this session'"'"'s own E2E run.
            chown -R 1000:1000 "$parent"
        ' || rc=$?
    if [[ "$rc" -eq 3 ]]; then
        err "nothing was imported: the destination already exists (see the message above)."
        exit 1
    elif [[ "$rc" -ne 0 ]]; then
        err "import failed (container exit $rc)."
        exit 1
    fi
    pg_done 1
    pg_step 2 2 "Checking symlinks"
    check_no_symlink_escape "$vol" "$sub"
    pg_done 2
    log "imported to: /workspace/$rel"
}

# ---------------------------------------------------------------------------
# T25 — aegis build windows|clean (phase 1: Inno Setup under Wine)
# ---------------------------------------------------------------------------
# The host compiles a .iss that lives in a data volume, in a throwaway container
# that sees ONLY that project's root (volume-subpath), has no network, a
# read-only rootfs, uid 1000 and no capabilities. The installer lands in
# Output/ next to the .iss, inside the volume; `aegis export` takes it out.
# Never launched from inside the workstation (it has no docker.sock).

# The image tag names the Inno version (from the Dockerfile's ARG) AND a short
# hash of the template, so an `aegis update` that changes the Dockerfile or the
# entrypoint builds a new image instead of silently reusing a stale one.
build_windows_image() {
    local dir="${AEGIS_BUILD_WINDOWS_DIR%/}" version hash
    version="$(sed -n 's/^ARG INNO_VERSION=\([0-9][0-9A-Za-z.]*\)[[:space:]]*$/\1/p' "${dir}/Dockerfile" 2>/dev/null | head -n 1)"
    if command -v sha256sum >/dev/null 2>&1; then
        hash="$(cat "${dir}/Dockerfile" "${dir}/entrypoint.sh" 2>/dev/null | sha256sum | cut -c1-12)"
    else
        hash="$(cat "${dir}/Dockerfile" "${dir}/entrypoint.sh" 2>/dev/null | shasum -a 256 | cut -c1-12)"
    fi
    printf '%s:inno-%s-%s\n' "$BUILD_WINDOWS_IMAGE_REPO" "${version:-unknown}" "$hash"
}

# volume-subpath needs Docker Engine 26+. `docker version` reports the SERVER
# (engine) version, which is the one that matters here — not the client's.
# Usage: require_volume_subpath_engine <command> <what it mounts>
require_volume_subpath_engine() {
    local what="$1" mounts="$2" version major
    version="$(docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
    if [[ -z "$version" ]]; then
        err "no se pudo consultar la versión de Docker Engine (¿Docker Desktop está corriendo?)."
        exit 1
    fi
    major="${version%%.*}"
    if [[ ! "$major" =~ ^[0-9]+$ ]] || (( major < BUILD_WINDOWS_MIN_ENGINE )); then
        err "Docker Engine ${version} es demasiado antiguo: '${what}' necesita Docker Engine ${BUILD_WINDOWS_MIN_ENGINE} o superior"
        err "(${mounts} con volume-subpath, que no existe antes de la 26). Actualiza Docker Desktop y reintenta."
        exit 1
    fi
}

require_build_windows_engine() {
    require_volume_subpath_engine "aegis build windows" "monta solo la raíz del proyecto"
}

ensure_build_windows_image() {
    local image="$1" dir="${AEGIS_BUILD_WINDOWS_DIR%/}"
    if docker image inspect "$image" >/dev/null 2>&1; then
        return 0
    fi
    if [[ ! -f "${dir}/Dockerfile" || ! -f "${dir}/entrypoint.sh" ]]; then
        err "the build-windows template is missing at ${dir} (${AEGIS_BUILD_WINDOWS_SOURCE})."
        err "run 'aegis install' (or set AEGIS_BUILD_WINDOWS_DIR to the folder that holds its Dockerfile)."
        exit 1
    fi
    log "building ${image} once (Debian + Wine + Inno Setup; needs the network, takes a few minutes)..."
    if ! docker build -t "$image" "$(_to_native_path "$dir")"; then
        err "the build-windows image could not be built; nothing was compiled."
        exit 1
    fi
}

cmd_build_windows() {
    local usage="usage: aegis build windows <code>/<path>/<file>.iss"
    local rel=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -*) err "unknown option for 'aegis build windows': $1"; exit 2 ;;
            *)
                [[ -z "$rel" ]] || { err "$usage"; exit 2; }
                rel="$1"; shift ;;
        esac
    done
    [[ -n "$rel" ]] || { err "$usage"; exit 2; }
    case "$rel" in
        *.iss|*.ISS) ;;
        *) err "not an Inno Setup script (expected a .iss file): $rel"; err "$usage"; exit 2 ;;
    esac

    local vol sub resolved
    # Plain assignment, never piped into `read` (see cmd_export).
    resolved="$(resolve_data_path "$rel")" || exit 1
    read -r vol sub <<<"$resolved"

    # The project root is code/<Cliente>/<repo>: the only folder the build
    # container gets to see. single-code-volume: sub always starts with code/
    # (the volume root is the whole /workspace), so that head is dropped and
    # the project-root math stays on the segments after it.
    local need=2
    local -a segs=()
    local seg
    IFS='/' read -r -a segs <<<"$sub"
    segs=("${segs[@]:1}")
    for seg in "${segs[@]}"; do
        # Empty or "." segments would make the project root ambiguous; a comma
        # or a quote would break --mount's CSV syntax.
        case "$seg" in
            ""|.|*,*|*\"*)
                err "invalid path segment '${seg}' in: $rel"
                exit 1 ;;
        esac
    done
    if (( ${#segs[@]} <= need )); then
        err "the .iss must live inside a project: code/<Cliente>/<repo>/.../<file>.iss (got: $rel)"
        exit 2
    fi
    local root iss_rel
    root="$(IFS='/'; printf '%s' "${segs[*]:0:need}")"
    iss_rel="$(IFS='/'; printf '%s' "${segs[*]:need}")"

    # Client-redesign T2.2: the template installs lazily at first use — after
    # argument validation, before anything touches docker.
    ensure_build_windows_template || exit 1

    require_build_windows_engine
    local image
    image="$(build_windows_image)"
    ensure_build_windows_image "$image"

    log "compiling ${rel} (project code/${root} only; --network none, read-only, uid 1000)."
    local rc=0
    # /tmp holds the whole Wine prefix: Wine 10 copies real PE DLLs for both
    # system32 and syswow64, ~1.4 GB measured on the host (T25.4, 2026-10-08);
    # 1g filled up mid-wineboot. tmpfs only uses the RAM it actually fills.
    MSYS_NO_PATHCONV=1 docker run --rm --network none --read-only \
        --user 1000:1000 --cap-drop ALL --security-opt no-new-privileges \
        --tmpfs /tmp:rw,exec,size=3g \
        --mount "type=volume,src=${vol},dst=/src,volume-subpath=${root}" \
        "$image" "$iss_rel" || rc=$?
    if [[ "$rc" -ne 0 ]]; then
        err "the build failed (exit ${rc}); nothing to export."
        exit "$rc"
    fi

    local out_dir
    out_dir="$(dirname "$iss_rel")"
    if [[ "$out_dir" == "." ]]; then
        out_dir="code/${root}/Output"
    else
        out_dir="code/${root}/${out_dir}/Output"
    fi
    log "done. The installer is in /workspace/${out_dir} (unless the .iss sets its own OutputDir)."
    log "take it out with: aegis export ${out_dir}"
}

# Removes every aegis-build-windows image (all tags: the tag changes with the
# template). Nothing to remove is not an error.
cmd_build_clean() {
    [[ $# -eq 0 ]] || { err "usage: aegis build clean"; exit 2; }
    local -a images=()
    local line
    while IFS= read -r line; do
        [[ -n "$line" && "$line" != *"<none>"* ]] && images+=("$line")
    done < <(docker image ls --format '{{.Repository}}:{{.Tag}}' "$BUILD_WINDOWS_IMAGE_REPO" 2>/dev/null || true)
    if [[ "${#images[@]}" -eq 0 ]]; then
        log "no ${BUILD_WINDOWS_IMAGE_REPO} image to remove."
        return 0
    fi
    local rm_rc=0
    pg_spin_start "removing ${#images[@]} image(s)"
    docker image rm "${images[@]}" >/dev/null || rm_rc=$?
    pg_spin_stop
    [[ "$rm_rc" -eq 0 ]] || exit "$rm_rc"
    log "removed: ${images[*]}"
}

cmd_build() {
    local verb="${1:-}"
    case "$verb" in
        windows) shift; cmd_build_windows "$@" ;;
        clean) shift; cmd_build_clean "$@" ;;
        *) err "usage: aegis build windows <code>/<path>/<file>.iss | aegis build clean"; exit 2 ;;
    esac
}

# ---------------------------------------------------------------------------
# T22 — aegis env / aegis add environment / aegis remove environment
# ---------------------------------------------------------------------------

require_env_helper() {
    if ! command -v node >/dev/null 2>&1; then
        err "node is required for language-manifest commands (JSON + live version lookups) but was not found in PATH."
        exit 1
    fi
    if [[ ! -f "$ENV_JS" || ! -f "$BUILD_VIEW_JS" ]]; then
        err "the configuration is incomplete - a helper file is missing."
        err "run 'aegis install' to reinstall it, or set AEGIS_WORKSTATION_DIR to the folder that holds it."
        exit 1
    fi
}

# Rebuilds the dev image (Docker-layer-cached per language — see the
# Dockerfile) from the current manifest, regenerates the effective
# allowlist, recreates the dev container (volumes untouched, see
# docker-compose.yml's named volumes) and reloads the egress proxy so it
# picks up the new allowlist.
#
# 2026-10-08: the image is tagged with AEGIS_DEV_IMAGE as resolve_dev_image
# decides it — aegis-workstation-env:<hash>, never the registry reference, so
# the next `aegis up` finds it instead of pulling over it. A manifest that asks
# for nothing builds nothing: its local build would be the published image minus
# the signature, so the signed one is pulled and verified instead (same as `up`).
env_rebuild_and_apply() {
    require_env_helper
    local started_at context_seconds rc=0 logdir
    started_at="$(date +%s)"
    logdir="${BUILD_LOG_DIR%/}"
    mkdir -p "$logdir"

    # Phase 1 is host work, not part of the image build, and the renderer prints
    # it so the whole checklist has a single source. The helper scripts are
    # internals: their output goes to a log, never to the user's terminal.
    if [[ ! -f "$GEN_BUILD_CONTEXT_SH" ]]; then
        err "the configuration is incomplete - ${GEN_BUILD_CONTEXT_SH} is missing; run 'aegis install'."
        exit 1
    fi
    context_seconds="$(regenerate_build_context)" || rc=$?
    if [[ "$rc" != "0" ]]; then
        err "generate-build-context.sh failed (log: ${logdir}/context-*.log) — nothing was rebuilt."
        exit "$rc"
    fi

    # The env tag includes the verified base digest, so the base is pulled and
    # verified before the tag is computed (R3-002).
    if manifest_requests_anything && [[ -z "$AEGIS_VERIFIED_BASE_REF" ]]; then
        pull_and_verify_published_image
    fi
    resolve_dev_image
    if manifest_requests_anything; then
        build_dev_image "$context_seconds" || rc=$?
    else
        log "the manifest asks for no languages or tools — using the signed published image instead of building one."
        pull_and_verify_published_image
    fi
    if [[ "$rc" != "0" ]]; then
        log "the image was not built — your workstation still runs the previous one, untouched."
        if [[ -n "${BUILD_UNDO:-}" ]]; then
            log "the manifest keeps this change; undo it with: ${BUILD_UNDO}"
        fi
        exit "$rc"
    fi
    # Record the reference just resolved in the launcher state (.env).
    write_compose_env

    bash "$GEN_ALLOWLIST_SH" >>"${logdir}/allowlist-$(date -u +%Y%m%dT%H%M%SZ).log" 2>&1
    log "allowlist updated (languages: $(manifest_language_names); tools: $(manifest_tool_names))"

    # Recreating the container and reloading the proxy: Docker's own output is
    # useful when it fails and noise when it does not, so it goes to a log and
    # only its tail is shown if something goes wrong.
    # --no-build: the image was just built (or pulled and verified) under exactly
    # this name; compose must start that one or fail, never build a second copy.
    local stack_log="${logdir}/stack-$(date -u +%Y%m%dT%H%M%SZ).log"
    local stack_rc=0
    pg_watch_start services _pg_compose_counts dev
    compose up -d --wait --no-build dev >>"$stack_log" 2>&1 || stack_rc=$?
    pg_watch_stop
    if [[ "$stack_rc" -ne 0 ]]; then
        err "the container did not come up; last lines:"
        tail -n 20 "$stack_log" | sed 's/^/  /' >&2
        exit 1
    fi
    if ! compose restart egress-proxy >>"$stack_log" 2>&1; then
        err "the egress proxy did not restart; last lines:"
        tail -n 20 "$stack_log" | sed 's/^/  /' >&2
        exit 1
    fi
    log "$(_compose_apply_claim "$(_compose_apply_class "$stack_log")")"

    summarize_rebuild "$started_at"
}

# --- T26: readable rebuild output ------------------------------------------
# The build itself is unchanged: same compose command, same order, same image.
# aegis-build-view.js only decides HOW the build's output is shown and keeps the
# complete log in BUILD_LOG_DIR. `--verbose` (or AEGIS_BUILD_VERBOSE=1) streams
# the raw log as before.

# _compose_apply_class <compose log>: classifies what `compose up -d --wait
# dev` actually did to the dev container, from the compose output captured in
# $1. The same file later receives the egress-proxy restart output, so lines
# naming another container never decide, and only the dev container's own
# lines count (its compose name ends in the service name + index: dev-1,
# dev_1). Prints recreated | running | unknown; the caller never invents a
# claim from "unknown".
_compose_apply_class() {
    local log_file="$1" dev_lines
    if [[ ! -f "$log_file" ]]; then
        printf 'unknown'
        return
    fi
    dev_lines="$(grep -E 'dev[-_][0-9]+' "$log_file" 2>/dev/null)" || true
    if [[ -n "$dev_lines" ]] && grep -qiE 'recreated|created|started|starting' <<<"$dev_lines"; then
        printf 'recreated'
    elif [[ -n "$dev_lines" ]] && grep -qiE 'running|up-to-date' <<<"$dev_lines"; then
        printf 'running'
    else
        printf 'unknown'
    fi
}

# _compose_apply_claim <class>: the rebuild log line, built ONLY from what
# compose reported. A no-op apply (container already running unchanged) must
# not claim "recreated"; an unrecognisable log keeps the previous wording
# rather than inventing a new one.
_compose_apply_claim() {
    case "$1" in
        recreated) printf 'container recreated, proxy reloaded' ;;
        running)   printf 'container already running unchanged, proxy reloaded' ;;
        *)         printf 'container recreated, proxy reloaded' ;;
    esac
}

build_log_path() {
    printf '%s/build-%s.log\n' "${BUILD_LOG_DIR%/}" "$(date -u +%Y%m%dT%H%M%SZ)"
}

format_duration() {
    local total="$1"
    if (( total >= 60 )); then
        printf '%dm %ds' $(( total / 60 )) $(( total % 60 ))
    else
        printf '%ds' "$total"
    fi
}

# Bytes -> a short human-readable size. Integer math only (no bc, not assumed).
format_size() {
    local bytes="$1"
    if (( bytes >= 1073741824 )); then
        printf '%d.%02d GB' $(( bytes / 1073741824 )) $(( (bytes % 1073741824) * 100 / 1073741824 ))
    elif (( bytes >= 1048576 )); then
        printf '%d MB' $(( bytes / 1048576 ))
    else
        printf '%d KB' $(( bytes / 1024 ))
    fi
}

# The image the dev container actually runs. This used to assume Compose's
# derived `<project>-dev:latest`, a name that never existed once the compose
# file set `image:` explicitly, so the size line silently vanished. Now: what the
# running container reports, else the reference this run resolved.
dev_image_tag() {
    local running
    running="$(docker inspect --format '{{.Config.Image}}' "$DEV_CONTAINER" 2>/dev/null || true)"
    printf '%s\n' "${running:-$AEGIS_DEV_IMAGE}"
}

# `$HOME/...` printed as `~/...`: the absolute path of the user's account is
# noise in a build log. Handles the POSIX and the Windows form of it.
tildify() {
    local value="$1" home_native
    home_native="$(_to_native_path "$HOME")"
    case "$value" in
        "$HOME"/*) printf '~/%s' "${value#"$HOME"/}" ;;
        "$home_native"/*) printf '~/%s' "${value#"$home_native"/}" ;;
        *) printf '%s' "$value" ;;
    esac
}

# Just the opt-in tools turned on in the manifest, for the allowlist line.
manifest_tool_names() {
    node "$ENV_JS" read "$AEGIS_ENV_FILE" | node -e '
        let s = ""; process.stdin.on("data", d => s += d).on("end", () => {
            const t = JSON.parse(s).tools || {};
            const on = process.argv[1].split(" ").filter((name) => t[name]);
            console.log(on.length ? on.join(" ") : "none");
        });' "$ALL_TOOLS"
}

# Just the language names in the manifest (no versions), for the allowlist line.
manifest_language_names() {
    node "$ENV_JS" read "$AEGIS_ENV_FILE" | node -e '
        let s = ""; process.stdin.on("data", d => s += d).on("end", () => {
            const m = JSON.parse(s); const parts = [];
            for (const lang of ["java", "dotnet", "node", "go", "python"]) {
                if ((m[lang] || []).length) parts.push(lang);
            }
            if (m.cpp) parts.push("cpp");
            console.log(parts.length ? parts.join(" ") : "none");
        });'
}

build_dev_image() {
    require_env_helper
    local host_seconds="$1" log
    mkdir -p "${BUILD_LOG_DIR%/}"
    log="$(build_log_path)"
    local -a view_args=(--host-status ok --host-detail "$(tildify "$AEGIS_ENV_FILE")")
    [[ -n "$host_seconds" ]] && view_args+=(--host-seconds "$host_seconds")
    [[ -n "${BUILD_UNDO:-}" ]] && view_args+=(--undo "$BUILD_UNDO")
    [[ "${AEGIS_BUILD_VERBOSE:-0}" == "1" ]] && view_args+=(--verbose)
    # MSYS_NO_PATHCONV because this call hands native-form paths to node
    # (see _to_native_path above), and node — not bash — spawns docker from
    # there: no MSYS conversion may interfere in between.
    #
    # A client has no checkout. It builds only the env layers (Dockerfile.client,
    # shipped in the signed bundle) FROM the published image, pinned by the
    # digest cosign just verified — pulled and verified here unless this run
    # already did (aegis up does it first).
    local client_dockerfile
    client_dockerfile="$(_dev_dockerfile)"
    if [[ ! -f "$client_dockerfile" ]]; then
        err "the configuration is incomplete - $(tildify "$client_dockerfile") is missing; run 'aegis install'."
        return 1
    fi
    [[ -n "$AEGIS_VERIFIED_BASE_REF" ]] || pull_and_verify_published_image
    # 2026-10-16: a client build reads base-image blobs from OUR registry
    # without asking — BuildKit fetches them lazily whenever its local store
    # lacks them — and the fetch that fails lands in the EXPORT, at the end of
    # a build that can take ten minutes. The pull and the verify already ran
    # with a token minted for them; the build ran with the user's
    # ~/.docker/config.json instead, where a credential that was old, absent,
    # or held by a Windows credential helper answered "401 Unauthorized" with
    # every layer already built and the image unpackable. Same throwaway
    # config as the pull, minted HERE so its hour covers the whole build, and
    # removed when the build ends.
    local build_config="" build_config_native=""
    build_config="$(mktemp -d)" || build_config=""
    if [[ -n "$build_config" ]]; then
        local build_token=""
        build_token="$(_image_download_token "build")" || build_token=""
        if [[ -z "$build_token" ]] || ! _write_registry_config "$build_config" "$build_token"; then
            # Never a new way to fail: until today this build asked for no
            # credential at all, so a licensing hiccup falls back to what the
            # environment already has — said out loud, because that is also
            # the state whose export can answer 401.
            err "WARNING: the build runs without a fresh registry credential - it falls back to this environment's docker config, and reading base images from our registry can then answer 401 at the export."
            rm -rf "$build_config"
            build_config=""
        fi
        build_token=""
    fi
    [[ -n "$build_config" ]] && build_config_native="$(_to_native_path "$build_config")"
    local -a build_cmd=(docker build
        -f "$(_to_native_path "$client_dockerfile")"
        --build-arg "AEGIS_BASE_IMAGE=${AEGIS_VERIFIED_BASE_REF}"
        -t "$AEGIS_DEV_IMAGE"
        "$(_to_native_path "${AEGIS_WORKSTATION_DIR%/}")")
    # One assignment array, never empty: `env` with no assignment is the same as
    # no `env` at all, and an empty expansion would trip `set -u` on older bash.
    local -a build_env=(MSYS_NO_PATHCONV=1)
    [[ -n "$build_config_native" ]] && build_env=(MSYS_NO_PATHCONV=1 "DOCKER_CONFIG=$build_config_native")
    local build_rc=0
    # The credential directory — empty when the build has none — is the helper's to
    # remove on every way out, Ctrl-C and SIGTERM included.
    _run_with_throwaway_config "$build_config" env "${build_env[@]}" node "$(_to_native_path "$BUILD_VIEW_JS")" "${view_args[@]}" \
        --log "$(_to_native_path "$log")" \
        --generated-dir "$(_to_native_path "$GENERATED_DIR")" \
        -- "${build_cmd[@]}" || build_rc=$?
    return "$build_rc"
}

summarize_rebuild() {
    local started_at="$1" seconds size size_line=""
    seconds=$(( $(date +%s) - started_at ))
    size="$(docker image inspect "$(dev_image_tag)" --format '{{.Size}}' 2>/dev/null || true)"
    [[ -n "$size" ]] && size_line=" - image $(format_size "$size")"
    log "done in $(format_duration "$seconds")$size_line"
}

cmd_env() {
    local action="${1:-list}"
    [[ $# -gt 0 ]] && shift || true
    case "$action" in
        list) cmd_env_list "$@" ;;
        rebuild)
            # Client-redesign L3: retired. add/remove environment|tool rebuild
            # by themselves; this manual escape only duplicated them.
            err "'aegis env rebuild' was retired: 'aegis add environment|tool' rebuilds by itself."
            err "  add a language:    aegis add environment <lang> [version...]"
            err "  add a tool:        aegis add tool <name>"
            exit 2
            ;;
        *)
            err "unknown 'aegis env' subcommand: $action"
            err "usage: aegis env [list|rebuild]"
            exit 2
            ;;
    esac
}

cmd_env_list() {
    require_env_helper
    if [[ "${1:-}" == "--remote" ]]; then
        local lang="${2:-}"
        [[ -z "$lang" ]] && { err "usage: aegis env list --remote <java|dotnet|node|go|python>"; exit 2; }
        node "$ENV_JS" list-remote "$lang"
        return 0
    fi
    echo "Your languages ($AEGIS_ENV_FILE):"
    node "$ENV_JS" read "$AEGIS_ENV_FILE" | node -e '
        let s = ""; process.stdin.on("data", d => s += d).on("end", () => {
            const m = JSON.parse(s); let any = false;
            for (const lang of ["java", "dotnet", "node", "go", "python"]) {
                const v = m[lang] || [];
                if (v.length) any = true;
                console.log("  " + lang.padEnd(8) + (v.length ? v.join(", ") : "-"));
            }
            if (m.cpp) any = true;
            console.log("  " + "cpp".padEnd(8) + (m.cpp ? "yes" : "-"));
            if (!any) console.log("\n  No languages yet. Add one with: aegis add environment <lang>");
            console.log("\nYour tools:");
            const t = m.tools || {};
            for (const name of process.argv[1].split(" ")) {
                console.log("  " + name.padEnd(8) + (t[name] ? "yes" : "-"));
            }
            console.log("\n  Turn one on or off with: aegis add tool <name> / aegis remove tool <name>");
        });' "$ALL_TOOLS"
    echo
    echo "Installed in the running workstation:"
    if is_up; then
        local installed
        # The "migrate" warning comes from mise trying to write to its
        # read-only data dir on images built before that dir was precreated;
        # it is harmless and disappears after the next rebuild.
        installed="$(docker exec "$DEV_CONTAINER" mise ls 2>&1 | grep -v -F '[WARN] migrate:' || true)"
        if [[ -n "$installed" ]]; then
            printf '%s\n' "$installed" | sed 's/^/  /'
        else
            echo "  (none)"
        fi
    else
        echo "  (workstation is not running — start it with: aegis up)"
    fi
}

# Prints a numbered menu of remote versions for one language and reads the
# user's selection (comma-separated indices, e.g. "2,4"). Echoes the
# resolved, chosen version STRINGS (space-separated) on stdout; nothing else
# goes to stdout so this can be captured with command substitution.
env_interactive_menu() {
    local lang="$1"
    local tsv
    tsv="$(node "$ENV_JS" list-remote "$lang")" || exit 1

    local -a versions=() labels=()
    local v lts label
    local shown=0
    local -a display_idx=()
    echo "Available $lang versions (LTS first) — installed ones already in the manifest are marked [installed]:" >&2
    local current
    current="$(node "$ENV_JS" versions-file "$AEGIS_ENV_FILE" "$lang" 2>/dev/null || true)"
    # Installed versions as an in-memory set: one grep per remote version
    # (hundreds for node) meant hundreds of process forks, which on Git Bash
    # for Windows made the menu look frozen for a long time.
    local -A installed=()
    local cv
    while IFS= read -r cv; do
        [[ -n "$cv" ]] && installed["$cv"]=1
    done <<<"$current"

    local n=0
    # Default view: newest version of each release line (major), in the
    # remote order (LTS first). "A" shows every version.
    local -a line_idx=()
    local -A seen_major=()
    while IFS=$'\t' read -r v lts label; do
        [[ -z "$v" ]] && continue
        n=$((n + 1))
        versions[n]="$v"
        local mark=""
        [[ -n "${installed[$v]:-}" ]] && mark=" [installed]"
        labels[n]="$v  $label$mark"
        local major="${v%%.*}"
        if [[ -z "${seen_major[$major]:-}" ]]; then
            seen_major[$major]=1
            line_idx+=("$n")
        fi
    done <<<"$tsv"

    local show_all=0
    while true; do
        local i
        local -a shown=()
        if [[ "$show_all" -eq 1 ]]; then
            for ((i = 1; i <= n; i++)); do shown+=("$i"); done
        else
            shown=("${line_idx[@]}")
        fi
        # Menu numbers are 1..k for what is on screen; menu_map translates
        # them back to the version index.
        local -a menu_map=()
        local k=0
        for i in "${shown[@]}"; do
            k=$((k + 1))
            menu_map[k]="$i"
            printf '  %3d) %s\n' "$k" "${labels[$i]}" >&2
        done
        if [[ "$show_all" -eq 0 && "${#line_idx[@]}" -lt "$n" ]]; then
            printf '    A) show all versions (%d total)\n' "$n" >&2
        fi
        printf 'Select one or more (comma-separated, e.g. "1,3"), or "A" to show all: ' >&2
        local sel
        read -r sel
        if [[ "$sel" == "A" || "$sel" == "a" ]]; then
            show_all=1
            continue
        fi
        if [[ -z "$sel" ]]; then
            err "no selection made"
            exit 1
        fi
        local -a chosen=()
        local part
        local saved_ifs="$IFS"
        IFS=','
        for part in $sel; do
            part="$(printf '%s' "$part" | tr -d '[:space:]')"
            [[ -z "$part" ]] && continue
            if ! [[ "$part" =~ ^[0-9]+$ ]] || (( part < 1 || part > k )); then
                IFS="$saved_ifs"
                err "invalid selection: $part"
                exit 1
            fi
            chosen+=("${versions[${menu_map[$part]}]}")
        done
        IFS="$saved_ifs"
        printf '%s\n' "${chosen[@]}"
        return 0
    done
}

cmd_add_environment() {
    local lang="${1:-}"
    [[ -z "$lang" ]] && { err "usage: aegis add environment <java|dotnet|node|go|python|cpp> [version...] [--dist temurin|corretto|zulu] [--yes] [--verbose]"; exit 2; }
    shift
    require_env_helper

    if [[ "$lang" == "cpp" ]]; then
        node "$ENV_JS" set-cpp "$AEGIS_ENV_FILE" true
        log "cpp environment enabled in the manifest."
        env_rebuild_and_apply
        return 0
    fi

    case "$lang" in go|node|python|dotnet|java) ;; *) err "unknown language: $lang (expected one of: $ALL_LANGS cpp)"; exit 2 ;; esac

    local dist="" yes=0
    local -a tokens=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dist) dist="${2:-}"; shift 2 ;;
            --yes) yes=1; shift ;;
            --verbose) AEGIS_BUILD_VERBOSE=1; shift ;;
            *) tokens+=("$1"); shift ;;
        esac
    done

    local -a resolved=()
    if [[ "${#tokens[@]}" -eq 0 ]]; then
        if [[ "$yes" -eq 1 ]]; then
            err "--yes requires at least one explicit version"
            exit 2
        fi
        local -a picked
        mapfile -t picked < <(env_interactive_menu "$lang")
        [[ "${#picked[@]}" -eq 0 ]] && { err "no version selected"; exit 1; }
        resolved=("${picked[@]}")
    else
        local tok full
        for tok in "${tokens[@]}"; do
            if [[ -n "$dist" && "$lang" == "java" ]]; then
                tok="${dist}-${tok}"
            fi
            full="$(node "$ENV_JS" resolve "$lang" "$tok")" || exit 1
            resolved+=("$full")
        done
    fi

    local r
    for r in "${resolved[@]}"; do
        log "adding $lang@$r to the manifest"
        node "$ENV_JS" add-version "$AEGIS_ENV_FILE" "$lang" "$r"
        BUILD_UNDO="aegis remove environment $lang $r"
    done

    env_rebuild_and_apply
}

cmd_remove_environment() {
    local lang="" version=""
    local -a positional=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --verbose) AEGIS_BUILD_VERBOSE=1; shift ;;
            -*) err "unknown option for 'aegis remove environment': $1"; exit 2 ;;
            *) positional+=("$1"); shift ;;
        esac
    done
    lang="${positional[0]:-}"
    version="${positional[1]:-}"
    [[ -z "$lang" ]] && { err "usage: aegis remove environment <java|dotnet|node|go|python|cpp> [version] [--verbose]"; exit 2; }
    require_env_helper

    if [[ "$lang" == "cpp" ]]; then
        node "$ENV_JS" set-cpp "$AEGIS_ENV_FILE" false
        log "cpp environment disabled in the manifest."
        env_rebuild_and_apply
        return 0
    fi

    case "$lang" in go|node|python|dotnet|java) ;; *) err "unknown language: $lang (expected one of: $ALL_LANGS cpp)"; exit 2 ;; esac

    if [[ -z "$version" ]]; then
        err "usage: aegis remove environment $lang <version> [--verbose]"
        err "currently in the manifest:"
        node "$ENV_JS" versions-file "$AEGIS_ENV_FILE" "$lang" | sed 's/^/    /' >&2
        exit 2
    fi

    log "removing $lang@$version from the manifest"
    node "$ENV_JS" remove-version "$AEGIS_ENV_FILE" "$lang" "$version"
    BUILD_UNDO="aegis add environment $lang $version --yes"
    env_rebuild_and_apply
}

# --- Opt-in tools (gh, az, railway, chromium) -------------------------------
# Same model as cpp: one boolean per tool in the manifest, and the image is
# rebuilt from it. `aegis add tool` / `aegis remove tool` without a name list
# the tools and whether each one is on.

tool_list() {
    local tool
    echo "Tools ($(tildify "$AEGIS_ENV_FILE")):"
    for tool in $ALL_TOOLS; do
        if [[ "$(node "$ENV_JS" tool-flag "$AEGIS_ENV_FILE" "$tool")" == "true" ]]; then
            printf '  %-8s on\n' "$tool"
        else
            printf '  %-8s off\n' "$tool"
        fi
    done
}

# Shared body of `aegis add tool` (value=true) and `aegis remove tool`
# (value=false).
tool_set_and_rebuild() {
    local verb="$1" value="$2"
    shift 2
    local tool=""
    local -a positional=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes) shift ;;
            --verbose) AEGIS_BUILD_VERBOSE=1; shift ;;
            -*) err "unknown option for 'aegis $verb tool': $1"; exit 2 ;;
            *) positional+=("$1"); shift ;;
        esac
    done
    require_env_helper
    tool="${positional[0]:-}"
    if [[ -z "$tool" ]]; then
        tool_list
        echo
        echo "usage: aegis $verb tool <${ALL_TOOLS// /|}> [--yes] [--verbose]"
        return 0
    fi
    if [[ "${#positional[@]}" -gt 1 ]]; then
        err "one tool at a time: aegis $verb tool <${ALL_TOOLS// /|}>"
        exit 2
    fi
    case " $ALL_TOOLS " in
        *" $tool "*) ;;
        *) err "unknown tool: $tool (expected one of: $ALL_TOOLS)"; exit 2 ;;
    esac

    local state="off" current
    [[ "$value" == "true" ]] && state="on"
    current="$(node "$ENV_JS" tool-flag "$AEGIS_ENV_FILE" "$tool")" || exit 1
    if [[ "$current" == "$value" ]]; then
        log "$tool is already $state in the manifest — nothing to rebuild (to rebuild anyway: aegis env rebuild)."
        return 0
    fi

    node "$ENV_JS" set-tool "$AEGIS_ENV_FILE" "$tool" "$value"
    log "$tool turned $state in the manifest."
    if [[ "$value" == "true" ]]; then
        BUILD_UNDO="aegis remove tool $tool"
    else
        BUILD_UNDO="aegis add tool $tool --yes"
    fi
    env_rebuild_and_apply
}

cmd_add_tool() {
    tool_set_and_rebuild add true "$@"
}

cmd_remove_tool() {
    tool_set_and_rebuild remove false "$@"
}

# `aegis version`: the product version from the same version.json the default
# image tag reads (see _product_version). Here a missing file IS fatal — the
# command has nothing else to say, and silence would be a lie. Works from any
# resolution of AEGIS_WORKSTATION_DIR: explicit, installed copy or the checkout
# — the file lives in the template tree either way.
# `aegis version` answers for BOTH halves, CLI first: the CLI is what the user
# just installed and needs no license; the workstation version is a licensed
# product, so without a license there is nothing to report but the way to get
# one. Reading version.json is local, but "which workstation do I have" only
# makes sense once the license allows it to exist.
cmd_version() {
    local here cli v
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    cli=""
    if [[ -f "${here}/VERSION" ]]; then
        # release-please writes "0.6.10 # x-release-please-version": take the
        # number, never the annotation.
        cli="$(head -n1 "${here}/VERSION" | cut -d' ' -f1 | tr -d '[:space:]')"
    fi
    [[ -n "$cli" ]] || cli="unknown (reinstall the CLI so VERSION lands next to aegis)"
    printf 'aegis CLI          %s\n' "$cli"

    # `version` is exempt from the gate, so the state was never computed for
    # this command: ask for it now (it is cached once computed).
    if ! _client_licensed; then
        printf 'aegis workstation  needs a license (aegis license activate <license-id>)\n'
        return 0
    fi

    if v="$(_product_version)"; then
        printf 'aegis workstation  %s\n' "$v"
    else
        printf 'aegis workstation  not installed (aegis install <license-id>)\n'
    fi
}

# ---------------------------------------------------------------------------
# Telemetry (opt-in). Off until `aegis telemetry on`; AEGIS_TELEMETRY=off wins.
# All of the logic (config, payload, sending) is in aegis-telemetry.js.
# ---------------------------------------------------------------------------

cmd_telemetry() {
    local sub="${1:-status}"
    [[ $# -gt 0 ]] && shift || true
    if [[ ! -f "$TELEMETRY_JS" ]]; then
        err "aegis-telemetry.js is missing next to the launcher ($(tildify "$TELEMETRY_JS")); run 'aegis update'."
        exit 1
    fi
    local js
    js="$(_to_native_path "$TELEMETRY_JS")"
    case "$sub" in
        status) node "$js" status ;;
        on) MSYS_NO_PATHCONV=1 node "$js" enable "$@" ;;
        off) node "$js" disable ;;
        *)
            err "unknown 'aegis telemetry' subcommand: $sub (expected: status | on | off)"
            exit 2
            ;;
    esac
}

# ---------------------------------------------------------------------------
# T38: persistent personal profile (docs/10-workstation.md section 12).
#
# The incident this closes: a recreated home/opencode-config volume silently
# loses the chosen `provider` block, because `gentle-ai install` rewrites
# opencode.json from scratch and the profile application used to be a purely
# manual step. The chosen profile now persists at
# /workspace/code/.aegis/profile.json (data volume: survives the wipe,
# rides `aegis backup`), and configure-workstation.sh re-applies it at the
# end of every configure run.
#
# Every path this command touches lives INSIDE the workstation container, so
# all file operations go through `docker exec` — the same exec route the
# session helpers use; MSYS_NO_PATHCONV=1 keeps Git Bash from rewriting the
# container-side absolute paths into Windows ones. Validation is `node`,
# inside the container (the image has node; the host may not): the profile
# must be valid JSON with a top-level `provider` object whose tree carries NO
# key named apiKey/token/secret (case-insensitive, punctuation-insensitive) —
# API keys belong in /connect, never in a profile. A refusal writes nothing:
# the source lands in a `.tmp` next to the store, is validated there, and
# only a clean file is renamed over the store. The merge itself stays
# apply-profile.sh's job (single source of merge semantics, D5).
# ---------------------------------------------------------------------------

# The validator: parses, requires a provider object, then walks ONLY the
# provider tree hunting forbidden key names. Exits 1 with the reason on
# stderr; on success prints the sorted provider names on stdout.
_PROFILE_VALIDATE_JS='
const fs = require("fs");
let cfg;
try {
    cfg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
} catch (e) {
    console.error("invalid JSON: " + e.message);
    process.exit(1);
}
if (!cfg.provider || typeof cfg.provider !== "object" || Array.isArray(cfg.provider)) {
    console.error("the file has no top-level \"provider\" object — nothing to store.");
    process.exit(1);
}
const banned = ["apikey", "token", "secret"];
let hit = null;
(function walk(node) {
    if (hit || node === null || typeof node !== "object") return;
    for (const k of Object.keys(node)) {
        if (hit) return;
        if (banned.indexOf(k.toLowerCase().replace(/[^a-z0-9]/g, "")) !== -1) { hit = k; return; }
        walk(node[k]);
    }
})(cfg.provider);
if (hit) {
    console.error("refused: the provider tree contains the key \"" + hit + "\": API keys belong in /connect, not in profiles.");
    process.exit(1);
}
process.stdout.write(Object.keys(cfg.provider).sort().join(", "));
'

# Applied-vs-pending report. Every path is the container's own; prints and
# exits 0 whether or not anything is stored yet (`show` reports, it does not
# scold).
_PROFILE_SHOW_JS='
const fs = require("fs");
const store = process.argv[1];
const opencode = process.argv[2];
if (!fs.existsSync(store)) {
    console.log("aegis: no stored profile at " + store + " — activate one with: aegis profile use <path|name>");
    process.exit(0);
}
let stored;
try {
    stored = JSON.parse(fs.readFileSync(store, "utf8"));
} catch (e) {
    console.log("aegis: the stored file at " + store + " is not valid JSON (" + e.message + ") — fix it and re-run: aegis profile use <path|name>");
    process.exit(0);
}
const names = (stored.provider && typeof stored.provider === "object" && !Array.isArray(stored.provider))
    ? Object.keys(stored.provider).sort() : [];
console.log("aegis: stored profile: " + store);
console.log("aegis: providers: [" + names.join(", ") + "]");
let live;
try {
    live = JSON.parse(fs.readFileSync(opencode, "utf8"));
} catch (e) {
    console.log("aegis: status: pending — " + opencode + " is not there yet; configure-workstation.sh applies the stored profile after gentle-ai install.");
    process.exit(0);
}
const livep = (live.provider && typeof live.provider === "object") ? live.provider : {};
const missing = names.filter(function (n) { return Object.prototype.hasOwnProperty.call(livep, n) === false; });
if (missing.length === 0) {
    console.log("aegis: status: applied — every stored provider is present in " + opencode);
} else {
    console.log("aegis: status: pending — missing from opencode.json: [" + missing.join(", ") + "] — re-apply now: aegis profile use <same path|name>");
}
'

_profile_exec() {
    MSYS_NO_PATHCONV=1 docker exec "$@"
}

# The staging file sits next to the store (same filesystem) so the final
# commit is a rename, never a partial copy of a live profile.
_profile_stage() { printf '%s.tmp.%s' "$AEGIS_PROFILE_STORE_PATH" "$$"; }

_profile_drop_stage() {
    _profile_exec "$DEV_CONTAINER" sh -c 'rm -f "$1"' sh "$(_profile_stage)" 2>/dev/null || true
}

_profile_require_up() {
    if ! is_up; then
        err "the workstation is not running — the profile lives inside its volumes: run 'aegis up' first."
        exit 1
    fi
}

cmd_profile_use() {
    local want="${1:-}"
    if [[ -z "$want" ]]; then
        err "usage: aegis profile use <path|name>"
        exit 2
    fi
    if [[ $# -gt 1 ]]; then
        err "one profile at a time: aegis profile use <path|name> (got $#)"
        exit 2
    fi
    _profile_require_up

    # Host file wins; else a bare name resolves under the profiles dir that
    # compose mounts read-only into the container (compose:214). Anything
    # with a slash that is not a real host file is simply a missing path,
    # and a name is kept filesystem-sane (no leading dot, no traversal).
    local kind="path" src=""
    if [[ ! -f "$want" ]]; then
        if [[ "$want" == */* ]]; then
            err "profile file not found: $want"
            exit 1
        fi
        if [[ ! "$want" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
            err "invalid profile name: $want — a name is one file under ${AEGIS_PROFILES_DIR%/}/ (no leading dot, no slashes); pass a POSIX path for your own copies."
            exit 2
        fi
        kind="name"
        src="${AEGIS_PROFILES_DIR%/}/$want.json"
    fi

    local stage
    stage="$(_profile_stage)"
    if ! _profile_exec "$DEV_CONTAINER" sh -c 'mkdir -p "$(dirname "$1")"' sh "$stage"; then
        err "cannot prepare the profile storage inside the workstation ($AEGIS_PROFILE_STORE_PATH)."
        exit 1
    fi

    if [[ "$kind" == "name" ]]; then
        if ! _profile_exec "$DEV_CONTAINER" cp "$src" "$stage"; then
            _profile_drop_stage
            err "profile not found in the workstation image: $src"
            err "names resolve under ${AEGIS_PROFILES_DIR%/}/ — pass a host-side path for your own copies."
            exit 1
        fi
    elif ! _profile_exec -i "$DEV_CONTAINER" sh -c 'cat > "$1"' sh "$stage" < "$want"; then
        _profile_drop_stage
        err "could not copy the profile into the workstation: $want"
        exit 1
    fi

    local vout
    if ! vout="$(_profile_exec "$DEV_CONTAINER" node -e "$_PROFILE_VALIDATE_JS" "$stage" 2>&1)"; then
        _profile_drop_stage
        if [[ -n "$vout" ]]; then
            local line
            while IFS= read -r line; do
                if [[ -n "$line" ]]; then err "$line"; fi
            done <<< "$vout"
        fi
        err "the profile was NOT stored — fix it and run 'aegis profile use' again."
        exit 2
    fi

    if ! _profile_exec "$DEV_CONTAINER" sh -c 'mv -f "$1" "$2"' sh "$stage" "$AEGIS_PROFILE_STORE_PATH"; then
        _profile_drop_stage
        err "could not store the profile at $AEGIS_PROFILE_STORE_PATH"
        exit 1
    fi
    log "profile stored at $AEGIS_PROFILE_STORE_PATH — it survives a home/opencode-config recreation and rides 'aegis backup'."

    # Apply now when opencode.json already exists; otherwise this is exactly
    # the recreation case and configure-workstation.sh is the one that will
    # merge on the next configure. A FAILED apply never un-stores the
    # profile: the store is the promise; the apply is opportunistic.
    if _profile_exec "$DEV_CONTAINER" test -f "$AEGIS_OPENCODE_JSON"; then
        if _profile_exec "$DEV_CONTAINER" bash "$AEGIS_APPLY_PROFILE_SCRIPT" "$AEGIS_PROFILE_STORE_PATH"; then
            log "applied now into $AEGIS_OPENCODE_JSON — add the API keys with /connect inside OpenCode, never in the profile."
        else
            log "WARNING: apply-profile.sh failed — the profile is stored and will be retried at the next configure run ('aegis up')."
        fi
    else
        log "no opencode.json yet in this home (agents not configured) — the stored profile will apply automatically by configure-workstation.sh on the next 'aegis up' or recreation."
    fi
}

cmd_profile_show() {
    _profile_require_up
    if ! _profile_exec "$DEV_CONTAINER" node -e "$_PROFILE_SHOW_JS" "$AEGIS_PROFILE_STORE_PATH" "$AEGIS_OPENCODE_JSON"; then
        err "could not read the stored profile inside the workstation ($DEV_CONTAINER)."
        exit 1
    fi
}

cmd_profile_clear() {
    _profile_require_up
    local state
    state="$(_profile_exec "$DEV_CONTAINER" sh -c 'if [ -f "$1" ]; then rm -f "$1"; echo removed; else echo none; fi' sh "$AEGIS_PROFILE_STORE_PATH" 2>/dev/null || true)"
    case "$state" in
        removed) log "removed the stored profile — the live opencode.json is untouched (providers already merged stay until configure regenerates the file)." ;;
        none)    log "no stored profile at $AEGIS_PROFILE_STORE_PATH — nothing to remove (live config untouched)." ;;
        *)       err "could not clear the stored profile inside the workstation."; exit 1 ;;
    esac
}

cmd_profile_help() {
    cat <<'EOF'
aegis profile — the personal OpenCode provider profile, persisted (T38)

  aegis profile use <path|name>
        Store the chosen profile at /workspace/code/.aegis/profile.json
        (the code data volume: survives a home/opencode-config recreation
        and rides `aegis backup`) and apply it immediately when opencode.json
        is already there — the merge is apply-profile.sh's shallow merge of
        the top-level `provider` key, idempotent, and leaves the gentle-ai
        fragments (agent/mcp/permission) untouched. A NAME resolves under
        /usr/local/share/aegis/profiles/. The profile must be valid JSON with
        a top-level provider object and WITHOUT any apiKey/token/secret key
        in that tree — API keys belong in /connect, not in profiles.
  aegis profile show
        The storage path, the stored provider names, and whether those
        providers are currently present in opencode.json (applied vs pending).
  aegis profile clear
        Remove the stored profile only. The live opencode.json is untouched.

configure-workstation.sh re-applies the stored profile at the end of every
configure run — that is the recreation-time recovery. The default-model
choice lives in OpenCode's own state and is NOT restored by this command.
See docs/10-workstation.md section 12.
EOF
}

cmd_profile() {
    local action="${1:-show}"
    [[ $# -gt 0 ]] && shift || true
    case "$action" in
        use) cmd_profile_use "$@" ;;
        show)
            [[ $# -eq 0 ]] || { err "usage: aegis profile show"; exit 2; }
            cmd_profile_show ;;
        clear)
            [[ $# -eq 0 ]] || { err "usage: aegis profile clear"; exit 2; }
            cmd_profile_clear ;;
        help|-h|--help) cmd_profile_help ;;
        *)
            err "unknown 'aegis profile' subcommand: $action"
            err "usage: aegis profile [use <path|name>|show|clear]"
            exit 2
            ;;
    esac
}

cmd_help() {
    case "$(_client_license_state)" in
        valid) cmd_help_client ;;
        expired) cmd_help_client_unlicensed; cmd_help_client_expired ;;
        *) cmd_help_client_unlicensed ;;
    esac
}

# Appended to the unlicensed document when the license expired: the commands
# that still work so the client can take its data out and stop the containers.
cmd_help_client_expired() {
    cat <<'EOF'

Your license expired (aegis account shows it). Until it is extended, these
still work so your data is never stranded:
  backup [--dest <dir>] [--full]    Back up code and Engram (--full: keep build output)
  export <path> [--dest <dir>]      Copy a file out of the workstation
  stop                        Stop it (your files and sessions are kept)
  down                        Remove the containers (volumes are kept)
  status                      What is running, resource use, volume sizes, last backup
EOF
}

# The client document before activation: only what works without a license
# (client-license-surface S1). Everything else is refused by _client_unlicensed,
# so it is not advertised here either.
cmd_help_client_unlicensed() {
    cat <<'EOF'
aegis — Aegis Workstation (client)

This machine has no valid license yet. Activate it first:
  aegis license activate <license-id>

Usage: aegis <command> [options]

  version                     Print the product version
  license [--file <path>]     Verify the signed license offline and show what it
                              entitles, or the reason it was refused
                              (alias: `aegis account`, kept for muscle memory)
  license activate <license-id> [--url <url>]
                              Claim a seat for this machine from the licensing
                              service and store the signed license
  license renew               Re-sign this machine's license under the current key
  license heartbeat           Tell the service this machine is alive
  license retire --yes        Free this machine's seat and delete its local files
  help, -h, --help            This help

Docs: docs/11-aegis-cli.md
EOF
}

# The one document: every command this launcher runs day to day.
# Client-redesign L5: the VANGEN welcome banner. Shown exactly twice --
# after a successful `aegis install` and on bare `aegis` (the interactive
# welcome). Never on explicit `aegis help`, `status`, or any other output:
# noise over information. Color only when stdout is a TTY.
_aegis_banner() {
    [[ -t 1 ]] && printf '\e[1;32m'
    cat <<'AEGIS_BANNER'
██╗   ██╗██████╗ ███╗   ██╗██████╗ ██████╗ ███╗   ██╗
██║   ██║██╔══██╗████╗  ██║██╔════╝██╔════╝ ████╗  ██║
██║   ██║███████║██╔██╗ ██║██║  ███╗█████╗   ██╔██╗ ██║
╚██╗ ██╔╝██╔══██║██║╚██╗██║██║   ██║██╔══╝   ██║╚██╗██║
 ╚████╔╝ ██║  ██║██║ ╚████║╚██████╔╝███████╗██║ ╚████║
  ╚═══╝  ╚═╝  ╚═╝╚═╝  ╚═══╝ ╚═════╝ ╚══════╝╚═╝  ╚═══╝
AEGIS_BANNER
    if [[ -t 1 ]]; then printf '\e[0m'; fi
    return 0
}

cmd_help_client() {
    cat <<'EOF'
aegis — Aegis Workstation

Usage: aegis <command> [options]

Empezar
  install                     Download the licensed configuration bundle for this
                              machine, verify it, and install it (needs an
                              active license)
  up                          Download the licensed image, verify its signature,
                              then start the workstation
  stop                        Stop it (your files and sessions are kept)
  down                        Remove the containers (volumes are kept)
  status                      What is running, resource use, volume sizes, last backup
  version                     Print the product version (aegis and its image)
  update                      Move to the latest version: install the signed
                              bundle, update this CLI, start the new image (your
                              environments and tools are rebuilt on it), then
                              remove the previous images. Volumes are kept.
  audit                       Check the security posture (PASS / FAIL)

Trabajar
  shell [path]                Open a terminal under /workspace/<path>
  herdr [path]                Open herdr under /workspace/<path>
    --secret <name>           Inject one vault secret into this session only
    --tunnel <host>:<port>[:<localPort>]
                              Repeatable: a localhost tunnel inside the session
                              for TCP clients that cannot use a proxy; the T40
                              allow rule is still the gate
    --cmd <command>           Run a single command instead of a terminal (or: -- <command>)
  profile use <path|name>     Store the chosen OpenCode provider profile in
                              the code volume (survives a home/config
                              recreation, rides `aegis backup`) and apply it
                              now; it re-applies automatically on the next
                              configure. API keys belong in /connect, never
                              in a profile.
  profile show                Stored path, provider names, applied vs pending.
  profile clear               Remove the stored profile (live config untouched).

Red
  allow list                  The egress allowlist
  allow add <domain>          Reach one more place (from the host only)
    --reason "..."              why it is there; `allow list` shows it back
    --for 30m|2h|7d             let it expire by itself (default: it does not)
    --ip                        only for a bare IP, which has to be asked for
  allow add --port <n> --for 30m|2h|7d [--to <host>]
                              A port window, no host: that port opens for EVERY
                              host already in the allowlist while it lives.
                              --to seeds the window's auto-tunnel (localhost:<n>
                              -> <host>:<n>) for every session
  allow remove <domain>       Take one of your own entries back out
  allow remove --port <n>     Take that port window back out
  allow reload                Re-apply the allowlist to the running proxy
  allow denied                What the proxy actually blocked
  allow test <url>            Would the proxy let this through?
  net connect [network]       Join an internal network to reach database containers
  net disconnect [network]    Leave it (alias: `aegis connect`, kept)
  sandbox <repo>              Boot a disposable, per-repo container with only
                              <repo> mounted and model-endpoints-only egress
    --gvisor                  Use the gVisor (runsc) runtime for this container
    --env <name>              Load one vault env file into this session only
    --secret <name>           Inject vault secret <name> as an environment variable
    --cmd <command>           Run a single command instead of a terminal (or: -- <command>)
  promote <repo>              Copy an evaluated sandbox repo into the
                              workstation's code volume, then tear the sandbox
                              down (copy first, destroy second)
    --to <destino>            Destination under code/ (default: the repo name)
    --force                   Replace the destination if it already exists
    --allow-dirty             Promote even with uncommitted changes

Tus datos
  secret list                 What is in the vault (names, sizes and dates)
  secret show <name>          Print ONE secret's content, after a confirmation
  secret put <name> --from <host-file>
                              Write a file into the vault (REPLACES if it exists)
  secret put <name> --stdin   Same seal from a pipe (cat <file> | aegis ...)
  secret host set <name> ...  Write an existing key's sidecars, sealed (T39.1)
  secret rm <name>            Remove one secret (no undo)
  backup [--dest <dir>] [--full]    Back up code and Engram (--full: keep build output)
  restore <archive>           Restore a backup (stop the workstation first)
  export <path> [--dest <dir>]      Copy a file out of the workstation
  import <host-path> <path>         Copy a file into the workstation

Licencia
  license [--file <path>]     Verify the signed license offline and show what it
                              entitles, or the reason it was refused
                              (alias: `aegis account`, kept for muscle memory)
  license activate <license-id> [--url <url>]
                              Claim a seat for this machine from the licensing
                              service and store the signed license
  license renew               Re-sign this machine's license under the current key
  license heartbeat           Tell the service this machine is alive
  license retire --yes        Free this machine's seat and delete its local files
  image verify [--tag <tag>]  Prove the local image was signed by this project's CI

Mantener
  env list                    Languages, versions and tools you have
  env list --remote <lang>    Versions available to add for one language
  add environment <lang> [version...]
                              Add a language (no version: pick from a menu)
                              lang: java, dotnet, node, go, python, cpp
  remove environment <lang> [version]
                              Remove a language or one of its versions
  add tool <name>             Add an opt-in CLI to the workstation
  remove tool <name>          Take it out of the image again
                              name: gh, az, railway, chromium (no name: list them, on/off)

  build windows <path>.iss    Compile an Inno Setup script (code/<Cliente>/<repo>/...)
                              in a throwaway Wine
                              container: no network, read-only, only that project
                              mounted (Docker Engine 26+). The .exe lands in
                              Output/ next to the .iss; take it out with `aegis export`
  build clean                 Remove the build-windows image (rebuilt on next use)
  telemetry status            Whether it is on, where it goes (never the token)
  telemetry on                Turn it on: sends to Vangen's fixed collector
  telemetry off               Turn it off and forget the token

Examples
  aegis shell --env auto code/my-repo
  aegis backup

Docs: docs/11-aegis-cli.md
EOF
}

# ---------------------------------------------------------------------------
# Update UX: optional log file and recovery hints (the steps and bars use
# the shared progress renderer near the top of this file)
# ---------------------------------------------------------------------------

_UPDATE_LOG_FILE=""
_UPDATE_VERBOSE=0

# Enable verbose logging to a file
_update_enable_logging() {
    _UPDATE_LOG_FILE="${1:-.aegis-update.log}"
    _UPDATE_VERBOSE=1
    mkdir -p "$(dirname "$_UPDATE_LOG_FILE")"
}

# Log message to file and optionally stdout
_update_log() {
    local level="$1" msg="$2"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local log_line="[$timestamp] [$level] $msg"

    if [[ -n "$_UPDATE_LOG_FILE" ]]; then
        printf '%s\n' "$log_line" >> "$_UPDATE_LOG_FILE"
    fi

    if [[ "$_UPDATE_VERBOSE" == "1" ]] && [[ "$level" != "DEBUG" ]]; then
        printf '    %s %s\n' "[$level]" "$msg" >&2
    fi
}

# Format error with recovery advice
_update_error_with_recovery() {
    local step_num="$1" error_msg="$2" recovery_state="$3"
    echo
    err "✗ Step $step_num failed: $error_msg"
    if [[ -n "$recovery_state" ]]; then
        err "  Recovery information saved to: $(tildify "$recovery_state")"
        err "  To resume, run: aegis update"
        err "  To view logs, run: tail -f $(tildify "$_UPDATE_LOG_FILE")"
    fi
    echo
}


# ---------------------------------------------------------------------------
# client-license-surface S3: `aegis update` moves to the latest SIGNED bundle
# and image:
#   1. aegis install            — the latest signed configuration bundle
#   2. the client CLI next to this one, atomically, with .bak copies
#   3. `aegis up` of the NEW CLI, in a fresh process (so it reads the new
#      version): pull + cosign-verify the new base, rebuild the developer image
#      when the manifest asks for anything, recreate the container. Named
#      volumes are never touched.
#   4. only after 3 succeeded: remove the previous base image and the previous
#      developer image. A failure anywhere keeps them, so nothing is lost.
# ---------------------------------------------------------------------------

_image_id() {
    docker image inspect --format '{{.Id}}' "$1" 2>/dev/null || true
}

# One KEY=value from a .env file (empty when missing).
_env_file_value() {
    local file="$1" key="$2"
    [[ -f "$file" ]] || return 0
    sed -n "s/^${key}=//p" "$file" | tail -n1
}

_remove_old_image() {
    if docker image rm "$1" >/dev/null 2>&1; then
        log "removed the previous image: $1"
    else
        err "WARNING: could not remove $1 (still in use?) — remove it later with: docker image rm $1"
    fi
}

# Step 2: the client launcher files, next to the launcher that is RUNNING (or
# into AEGIS_BIN_DIR when the caller set it), so the command the user actually
# types is the one updated. Fail-closed and all-or-nothing: every entry is
# staged BESIDE its target first, and only when all of them are ready are they
# renamed into place (the running script keeps its own inode: copying straight
# onto the target would truncate the file bash is reading from mid-run).
_client_bin_dir() {
    if [[ -n "$AEGIS_BIN_DIR_EXPLICIT" ]]; then
        printf '%s' "${AEGIS_BIN_DIR%/}"
    else
        printf '%s' "${SCRIPT_DIR%/}"
    fi
}

# T4: downloads the latest (or AEGIS_CLI_VERSION-pinned) aegis-cli release,
# verifies its cosign bundle with the SAME throwaway-container pattern
# _verify_local_image uses for the workstation image (no binary to manage on
# Windows), and extracts it. On success, sets AEGIS_CLI_STAGING_DIR to the
# extraction directory — a global, NOT an echo: log()/err() write to stdout,
# so a `$(_fetch_cli_release)` capture would corrupt the path with every
# progress line this function prints. The caller is responsible for removing
# its PARENT (the mktemp -d root) once it is done reading from it. Failure is
# a non-zero return with AEGIS_CLI_STAGING_DIR left unset.
AEGIS_CLI_STAGING_DIR=""
_fetch_cli_release() {
    AEGIS_CLI_STAGING_DIR=""
    local tag="${AEGIS_CLI_VERSION:-}" staging tarball bundle out rc=0
    command -v docker >/dev/null 2>&1 || { err "docker is required to verify the aegis-cli release"; return 1; }
    staging="$(mktemp -d)" || { err "mktemp failed"; return 1; }
    tarball="${staging}/aegis-cli.tar.gz"
    bundle="${staging}/aegis-cli.tar.gz.cosign.bundle"

    if [[ -z "$tag" ]]; then
        tag="$(curl -fsSL "https://api.github.com/repos/${AEGIS_CLI_REPO}/releases/latest" \
            | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
        if [[ -z "$tag" ]]; then
            err "could not resolve the latest aegis-cli release"
            rm -rf "$staging"
            return 1
        fi
    fi

    local base_url="https://github.com/${AEGIS_CLI_REPO}/releases/download/${tag}"
    if ! pg_download "${base_url}/aegis-cli.tar.gz" "$tarball"; then
        err "could not download aegis-cli ${tag}"
        rm -rf "$staging"
        return 1
    fi
    if ! pg_download "${base_url}/aegis-cli.tar.gz.cosign.bundle" "$bundle"; then
        err "could not download the aegis-cli ${tag} signature bundle"
        rm -rf "$staging"
        return 1
    fi

    log "verifying aegis-cli ${tag}"
    out="$(mktemp)" || { err "mktemp failed"; rm -rf "$staging"; return 1; }
    local staging_native
    staging_native="$(_to_native_path "$staging")"
    # No registry credentials needed here (unlike _verify_local_image): a
    # blob verification only talks to public Sigstore infrastructure
    # (Fulcio/Rekor/TUF), never the private proxy registry. --user 0:0 for
    # the same reason as there — the pinned image's uid 65532 cannot read a
    # plain mktemp -d on a real Linux host.
    env MSYS_NO_PATHCONV=1 docker run --rm \
        --user 0:0 \
        --volume "${staging_native}:/work:ro" \
        "$AEGIS_COSIGN_IMAGE" verify-blob \
            --bundle /work/aegis-cli.tar.gz.cosign.bundle \
            --certificate-oidc-issuer "$AEGIS_IMAGE_OIDC_ISSUER" \
            --certificate-identity-regexp "$AEGIS_CLI_IDENTITY_REGEXP" \
            /work/aegis-cli.tar.gz >"$out" 2>&1 || rc=$?
    if [[ "$rc" -ne 0 ]]; then
        err "the aegis-cli ${tag} signature did NOT verify:"
        sed 's/^/  /' "$out" >&2
        rm -f "$out"
        rm -rf "$staging"
        return 1
    fi
    rm -f "$out"
    log "aegis-cli ${tag} signature verified — signed by a run of github.com/${AEGIS_CLI_REPO}"

    # R1-001, carried over from the old host-launcher-files.txt check: a bare
    # file name only, never a path out of the extraction directory. GNU tar
    # does not refuse a `../` member on its own, and a signature only proves
    # WHO published the bytes, not that this script trusts every path inside
    # them — so the member list is validated BEFORE tar ever touches disk.
    #
    # aegis-cli's own scripts/build-release-tarball.sh packs with
    # `tar -C <stage> -cf - .`, which gives every member a leading "./" AND
    # an explicit "./" entry for the staging directory itself (confirmed
    # against a real published release, not assumed) — strip that prefix
    # before judging a member "a path", and the bare "./" entry is the
    # directory, not a file to reject.
    local m stripped
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        stripped="${m#./}"
        [[ -z "$stripped" ]] && continue
        if [[ "$stripped" == */* || "$stripped" == .* ]]; then
            err "the aegis-cli ${tag} release contains an invalid member '${m}' — the CLI was not updated."
            rm -rf "$staging"
            return 1
        fi
    done < <(tar -tzf "$tarball")

    mkdir -p "${staging}/extracted"
    if ! tar -xzf "$tarball" -C "${staging}/extracted"; then
        err "could not extract aegis-cli ${tag}"
        rm -rf "$staging"
        return 1
    fi
    AEGIS_CLI_STAGING_DIR="${staging}/extracted"
}

_client_install_launcher() {
    local dst stamp f staging
    dst="$(_client_bin_dir)"

    if ! _fetch_cli_release; then
        err "the CLI was not updated."
        return 1
    fi
    staging="$AEGIS_CLI_STAGING_DIR"

    local -a names=()
    for f in "${staging}"/*; do
        [[ -f "$f" ]] || continue
        names+=("$(basename "$f")")
    done
    if [[ ${#names[@]} -eq 0 ]]; then
        err "the downloaded aegis-cli release had no files — the CLI was not updated."
        rm -rf "$(dirname "$staging")"
        return 1
    fi

    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "$dst"
    for f in "${names[@]}"; do
        if ! cp "${staging}/${f}" "${dst}/.${f}.new-${stamp}"; then
            local g
            for g in "${names[@]}"; do rm -f "${dst}/.${g}.new-${stamp}"; done
            err "could not stage the new CLI in $(tildify "$dst") — the CLI was not updated."
            rm -rf "$(dirname "$staging")"
            return 1
        fi
        [[ "$f" == "aegis" ]] && chmod +x "${dst}/.${f}.new-${stamp}" 2>/dev/null || true
    done
    rm -rf "$(dirname "$staging")"
    # Commit: back up, then rename into place. Every step is checked: a failure
    # here is reported as a partial update with its backups, never as success.
    local failed=""
    for f in "${names[@]}"; do
        if [[ -f "${dst}/${f}" ]] && ! cp -p "${dst}/${f}" "${dst}/${f}.bak-${stamp}"; then
            failed="$f"; break
        fi
        if ! mv -f "${dst}/.${f}.new-${stamp}" "${dst}/${f}"; then
            failed="$f"; break
        fi
    done
    if [[ -n "$failed" ]]; then
        for f in "${names[@]}"; do rm -f "${dst}/.${f}.new-${stamp}"; done
        err "the CLI in $(tildify "$dst") was only PARTLY updated (stopped at ${failed});"
        err "restore it from its *.bak-${stamp} files, or run 'aegis update' again."
        return 1
    fi
    log "CLI updated in $(tildify "$dst") (previous files: *.bak-${stamp})"
}

# The images a client update replaces, written BEFORE the install and removed
# only after their cleanup: a retry after a failed start still knows which
# images were the previous ones (review finding R4-002).
_client_update_state_file() {
    printf '%s' "${AEGIS_INSTALL_DIR%/}.update-previous"
}

# _update_cleanup_line <removed> <reason>: renders the cleanup line of the
# `aegis update` summary from what the run ACTUALLY did. $1 is the number of
# images really removed; $2 says why nothing was queued for removal
# ("same-version" | "no-stale-images") and is read only when $1 is 0. With
# images removed it keeps the success check; with none it states plainly that
# there was nothing to clean, because a ✓ over an empty to_remove list claims
# work the run never did (same truth class as the warm-pull fix, 78e28c8).
_update_cleanup_line() {
    local removed="$1" reason="$2"
    if (( removed > 0 )); then
        printf '  ✓ Previous images cleaned up\n'
    elif [[ "$reason" == "same-version" ]]; then
        printf '  - Nothing to clean up: same version, no stale images\n'
    else
        printf '  - Nothing to clean up: no stale images\n'
    fi
}

cmd_update_client() {
    local verbose=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --verbose|-v) verbose=1; shift ;;
            --help|-h)
                err "usage: aegis update [--verbose]"
                exit 0
                ;;
            -*)
                err "usage: aegis update [--verbose]"
                exit 2
                ;;
            *)
                err "usage: aegis update [--verbose]"
                exit 2
                ;;
        esac
    done

    [[ "$verbose" == "1" ]] && _update_enable_logging "${HOME}/.aegis/update.log"

    printf '\n'
    log "Starting aegis update..."
    _update_log "INFO" "aegis update started at $(date)"

    local env_file="${AEGIS_WORKSTATION_DIR%/}/.devcontainer/.env" state bin_dir resumed=0
    local old_version old_tag old_base_ref old_base_id old_dev new_version new_tag new_base_id new_dev
    # Every one of these is initialized: the launcher runs with set -u, and the
    # sweep guards below read them even when the branch that assigns them never
    # runs (a same-version update skips the old-dev removal entirely — the
    # 0.27.4 acceptance hit exactly that and died mid-update).
    local old_env_ids="" old_dev_id="" new_dev_id="" stage=""
    state="$(_client_update_state_file)"
    bin_dir="$(_client_bin_dir)"
    if [[ -f "$state" ]]; then
        # A previous update installed but did not finish: keep ITS old images.
        old_version="$(_env_file_value "$state" OLD_VERSION)"
        old_tag="$(_env_file_value "$state" OLD_TAG)"
        old_base_id="$(_env_file_value "$state" OLD_BASE_ID)"
        old_dev="$(_env_file_value "$state" OLD_DEV)"
        stage="$(_env_file_value "$state" STAGE)"
        resumed=1
        # 2026-10-29 incident (issue #251 follow-up): STAGE=2 means two
        # DIFFERENT things, and the code used to treat them as one. (a) This
        # process IS the handoff exec from the line below, immediately after
        # 1-2 just succeeded in the parent — AEGIS_UPDATE_HANDOFF marks that.
        # (b) This is a FRESH `aegis update` invocation from the user, finding
        # a STAGE=2 state left over because step 3 (start) failed last time.
        # Collapsing both into "skip 1-2" was the bug: a client stuck on a
        # broken published version (v0.37.2's invalid compose, #251) re-pulled
        # the SAME broken bundle:latest-tag forever — step 3 always failed the
        # same way, re-writing STAGE=2, forever. Case (b) must re-run step 1:
        # installing bundle:latest is idempotent (backup + re-extract) and is
        # the ONLY step that can pick up a newer release published since the
        # last failure, which is what lets a stuck client converge on its own.
        if [[ "$stage" == "2" && -n "${AEGIS_UPDATE_HANDOFF:-}" ]]; then
            log "resuming at 3/4 with the updated CLI"
        elif [[ "$stage" == "2" ]]; then
            log "a previous update installed but failed to start — reinstalling the bundle in case a fix was published since, then retrying"
        else
            log "resuming an unfinished update from ${old_version:-unknown}"
        fi
    else
        old_version="$(_product_version || echo unknown)"
        old_tag="$AEGIS_IMAGE_TAG"
        old_base_id="$(_image_id "${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${old_tag}")"
        # Read BEFORE the install: it replaces the configuration tree, .env included.
        old_dev="$(_env_file_value "$env_file" AEGIS_DEV_IMAGE)"
        mkdir -p "$(dirname "$state")"
        printf 'OLD_VERSION=%s\nOLD_TAG=%s\nOLD_BASE_ID=%s\nOLD_DEV=%s\n' \
            "$old_version" "$old_tag" "$old_base_id" "$old_dev" > "$state"
    fi
    old_base_ref="${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${old_tag}"
    local -a child_env=(-u AEGIS_VERIFIED_BASE_REF -u AEGIS_DEV_IMAGE)
    [[ -n "$AEGIS_IMAGE_TAG_EXPLICIT" ]] || child_env+=(-u AEGIS_IMAGE_TAG)

    if [[ "$stage" != "2" || -z "${AEGIS_UPDATE_HANDOFF:-}" ]]; then
        pg_step 1 4 "Installing signed configuration bundle"
        _update_log "INFO" "Installing bundle from $(tildify "${AEGIS_INSTALL_SOURCE:-registry}")"
        if ! ( cmd_install ); then
            # Nothing was replaced: a state file this run created would make the
            # next update "resume" one that never happened (review finding R3-002).
            [[ "$resumed" == "1" ]] || rm -f "$state"
            _update_log "ERROR" "Bundle installation failed"
            _update_error_with_recovery 1 "the bundle was not installed — your CLI and images were not changed." "$state"
            exit 1
        fi
        _update_log "INFO" "Bundle installed successfully"
        pg_done 1

        pg_step 2 4 "Updating CLI"
        _update_log "INFO" "Updating CLI from $(tildify "$bin_dir")"
        if ! _client_install_launcher; then
            _update_log "ERROR" "CLI installation failed"
            _update_error_with_recovery 2 "the configuration is already the new one; run 'aegis update' again once the cause is fixed." "$state"
            exit 1
        fi
        _update_log "INFO" "CLI updated successfully"
        pg_done 2

        # Steps 3/4 belong to the NEW version's code (an older CLI does not even
        # know the image sweep exists), but they were still running inside THIS
        # process — so a client updating from an older release got the new
        # cleanup one update late. Hand the process over: the state file says
        # STAGE=2, so the updated launcher resumes straight at 3/4, and exec
        # keeps the same stdout/stderr, making the handoff invisible.
        printf 'STAGE=2\n' >> "$state"
        log "handing over to the updated CLI for the start + cleanup"
        # AEGIS_UPDATE_HANDOFF=1 marks THIS exact exec as the handoff: the
        # child process reads STAGE=2 AND this var together to know steps 1-2
        # just ran in its parent and must not run again. A later, independent
        # `aegis update` invocation never carries this var, so it reads
        # STAGE=2 alone as "the previous attempt died before cleanup" and
        # correctly re-runs step 1 instead of skipping it.
        exec env "${child_env[@]}" AEGIS_UPDATE_HANDOFF=1 bash "${bin_dir}/aegis" update
    fi

    # Step 3 is the new CLI's own `aegis up`: it prints its own phases and
    # measured progress (image pull, build steps), so nothing is drawn here.
    pg_step 3 4 "Starting new version (download + verify; rebuilding image if needed)"
    _update_log "INFO" "Pulling base image: ${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${new_tag:-<auto>}"
    # Every developer image that exists right now was built by the OLD version —
    # the rebuild `up` is about to do does not count. Captured HERE, not before
    # the install, so a handoff from an older CLI (whose code never captured
    # anything) still gets the full set: nothing has been removed yet.
    old_env_ids="$(docker images --format '{{.ID}}' "$AEGIS_ENV_IMAGE_REPO" | tr '\n' ' ')"
    _update_log "INFO" "Found $( echo $old_env_ids | wc -w ) previous developer images"
    if ! env "${child_env[@]}" bash "${bin_dir}/aegis" up; then
        _update_log "ERROR" "Failed to start new version"
        err "the new version did not start — the previous images are kept, so nothing was removed."
        err "the new configuration and CLI are installed; the previous ones are in $(tildify "${AEGIS_INSTALL_DIR%/}").bak-<date> and $(tildify "$bin_dir")/*.bak-<date>."
        err "fix the cause above and run 'aegis update' again: it still removes the previous images once the new version starts."
        exit 1
    fi
    _update_log "INFO" "New version started successfully"
    pg_done 3

    pg_step 4 4 "Removing previous images"
    new_version="$(_product_version || echo unknown)"
    if [[ -n "$AEGIS_IMAGE_TAG_EXPLICIT" ]]; then
        new_tag="$AEGIS_IMAGE_TAG"
    else
        new_tag="v${new_version}"
    fi
    new_base_id="$(_image_id "${AEGIS_IMAGE_REGISTRY}/${AEGIS_IMAGE_REPO}:${new_tag}")"
    new_dev="$(_env_file_value "$env_file" AEGIS_DEV_IMAGE)"
    # The list is built first so the bar counts real removals against a known
    # total. The previous developer image goes only when it IS one and it
    # changed.
    local id
    local -a to_remove=()
    if [[ "$old_dev" == "${AEGIS_ENV_IMAGE_REPO}:"* && "$old_dev" != "$new_dev" ]]; then
        old_dev_id="$(_image_id "$old_dev")"
        to_remove+=("$old_dev")
    fi
    new_dev_id="$(_image_id "$new_dev")"
    # ...and so does every OTHER developer image captured before the start:
    # each was built on the old base and holds its layers hostage on disk. The
    # image the NEW container runs (which can coincide with an old id when the
    # rebuild is byte-identical) and the one already listed by ref are spared.
    for id in ${old_env_ids}; do
        [[ -n "$id" && "$id" != "$new_dev_id" && "$id" != "$old_dev_id" ]] || continue
        docker image inspect "$id" >/dev/null 2>&1 || continue
        to_remove+=("$id")
    done
    # The previous base: by its tag when the version moved, by its id when the
    # same tag was re-published under a new digest.
    if [[ -n "$old_base_id" ]]; then
        if [[ "$old_tag" != "$new_tag" ]]; then
            to_remove+=("$old_base_ref")
        elif [[ "$old_base_id" != "$new_base_id" ]]; then
            to_remove+=("$old_base_id")
        fi
    fi
    local removed=0
    for id in "${to_remove[@]}"; do
        _remove_old_image "$id"
        removed=$(( removed + 1 ))
        pg_progress "$removed" "${#to_remove[@]}" images force
    done
    pg_done 4
    _update_log "INFO" "Cleanup completed, removing state file"
    rm -f "$state"

    printf '\n'
    printf '✓ Updated: aegis %s -> %s\n' "$old_version" "$new_version"
    printf '  ✓ Configuration installed\n'
    printf '  ✓ CLI updated\n'
    printf '  ✓ Base image verified and running\n'
    if (( removed > 0 )); then
        _update_cleanup_line "$removed" ""
    elif [[ "$old_tag" == "$new_tag" ]]; then
        # Nothing was queued: the run resolved to the same version, so there
        # was never anything to remove.
        _update_cleanup_line 0 "same-version"
    else
        # to_remove is empty here, so nothing stale was found against the new
        # version even though the version moved.
        _update_cleanup_line 0 "no-stale-images"
    fi
    printf '  ✓ All data preserved\n'
    printf '\n'

    if [[ -n "$_UPDATE_LOG_FILE" ]]; then
        printf 'Logs: %s\n' "$(tildify "$_UPDATE_LOG_FILE")"
    fi
    printf '\n'

    _update_log "INFO" "aegis update completed successfully at $(date)"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

# client-license-surface S1: is this machine licensed? The same offline Ed25519
# verification `aegis account` runs (aegis-license.js verify, exit 0 = valid);
# an expired, tampered or missing license — or a missing helper/key file — is
# "not licensed". Silent: the caller decides what to say.
_client_licensed() {
    [[ "$(_client_license_state)" == "valid" ]]
}

# valid | expired | none. "expired" means the token IS authentic (signed by an
# accepted key) and only its window closed: aegis-license.js prints the
# entitlement report on stdout for exactly that case and nothing for a
# tampered, untrusted or unreadable one. main() computes it once into
# _CLIENT_LICENSE_STATE (a $(...) call runs in a subshell and could not cache).
_CLIENT_LICENSE_STATE=""
_client_license_state() {
    if [[ -z "$_CLIENT_LICENSE_STATE" ]]; then
        _CLIENT_LICENSE_STATE="none"
        if [[ -f "$AEGIS_LICENSE_FILE" && -f "$AEGIS_LICENSE_KEYS_FILE" && -f "$LICENSE_JS" ]] \
            && command -v node >/dev/null 2>&1; then
            local out rc=0
            out="$(node "$LICENSE_JS" verify "$AEGIS_LICENSE_FILE" "$AEGIS_LICENSE_KEYS_FILE" 2>/dev/null)" || rc=$?
            if [[ "$rc" -eq 0 ]]; then
                _CLIENT_LICENSE_STATE="valid"
            elif [[ "$rc" -eq 1 && -n "$out" ]]; then
                _CLIENT_LICENSE_STATE="expired"
            fi
        fi
    fi
    printf '%s' "$_CLIENT_LICENSE_STATE"
}

# Refuses a command that needs a license, before it runs anything.
_client_unlicensed() {
    local cmd="$1"
    err "'aegis ${cmd}' needs a license — this machine has no valid license."
    err "activate it with: aegis license activate <license-id>   (aegis license shows why the current one was refused)"
    exit 2
}

main() {
    # Bare `aegis` (no arguments at all) is the interactive welcome: banner
    # first, then the help. An explicit `aegis help` stays pure information.
    if [[ $# -eq 0 ]]; then
        _aegis_banner
    fi
    local sub="${1:-help}"
    [[ $# -gt 0 ]] && shift || true

    _CLIENT_LICENSE_STATE="$(_client_license_state)"
    # S1: an ALLOW-list, so it fails closed — a command added to the
    # dispatch below is gated without touching this block. Without a valid
    # license only version/account/help answer; anything else (an unknown
    # word included) is refused before it runs. Licensed, an unknown word
    # still reaches "unknown command".
    #
    # A license that existed and EXPIRED must not strand the client's data
    # (user decision 2026-10-14): backup/export/stop/down/status stay
    # available for it, never for a machine that never had a valid one.
    case "$sub" in
        version|--version|-v|account|license|help|-h|--help) ;;
        backup|export|stop|down|status)
            [[ "$(_client_license_state)" != "none" ]] || _client_unlicensed "$sub"
            ;;
        install)
            # Client-redesign L4.2: `aegis install <license-id>` is the
            # complete first journey — the activation runs inside the command,
            # before anything is installed. Bare `install` unlicensed gets the
            # journey explanation instead of the generic gate refusal.
            if [[ -z "${1:-}" ]]; then
                _client_licensed || {
                    err "'aegis install' needs a license — run the first journey in one command:"
                    err "  aegis install <license-id>"
                    err "or the explicit two-step alternative: aegis license activate <license-id>"
                    exit 2
                }
            fi
            ;;
        *) _client_licensed || _client_unlicensed "$sub" ;;
    esac

    case "$sub" in
        up) cmd_up "$@" ;;
        shell) cmd_shell "$@" ;;
        herdr) cmd_herdr "$@" ;;
        sandbox) cmd_sandbox "$@" ;;
        promote) cmd_promote "$@" ;;
        license) _LICENSE_CMD="license"; cmd_account "$@" ;;
        account) _LICENSE_CMD="account"; cmd_account "$@" ;;
        net)
            case "${1:-}" in
                connect) shift; cmd_connect "$@" ;;
                disconnect) shift; cmd_disconnect "$@" ;;
                *)
                    err "unknown 'aegis net' subcommand: ${1:-<none>} (expected: aegis net connect|disconnect)"
                    exit 2
                    ;;
            esac
            ;;
        volume) cmd_volume "$@" ;;
        image) cmd_image "$@" ;;
        env) cmd_env "$@" ;;
        add)
            case "${1:-}" in
                environment) shift; cmd_add_environment "$@" ;;
                tool) shift; cmd_add_tool "$@" ;;
                *)
                    err "unknown 'aegis add' subcommand: ${1:-<none>} (expected: aegis add environment ... | aegis add tool ...)"
                    exit 2
                    ;;
            esac
            ;;
        remove)
            case "${1:-}" in
                environment) shift; cmd_remove_environment "$@" ;;
                tool) shift; cmd_remove_tool "$@" ;;
                *)
                    err "unknown 'aegis remove' subcommand: ${1:-<none>} (expected: aegis remove environment ... | aegis remove tool ...)"
                    exit 2
                    ;;
            esac
            ;;
        connect) cmd_connect "$@" ;;
        disconnect) cmd_disconnect "$@" ;;
        stop) cmd_stop "$@" ;;
        down) cmd_down "$@" ;;
        status) cmd_status "$@" ;;
            allow) cmd_allow "$@" ;;
            audit) cmd_audit "$@" ;;
        install) cmd_install "$@" ;;
        update) cmd_update_client "$@" ;;
        secret) cmd_secret "$@" ;;
        profile) cmd_profile "$@" ;;
        telemetry) cmd_telemetry "$@" ;;
        version|--version|-v) cmd_version ;;
        backup) cmd_backup "$@" ;;
        restore) cmd_restore "$@" ;;
        export) cmd_export "$@" ;;
        import) cmd_import "$@" ;;
        build) cmd_build "$@" ;;
        help|-h|--help) cmd_help ;;
        *)
            err "unknown command: $sub"
            cmd_help
            exit 2
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Telemetry hook
#
# Many cmd_* functions `exit` from inside, so the one place that sees every
# finished command is an EXIT trap, installed right before main. It reports the
# first one or two words only when they are in the fixed vocabulary of
# aegis-telemetry.js (anything else becomes "other"): the second word is
# captured only for the grouped commands, so a path or a name typed after
# `shell` or `secret show` is never even held.
#
# Off costs two bash tests (kill switch, config file) and no process. On, the
# sender is started detached in the background: the CLI never waits for the
# network, and the sender itself gives up after ~3s. A synchronous send with a
# hard cap would add up to that cap to every command on a slow link; background
# + disown with all three fds redirected survives bash exiting in Git Bash and
# cannot keep a caller's pipe open.
# ---------------------------------------------------------------------------

_TELEMETRY_FIRST=""
_TELEMETRY_SECOND=""
_TELEMETRY_START_NS=""

_telemetry_now_ns() {
    local n
    n="$(date +%s%N 2>/dev/null || true)"
    [[ "$n" =~ ^[0-9]{16,}$ ]] && printf '%s' "$n"
    return 0
}

_telemetry_emit() {
    local rc="$1"
    case "$_TELEMETRY_FIRST" in ""|help|-h|--help|telemetry) return 0 ;; esac
    case "${AEGIS_TELEMETRY:-}" in off|OFF|Off) return 0 ;; esac
    [[ -f "${AEGIS_TELEMETRY_FILE:-$HOME/.aegis/telemetry.json}" ]] || return 0
    [[ -f "$TELEMETRY_JS" ]] || return 0
    command -v node >/dev/null 2>&1 || return 0
    local end_ns ms=0
    end_ns="$(_telemetry_now_ns)"
    if [[ -n "$_TELEMETRY_START_NS" && -n "$end_ns" ]]; then
        ms=$(( (end_ns - _TELEMETRY_START_NS) / 1000000 ))
    fi
    # node on Windows cannot open an MSYS path (/c/Users/...), and MSYS_NO_PATHCONV
    # turns off the automatic translation, so every file the sender reads is
    # handed over as a native path. Without this the language manifest silently
    # read as empty on Windows.
    AEGIS_ENV_FILE="$(_to_native_path "$AEGIS_ENV_FILE")" \
    AEGIS_TELEMETRY_FILE="$(_to_native_path "${AEGIS_TELEMETRY_FILE:-$HOME/.aegis/telemetry.json}")" \
    MSYS_NO_PATHCONV=1 node "$(_to_native_path "$TELEMETRY_JS")" send \
        --first "$_TELEMETRY_FIRST" --second "$_TELEMETRY_SECOND" \
        --exit-code "$rc" --duration-ms "$ms" \
        --workstation-dir "$(_to_native_path "${AEGIS_WORKSTATION_DIR%/}")" \
        </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
    return 0
}

# Captures the exit status first and never changes it.
_telemetry_on_exit() {
    local rc=$?
    set +e +u
    # OD1.2: client install fetches into a temp dir; this is the one EXIT trap,
    # so the cleanup lives here rather than in a second trap that would replace
    # this one (and the telemetry report with it).
    if [[ -n "${AEGIS_INSTALL_TMP:-}" && -d "${AEGIS_INSTALL_TMP:-}" ]]; then
        rm -rf "$AEGIS_INSTALL_TMP"
    fi
    _telemetry_emit "$rc" 2>/dev/null || true
    return 0
}

_TELEMETRY_FIRST="${1:-}"
case "$_TELEMETRY_FIRST" in
    # The defaults the dispatchers apply have to be applied here too, or a bare
    # `aegis account` -- which reports the licence -- would be counted as "other".
    account) _TELEMETRY_SECOND="${2:-license}" ;;
    license) _TELEMETRY_SECOND="${2:-show}" ;;
    env|secret|allow|add|remove|build) _TELEMETRY_SECOND="${2:-}" ;;
esac
_TELEMETRY_START_NS="$(_telemetry_now_ns)"
trap '_telemetry_on_exit' EXIT

main "$@"
